#!/usr/bin/env bash
# Run one proxy scenario: a repository rule downloads one URL through scripts/proxy/fake-proxy.
#
# usage: scripts/proxy/run <oracle|BLAZE-BINARY> <out-dir> <url> <proxy-var>=<proxy-url> <responses>
#                          [<extra startup option>...]
#        scripts/proxy/run selftest
#        scripts/proxy/run help
#
#   <url>         what `repository_ctx.download` fetches, for example https://origin.example/f;
#                 a comma-separated list downloads each URL in turn (outputs f0, f1, ...)
#   <proxy-var>   HTTPS_PROXY, HTTP_PROXY, https_proxy or http_proxy; in <proxy-url> the word PORT
#                 is replaced by the fake proxy's port (http://user:pw@127.0.0.1:PORT)
#   <responses>   the fake proxy's answer list (scripts/proxy/fake-proxy help)
#
# Workspace: ~/.cache/blaze/work/proxy/ws (MODULE.bazel, defs.bzl, BUILD.bazel written each run;
# the download carries the sha256 of "hello\n", the fake proxy's body, since Bazel refuses http
# without a checksum;
# the module has no bazel_dep; its lockfile and the registry files are fetched once without a
# proxy into the private repository cache ~/.cache/blaze/work/proxy/repo-cache, so the proxied
# download is the server's first HTTP connection; the cached "hello\n" blob and the fetched
# repository are deleted before each run).
# Runs `query @r//:all` with startup options --output_user_root=~/.cache/blaze/oracle-out/proxy-ur
# --nohome_rc --nosystem_rc and command options --repository_cache=<private> --color=no
# --curses=no, inside
# `systemd-run --user --collect --wait -p MemoryMax=12G -p MemorySwapMax=0` (the server dies with
# the unit: every run is a fresh JVM, so ProxyHelper's one-time Authenticator setup happens anew),
# through scripts/lib/compare_common.py, whose supervisor records how the binary really ended
# (systemd-run itself returns 0 after a death by SIGPIPE or SIGTERM).
# Environment: HOME, PATH=/usr/bin:/bin, the proxy variable.
# `oracle` must be the pinned oracle (sha256 in UPSTREAM.json), or the run is refused (exit 2).
# Results in <out-dir>: the proxy log (NN-cC.req, NN-cC.tunnel, events.txt), stderr, exit-code
# (the number after a normal exit; otherwise `signal SIGPIPE`, `oom-kill (...)`, `timeout`),
# termination (compare_common's text), binary.txt (path and sha256 of the binary).
# This tool records; it compares nothing. What the Rust tests compare: scripts/proxy/classify.
# selftest: a fake binary killed by SIGPIPE through the same launcher must not record exit 0.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
cc="$here/../lib/compare_common.py"

# launch <out-dir> <ws> <binary> <args...>: runs the binary in a --wait service unit with a clean
# environment (plus the variables given as --env K=V before the binary, see below), stdout and
# stderr to <out-dir>, the termination to <out-dir>/termination; echoes the exit-code text.
launch() {
  local out=$1 ws=$2; shift 2
  local envs=()
  while [[ $1 == --env ]]; do envs+=(--env "$2"); shift 2; done
  set +e
  /usr/bin/python3 -I "$cc" run --mode service --cwd "$ws" "${envs[@]}" \
    --stdout "$out/stdout" --stderr "$out/stderr" --termination "$out/termination" -- "$@" \
    2>/dev/null
  set -e
  local t; t=$(cat "$out/termination")
  if [[ $t =~ ^exit\ ([0-9]+)$ ]]; then echo "${BASH_REMATCH[1]}"; else echo "$t"; fi
}

if [[ ${1:-} == selftest ]]; then
  d=$(mktemp -d "$HOME/.cache/blaze/work/compare-common/selftest-proxy-XXXXXX")
  printf '#!/bin/bash\necho hello\nkill -PIPE $$\n' > "$d/fake"; chmod +x "$d/fake"
  printf '#!/bin/bash\necho hello\nexit 3\n' > "$d/fake3"; chmod +x "$d/fake3"
  fail=0
  got=$(launch "$d" "$d" "$d/fake" query); echo "  SIGPIPE recorded as: $got"
  [[ $got == "signal SIGPIPE" ]] || fail=1
  got=$(launch "$d" "$d" "$d/fake3" query); echo "  exit 3 recorded as: $got"
  [[ $got == 3 ]] || fail=1
  if /usr/bin/python3 -I "$cc" check-oracle "$d/fake" 2>/dev/null; then
    echo "  wrong oracle accepted"; fail=1
  else echo "  wrong oracle refused"; fi
  rm -r "$d"
  if [[ $fail == 0 ]]; then echo "proxy/run selftest: PASS"; else echo "proxy/run selftest: FAIL"; fi
  exit $fail
fi
if [[ $# -lt 5 || $1 == help ]]; then sed -n '2,35p' "$0" | sed 's/^# \{0,1\}//'; exit 0; fi
bin=$1; out=$2; url=$3; pvar=${4%%=*}; purl=${4#*=}; responses=$5
shift 5; extra=("$@")
if [[ $bin == oracle ]]; then
  bin=~/.cache/blaze/oracle/bazel-9.3.2-linux-x86_64
  /usr/bin/python3 -I "$cc" check-oracle "$bin" >/dev/null || exit 2
fi
ws=~/.cache/blaze/work/proxy/ws
ur=~/.cache/blaze/oracle-out/proxy-ur
rc=~/.cache/blaze/work/proxy/repo-cache
mkdir -p "$ws" "$ur"
rm -rf "$out"; mkdir -p "$out"
echo 'module(name = "proxy_probe")
dl = use_repo_rule("//:defs.bzl", "dl")
dl(name = "r", urls = ["'"${url//,/\",\"}"'"])' > "$ws/MODULE.bazel"
cat > "$ws/defs.bzl" <<'EOF'
def _impl(rctx):
    for i, url in enumerate(rctx.attr.urls):
        rctx.download(url = url, output = "f%d" % i, canonical_id = url, sha256 = "5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03")
    rctx.file("BUILD.bazel", "")

dl = repository_rule(implementation = _impl, attrs = {"urls": attr.string_list()})
EOF
: > "$ws/BUILD.bazel"
common=(--output_user_root="$ur" --nohome_rc --nosystem_rc)
if [[ ! -f $ws/MODULE.bazel.lock ]]; then
  mkdir -p "$out/warmup"
  warm=$(launch "$out/warmup" "$ws" "$bin" "${common[@]}" mod deps --repository_cache="$rc")
  echo "warm-up mod deps: $warm"
fi
rm -rf "$rc"/content_addressable/sha256/5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03
rm -rf "$ur"/*/external/+dl+r "$ur"/*/external/@+dl+r.marker
log=$out/proxy
"$here/fake-proxy" 0 "$log" "$responses" > "$out/proxy.port" &
ppid_=$!
trap 'kill $ppid_ 2>/dev/null || true' EXIT
for _ in $(seq 50); do [[ -s $out/proxy.port ]] && break; read -rt 0.1 <> <(:) || true; done
port=$(head -1 "$out/proxy.port")
purl=${purl//PORT/$port}
echo "$bin $(sha256sum "$bin" | cut -d' ' -f1)" > "$out/binary.txt"
code=$(launch "$out" "$ws" --env "$pvar=$purl" \
  "$bin" "${common[@]}" "${extra[@]}" query @r//:all --repository_cache="$rc" --color=no --curses=no)
echo "$code" > "$out/exit-code"
echo "$out exit=$code"
