#!/usr/bin/env bash
# Runs the shell functions of Bazel's src/test/shell/bazel/remote/remote_downloader_test.sh
# (the remote downloader, --experimental_remote_downloader, backed by the remote worker's Remote
# Asset API) by hand on the oracle or on Blaze. The functions are taken verbatim from the pinned
# source, and so are the framework helpers they use from remote_helpers.sh (serve_file,
# wait_for_server_startup, shutdown_server); the others (bazel, fail, expect_log,
# assert_contains, setup_module_dot_bazel, start_worker, stop_worker) are defined here.
#
# usage: scripts/remote-http/downloader-probe <oracle|BINARY> <side-name> [FUNCTION_REGEX]
#        scripts/remote-http/downloader-probe help
#
# One output user root per side: ~/.cache/blaze/work/remote-7/downloader-probe/<side-name>/
# {ws,ur,tmp,worker,log/<function>.log}. The functions create their workspace under ws (main,
# main2, ...), as the test does; after each function its output base is expunged and its server
# shut down, so at most one server and the worker live. startup --max_idle_secs=60, build
# --jobs=4. Everything runs inside one
#   systemd-run --user --collect --wait -p MemoryMax=12G -p MemorySwapMax=0
# unit. Blaze runs with BLAZE_SERVER_MODE=daemon. Prints one line per function: name, PASS or
# FAIL and the failure message.
set -uo pipefail

if [[ $# -lt 2 || "$1" == "help" || "$1" == "-h" || "$1" == "--help" ]]; then
  sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'
  [[ $# -ge 1 && ( "$1" == "help" || "$1" == "-h" || "$1" == "--help" ) ]] && exit 0
  exit 2
fi
CACHE="$HOME/.cache/blaze"
SRC="$CACHE/src/bazel-9.3.2"
if [[ "$1" == "oracle" ]]; then
  BIN="$CACHE/oracle/bazel-9.3.2-linux-x86_64"
else
  BIN="$(realpath "$1")"
fi
SIDE="$2"
REGEX="${3:-.*}"
BASE="$CACHE/work/remote-7/downloader-probe/$SIDE"

if [[ "${DOWNLOADER_PROBE_IN_UNIT:-}" != "1" ]]; then
  mkdir -p "$BASE"
  exec systemd-run --user --collect --wait --quiet --pipe -p MemoryMax=12G -p MemorySwapMax=0 \
    --setenv=HOME="$HOME" --setenv=PATH=/usr/bin:/bin:/usr/sbin \
    --setenv=DOWNLOADER_PROBE_IN_UNIT=1 --setenv=BLAZE_SERVER_MODE=daemon \
    "$(realpath "$0")" "$@"
fi

INSTALL="$CACHE/oracle-out/ur/install/58cf1ecbff441bac762b0050d6da21e9"
JAVA="$INSTALL/embedded_tools/jdk/bin/java"
JAR="$CACHE/work/upstream-src/bazel-bin/src/tools/remote/worker_deploy.jar"
LOCKFILE="$SRC/src/test/tools/bzlmod/MODULE.bazel.lock"
WS="$BASE/ws"
UR="$BASE/ur"
export TEST_TMPDIR="$BASE/tmp"
BAZELRC="$BASE/bazelrc"
python_server="$SRC/src/test/shell/bazel/testing_server.py"
mkdir -p "$WS" "$UR" "$TEST_TMPDIR" "$BASE/log" "$BASE/home"
# testenv.sh's setup_bazelrc (without its output user root), then the memory rule's options.
cat > "$BAZELRC" <<EOF
common --show_progress_rate_limit=-1
common --color=no --curses=no
build --sandbox_tmpfs_path=/tmp
build --incompatible_skip_genfiles_symlink=false
build --incompatible_use_toolchain_resolution_for_java_rules
build --java_runtime_version=21
build --tool_java_runtime_version=21
common --repository_cache=$CACHE/repo-cache
common --repo_env=BAZEL_HTTP_RULES_URLS_AS_DEFAULT_CANONICAL_ID=0
startup --max_idle_secs=60
build --jobs=4
EOF

# --- the test framework's helpers -------------------------------------------------------------
bazel() {
  HOME="$BASE/home" "$BIN" --bazelrc="$BAZELRC" --output_user_root="$UR" "$@"
}
fail() {
  echo "FAIL: $*" >> "$RESULT"
  exit 1
}
expect_log() {
  grep -q -- "$1" "$TEST_log" || fail "${2:-Expected regexp \"$1\" not found}"
}
assert_contains() {
  grep -sq -- "$1" "$2" && return 0
  fail "${3:-Expected regexp '$1' not found in '$2'}"
}
pick_random_unused_tcp_port() {
  python3 -c 'import socket; s=socket.socket(); s.bind(("",0)); print(s.getsockname()[1])'
}
# testenv.sh setup_module_dot_bazel
setup_module_dot_bazel() {
  module_dot_bazel=${1:-MODULE.bazel}
  cat > $module_dot_bazel <<EOF
module(name = 'test')
EOF
  cp -f "$LOCKFILE" "$(dirname ${module_dot_bazel})/MODULE.bazel.lock"
  echo $module_dot_bazel
}
start_worker() {
  work_path="$BASE/worker/work"
  cas_path="$BASE/worker/cas"
  pid_file="$BASE/worker/pid"
  mkdir -p "$work_path" "$cas_path" \
    "$BASE/worker/runfiles/io_bazel/src/tools/remote/src/main/java/com/google/devtools/build/remote/worker"
  worker_port=$(pick_random_unused_tcp_port)
  RUNFILES_DIR="$BASE/worker/runfiles" "$JAVA" -jar "$JAR" --work_path="$work_path" \
    --cas_path="$cas_path" --listen_port="$worker_port" --pid_file="$pid_file" "$@" \
    >> "$BASE/worker/log" 2>&1 &
  WORKER_PID=$!
  local i
  for i in $(seq 1 150); do [[ -s "$pid_file" ]] && break; sleep 0.2; done
}
stop_worker() {
  if [[ -n "${WORKER_PID:-}" ]]; then
    kill -9 "$WORKER_PID" 2>/dev/null
    wait "$WORKER_PID" 2>/dev/null
    WORKER_PID=
  fi
  chmod -R u+w "$BASE/worker" 2>/dev/null
  rm -rf "$BASE/worker"
}

function_body() {
  awk -v name="$2" '$0 ~ "^function " name "\\(\\) \\{" {p=1} p {print} p && /^}/ {exit}' "$1"
}
REMOTE_HELPERS="$SRC/src/test/shell/bazel/remote_helpers.sh"
for f in serve_file wait_for_server_startup shutdown_server; do
  eval "$(function_body "$REMOTE_HELPERS" "$f")"
done

# --- the functions under test ---------------------------------------------------------------
DOWNLOADER_TEST="$SRC/src/test/shell/bazel/remote/remote_downloader_test.sh"
FUNCTIONS=(
  test_remote_downloader_http_archive
  test_remote_downloader_checksum_mismatch
  test_remote_downloader_canonical_id
  test_remote_downloader_caching
)
for f in "${FUNCTIONS[@]}"; do eval "$(function_body "$DOWNLOADER_TEST" "$f")"; done

# Expunges and shuts down the server of every workspace directory the functions created.
clean_workspaces() {
  local d
  for d in "$WS" "$WS"/main*; do
    [[ -f "$d/MODULE.bazel" ]] || continue
    (cd "$d" && bazel clean --expunge >/dev/null 2>&1)
    (cd "$d" && bazel shutdown >/dev/null 2>&1)
  done
}

reset_workspace() {
  clean_workspaces
  chmod -R u+w "$WS" "$TEST_TMPDIR" 2>/dev/null
  rm -rf "$WS" "$TEST_TMPDIR"
  mkdir -p "$WS" "$TEST_TMPDIR"
  setup_module_dot_bazel "$WS/MODULE.bazel" >/dev/null
}

run_one() {
  local name="$1"
  reset_workspace
  export TEST_log="$BASE/log/$name.log"
  RESULT="$BASE/log/$name.result"
  : > "$TEST_log"
  : > "$RESULT"
  (
    cd "$WS" || exit 1
    start_worker
    "$name"
    rc=$?
    # tear_down
    bazel clean >> "$TEST_log" 2>&1
    stop_worker
    shutdown_server
    exit $rc
  ) >> "$BASE/log/$name.out" 2>&1
  local rc=$?
  clean_workspaces
  if [[ $rc -eq 0 ]]; then
    echo -e "$name\tPASS"
  else
    echo -e "$name\tFAIL\t$(head -1 "$RESULT")"
  fi
}

for f in "${FUNCTIONS[@]}"; do
  [[ "$f" =~ $REGEX ]] && run_one "$f"
done
reset_workspace
clean_workspaces
exit 0
