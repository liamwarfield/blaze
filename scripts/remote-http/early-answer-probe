#!/usr/bin/env bash
# Round-8 (H1) probe: an HTTP cache that answers an upload before it has read the body.
#
# usage: scripts/remote-http/early-answer-probe <oracle|BINARY> <side-name> <early|auth|authput|snappy|snappy-bad>
#        scripts/remote-http/early-answer-probe help
#
# early: `build --remote_cache=http://127.0.0.1:PORT --remote_timeout=10 //:big` (a 64 MiB
#        output) against a server that answers the large PUT with 403 before reading the body.
# auth:  the same build with `--credential_helper` (a helper that hands out "Bearer bad" first and
#        "Bearer good" from its second call on) against a server that answers 401 invalid_token
#        to every request without "Bearer good", before reading the body of a large PUT.
# authput: auth with --noremote_accept_cached, so that the first request with the first token is
#        an upload (the large one answered before its body is read).
# snappy, snappy-bad: build (uploads), clean, build again with --remote_download_all (the
#        outputs come back through GET, answered with Content-Encoding: snappy); the output's
#        sha256 is recorded.
# One workspace and one output user root per side:
#   $EARLY_PROBE_BASE/<side-name>/{ws,ur,log} (default ~/.cache/blaze/work/remote-9/early-probe)
# Writes log/<mode>.out (the build's output, with the elapsed seconds) and log/<mode>.server.log
# (the server's request log). The server is shut down and the output base expunged at the end.
# Runs under systemd-run --user --collect --wait -p MemoryMax=12G -p MemorySwapMax=0, Blaze with
# BLAZE_SERVER_MODE=daemon, startup --max_idle_secs=60, --jobs=4.
set -uo pipefail
if [[ $# -lt 3 || "$1" == "help" ]]; then
  sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'
  [[ "${1:-}" == "help" ]] && exit 0
  exit 2
fi
CACHE="$HOME/.cache/blaze"
if [[ "$1" == "oracle" ]]; then BIN="$CACHE/oracle/bazel-9.3.2-linux-x86_64"; else BIN="$(realpath "$1")"; fi
SIDE="$2"; MODE="$3"
BASE="${EARLY_PROBE_BASE:-$CACHE/work/remote-9/early-probe}/$SIDE"
HERE="$(cd "$(dirname "$0")" && pwd)"
if [[ "${EARLY_PROBE_IN_UNIT:-}" != "1" ]]; then
  mkdir -p "$BASE"
  exec systemd-run --user --collect --wait --quiet --pipe -p MemoryMax=12G -p MemorySwapMax=0 \
    --setenv=HOME="$HOME" --setenv=PATH=/usr/bin:/bin --setenv=EARLY_PROBE_IN_UNIT=1 \
    --setenv=BLAZE_SERVER_MODE=daemon --setenv=EARLY_PROBE_BASE="${EARLY_PROBE_BASE:-$CACHE/work/remote-9/early-probe}" --setenv=BIG_SIZE="${BIG_SIZE:-67108864}" "$(realpath "$0")" "$@"
fi
WS="$BASE/ws"; UR="$BASE/ur"; LOG="$BASE/log"
mkdir -p "$WS" "$UR" "$LOG"
cd "$WS"
# The pinned lockfile (as http-variants-probe), so that module resolution reads no registry
# file through the credential helper.
LOCKFILE="$HOME/.cache/blaze/src/bazel-9.3.2/src/test/tools/bzlmod/MODULE.bazel.lock"
version=$(sed -n "s|.*modules/rules_shell/\([^/]*\)/source\.json.*|\1|p" "$LOCKFILE" | head -1)
printf 'module(name = "test")\nbazel_dep(name = "rules_shell", version = "%s")\n' "$version" > MODULE.bazel
cp "$LOCKFILE" MODULE.bazel.lock
cat > BUILD <<B
genrule(name = "big", outs = ["big.bin"], cmd = "head -c ${BIG_SIZE:-67108864} /dev/zero > \$@ && echo -n abcabc >> \$@")
B
cat > "$BASE/helper" <<'H'
#!/bin/sh
# Hands out "Bearer bad" on its first call, "Bearer good" afterwards.
n=$(cat "$0.count" 2>/dev/null || echo 0); echo $((n + 1)) > "$0.count"
cat > /dev/null
if [ "$n" = 0 ]; then t=bad; else t=good; fi
printf '{"headers":{"Authorization":["Bearer %s"]}}\n' "$t"
H
chmod +x "$BASE/helper"; rm -f "$BASE/helper.count"
port=$(python3 -c 'import socket; s=socket.socket(); s.bind(("",0)); print(s.getsockname()[1])')
: > "$LOG/$MODE.server.log"
server_mode=$MODE; [[ "$MODE" == authput ]] && server_mode=auth
python3 "$HERE/early-answer-server.py" "$port" "$server_mode" "$LOG/$MODE.server.log" &
SERVER=$!
sleep 1
extra=()
[[ "$MODE" == auth ]] && extra=(--credential_helper=127.0.0.1="$BASE/helper")
[[ "$MODE" == authput ]] && extra=(--credential_helper=127.0.0.1="$BASE/helper" --noremote_accept_cached)
bazel() { "$BIN" --output_user_root="$UR" --max_idle_secs=60 "$@"; }
start=$(date +%s.%N)
bazel build --jobs=4 --remote_cache=http://127.0.0.1:$port --remote_timeout=10 "${extra[@]}" //:big \
  > "$LOG/$MODE.out" 2>&1
code=$?
if [[ "$MODE" == snappy* ]]; then
  bazel clean >> "$LOG/$MODE.out" 2>&1
  bazel build --jobs=4 --remote_cache=http://127.0.0.1:$port --remote_timeout=10 \
    --remote_download_all //:big >> "$LOG/$MODE.out" 2>&1
  code=$?
  echo "output sha256 $(sha256sum bazel-bin/big.bin 2>/dev/null | cut -c1-16)" >> "$LOG/$MODE.out"
fi
end=$(date +%s.%N)
echo "exit $code, $(python3 -c "print(round($end - $start, 1))") s, helper calls $(cat "$BASE/helper.count" 2>/dev/null || echo 0)" >> "$LOG/$MODE.out"
bazel clean --expunge > /dev/null 2>&1
bazel shutdown > /dev/null 2>&1
kill "$SERVER" 2>/dev/null; wait "$SERVER" 2>/dev/null
grep -E "WARNING|ERROR|^exit|^output|processes" "$LOG/$MODE.out"
