"""Byte-string ground-truth cases. Each case prints `CASE <name> <ASCII value>`."""

load(":bytes_util.bzl", "b")
load(":sha1_shim.bzl", "sha1")

def _cases():
    pig = "🐷"
    e = "é"
    return [
        ("len_e", len(e)),
        ("len_pig", len(pig)),
        ("len_mix", len("aé🐷z")),
        ("bytes_e", b(e)),
        ("bytes_pig", b(pig)),
        ("index_e0", b(e[0])),
        ("index_pig_neg1", b(pig[-1])),
        ("slice_pig_1_3", b(pig[1:3])),
        ("slice_step2", b("aé🐷"[::2])),
        ("elems_len", len("é🐷".elems())),
        ("elems_e", [b(c) for c in e.elems()]),
        ("find_b", "aé🐷b".find("b")),
        ("index_pig", "aé🐷b".index("🐷")),
        ("rfind_e", "éaé".rfind("é")),
        ("count_cont", "éé".count("\251")),
        ("octal_eq", "\303\251" == e),
        ("octal_len", len("\377")),
        ("join_bytes_eq", "".join(["\303", "\251"]) == e),
        ("in_cont", "\251" in e),
        ("split_cont", [b(x) for x in "a€b".split("\202")]),
        ("replace_cont", b(e.replace("\251", "x"))),
        ("startswith_lead", e.startswith("\303")),
        ("partition_cont", [b(x) for x in e.partition("\251")]),
        ("removeprefix_lead", b(e.removeprefix("\303"))),
        ("rejoin_halves", pig[:2] + pig[2:] == pig),
        ("upper_e", b("aé".upper())),
        ("lower_E", b("AÉ".lower())),
        ("upper_zh", b("中".upper())),
        ("capitalize_zh", b("中".capitalize())),
        ("capitalize_e", b("éA".capitalize())),
        ("title_ete", b("été".title())),
        ("title_x_zh_y", b("x中y".title())),
        ("istitle_E", "Éa".istitle()),
        ("isalpha_e", e.isalpha()),
        ("isalnum_e", e.isalnum()),
        ("isdigit_e", e.isdigit()),
        ("islower_ae", "aé".islower()),
        ("isupper_AE", "AÉ".isupper()),
        ("isspace_nel", "\205".isspace()),
        ("isspace_nbsp", "\240".isspace()),
        ("strip_spaces_e", b(" é ".strip())),
        ("strip_A_ring", b("Å".strip())),
        ("strip_nbsp", b("\240a\240".strip())),
        ("lstrip_lead", b(e.lstrip("\303"))),
        ("splitlines_nel", [b(x) for x in "a\302\205b\nc".splitlines()]),
        ("repr_e_ctl", b(repr("é\001\177\200"))),
        ("str_list", b(str(["é"]))),
        ("pct_s_r", b("%s|%r" % (e, e))),
        ("format_e", b("{}|{}".format(e, len(e)))),
        ("json_encode_e", b(json.encode(e))),
        ("json_encode_ff", b(json.encode("\377"))),
        ("json_encode_dict", b(json.encode({"é": pig}))),
        ("json_encode_ctl", b(json.encode("\001\177\200"))),
        ("json_decode_u00e9", b(json.decode('"\\u00e9"'))),
        ("json_decode_pair", b(json.decode('"\\ud83d\\udc37"'))),
        ("json_decode_lone", b(json.decode('"\\ud83d"'))),
        ("json_decode_raw", b(json.decode('"é"'))),
        ("json_decode_len", len(json.decode('"\\u00e9"'))),
        ("hash_e", hash(e)),
        ("hash_pig", hash(pig)),
        ("sorted", [b(x) for x in sorted(["z", e, "\377", "a", pig])]),
        ("lt_e_z", e < "z"),
        ("reversed_e", b("".join(reversed(e.elems())))),
        ("repeat_len", len(e * 3)),
        ("dict_octal_key", {e: 1}.get("\303\251")),
        ("sha1_e_nl", sha1("é\n")),
        ("sha1_pig", sha1(pig)),
        ("sha1_ascii", sha1("scruto\n")),
        ("sha1_readme", sha1("# 🐷 `workerd`, Cloudflare's JavaScript/Wasm Runtime\n\n![Banner](/docs/assets/banner.png)\n")),
    ]

def report():
    for name, value in _cases():
        print("CASE %s %s" % (name, value))
