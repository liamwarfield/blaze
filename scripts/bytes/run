#!/usr/bin/env python3
"""Capture Bazel 9.3.2 ground truth for byte-string semantics. See `run help`."""

import glob
import json
import os
import shutil
import subprocess
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
import compare_common as cc  # noqa: E402

USAGE = """\
usage: scripts/bytes/run [--binary <path>] [--out <dir>] [--output-user-root <dir>]
       scripts/bytes/run selftest
       scripts/bytes/run help

Copies scripts/bytes/workspace to ~/.cache/blaze/work/bytes (plus aspect_tools_telemetry's
sha1.bzl and bazel_lib's lib/private/strings.bzl from the repository cache / workerd fetch
outputs), then runs <binary> (default: the oracle) and records its outputs under <out>.
Defaults: the oracle uses --output_user_root=~/.cache/blaze/oracle-out/ur-bytes and
<out> = ~/.cache/blaze/work/bytes-out (the saved oracle outputs); any other binary uses
~/.cache/blaze/oracle-out/ur-bytes-blaze and ~/.cache/blaze/work/bytes-out-blaze, so that a run
of Blaze never overwrites the oracle's outputs or shares its output base. The output user root
is deleted first, so that every run fetches @bytes_repo and prints its RCASE lines. Recorded:

  build.stderr      `build //... @bytes_repo//:all` stderr (CASE/RCASE/RAWPRINT lines)
  labels.stderr     `build //labels:all` stderr (LCASE lines)
  providers.stderr  `build //providers:all` stderr (CASE lines: repr of native providers)
  fail.stderr       `build //fail:all` stderr (a failing genrule; its "error executing" line)
  flagoff.stderr    side workspace side/flagoff (~/.cache/blaze/work/bytes_flagoff):
                    `build //:all --aspects=//:defs.bzl%a --nointernal_starlark_utf_8_byte_strings`
  rc_import.txt     side workspace side/rcimport, copied to the non-ASCII path
                    ~/.cache/blaze/work/bytes_rc_é: `query //:x` with %workspace% rc imports
  outputs/*         bazel-bin outputs and @bytes_repo files (raw bytes)
  query_build.txt   `query //:all --output=build`
  query_label_kind.txt, query_jsonproto.txt, cquery_jsonproto.txt
  aquery_text.txt, aquery_jsonproto.txt (--include_file_write_contents)
  exit_codes.txt    one line per command: `<name> <code>` after a normal exit, otherwise
                    `<name> <termination>` (`signal SIGPIPE`, `oom-kill (...)`, `timeout (...)`)
  provenance.json   the binary's path and sha256 (and whether it is the pinned oracle), the
                    repository HEAD and dirty flag, the date, every command line, and the
                    recording key (this tool's sha256, argv and environment with the binary and
                    output user root as placeholders, digest of the prepared workspaces):
                    scripts/bytes/compare refuses two recordings whose keys differ.

Every command runs through scripts/lib/compare_common.py in a --scope unit (MemoryMax=12G, the
server stays up between commands) whose supervisor records how the command really ended.

Compare a Blaze run with the oracle's: scripts/bytes/compare.

Run it inside `systemd-run --user --collect --wait -p MemoryMax=12G -p MemorySwapMax=0`
(AGENTS.md). Expected values for docs/research/07-byte-strings.md and the starlark_conformance
`byte_strings` spike come from the oracle's run.
"""

HOME = os.path.expanduser("~")
ORACLE = f"{HOME}/.cache/blaze/oracle/bazel-9.3.2-linux-x86_64"
WS = f"{HOME}/.cache/blaze/work/bytes"
UR = f"{HOME}/.cache/blaze/oracle-out/ur-bytes"
REPO_CACHE = f"{HOME}/.cache/blaze/repo-cache"
HERE = os.path.dirname(os.path.abspath(__file__))
# Side workspaces: (directory under scripts/bytes/side, workspace path). The rc-import one lives
# under a path with a non-ASCII byte sequence (C3 A9) on purpose.
WS_FLAGOFF = f"{HOME}/.cache/blaze/work/bytes_flagoff"
WS_RC = f"{HOME}/.cache/blaze/work/bytes_rc_\u00e9"


def find_one(pattern):
    hits = sorted(glob.glob(pattern, recursive=True))
    if not hits:
        sys.exit(f"not found: {pattern}")
    return hits[0]


def prepare():
    if os.path.exists(WS):
        shutil.rmtree(WS)
    shutil.copytree(os.path.join(HERE, "workspace"), WS)
    sha1 = find_one(f"{HOME}/.cache/blaze/work/repos/workerd-contents/*/*/sha1.bzl")
    strings = find_one(f"{REPO_CACHE}/contents/*/*/lib/private/strings.bzl")
    tp = os.path.join(WS, "third_party/telemetry")
    with open(sha1, encoding="utf-8") as f:
        text = f.read().replace(
            'load("@bazel_lib//lib:strings.bzl", "ord")',
            'load("//third_party/telemetry:strings.bzl", "ord")',
        )
    with open(os.path.join(tp, "sha1.bzl"), "w", encoding="utf-8") as f:
        f.write(text)
    shutil.copy(strings, os.path.join(tp, "strings.bzl"))
    for name, ws in (("flagoff", WS_FLAGOFF), ("rcimport", WS_RC)):
        if os.path.exists(ws):
            shutil.rmtree(ws)
        shutil.copytree(os.path.join(HERE, "side", name), ws)


def inputs_digest():
    """Digest of the three prepared workspaces (after prepare())."""
    return {"ws": cc.tree_digest(WS), "flagoff": cc.tree_digest(WS_FLAGOFF),
            "rcimport": cc.tree_digest(WS_RC)}


def main(argv):
    if argv[:1] == ["help"]:
        print(USAGE)
        return 0
    if argv[:1] == ["selftest"]:
        return selftest()
    binary, out, ur = ORACLE, None, None
    args = list(argv)
    while args:
        a = args.pop(0)
        if a == "--binary" and args:
            binary = os.path.abspath(args.pop(0))
        elif a == "--out" and args:
            out = args.pop(0)
        elif a == "--output-user-root" and args:
            ur = args.pop(0)
        else:
            print(USAGE)
            return 2
    if not os.path.isfile(binary):
        sys.exit(f"binary {binary} does not exist")
    binary_sha = cc.sha256_file(binary)
    if os.path.realpath(binary) == os.path.realpath(ORACLE) and binary_sha != cc.pinned_sha256():
        sys.exit(f"refused: {binary} is not the pinned oracle (sha256 {binary_sha})")
    is_oracle = binary_sha == cc.pinned_sha256()
    if out is None:
        out = f"{HOME}/.cache/blaze/work/bytes-out" + ("" if is_oracle else "-blaze")
    if ur is None:
        ur = UR if is_oracle else UR + "-blaze"
    if not is_oracle and os.path.realpath(out) == os.path.realpath(
        f"{HOME}/.cache/blaze/work/bytes-out"
    ):
        sys.exit("refusing to overwrite the saved oracle outputs with another binary's")
    prepare()
    digest = inputs_digest()
    if os.path.exists(out):
        shutil.rmtree(out)
    # A fresh output user root every time: the repository rule of @bytes_repo prints its RCASE
    # lines only when it runs, and an output base left by an earlier run would hide them.
    if os.path.exists(ur):
        subprocess.run(["chmod", "-R", "u+w", ur], check=False)
        shutil.rmtree(ur)
    os.makedirs(os.path.join(out, "outputs"))
    env = {"HOME": HOME, "PATH": "/usr/bin:/bin"}
    startup = [binary, f"--output_user_root={ur}", "--nohome_rc", "--nosystem_rc"]
    common = [f"--repository_cache={REPO_CACHE}", "--color=no", "--curses=no"]
    codes = []
    argvs = []

    def code_text(term):
        return str(term.code) if term.normal else str(term)

    def run(name, cmd, extra, save_stdout=None, cwd=WS):
        argv_ = startup + [cmd] + common + extra
        p = cc.run(argv_, cwd, mode="scope", tag="bytes-" + name)
        codes.append(f"{name} {code_text(p.term)}")
        argvs.append({"name": name, "cwd": cwd,
                      "argv": ["<BINARY>", "--output_user_root=<UR>"] + argv_[2:]})
        with open(os.path.join(out, name + ".stderr"), "wb") as f:
            f.write(p.err)
        if save_stdout:
            with open(os.path.join(out, save_stdout), "wb") as f:
                f.write(p.out)

    run("build", "build", ["//:all", "@bytes_repo//:all"])
    run("labels", "build", ["//labels:all"])
    run("providers", "build", ["//providers:all"])
    run("fail", "build", ["//fail:all"])
    run("flagoff", "build",
        ["//:all", "--aspects=//:defs.bzl%a", "--nointernal_starlark_utf_8_byte_strings"],
        cwd=WS_FLAGOFF)
    run("rc_import", "query", ["//:x"], "rc_import.txt", cwd=WS_RC)
    run("query_build", "query", ["//:all", "--output=build"], "query_build.txt")
    run("query_label_kind", "query", ["//:all", "--output=label_kind"], "query_label_kind.txt")
    run("query_jsonproto", "query", ["//:all", "--output=streamed_jsonproto"],
        "query_jsonproto.txt")
    run("cquery_jsonproto", "cquery", ["//:all", "--output=jsonproto"], "cquery_jsonproto.txt")
    run("aquery_text", "aquery", ["//:all", "--include_file_write_contents"], "aquery_text.txt")
    run("aquery_jsonproto", "aquery",
        ["//:all", "--output=jsonproto", "--include_file_write_contents"],
        "aquery_jsonproto.txt")
    p = cc.run(startup + ["info", "output_base"], WS, mode="scope", tag="bytes-info")
    output_base = p.out.decode().strip()
    for f in glob.glob(os.path.join(WS, "bazel-bin", "*.txt")):
        shutil.copy(f, os.path.join(out, "outputs", os.path.basename(f)))
    for f in glob.glob(os.path.join(output_base, "external", "+bytes_repo+bytes_repo", "*.txt")):
        shutil.copy(f, os.path.join(out, "outputs", "repo_" + os.path.basename(f)))
    shutdowns = {}
    for ws in (WS, WS_FLAGOFF, WS_RC):
        shutdowns[ws] = str(cc.run(startup + ["shutdown"], ws, mode="scope",
                                   tag="bytes-shutdown").term)
    with open(os.path.join(out, "exit_codes.txt"), "w") as f:
        f.write("\n".join(codes) + "\n")
    key = cc.cache_key(cc.tool_sha256(os.path.abspath(__file__)), None, argvs, env, digest)
    with open(os.path.join(out, "provenance.json"), "w") as f:
        json.dump({"binary": {"path": binary, "sha256": binary_sha,
                              "is_pinned_oracle": is_oracle},
                   "repo": cc.repo_state(), "output_user_root": ur, "shutdown": shutdowns,
                   "key": key, "key_digest": cc.key_digest(key)}, f, indent=1)
    print("\n".join(codes))
    return 0


def selftest():
    def run_pair(ofake, bfake, wd):
        cc.require_oracle(ofake)
        texts = {}
        for side, fake in (("oracle", ofake), ("blaze", bfake)):
            p = cc.run([fake, "build"], wd, mode="scope", tag="selftest")
            texts[side] = (p.term, p.out, p.err)
        (ot, oo, oe), (bt, bo, be) = texts["oracle"], texts["blaze"]
        return cc.judge(ot, bt, [n for n, a, b in (("stdout", oo, bo), ("stderr", oe, be))
                                 if a != b], blaze_unported=cc.unported_message(be))

    def extra(st):
        # exit_codes.txt keeps the plain number for a normal exit and never a number otherwise.
        for t, want in ((cc.Termination("exit", 0), "0"),
                        (cc.Termination("signal", 141, "SIGPIPE"), "signal SIGPIPE")):
            got = str(t.code) if t.normal else str(t)
            st.check("exit_codes.txt line for %s" % t, got == want, got)

    return cc.selftest("bytes/run", run_pair=run_pair, extra=extra, mode="scope")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
