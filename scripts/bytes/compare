#!/usr/bin/env python3
"""Compare a scripts/bytes/run recording with the saved oracle outputs. See `compare help`."""

import json
import os
import re
import subprocess
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
import compare_common as cc  # noqa: E402

# Commands whose non-zero exit is the behaviour under test, with the oracle's code.
DECLARED_EXIT = {"fail": 1}  # //fail:all is a failing genrule by design

USAGE = """\
usage: scripts/bytes/compare [--oracle <dir>] [--candidate <dir>] [--binary <blaze>]
                             [--verbose] [--unverified-oracle] [--json <file>]
       scripts/bytes/compare selftest
       scripts/bytes/compare help

Compares the recording of `scripts/bytes/run --binary <blaze>` (default
~/.cache/blaze/work/bytes-out-blaze) with the oracle's (default ~/.cache/blaze/work/bytes-out),
byte for byte, and prints `matching / total` plus every item that differs. Items:

  case:<file>:<KIND> <name>   one per CASE / RCASE / LCASE / RAWPRINT line of build.stderr,
                              labels.stderr, providers.stderr and flagoff.stderr (the whole
                              DEBUG line, bytes)
  failmsg:<file>:<n>          the n-th line of fail.stderr that contains "error executing"
  output:<name>               one per file under outputs/
  stdout:<name>               query_build.txt, query_label_kind.txt, query_jsonproto.txt,
                              cquery_jsonproto.txt, aquery_text.txt, aquery_jsonproto.txt
  exit:<command>              one per line of exit_codes.txt
  stderr:<file>               the whole of each *.stderr, after the exclusion rules of
                              scripts/lib/compare_common.py (VOLATILE_RULES; `paths`: each
                              recording's output user root; B1_GAP_RULES: the oracle runs all
                              commands on one warm server), listed in the report with the lines
                              each changed or removed

An item missing on either side differs. --verbose prints both values of each differing item
(repr of the bytes, cut at 400).

Guards (scripts/lib/compare_common.py):
  * the oracle directory must have provenance.json (written by scripts/bytes/run) naming a
    binary whose sha256 is the pin in UPSTREAM.json; otherwise the comparison is refused
    (exit 2). --unverified-oracle compares a recording without provenance (made before
    2026-11-19) anyway; the report then says so and the result is never a pass.
  * when both recordings have provenance.json their recording keys (bytes/run's sha256, every
    command line, the environment, the digest of the prepared workspaces) must be equal, or the
    comparison is refused (a stale oracle recording).
  * each `exit:<command>` item is judged by compare_common: equal non-zero exits are
    BOTH-FAILED unless DECLARED_EXIT names the command with that code; a termination that is not
    a normal exit (signal, oom-kill, timeout) is never identical.
  * an oracle recording with no items is an error.
  * the candidate must have provenance.json, must not have been recorded by the oracle, and is
    judged only when --binary names the binary that recorded it (its sha256 must match);
    without --binary the report has a SKIPPED row and cannot pass. Both recordings' files must
    still have the digests their provenance.json recorded.
The report starts with both recordings' binaries (path, sha256), the repository HEAD and dirty
flag, and ends with the denominator (items selected, compared, identical, different,
both-failed). Exit status 0 only when every item is identical; 1 otherwise; 2 on a refusal or
usage error. --json writes the report.
"""

HOME = os.path.expanduser("~")
CASE = re.compile(rb"\b(CASE|RCASE|LCASE|RAWPRINT)\b(?: ([A-Za-z0-9_]+))?")
STDOUT = [
    "query_build.txt",
    "query_label_kind.txt",
    "query_jsonproto.txt",
    "cquery_jsonproto.txt",
    "aquery_text.txt",
    "aquery_jsonproto.txt",
    "rc_import.txt",
]
CASE_FILES = ("build.stderr", "labels.stderr", "providers.stderr", "flagoff.stderr")
FAIL_FILES = ("fail.stderr",)


def read(path):
    try:
        with open(path, "rb") as f:
            return f.read()
    except OSError:
        return None


def items(d):
    out = {}
    for name in CASE_FILES:
        data = read(os.path.join(d, name)) or b""
        seen = {}
        for line in data.split(b"\n"):
            m = CASE.search(line)
            if not m or not line.startswith(b"DEBUG: "):
                continue
            kind = m.group(1).decode()
            key = kind if kind == "RAWPRINT" else f"{kind} {(m.group(2) or b'').decode()}"
            n = seen.get(key, 0)
            seen[key] = n + 1
            if n:
                key = f"{key}#{n + 1}"
            out[f"case:{name}:{key}"] = line
    for name in FAIL_FILES:
        data = read(os.path.join(d, name)) or b""
        n = 0
        for line in data.split(b"\n"):
            if b"error executing" in line:
                n += 1
                out[f"failmsg:{name}:{n}"] = line
    od = os.path.join(d, "outputs")
    if os.path.isdir(od):
        for name in sorted(os.listdir(od)):
            out[f"output:{name}"] = read(os.path.join(od, name))
    for name in STDOUT:
        data = read(os.path.join(d, name))
        if data is not None:
            out[f"stdout:{name}"] = data
    codes = read(os.path.join(d, "exit_codes.txt")) or b""
    for line in codes.decode().splitlines():
        cmd, _, code = line.partition(" ")
        out[f"exit:{cmd}"] = code.encode()
    return out


def provenance(d):
    try:
        with open(os.path.join(d, "provenance.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def exit_term(value):
    """Termination of an exit_codes.txt value: a number, or compare_common text."""
    if value is None:
        return None
    text = value.decode() if isinstance(value, bytes) else value
    if text.lstrip("-").isdigit():
        n = int(text)
        if n < 0:  # recorded by subprocess before 2026-11-19: killed by a signal
            return cc.Termination("signal", 128 - n, "SIG%d" % -n)
        return cc.Termination("exit", n)
    return cc.Termination("abnormal", detail=text)


RULES = cc.VOLATILE_RULES + cc.B1_GAP_RULES


def changed_outputs(d, prov):
    rec = (prov or {}).get("outputs")
    if not rec:
        return ["(no output digests recorded)"]
    now = cc.outputs_digest([os.path.join(d, r) for r in rec])
    return [r for r, v in rec.items() if now.get(os.path.join(d, r)) != v]


def text_term(text):
    """A Termination from its text (`exit N`, `signal NAME`, `oom-kill (...)`, ...)."""
    words = (text or "").split()
    if words[:1] == ["exit"] and len(words) > 1 and words[1].lstrip("-").isdigit():
        return cc.Termination("exit", int(words[1]))
    if words[:1] == ["signal"] and len(words) > 1:
        return cc.Termination("signal", None, words[1])
    return cc.Termination(words[0] if words else "unrecorded", detail=text)


def aux_terms(prov):
    """[(what, Termination)] of the auxiliary commands a recording's provenance names."""
    if not prov:
        return []
    if isinstance(prov.get("auxiliary"), dict):
        return [(k, cc.Termination.from_dict(v)) for k, v in sorted(prov["auxiliary"].items())]
    out = []
    if prov.get("info"):
        out.append(("info", text_term(prov["info"])))
    for ws, t in sorted((prov.get("shutdown") or {}).items()):
        out.append(("shutdown " + os.path.basename(ws), text_term(t)))
    return out


def compare_dirs(oracle, candidate, verbose=False, unverified=False, binary=None):
    """The compare_common Report of two recordings (raises cc.Refusal)."""
    oprov, cprov = provenance(oracle), provenance(candidate)
    if oprov is None:
        if not unverified:
            raise cc.Refusal(f"{oracle} has no provenance.json: its binary is unknown "
                             "(--unverified-oracle compares it anyway, never as a pass)")
    elif oprov["binary"]["sha256"] != cc.pinned_sha256():
        raise cc.Refusal(f"{oracle} was recorded by {oprov['binary']['path']} (sha256 "
                         f"{oprov['binary']['sha256']}), not the pinned oracle")
    if cprov is None:
        raise cc.Refusal(f"{candidate} has no provenance.json: the binary that recorded it is "
                         "unknown")
    if cprov["binary"]["sha256"] in (cc.pinned_sha256(), cc.PINNED_SHA256):
        raise cc.Refusal(f"{candidate} was recorded by the oracle")
    for d, prov in ((oracle, oprov), (candidate, cprov)):
        if prov is not None and changed_outputs(d, prov):
            raise cc.Refusal(f"{d}: files changed since they were recorded: "
                             f"{changed_outputs(d, prov)[:3]}")
    if oprov and oprov.get("key_digest") != cprov.get("key_digest"):
        old, new = oprov.get("key") or {}, cprov.get("key") or {}
        raise cc.Refusal("the two recordings were made with different inputs or commands "
                         f"(differ in: {[k for k in new if old.get(k) != new.get(k)]}); "
                         "record the oracle again")
    named = cc.blaze_identity(binary) if binary else None
    if named and named["sha256"] != cprov["binary"]["sha256"]:
        raise cc.Refusal(f"{candidate} was recorded by sha256 {cprov['binary']['sha256']}, not "
                         f"by the named {binary} ({named['sha256']})")
    rep = cc.Report("bytes/compare",
                    blaze={"path": cprov["binary"]["path"], "sha256": cprov["binary"]["sha256"]},
                    oracle={"path": oprov["binary"]["path"], "sha256": oprov["binary"]["sha256"]}
                    if oprov else {"path": oracle + " (UNVERIFIED: no provenance.json)",
                                   "sha256": None},
                    selection=f"items of {oracle} against {candidate}",
                    tool_files=[os.path.abspath(__file__)],
                    compared="CASE/RCASE/LCASE/RAWPRINT lines, error lines, outputs, stdout "
                             "files, exit codes, and every stderr file in full after the "
                             "exclusion rules listed at the end")
    norm = cc.Normaliser(RULES, path_reason="each recording's output user root")
    rep.add_normaliser(norm)
    # Audit 4r2, T5: the terminations of `info` and `shutdown` that bytes/run recorded are
    # listed; an abnormal one fails the comparison.
    for role, prov in (("oracle", oprov), ("candidate", cprov)):
        for what, term in aux_terms(prov):
            rep.add_aux("%s %s" % (role, what), term)
    want, got = items(oracle), items(candidate)
    if not want:
        raise cc.Refusal(f"no oracle recording in {oracle} (run scripts/bytes/run first)")
    keys = list(want) + [k for k in got if k not in want]
    for k in keys:
        if k.startswith("exit:"):
            cmd = k[5:]
            cls, detail = cc.judge(exit_term(want.get(k)), exit_term(got.get(k)), [],
                                   declared_exit=DECLARED_EXIT.get(cmd))
            if k not in want:
                cls, detail = cc.DIFFERENT, "EXTRA (only in the candidate)"
            elif k not in got:
                cls, detail = cc.DIFFERENT, "MISSING (only in the oracle)"
        elif k not in got:
            cls, detail = cc.DIFFERENT, "MISSING"
        elif k not in want:
            cls, detail = cc.DIFFERENT, "EXTRA"
        elif want[k] == got[k]:
            cls, detail = cc.IDENTICAL, ""
        else:
            cls, detail = cc.DIFFERENT, "DIFF"
        rep.add(k, cls, detail)
    op = [((oprov or {}).get("output_user_root"), "<UR>")]
    bp = [(cprov.get("output_user_root"), "<UR>")]
    names = sorted({n for d in (oracle, candidate) for n in os.listdir(d)
                    if n.endswith(".stderr")})
    for n in names:
        o, b = read(os.path.join(oracle, n)), read(os.path.join(candidate, n))
        if o is None or b is None:
            rep.add("stderr:" + n, cc.DIFFERENT, "only in the %s" % (
                "candidate" if o is None else "oracle"))
            continue
        eq, gaps = norm.compare(o, b, "stderr", [x for x in op if x[0]],
                                [x for x in bp if x[0]])
        rep.add("stderr:" + n, cc.IDENTICAL if eq and not gaps else
                cc.KNOWN_GAP if eq else cc.DIFFERENT,
                "" if eq and not gaps else ("gap rules " + ", ".join(gaps) if eq else "DIFF"))
    if oprov is None:
        rep.add("oracle-provenance", cc.SKIPPED,
                "the oracle recording has no provenance.json: its binary is not verified")
    if named is None:
        rep.add("candidate-binary", cc.SKIPPED,
                "the binary that recorded the candidate was not named (--binary)")
    return rep, want, got


def main(argv):
    if argv[:1] == ["help"]:
        print(USAGE)
        return 0
    if argv[:1] == ["selftest"]:
        return selftest()
    oracle = f"{HOME}/.cache/blaze/work/bytes-out"
    candidate = f"{HOME}/.cache/blaze/work/bytes-out-blaze"
    verbose = unverified = False
    json_out = binary = None
    args = list(argv)
    while args:
        a = args.pop(0)
        if a == "--oracle" and args:
            oracle = args.pop(0)
        elif a == "--candidate" and args:
            candidate = args.pop(0)
        elif a == "--verbose":
            verbose = True
        elif a == "--unverified-oracle":
            unverified = True
        elif a == "--json" and args:
            json_out = args.pop(0)
        elif a == "--binary" and args:
            binary = os.path.abspath(args.pop(0))
        else:
            print(USAGE)
            return 2
    try:
        rep, want, got = compare_dirs(oracle, candidate, verbose, unverified, binary)
    except cc.Refusal as e:
        return cc.refuse("bytes/compare", e)
    rep.print_header()
    for r in rep.rows:
        if r["class"] != cc.IDENTICAL:
            print(f"{r['class']} {r['case']} {r['detail']}")
            if verbose and r["case"] in set(want) | set(got):
                for side, v in (("oracle", want.get(r["case"])), ("blaze ", got.get(r["case"]))):
                    print(f"    {side}: {repr(v)[:400]}")
    groups = {}
    for r in rep.rows:
        g = r["case"].split(":", 1)[0]
        t = groups.setdefault(g, [0, 0])
        t[1] += 1
        if r["class"] == cc.IDENTICAL:
            t[0] += 1
    detail = ", ".join(f"{g} {m}/{t}" for g, (m, t) in groups.items())
    n_ident = sum(1 for r in rep.rows if r["class"] == cc.IDENTICAL)
    print(f"identical {n_ident} / {len(rep.rows)} ({detail})")
    rep.print_footer()
    if json_out:
        rep.write_json(json_out)
    return rep.exit_code()


def selftest():
    """The real command lines: bytes/run records both fakes, bytes/compare judges them."""
    st = cc.Selftest("bytes/compare")
    fh = cc.FakeHome("bytes-compare")
    run_tool = os.path.join(os.path.dirname(os.path.abspath(__file__)), "run")
    me = os.path.abspath(__file__)
    o_dir = os.path.join(fh.cache, "work", "bytes-out")
    b_dir = os.path.join(fh.cache, "work", "bytes-out-blaze")
    base = ["--oracle", o_dir, "--candidate", b_dir]
    try:
        o, b = fh.fakes(dict(out=b"same\n"), dict(out=b"same\n"))
        st.check("tripwire trips on a direct launch",
                 subprocess.run([b, "build"], capture_output=True).returncode == 99
                 and fh.tripped())
        if fh.tripped():
            os.remove(fh.tripfile)
        for name, ospec, bspec, ok, what in cc.itemised():
            # //fail:all is declared to exit 1 (DECLARED_EXIT): the fakes do so.
            o, b = fh.fakes(ospec, bspec, when=[("//fail:all", 1)])
            r1 = fh.run_tool(run_tool, [])[0]
            r2 = fh.run_tool(run_tool, ["--binary", b])[0]
            rc, rep, log = fh.run_tool(me, base + ["--binary", b])
            classes = [r["class"] for r in (rep or {}).get("cases", [])]
            st.check("scenario %s" % name, r1 == 0 and r2 == 0 and ok(rc, classes),
                     "run %s/%s, compare exit %s; want %s (%s)" % (r1, r2, rc, what, log))
            if name == "equal":
                rc, rep, log = fh.run_tool(me, base)
                st.check("candidate binary not named: no pass", rc == 1, "exit %s" % rc)
                other = os.path.join(fh.home, "bin", "blaze-other")
                cc.make_fake(other, token=fh.token, tripfile=fh.tripfile, role="other",
                             out=b"same\n")
                rc, rep, log = fh.run_tool(me, base + ["--binary", other])
                st.check("candidate recorded by another binary refused", rc == 2,
                         "exit %s" % rc)
                with open(os.path.join(o_dir, "build.stderr"), "ab") as f:
                    f.write(b"tampered\n")
                rc, rep, log = fh.run_tool(me, base + ["--binary", b])
                st.check("changed oracle file refused", rc == 2, "exit %s" % rc)
                pj = os.path.join(b_dir, "provenance.json")
                prov = json.load(open(pj))
                st.check("T5: provenance holds the info and shutdown terminations",
                         "info" in prov.get("auxiliary", {})
                         and any(k.startswith("shutdown") for k in prov["auxiliary"]))
                prov["auxiliary"]["info"] = cc.Termination("signal", 137, "SIGKILL").to_dict()
                with open(pj, "w") as f:
                    json.dump(prov, f)
                fh.run_tool(run_tool, [])
                rc, rep, log = fh.run_tool(me, base + ["--binary", b])
                st.check("T5: an abnormal recorded info or shutdown fails the comparison",
                         rc == 1 and any(a["abnormal"] for a in (rep or {}).get("auxiliary", [])),
                         "exit %s" % rc)
        o, b = fh.fakes(dict(out=b"same\n"), dict(out=b"same\n"), when=[("//fail:all", 1)])
        fh.run_tool(run_tool, [])
        fh.run_tool(run_tool, ["--binary", b])
        rc, rep, log = fh.run_tool(me, base + ["--binary", b], pin="0" * 64)
        st.check("oracle recording by a binary that is not the pin refused", rc == 2,
                 "exit %s" % rc)
        fh.run_tool(run_tool, ["--binary", o, "--out", b_dir,
                               "--output-user-root", os.path.join(fh.root, "ur-x")])
        rc, rep, log = fh.run_tool(me, base)
        st.check("candidate recorded by the oracle refused", rc == 2, "exit %s" % rc)
        os.remove(os.path.join(b_dir, "provenance.json"))
        rc, rep, log = fh.run_tool(me, base)
        st.check("candidate without provenance refused", rc == 2, "exit %s" % rc)
        st.check("no process started outside the launcher", not fh.tripped())
    finally:
        if not st.failures:
            fh.remove()
        else:
            print("  (fake HOME kept: %s)" % fh.root)
    return st.finish()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
