#!/usr/bin/env python3
"""Execution platform -> REAPI Platform and argv[0]: oracle vs Blaze. See `platform-probe help`."""

import os
import re
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
CACHE = os.path.expanduser("~/.cache/blaze")
ORACLE = os.path.join(CACHE, "oracle", "bazel-9.3.2-linux-x86_64")
WORK = os.path.join(CACHE, "work", "remote")
OUT_ROOT = os.path.join(CACHE, "oracle-out", "ur-remote")
REPO_CACHE = os.path.join(CACHE, "repo-cache")
WORKER = os.path.join(HERE, "worker")

USAGE = """\
usage: scripts/remote/platform-probe oracle <tag> [--port N] [<case>...]
       scripts/remote/platform-probe run <binary> <tag> [--port N] [<case>...]
       scripts/remote/platform-probe compare <tag-a> <tag-b>
       scripts/remote/platform-probe cases
       scripts/remote/platform-probe help

How an execution platform's `remote_execution_properties` (a text-format
build.bazel.remote.execution.v2.Platform), `exec_properties`, a target's `exec_properties` and
`--remote_default_exec_properties` become the Platform of the remote Action and Command
(PlatformUtils.getPlatformProto), and how argv[0] follows the execution platform's OS constraint
(RemoteExecutionService.buildCommand, getOsFromConstraintsOrHost).

Each case is a workspace (MODULE.bazel, BUILD, defs.bzl, tools/run.sh) whose BUILD defines the
execution platform //:p (and parents) and the target //:t, a Starlark rule running
`ctx.actions.run(executable = //tools:run.sh, arguments = [<out>, "PLATFORM_PROBE_<case>"])`.
The case is built with
  build //:t --extra_execution_platforms=//:p --remote_executor=grpc://localhost:<port>
  --remote_grpc_log=<step>/grpc.log <case flags>
against Bazel's own remote worker (scripts/remote/worker, name td-<tag> or <tag> if it starts
with td-, started fresh for
each `oracle`/`run` call on --port, default 9640). The worker's CAS is then searched for the
Action whose Command carries the case's marker argument.

`oracle <tag>` uses the oracle binary, `run <binary> <tag>` another binary (copy a Blaze
binary first, others rebuild target/debug/blaze). Without cases every case runs. Work dir:
~/.cache/blaze/work/remote/<tag>-platform/<case>/{ws,stdout,stderr,exit,result.txt}; output
user root ~/.cache/blaze/oracle-out/ur-remote/<tag>-platform (fresh per call). A call
replaces the directories of the cases it runs and keeps the others.

Per case it prints and writes result.txt:
  exit <code>
  error <first ERROR line and its continuation lines joined by ` | `, the workspace path
        replaced by <ws>, the worker's by <worker>>  (or `error -`)
  action-platform <name=value ...> (in the order sent; `-` when no Action was sent, `none`
                  when the Action has no Platform)
  command-platform <...> (same for the Command)
  argv0 <Command.arguments[0]>
  processes <the `N processes: ...` line>
  then-exit/then-error/then-processes  for a case with a second build (`then` flags in `cases`):
                  the same workspace, output base and worker, built again with those flags

`compare <a> <b>` prints both result.txt per case and SAME/DIFFERENT; exit 0 iff all equal.
`cases` lists the cases with their flags.

Every Bazel/Blaze call runs in `systemd-run --user --collect --wait -p MemoryMax=12G
-p MemorySwapMax=0` with HOME and PATH=/usr/bin:/bin only, startup options
--output_user_root=<above> --nohome_rc --nosystem_rc, and --repository_cache=~/.cache/blaze/
repo-cache --color=no --curses=no.
"""

DEFS = """\
def _probe_impl(ctx):
    out = ctx.actions.declare_file(ctx.attr.name + ".out")
    ctx.actions.run(
        executable = ctx.executable.tool,
        arguments = [out.path, ctx.attr.marker],
        outputs = [out],
        mnemonic = "Probe",
    )
    return [DefaultInfo(files = depset([out]))]

probe = rule(
    implementation = _probe_impl,
    attrs = {
        "tool": attr.label(executable = True, cfg = "exec", allow_single_file = True),
        "marker": attr.string(),
    },
)
"""

RUN_SH = "#!/bin/sh\necho ok > \"$1\"\n"


def target(case, extra=""):
    return ('load(":defs.bzl", "probe")\n\nprobe(\n    name = "t",\n    tool = "//tools:run.sh",\n'
            '    marker = "PLATFORM_PROBE_%s",\n%s)\n' % (case, extra))


def plat(name, body):
    return "platform(\n    name = \"%s\",\n%s)\n\n" % (name, body)


def rep(text):
    # A Starlark triple-quoted string holding `text` verbatim (no backslash processing).
    assert '"""' not in text
    # A trailing newline keeps a text ending in `"` from touching the closing quotes.
    return 'r"""%s\n"""' % text


# name -> (BUILD text without the target, target extra attrs, extra flags)
CASES = {}


def case(name, platforms, target_extra="", flags=(), then=None):
    CASES[name] = (platforms, target_extra, list(flags), None if then is None else list(then))


