def rm(p):
    if os.path.lexists(p):
        subprocess.run(["chmod", "-R", "u+w", p])
        shutil.rmtree(p)


def write_ws(ws, name):
    platforms, target_extra, _, _ = CASES[name]
    os.makedirs(os.path.join(ws, "tools"))
    files = {
        "MODULE.bazel": 'bazel_dep(name = "platforms", version = "1.0.0")\n',
        "defs.bzl": DEFS,
        "BUILD": platforms + target(name, target_extra),
        "tools/BUILD": 'exports_files(["run.sh"])\n',
        "tools/run.sh": RUN_SH,
    }
    for rel, text in files.items():
        with open(os.path.join(ws, rel), "w") as f:
            f.write(text)
    os.chmod(os.path.join(ws, "tools/run.sh"), 0o755)


def run_binary(binary, our, ws, step, args):
    full = [binary, "--output_user_root=" + our, "--nohome_rc", "--nosystem_rc", args[0],
            "--repository_cache=" + REPO_CACHE, "--color=no", "--curses=no"] + args[1:]
    unit = ["systemd-run", "--user", "--collect", "--wait", "--pipe", "--quiet", "--same-dir",
            "-p", "MemoryMax=12G", "-p", "MemorySwapMax=0", "env", "-i",
            "HOME=" + os.environ["HOME"], "PATH=/usr/bin:/bin"]
    with open(os.path.join(step, "stdout"), "wb") as so, \
            open(os.path.join(step, "stderr"), "wb") as se:
        return subprocess.run(unit + full, cwd=ws, stdout=so, stderr=se).returncode


# --- minimal protobuf wire decoding (Action, Command, Platform) ---

def varint(b, i):
    r, s = 0, 0
    while True:
        c = b[i]
        i += 1
        r |= (c & 0x7F) << s
        s += 7
        if not c & 0x80:
            return r, i


def fields(b):
    i, out = 0, []
    while i < len(b):
        key, i = varint(b, i)
        num, wt = key >> 3, key & 7
        if wt == 0:
            v, i = varint(b, i)
        elif wt == 2:
            n, i = varint(b, i)
            v = b[i:i + n]
            if len(v) != n:
                raise ValueError("truncated")
            i += n
        elif wt == 1:
            v, i = b[i:i + 8], i + 8
        elif wt == 5:
            v, i = b[i:i + 4], i + 4
        else:
            raise ValueError("wire type %d" % wt)
        out.append((num, wt, v))
    return out


def platform_props(b):
    props = []
    for num, wt, v in fields(b):
        if num == 1 and wt == 2:
            name = value = ""
            for n2, w2, v2 in fields(v):
                if n2 == 1 and w2 == 2:
                    name = v2.decode("utf-8", "replace")
                elif n2 == 2 and w2 == 2:
                    value = v2.decode("utf-8", "replace")
            props.append("%s=%s" % (name, value))
    return props


def show_props(props):
    if props is None:
        return "none"
    return " ".join(repr(p)[1:-1] for p in props) or "none"


def find_action(cas_root, marker):
    blobs = {}
    for d, _, files in os.walk(cas_root):
        for f in files:
            if re.fullmatch(r"[0-9a-f]{64}", f):
                blobs[f] = os.path.join(d, f)
    mark = marker.encode()
    for h, p in blobs.items():
        data = open(p, "rb").read()
        try:
            fs = fields(data)
        except (ValueError, IndexError):
            continue
        cmd_hash = None
        aplat = None
        for num, wt, v in fs:
            if num == 1 and wt == 2:
                try:
                    for n2, w2, v2 in fields(v):
                        if n2 == 1 and w2 == 2 and re.fullmatch(rb"[0-9a-f]{64}", v2):
                            cmd_hash = v2.decode()
                except (ValueError, IndexError):
                    pass
            if num == 10 and wt == 2:
                aplat = platform_props(v)
        if cmd_hash is None or cmd_hash not in blobs:
            continue
        cdata = open(blobs[cmd_hash], "rb").read()
        if mark not in cdata:
            continue
        try:
            cfs = fields(cdata)
        except (ValueError, IndexError):
            continue
        args = [v.decode("utf-8", "replace") for n, w, v in cfs if n == 1 and w == 2]
        if marker not in args:
            continue
        cplat = None
        for n, w, v in cfs:
            if n == 5 and w == 2:
                cplat = platform_props(v)
        return aplat, cplat, args
    return None


def error_blocks(err, ws, worker):
    """Each ERROR line with its continuation lines, joined by ` | `, paths normalised."""
    out = []
    i = 0
    stop = ("ERROR:", "INFO:", "WARNING:", "Target ", "Use --", "FAILED:")
    while i < len(err):
        if err[i].startswith("ERROR:"):
            block = [err[i]]
            i += 1
            while i < len(err) and not err[i].startswith(stop):
                block.append(err[i])
                i += 1
            text = " | ".join(block)
            text = text.replace(ws, "<ws>").replace(os.path.realpath(ws), "<ws>")
            text = text.replace(os.path.join(WORK, "worker-" + worker), "<worker>")
            text = re.sub(r"build-[0-9a-f-]{36}", "build-<uuid>", text)
            out.append(text.replace("\t", "\\t"))
        else:
            i += 1
    return out


def run_cases(binary, tag, port, names):
    root = os.path.join(WORK, tag + "-platform")
    our = os.path.join(OUT_ROOT, tag + "-platform")
    rm(our)
    os.makedirs(root, exist_ok=True)
    worker = tag if tag.startswith("td-") else "td-" + tag
    for name in names:
        subprocess.run([WORKER, "start", worker, str(port)], check=True,
                       stdout=subprocess.DEVNULL)
        step = os.path.join(root, name)
        rm(step)
        ws = os.path.join(step, "ws")
        write_ws(ws, name)
        args = ["build", "//:t", "--extra_execution_platforms=//:p",
                "--remote_executor=grpc://localhost:%d" % port,
                "--remote_grpc_log=" + os.path.join(step, "grpc.log")] + CASES[name][2]
        code = run_binary(binary, our, ws, step, args)
        err = open(os.path.join(step, "stderr"), errors="replace").read().splitlines()
        errors = error_blocks(err, ws, worker)
        procs = [l for l in err if re.search(r"\d+ process(es)?:", l)]
        then_lines = []
        if CASES[name][3] is not None:
            step2 = os.path.join(step, "then")
            os.makedirs(step2)
            args2 = ["build", "//:t", "--extra_execution_platforms=//:p",
                     "--remote_executor=grpc://localhost:%d" % port,
                     "--remote_grpc_log=" + os.path.join(step2, "grpc.log")] + CASES[name][3]
            code2 = run_binary(binary, our, ws, step2, args2)
            err2 = open(os.path.join(step2, "stderr"), errors="replace").read().splitlines()
            procs2 = [l for l in err2 if re.search(r"\d+ process(es)?:", l)]
            errors2 = error_blocks(err2, ws, worker)
            then_lines = ["then-exit %d" % code2,
                          "then-error %s" % (errors2[0] if errors2 else "-"),
                          "then-processes %s" % (procs2[0] if procs2 else "-")]
        found = find_action(os.path.join(WORK, "worker-" + worker, "cas", "cas"),
                            "PLATFORM_PROBE_" + name)
        lines = ["exit %d" % code, "error %s" % (errors[0] if errors else "-"),
                 "processes %s" % (procs[0] if procs else "-")]
        if found is None:
            lines += ["action-platform -", "command-platform -", "argv0 -"]
        else:
            aplat, cplat, args_ = found
            lines += ["action-platform %s" % show_props(aplat),
                      "command-platform %s" % show_props(cplat),
                      "argv0 %s" % (args_[0] if args_ else "-")]
        lines += then_lines
        with open(os.path.join(step, "result.txt"), "w") as f:
            f.write("\n".join(lines) + "\n")
        with open(os.path.join(step, "exit"), "w") as f:
            f.write("%d\n" % code)
        print("== %s" % name)
        for l in lines:
            print("  " + l)
        sys.stdout.flush()
    subprocess.run([WORKER, "stop", worker], stdout=subprocess.DEVNULL)
    return 0


def parse_run_args(rest):
    port = 9640
    names = []
    i = 0
    while i < len(rest):
        if rest[i] == "--port":
            port = int(rest[i + 1])
            i += 2
            continue
        names.append(rest[i])
        i += 1
    for n in names:
        if n not in CASES:
            sys.exit("unknown case %s (see `platform-probe cases`)" % n)
    return port, names or list(CASES)


def cmd_compare(a, b):
    same = True
    for name in CASES:
        pa = os.path.join(WORK, a + "-platform", name, "result.txt")
        pb = os.path.join(WORK, b + "-platform", name, "result.txt")
        if not (os.path.isfile(pa) and os.path.isfile(pb)):
            continue
        ta, tb = open(pa).read(), open(pb).read()
        print("== %s %s" % (name, "SAME" if ta == tb else "DIFFERENT"))
        if ta == tb:
            for l in ta.splitlines():
                print("  " + l)
        else:
            same = False
            for la, lb in zip(ta.splitlines(), tb.splitlines()):
                if la == lb:
                    print("  " + la)
                else:
                    print("  %s: %s" % (a, la))
                    print("  %s: %s" % (b, lb))
    return 0 if same else 1


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("help", "--help", "-h"):
        print(USAGE, end="")
        return 0
    if args[0] == "cases":
        for n, (_, t, fl, then) in CASES.items():
            print("%-30s %s%s%s" % (n, " ".join(fl), " (target exec_properties)" if t else "",
                                    "" if then is None else "; then " + " ".join(then)))
        return 0
    if args[0] == "oracle" and len(args) >= 2:
        port, names = parse_run_args(args[2:])
        return run_cases(ORACLE, args[1], port, names)
    if args[0] == "run" and len(args) >= 3:
        port, names = parse_run_args(args[3:])
        return run_cases(os.path.abspath(os.path.expanduser(args[1])), args[2], port, names)
    if args[0] == "compare" and len(args) == 3:
        return cmd_compare(args[1], args[2])
    print(USAGE, end="", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
