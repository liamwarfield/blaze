#!/usr/bin/python3 -I
"""Run one command inside a systemd unit and record how it ended. See `unit-supervisor help`."""

import os
import signal
import sys

USAGE = """\
usage: scripts/remote/unit-supervisor <status-file> <command> [args...]
       scripts/remote/unit-supervisor help

Runs <command> as a child process, waits for it and writes how it ended to <status-file>
(one line): `exit N` for a normal exit with status N, or `signal N NAME` (for example
`signal 13 SIGPIPE`) when a signal killed it. Exits with N, or with 128+N after a signal.

Meant to be the main process of a `systemd-run --wait` unit: systemd counts the death of a
unit's main process by SIGPIPE, SIGHUP, SIGINT or SIGTERM as a clean exit and `systemd-run`
then returns 0, so the real status must be recorded inside the unit. The tools of
scripts/remote/ read it back through unitstatus.py.

SIGINT, SIGTERM, SIGHUP and SIGQUIT sent to the supervisor (for example by
`systemctl --user kill --kill-whom=main`) are forwarded to the child. The child starts with
SIGPIPE and SIGXFSZ at their defaults (Python ignores them) and no other change: same
environment, working directory, stdio and signal mask.
"""

FORWARDED = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT)


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("help", "--help", "-h"):
        print(USAGE, end="")
        return 0
    if len(args) < 2:
        sys.stderr.write(USAGE)
        return 2
    status_file, cmd = args[0], args[1:]
    child = []
    pending = []

    def forward(signum, _frame):
        if child:
            try:
                os.kill(child[0], signum)
            except ProcessLookupError:
                pass
        else:
            pending.append(signum)

    for s in FORWARDED:
        signal.signal(s, forward)
    pid = os.fork()
    if pid == 0:
        for s in FORWARDED + (signal.SIGPIPE, signal.SIGXFSZ):
            signal.signal(s, signal.SIG_DFL)
        try:
            os.execvp(cmd[0], cmd)
        except OSError as e:
            os.write(2, ("unit-supervisor: cannot run %s: %s\n" % (cmd[0], e)).encode())
            os._exit(127)
    child.append(pid)
    for s in pending:
        os.kill(pid, s)
    _, status = os.waitpid(pid, 0)
    if os.WIFSIGNALED(status):
        n = os.WTERMSIG(status)
        line = "signal %d %s\n" % (n, signal.Signals(n).name)
        code = 128 + n
    else:
        code = os.WEXITSTATUS(status)
        line = "exit %d\n" % code
    with open(status_file, "w") as f:
        f.write(line)
    return code


if __name__ == "__main__":
    sys.exit(main())
