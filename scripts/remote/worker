#!/usr/bin/env bash
# Start/stop Bazel's own remote worker (the reference server for blaze_remote).
#
# usage: scripts/remote/worker start <name> <port> [extra worker flags...]
#        scripts/remote/worker stop <name>
#        scripts/remote/worker status <name>
#        scripts/remote/worker help
#
# `start` runs ~/.cache/blaze/work/upstream-src/bazel-bin/src/tools/remote/worker_deploy.jar
# (built from the pinned Bazel source) with the oracle's embedded JDK as the transient systemd
# user unit blaze-remote-worker-<name> (MemoryMax=8G), listening on localhost:<port> with
#   --work_path=~/.cache/blaze/work/remote/worker-<name>/work
#   --cas_path=~/.cache/blaze/work/remote/worker-<name>/cas
#   --pid_file=~/.cache/blaze/work/remote/worker-<name>/pid
# after deleting that directory (a fresh, empty cache), and waits until the port accepts
# connections. Extra flags go to the worker (e.g. --sandboxing, --tls_certificate=...).
# `stop` stops the unit. The worker serves the Remote Execution API v2 (cache and execution).
set -euo pipefail
if [[ "${1:-help}" == "help" || "${1:-}" == "--help" ]]; then sed -n '2,17p' "$0"; exit 0; fi
cmd="$1"; name="${2:?name}"
unit="blaze-remote-worker-$name"
dir="${BLAZE_REMOTE_WORK:-$HOME/.cache/blaze/work/remote}/worker-$name"
java="$HOME/.cache/blaze/oracle-out/ur/install/58cf1ecbff441bac762b0050d6da21e9/embedded_tools/jdk/bin/java"
jar="$HOME/.cache/blaze/work/upstream-src/bazel-bin/src/tools/remote/worker_deploy.jar"
case "$cmd" in
  start)
    port="${3:?port}"; shift 3
    systemctl --user stop "$unit" 2>/dev/null || true
    systemctl --user reset-failed "$unit" 2>/dev/null || true
    chmod -R u+w "$dir" 2>/dev/null || true
    rm -rf "$dir"; mkdir -p "$dir/work" "$dir/cas"
    # ExecutionServer resolves its (macOS-only) xcode-locator through runfiles; a directory is enough.
    mkdir -p "$dir/runfiles/io_bazel/src/tools/remote/src/main/java/com/google/devtools/build/remote/worker"
    systemd-run --user --collect --quiet --unit "$unit" -p MemoryMax=8G -p MemorySwapMax=0 \
      --setenv=HOME="$HOME" --setenv=PATH=/usr/bin:/bin --setenv=RUNFILES_DIR="$dir/runfiles" \
      -p StandardOutput="file:$dir/stdout" -p StandardError="file:$dir/stderr" \
      "$java" -jar "$jar" --work_path="$dir/work" --cas_path="$dir/cas" --pid_file="$dir/pid" \
      --listen_port="$port" "$@"
    for _ in $(seq 1 100); do
      if (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then echo "worker $name listening on $port"; exit 0; fi
      sleep 0.2
    done
    echo "worker $name did not start; see $dir/stderr" >&2; exit 1 ;;
  stop) systemctl --user stop "$unit" 2>/dev/null || true; echo "worker $name stopped" ;;
  status) systemctl --user is-active "$unit" ;;
  *) echo "unknown command: $cmd" >&2; exit 2 ;;
esac
