#!/usr/bin/env python3
"""Compares Blaze's Starlark interpreter with Bazel 9.3.2's. See `interp-diff help`."""

import os
import re
import shutil
import subprocess
import sys

USAGE = """\
usage: scripts/starlark/interp-diff record-java [CASEDIR]
       scripts/starlark/interp-diff binary [--blaze BIN] [--only REGEX] [--json FILE] [CASEDIR]
       scripts/starlark/interp-diff selftest
       scripts/starlark/interp-diff help

CASEDIR (default crates/starlark_conformance/tests/data/interp) holds NAME.star files: small
Starlark programs that print values (or fail).

record-java  runs every case on Bazel 9.3.2's own interpreter (net.starlark.java in the oracle's
             A-server.jar) with crates/starlark_conformance/java/StarlarkProbe.java in latin1
             mode (how Bazel reads BUILD and .bzl files) and writes NAME.latin1.txt next to the
             case. These are the expected outputs of the starlark_conformance test
             `java_recorded_interp` (tests/java_recorded.rs).

binary       differential run on the real binaries. One scratch workspace
             (~/.cache/blaze/oracle-out/interp-diff/ws) gets two packages per case:
               b_NAME/BUILD        the case as a BUILD file;
               z_NAME/case.bzl     `probe_ok = 1` followed by the case, as a .bzl file,
               z_NAME/BUILD        `load(":case.bzl", "probe_ok")`.
             The oracle (~/.cache/blaze/oracle/bazel-9.3.2-linux-x86_64) and Blaze (BIN,
             default target/debug/blaze) each run once, `query --keep_going //...`, under
             systemd-run (MemoryMax=12G), with separate output user roots. Per package the tool
             compares: accepted or rejected (an ERROR line naming the package), the DEBUG
             lines (print output with file:line:col), and the text of every ERROR message that
             names the package, with its continuation lines (Bazel's traceback, the source
             lines, `Error in f: ...`), in order (docs/decisions.md 2026-11-19: core-language
             error texts are ported). Prints one line per package that differs (OUTCOME: the
             outcome or the print output differs; TEXT: only the error text differs, with both
             texts) and a summary; exit status 1 if any differs. Stderr of both runs is saved
             under ~/.cache/blaze/oracle-out/interp-diff/.
             --only REGEX keeps the cases whose NAME matches.

             Guards (scripts/lib/compare_common.py): both runs go through a supervisor in the
             scope (environment HOME and PATH=/usr/bin:/bin only) that records how the query
             really ended (`exit N`, `signal NAME`, `oom-kill`, `timeout` after 3600 s). The
             terminations are compared as one more row, `query-termination`: the expected exit
             is 3 when the oracle rejects at least one package (--keep_going), else 0; equal
             failures otherwise are BOTH-FAILED. The oracle must be the pinned one
             (UPSTREAM.json); an --only that matches no case is an error. Each package is one
             row: IDENTICAL, or DIFFERENT (OUTCOME or TEXT). The report starts with the
             repository HEAD and dirty flag and both binaries' paths and sha256 and ends with
             the denominator; --json writes it. Exit status 0 only when every row is IDENTICAL;
             1 otherwise; 2 on a refusal.

selftest     proves the guards with fake binaries (no real build)."""

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(os.path.dirname(HERE))
DEFAULT_CASES = os.path.join(ROOT, "crates/starlark_conformance/tests/data/interp")
ORACLE = os.path.expanduser("~/.cache/blaze/oracle/bazel-9.3.2-linux-x86_64")
INSTALL_BASE = os.path.expanduser(
    "~/.cache/blaze/oracle-out/ur/install/58cf1ecbff441bac762b0050d6da21e9")
PROBE = os.path.join(ROOT, "crates/starlark_conformance/java/StarlarkProbe.java")
BASE = os.path.expanduser("~/.cache/blaze/oracle-out/interp-diff")
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(ROOT, "scripts", "lib"))
import compare_common as cc  # noqa: E402


def cases_in(casedir, only=None):
    names = sorted(f[:-5] for f in os.listdir(casedir) if f.endswith(".star"))
    if only:
        names = [n for n in names if re.search(only, n)]
    return names


def record_java(casedir):
    names = cases_in(casedir)
    for n in names:
        p = subprocess.run(
            ["java", "--enable-native-access=ALL-UNNAMED", "-cp",
             os.path.join(INSTALL_BASE, "A-server.jar"), PROBE, "latin1", n + ".star"],
            cwd=casedir, capture_output=True)
        if p.returncode != 0:
            sys.stderr.write("%s: the probe failed (exit %d):\n%s\n" % (
                n, p.returncode, p.stderr.decode("latin-1")))
            sys.exit(1)
        with open(os.path.join(casedir, n + ".latin1.txt"), "wb") as f:
            f.write(p.stdout)
    print("recorded %d cases with %s" % (len(names), os.path.join(INSTALL_BASE, "A-server.jar")))


def make_workspace(casedir, names):
    ws = os.path.join(BASE, "ws")
    shutil.rmtree(ws, ignore_errors=True)
    os.makedirs(ws)
    open(os.path.join(ws, "MODULE.bazel"), "w").close()
    for n in names:
        with open(os.path.join(casedir, n + ".star"), "rb") as f:
            src = f.read()
        os.makedirs(os.path.join(ws, "b_" + n))
        with open(os.path.join(ws, "b_" + n, "BUILD"), "wb") as f:
            f.write(src)
        os.makedirs(os.path.join(ws, "z_" + n))
        with open(os.path.join(ws, "z_" + n, "case.bzl"), "wb") as f:
            f.write(b"probe_ok = 1\n" + src)
        with open(os.path.join(ws, "z_" + n, "BUILD"), "wb") as f:
            f.write(b'load(":case.bzl", "probe_ok")\n')
    return ws


def run(binary, ws, tag, base=BASE):
    """(compare_common.Termination, stderr with <WS>) of `query --keep_going //...`."""
    home = os.path.expanduser("~")
    argv = [binary, "--output_user_root=" + os.path.join(base, "ur-" + tag), "--nohome_rc",
            "--nosystem_rc", "query", "--keep_going", "--color=no", "--curses=no",
            "--repository_cache=" + home + "/.cache/blaze/repo-cache", "//..."]
    p = cc.run(argv, ws, timeout=3600, mode="scope", tag="interp-diff-" + tag)
    err = p.err.decode("latin-1").replace(ws, "<WS>")
    with open(os.path.join(base, tag + ".stderr.txt"), "w", encoding="latin-1") as f:
        f.write(err)
    with open(os.path.join(base, tag + ".stdout.txt"), "wb") as f:
        f.write(p.out)
    if not (p.term.normal and p.term.code in (0, 3)):
        sys.stderr.write("%s: %s, see %s\n" % (tag, p.term,
                                               os.path.join(base, tag + ".stderr.txt")))
    return p.term, err


PKG_RE = re.compile(r"(?:<WS>/|//|package '|package contains errors: )([bz]_[A-Za-z0-9_]+)")


CONTINUATION = re.compile(r"^(\t|Traceback |Error |Error:|Error in )")


def summarize(err, packages):
    """Per package: (rejected, DEBUG lines in order, error message blocks in order). One package
    is evaluated by one thread, so its print order is deterministic (audit round 4, R4)."""
    rejected = set()
    debug = {p: [] for p in packages}
    errors = {p: [] for p in packages}
    block = None
    for line in err.split("\n"):
        if block is not None and CONTINUATION.match(line):
            block[1].append(line)
            continue
        block = None
        if line.startswith("DEBUG: <WS>/"):
            m = re.match(r"DEBUG: <WS>/([^/]+)/(\S+): (.*)$", line)
            if m and m.group(1) in debug:
                debug[m.group(1)].append(m.group(2) + ": " + m.group(3))
        elif line.startswith("ERROR: "):
            named = [m.group(1) for m in PKG_RE.finditer(line) if m.group(1) in debug]
            for p in named:
                rejected.add(p)
            if named:
                block = (named[0], [line])
                errors[named[0]].append(block[1])
    return {p: (p in rejected, debug[p], ["\n".join(b) for b in errors[p]])
            for p in packages}


RULES = list(cc.VOLATILE_RULES)


def judge_packages(packages, oracle_term, oracle_err, blaze_term, blaze_err, report,
                   oracle_out=b"", blaze_out=b"", norm=None):
    """Adds the query-termination, query-stdout and query-stderr rows and one row per
    package; prints OUTCOME/TEXT lines."""
    want = summarize(oracle_err, packages)
    got = summarize(blaze_err, packages)
    rejected = sum(1 for p in packages if want[p][0])
    cls, detail = cc.judge(oracle_term, blaze_term, [], declared_exit=3 if rejected else None)
    report.add("query-termination", cls, detail or "oracle %s, blaze %s" % (
        oracle_term, blaze_term))
    norm = norm or cc.Normaliser(RULES)
    for name, stream, o, b in (("query-stdout", "stdout", oracle_out, blaze_out),
                               ("query-stderr", "stderr", oracle_err, blaze_err)):
        eq, _ = norm.compare(o, b, stream)
        report.add(name, cc.IDENTICAL if eq else cc.DIFFERENT,
                   "the whole %s after the exclusion rules" % stream)
    outcome = text = 0
    for p in packages:
        if want[p][:2] != got[p][:2]:
            outcome += 1
            print("OUTCOME %s: oracle %s %s | blaze %s %s" % (
                p, "rejected" if want[p][0] else "accepted", want[p][1],
                "rejected" if got[p][0] else "accepted", got[p][1]))
            report.add(p, cc.DIFFERENT, "outcome or print output")
        elif want[p][2] != got[p][2]:
            text += 1
            print("TEXT %s:\n  oracle %r\n  blaze  %r" % (p, want[p][2], got[p][2]))
            report.add(p, cc.DIFFERENT, "error text only")
        else:
            report.add(p, cc.IDENTICAL, "rejected" if want[p][0] else "accepted")
    return want, outcome, text


def binary(casedir, blaze, only, json_out=None):
    names = cases_in(casedir, only)
    if not names:
        return cc.empty_selection_error("starlark/interp-diff")
    try:
        oracle, oracle_sha = cc.require_oracle(ORACLE)
        bid = cc.blaze_identity(blaze)
    except cc.Refusal as e:
        return cc.refuse("starlark/interp-diff", e)
    report = cc.Report("starlark/interp-diff", blaze=bid,
                       oracle={"path": oracle, "sha256": oracle_sha},
                       selection="%d cases of %s%s" % (len(names), casedir,
                                                       " (--only %s)" % only if only else ""),
                       tool_files=[os.path.abspath(__file__)],
                       compared="the query's termination, its whole stdout and stderr (paths "
                                "of the workspace as <WS>) after the exclusion rules listed at "
                                "the end, and per package: accepted or rejected, the DEBUG "
                                "lines in order, the error texts in order")
    norm = cc.Normaliser(RULES, path_reason="the scratch workspace (one for both sides) is "
                         "written as <WS> before the rules")
    report.add_normaliser(norm)
    report.print_header()
    ws = make_workspace(casedir, names)
    packages = ["b_" + n for n in names] + ["z_" + n for n in names]
    oracle_term, oracle_err = run(oracle, ws, "oracle")
    blaze_term, blaze_err = run(bid["path"], ws, "blaze")
    outs = {}
    for tag in ("oracle", "blaze"):
        with open(os.path.join(BASE, tag + ".stdout.txt"), "rb") as f:
            outs[tag] = f.read()
    want, outcome, text = judge_packages(packages, oracle_term, oracle_err, blaze_term,
                                         blaze_err, report, outs["oracle"], outs["blaze"], norm)
    accepted = sum(1 for p in packages if not want[p][0])
    print("%d cases, %d packages (oracle: %d accepted, %d rejected); oracle %s, blaze %s; "
          "%d packages differ in outcome, %d more in error text only; %d identical"
          % (len(names), len(packages), accepted, len(packages) - accepted, oracle_term,
             blaze_term, outcome, text, len(packages) - outcome - text))
    report.print_footer()
    if json_out:
        report.write_json(json_out)
    return report.exit_code()


def selftest():
    first = cases_in(DEFAULT_CASES)[0]

    def argv(blaze, label):
        return ["binary", "--blaze", blaze, "--only", "^%s$" % re.escape(first)]

    return cc.selftest_tool(
        "starlark/interp-diff", os.path.abspath(__file__), argv,
        empty=lambda b, l: ["binary", "--blaze", b, "--only", "^no case has this name$"],
        scenarios=cc.itemised())


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("help", "--help", "-h"):
        print(USAGE)
        return
    cmd, rest = args[0], args[1:]
    if cmd == "record-java":
        record_java(os.path.abspath(rest[0]) if rest else DEFAULT_CASES)
        return
    if cmd == "selftest":
        sys.exit(selftest())
    if cmd == "binary":
        blaze = os.path.join(ROOT, "target/debug/blaze")
        only = None
        json_out = None
        casedir = DEFAULT_CASES
        i = 0
        while i < len(rest):
            if rest[i] == "--blaze":
                blaze = os.path.abspath(rest[i + 1])
                i += 2
            elif rest[i] == "--only":
                only = rest[i + 1]
                i += 2
            elif rest[i] == "--json":
                json_out = rest[i + 1]
                i += 2
            else:
                casedir = os.path.abspath(rest[i])
                i += 1
        os.makedirs(BASE, exist_ok=True)
        sys.exit(binary(casedir, blaze, only, json_out))
    print(USAGE)
    sys.exit(2)


if __name__ == "__main__":
    main()
