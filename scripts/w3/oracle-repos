#!/usr/bin/env python3
"""Record the oracle's external repositories for a corpus project. See `oracle-repos help`."""

import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
ORACLE_DIR = os.path.join(os.path.dirname(HERE), "oracle")
sys.path.insert(0, ORACLE_DIR)

import oracle_common as oc  # noqa: E402


def _load_record():
    """Imports scripts/oracle/record (no .py suffix) for its workspace and run helpers."""
    path = os.path.join(ORACLE_DIR, "record")
    loader = importlib.machinery.SourceFileLoader("oracle_record", path)
    spec = importlib.util.spec_from_loader("oracle_record", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


record = _load_record()

USAGE = """\
usage: scripts/w3/oracle-repos --project <name|all> [--repo-output-base DIR] [--fresh]
                               [--no-scope] [--binary PATH]
       scripts/w3/oracle-repos help

Writes ~/.cache/blaze/w3/<project>.repos.json: the external repositories of a corpus project as
the oracle (Bazel 9.3.2) sees them, for Blaze's OracleRepos (crates/blaze_sky_loading, the
ExternalRepos seam: REPOSITORY_MAPPING and REPOSITORY_DIRECTORY).

Steps:
  1. copy the read-only checkout ~/.cache/blaze/corpus/<project> to
     ~/.cache/blaze/work/w3/<project> exactly as scripts/oracle/record does (rsync minus bazel-*
     and .git, then restore to the checkout's git HEAD);
  2. run the oracle on that copy (startup --output_user_root=~/.cache/blaze/oracle-out/ur-w3
     --nohome_rc --nosystem_rc; --repository_cache=~/.cache/blaze/repo-cache; env HOME and
     PATH=/usr/bin:/bin only; inside `systemd-run --user --scope -p MemoryMax=12G
     -p MemorySwapMax=0` unless --no-scope):
       mod graph --output=json --include_builtin          (module names and versions)
       mod dump_repo_mapping '' _builtins <repos...>      (repeated until closed under the
                                                           canonical names the mappings name;
                                                           "Repositories not found" are
                                                           recorded as not found)
     then `shutdown`;
  3. take repo directories from the external/ directory of the oracle output base that holds the
     fetched repos (--repo-output-base; defaults: the reference output bases below), resolved to
     real paths, null when absent (e.g. re2's libpfm+, never fetched).

Default repo output bases, searched in order (the first with external/<repo> wins; the ur/ ones
were fetched by full builds of the read-only checkouts, the rec-oracle-9.3.2 one by the oracle
recording's query commands):
  brotli  ~/.cache/blaze/oracle-out/ur/583b18a54a0812f6ca106c9c2c1eb80c
  re2     ~/.cache/blaze/oracle-out/rec-oracle-9.3.2/d4c1ff46e292915bfbb425566b16402b
          ~/.cache/blaze/oracle-out/ur/f5418354f8881fd01f338636721e5f81

Output (JSON, format 1):
  {"format": 1, "project": ..., "workspace": <abs path of the copy>,
   "workspace_fixups": [...],                                 (paths restored to HEAD)
   "oracle": {"binary", "output_user_root", "output_base", "repo_output_base": [bases...], "commands"},
   "main_repo_mapping": [[apparent, canonical], ...],          (Java entry order)
   "modules": {"<root>"|"name@version": {"name", "version", "canonical_repo"}},
   "repos": {<canonical name>: {
       "found": bool,                  (false: RepositoryMappingValue.NOT_FOUND_VALUE)
       "mapping": [[apparent, canonical], ...] | null,
       "module_name": str | null,      (RepositoryMappingValue.associatedModuleName)
       "module_version": str | null,   (associatedModuleVersion, normalized)
       "kind": "main" | "module" | "extension" | "builtins" | "not_found",
       "directory": <real path> | null}}}  (main repo: the workspace)
  Associated modules follow RepositoryMappingFunction: a module repo has its module; a repo
  generated by a module extension has the module hosting the extension (the module whose repo
  holds the extension's .bzl); @_builtins and repos not found have none.

Options:
  --project NAME          brotli, re2 or all
  --repo-output-base DIR  output base whose external/ holds the fetched repos
  --fresh                 delete the ur-w3 output base of this workspace first
  --no-scope              do not wrap the run in systemd-run --scope
  --binary PATH           default ~/.cache/blaze/oracle/bazel-9.3.2-linux-x86_64
"""

BINARY = os.path.join(oc.CACHE, "oracle", "bazel-9.3.2-linux-x86_64")
OUTPUT_USER_ROOT = os.path.join(oc.OUTPUT_ROOTS, "ur-w3")
OUT_DIR = os.path.join(oc.CACHE, "w3")
WORK = os.path.join(oc.WORK, "w3")
# Searched in order; the first base with external/<repo> wins. re2's recording output base
# (rec-oracle-9.3.2) holds the repos the oracle fetched for `query deps(...)` (zlib, fuchsia_sdk,
# remote_coverage_tools, ...), which the full build never fetched.
REPO_OUTPUT_BASES = {
    "brotli": [os.path.join(oc.OUTPUT_ROOTS, "ur", "583b18a54a0812f6ca106c9c2c1eb80c")],
    "re2": [
        os.path.join(oc.OUTPUT_ROOTS, "rec-oracle-9.3.2", "d4c1ff46e292915bfbb425566b16402b"),
        os.path.join(oc.OUTPUT_ROOTS, "ur", "f5418354f8881fd01f338636721e5f81"),
    ],
}
# Java: bazel/bzlmod/ModuleKey.java WELL_KNOWN_MODULES
WELL_KNOWN_MODULES = {"bazel_tools": "bazel_tools", "platforms": "platforms"}
NOT_FOUND_RE = re.compile(r"Repositories not found: (.*)$", re.M)


def maybe_reexec_in_scope(args):
    if args.no_scope or os.environ.get("BLAZE_ORACLE_SCOPE") == "1":
        return
    if shutil.which("systemd-run") is None:
        print("warning: systemd-run not found; running without memory limits", file=sys.stderr)
        return
    argv = [
        "systemd-run", "--user", "--scope", "--collect", "--quiet",
        "-p", "MemoryMax=" + record.MEMORY_MAX, "-p", "MemorySwapMax=0",
        "--", "env", "BLAZE_ORACLE_SCOPE=1", sys.executable, "-I", os.path.abspath(__file__),
    ] + sys.argv[1:]
    os.execvp(argv[0], argv)


class Oracle:
    def __init__(self, binary, ws, log_dir):
        self.binary = binary
        self.ws = ws
        self.log_dir = log_dir
        self.n = 0
        self.commands = []

    def run(self, name, args, startup_only=False):
        self.n += 1
        out = os.path.join(self.log_dir, "%02d_%s.stdout" % (self.n, name))
        err = os.path.join(self.log_dir, "%02d_%s.stderr" % (self.n, name))
        cmd = [self.binary, "--output_user_root=" + OUTPUT_USER_ROOT, "--nohome_rc",
               "--nosystem_rc"] + args[:1]
        if not startup_only:
            cmd += ["--repository_cache=" + oc.REPO_CACHE, "--color=no", "--curses=no"]
        cmd += args[1:]
        rc, dur = record.run(cmd, self.ws, out, err)
        self.commands.append({"name": name, "argv": cmd[1:], "exit_code": rc, "duration_s": dur})
        print("[oracle-repos]   %s: exit %d (%.1fs)" % (name, rc, dur), flush=True)
        with open(out, encoding="utf-8") as f:
            stdout = f.read()
        with open(err, encoding="utf-8", errors="replace") as f:
            stderr = f.read()
        return rc, stdout, stderr


def walk_graph(node, modules):
    key = node["key"]
    if key not in modules or not node.get("unexpanded"):
        modules.setdefault(key, {"name": node["name"], "version": node["version"]})
    for k in ("dependencies", "indirectDependencies"):
        for child in node.get(k, []):
            walk_graph(child, modules)


def canonical_repo_names(modules):
    """Java ModuleKey.getCanonicalRepoName, with versions only for multiple-version modules."""
    versions = {}
    for key, m in modules.items():
        if key != "<root>":
            versions.setdefault(m["name"], set()).add(m["version"])
    for key, m in modules.items():
        name = m["name"]
        if name in WELL_KNOWN_MODULES:
            m["canonical_repo"] = WELL_KNOWN_MODULES[name]
        elif key == "<root>":
            m["canonical_repo"] = ""
        elif len(versions[name]) > 1:
            m["canonical_repo"] = "%s+%s" % (name, m["version"])
        else:
            m["canonical_repo"] = name + "+"


def dump_mappings(oracle, repos):
    """Runs `mod dump_repo_mapping` on `repos`; returns {repo: [[k, v], ...]} and not-found."""
    remaining = list(repos)
    not_found = []
    for _ in range(20):
        if not remaining:
            return {}, not_found
        rc, out, err = oracle.run("dump_repo_mapping", ["mod", "dump_repo_mapping"] + remaining)
        if rc == 0:
            lines = [l for l in out.split("\n") if l.strip()]
            if len(lines) != len(remaining):
                oc.die("dump_repo_mapping printed %d lines for %d repos" %
                       (len(lines), len(remaining)))
            result = {}
            for repo, line in zip(remaining, lines):
                result[repo] = [list(p) for p in json.loads(line, object_pairs_hook=list)]
            return result, not_found
        m = NOT_FOUND_RE.search(err)
        if not m:
            oc.die("dump_repo_mapping failed (exit %d):\n%s" % (rc, err[-4000:]))
        missing = [s.strip() for s in m.group(1).split(",")]
        # RepositoryName.getName of the main repo is "".
        missing_set = set(missing)
        not_found += [r for r in remaining if r in missing_set]
        remaining = [r for r in remaining if r not in missing_set]
    oc.die("dump_repo_mapping did not converge")


def external_dirs(repo_output_bases):
    names = []
    for base in repo_output_bases:
        ext = os.path.join(base, "external")
        if not os.path.isdir(ext):
            continue
        for name in sorted(os.listdir(ext)):
            if name.endswith(".marker") or name.startswith("@") or name == "_main":
                continue
            if os.path.isdir(os.path.join(ext, name)) and name not in names:
                names.append(name)
    return names


def repo_directory(repo_output_bases, repo):
    """The real path of external/<repo> in the first output base that has it, else None."""
    for base in repo_output_bases:
        d = os.path.join(base, "external", repo)
        if os.path.isdir(d):
            return os.path.realpath(d)
    return None


def associated_module(repo, found, modules_by_repo):
    """Java RepositoryMappingFunction.computeInternal: (kind, module name, module version)."""
    if repo == "_builtins":
        return "builtins", None, None
    if not found:
        return "not_found", None, None
    m = modules_by_repo.get(repo)
    if m is not None:
        return ("main" if repo == "" else "module"), m["name"], m["version"]
    # A repo generated by a module extension: "<extension unique name>+<internal name>", where the
    # unique name is "<canonical repo of the extension's .bzl>+<extension name>[n]"
    # (BazelDepGraphFunction.makeUniqueNameCandidate). The extension's repo is a module repo.
    best = None
    for r, mod in modules_by_repo.items():
        if r and repo.startswith(r + "+") and "+" in repo[len(r) + 1:]:
            if best is None or len(r) > len(best[0]):
                best = (r, mod)
    if best is None:
        oc.die("cannot find the module hosting the extension that generates @@" + repo)
    return "extension", best[1]["name"], best[1]["version"]


def run_project(args, project, spec):
    checkout = oc.expand(spec["checkout"])
    ws = os.path.join(WORK, project)
    repo_output_bases = [os.path.realpath(b) for b in (
        [args.repo_output_base] if args.repo_output_base else REPO_OUTPUT_BASES[project])]
    print("[oracle-repos] %s: preparing %s" % (project, ws), flush=True)
    fixed = record.prepare_workspace(checkout, ws)
    ws = os.path.realpath(ws)
    output_base = os.path.join(OUTPUT_USER_ROOT, hashlib.md5(ws.encode()).hexdigest())
    if args.fresh:
        record.kill_servers(OUTPUT_USER_ROOT)
        record.make_writable_and_remove(output_base)
    log_dir = os.path.join(OUT_DIR, "logs", project)
    record.make_writable_and_remove(log_dir)
    os.makedirs(log_dir)
    oracle = Oracle(os.path.abspath(oc.expand(args.binary)), ws, log_dir)

    try:
        rc, out, err = oracle.run("mod_graph", ["mod", "graph", "--output=json",
                                                "--include_builtin"])
        if rc != 0:
            oc.die("mod graph failed (exit %d):\n%s" % (rc, err[-4000:]))
        modules = {}
        walk_graph(json.loads(out), modules)
        canonical_repo_names(modules)
        modules_by_repo = {m["canonical_repo"]: m for m in modules.values()}

        queried = ["", "_builtins"]
        for name in external_dirs(repo_output_bases):
            if name not in queried:
                queried.append(name)
        mappings, not_found = {}, []
        pending = list(queried)
        while pending:
            got, nf = dump_mappings(oracle, pending)
            mappings.update(got)
            not_found += nf
            pending = []
            for mapping in got.values():
                for _, canonical in mapping:
                    if canonical not in queried:
                        queried.append(canonical)
                        pending.append(canonical)
    finally:
        oracle.run("shutdown", ["shutdown"], startup_only=True)

    repos = {}
    for repo in queried:
        found = repo in mappings
        kind, mod_name, mod_version = associated_module(repo, found, modules_by_repo)
        if repo == "":
            directory = ws
        else:
            directory = None if repo == "_builtins" else repo_directory(repo_output_bases, repo)
        repos[repo] = {
            "found": found,
            "mapping": mappings.get(repo),
            "module_name": mod_name,
            "module_version": mod_version,
            "kind": kind,
            "directory": directory,
        }
    for name in external_dirs(repo_output_bases):
        if not repos.get(name, {}).get("found"):
            print("[oracle-repos] warning: %s has a directory but no repo mapping" % name)

    result = {
        "format": 1,
        "project": project,
        "workspace": ws,
        "workspace_fixups": fixed,
        "oracle": {
            "binary": oracle.binary,
            "output_user_root": OUTPUT_USER_ROOT,
            "output_base": output_base,
            "repo_output_base": repo_output_bases,
            "commands": oracle.commands,
        },
        "main_repo_mapping": mappings[""],
        "modules": {k: modules[k] for k in sorted(modules)},
        "repos": repos,
    }
    path = os.path.join(OUT_DIR, project + ".repos.json")
    oc.write_json(path, result)
    counts = {}
    for r in repos.values():
        counts[r["kind"]] = counts.get(r["kind"], 0) + 1
    with_dir = sum(1 for r in repos.values() if r["directory"])
    print("[oracle-repos] %s: wrote %s (%d repos: %s; %d with a directory)" % (
        project, path, len(repos),
        ", ".join("%s %d" % kv for kv in sorted(counts.items())), with_dir), flush=True)


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("help", "-h", "--help"):
        print(USAGE)
        return 0
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--project", required=True)
    ap.add_argument("--repo-output-base")
    ap.add_argument("--fresh", action="store_true")
    ap.add_argument("--no-scope", action="store_true")
    ap.add_argument("--binary", default=BINARY)
    args = ap.parse_args()
    projects = oc.load_projects()
    names = sorted(projects) if args.project == "all" else [args.project]
    for n in names:
        if n not in projects:
            oc.die("unknown project %r (have: %s)" % (n, ", ".join(sorted(projects))))
        if not args.repo_output_base and n not in REPO_OUTPUT_BASES:
            oc.die("no default repo output base for %r; pass --repo-output-base" % n)
    if args.repo_output_base and len(names) > 1:
        oc.die("--repo-output-base needs a single --project")
    if not os.access(oc.expand(args.binary), os.X_OK):
        oc.die("binary not executable: " + args.binary)
    maybe_reexec_in_scope(args)
    os.makedirs(OUT_DIR, exist_ok=True)
    for n in names:
        run_project(args, n, projects[n])
    return 0


if __name__ == "__main__":
    sys.exit(main())
