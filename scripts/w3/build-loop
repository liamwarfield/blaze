#!/usr/bin/env bash
# usage: scripts/w3/build-loop <out_dir> [iterations] [sleep_s]   (help: this text)
# Repeats: scripts/w3/build-errors <out_dir>; then builds target/debug/blaze-query-dev when the check
# passed (log in <out_dir>/BIN.txt). For the W3 lead; agents read the outputs, never run cargo.
set -u
if [[ "${1:-help}" == "help" ]]; then sed -n '2,4p' "$0"; exit 0; fi
out=$1; n=${2:-40}; s=${3:-150}
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
for i in $(seq 1 "$n"); do
  "$root/scripts/w3/build-errors" "$out" > /dev/null 2>&1
  if grep -q 'cargo exit 0' "$out/SUMMARY.txt"; then
    { date '+%F %T'; "$root/scripts/cargo-capped" build -p blaze_query --bin blaze-query-dev 2>&1 | tail -3; } > "$out/BIN.txt"
  fi
  sleep "$s"
done
