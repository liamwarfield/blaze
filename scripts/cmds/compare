def _varint(n):
    out = bytearray()
    while True:
        b = n & 0x7F
        n >>= 7
        if n:
            out.append(b | 0x80)
        else:
            out.append(b)
            return bytes(out)


def _field(number, payload):
    """A length-delimited field (wire type 2)."""
    if isinstance(payload, str):
        payload = payload.encode("utf-8")
    return _varint(number << 3 | 2) + _varint(len(payload)) + payload


def encode_flag_policy(flag, op, values=(), behavior=None, new_value=None, use_default=False,
                       commands=(), custom_error_message=None):
    """blaze.invocation_policy.FlagPolicy in protobuf binary form (fields in number order, as
    Java's writeTo writes them). op: set_value, use_default, allow_values, disallow_values."""
    body = _field(1, flag)
    for c in commands:
        body += _field(2, c)
    if op == "set_value":
        inner = b"".join(_field(1, v) for v in values)
        if behavior is not None:
            inner += _varint(4 << 3 | 0) + _varint(behavior)
        body += _field(3, inner)
    elif op == "use_default":
        body += _field(4, b"")
    elif op in ("allow_values", "disallow_values"):
        inner = b"".join(_field(1, v) for v in values)
        if new_value is not None:
            inner += _field(3, new_value)
        if use_default:
            inner += _field(4, b"")
        body += _field(6 if op == "allow_values" else 5, inner)
    if custom_error_message is not None:
        body += _field(7, custom_error_message)
    return body


def encode_policy(*flag_policies):
    """InvocationPolicy (base64 of its binary form, as Blaze/Bazel accept it)."""
    return base64.b64encode(b"".join(_field(1, fp) for fp in flag_policies)).decode("ascii")


