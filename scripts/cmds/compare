                                ("disallow_values base64", b_disallow, []),
                                ("unknown flag", t_unknown, []),
                                ("for_command test", t_commands, ["--jobs=3"])]:
        argv = ["canonicalize-flags", "--canonicalize_policy", "--invocation_policy=" + policy]
        if name == "for_command test":
            argv.append("--for_command=test")
        cases.append(Case("canonicalize-flags canonicalize_policy " + name,
                          argv + ["--"] + flags, cwd="brotli"))
    # The startup option: enforced on every command's options.
    startup = [
        ("info set_value text", t_set_jobs, ["info", "--jobs=3", "release"]),
        ("info set_value base64", b_set_jobs, ["info", "release"]),
        ("info throw", t_throw, ["info", "--jobs=3", "release"]),
        ("info allow_values error", t_allow_err, ["info", "release"]),
        ("info disallow_values base64", b_disallow, ["info", "-c", "dbg", "release"]),
        ("info config", t_config, ["info", "release"]),
        ("info malformed", "flag_policies { flag_name: ", ["info", "release"]),
        ("info deprecated set_value", t_deprecated_set, ["info", "release"]),
        ("info deprecated use_default", t_deprecated_default,
         ["info", "--experimental_skyframe_prepare_analysis", "release"]),
        ("info strategy policy", t_strategy, ["info", "release"]),
        ("build throw", t_throw, ["build", "--jobs=3", "//:brotli"]),
        ("build allow_values error base64", b_allow_err, ["build", "//:brotli"]),
        ("build malformed base64 proto", "AAAA", ["build", "//:brotli"]),
        ("build set_value nobuild", 'flag_policies { flag_name: "build" set_value { '
         'flag_value: "false" behavior: FINAL_VALUE_IGNORE_OVERRIDES } }', ["build", "//:brotli"]),
        ("version use_default", t_use_default, ["version"]),
    ]
    for name, policy, argv in startup:
        cases.append(Case("startup policy " + name, argv, cwd="brotli",
                          startup=["--invocation_policy=" + policy]))
    return cases


RULES = [r for r in cc.VOLATILE_RULES if r.name in ("progress", "elapsed", "critical_path",
                                                    "jvm_warning", "download_temp")] + [
    cc.Rule("install_md5", r"/install/[0-9a-f]{32}/", "the install md5 (name of "
            "<UR>/install/<md5>) is a checksum of the binary's embedded files; Blaze's archive "
            "differs by design (as in scripts/w1/compare-info)", repl="/install/<INSTALL_MD5>/",
            streams=("stdout", "stderr"))]

# Cases whose oracle result measures something other than what the case names (audit round 4,
# C4). The case list's owner repairs them; until then the report says so on their rows.
MEASURES_WRONG_THING = {
    "fetch re2 empty output base": "the oracle fails on `Unknown host: "
                                   "netcologne.dl.sourceforge.net` (libpfm download)",
    "fetch re2 warm": "the oracle fails on `Unknown host: netcologne.dl.sourceforge.net`",
    "fetch re2 --all": "the oracle fails on `Unknown host: netcologne.dl.sourceforge.net`",
    "fetch brotli --force --repo": "`No repository visible as '@platforms'`: it measures the "
                                   "@nosuch error again, not --force",
}


def path_pairs(ctx):
    return [(ctx.get(k), "<%s>" % k.upper()) for k in ("ob", "ws", "ur") if ctx.get(k)]


ENV = {"USER": USER}  # on top of HOME and PATH=/usr/bin:/bin (compare_common.clean_env)


def wrap(binary, root, cwd, startup, argv):
    """The binary's argv (compare_common.run adds the unit, the supervisor and env -i)."""
    return [binary, "--output_user_root=" + root, "--nohome_rc", "--nosystem_rc"] + \
        list(startup) + list(argv)


def invoke(cmd, cwd, timeout=COMMAND_TIMEOUT):
    r = cc.run(cmd, cwd, env=ENV, timeout=timeout, mode="service", memory_max=MEMORY_MAX,
               tag="cmds")
    return r.out, r.err, r.term, r.duration


def side_work(side):
    return os.path.join(WORK, side)


def case_command(side, binary, case, workspaces):
    """(cwd, argv, ctx) of one case on one side."""
    root = ROOTS[side]
    startup = list(case.startup)
    ctx = {"ur": root}
    if case.cwd == "outside":
        cwd = OUTSIDE
    else:
        cwd = workspaces[case.cwd]
        ctx["ws"] = cwd
    argv = list(case.argv)
    if argv[0] == "fetch":
        ob = os.path.join(side_work(side), "ob-" + case.cwd)
        startup.append("--output_base=" + ob)
        argv.insert(1, "--repository_cache=" + REPO_CACHE)
        ctx["ob"] = ob
    return cwd, wrap(binary, root, cwd, startup, argv), ctx


def oracle_key(case, cwd, cmd, inputs, before):
    """The cache key of the oracle's result of `case` (compare_common.cache_key). The stored
    outputs are raw (normalised when loaded), so this tool's sha256 is not part of it."""
    return cc.cache_key(None, cc.pinned_sha256(), cmd,
                        cc.clean_env(ENV), inputs,
                        extra={"cwd": cwd, "fresh_output_base": case.fresh_output_base,
                               "cases_before": before})


_source_digests = {}


def side_workspaces(side, cases, prepare):
    """{project: (realpath of the work copy, digest of its source)}; prepares the copies when
    asked. The digest is of the read-only corpus checkout the copy is made from (the copy itself
    changes once a command ran in it)."""
    out = {}
    for project in sorted({c.cwd for c in cases if c.cwd != "outside"}):
        ws = os.path.join(side_work(side), project)
        src = os.path.join(oc.CACHE, "corpus", project)
        if prepare:
            record.prepare_workspace(src, ws)
        if project not in _source_digests:
            _source_digests[project] = cc.tree_digest(src)
        out[project] = (os.path.realpath(ws), _source_digests[project])
    return out


RESULT_EXTS = ("out", "err", "rc", "term", "cmd")


def run_side(side, binary, cases, report, blaze=None):
    root = ROOTS[side]
    os.makedirs(OUTSIDE, exist_ok=True)
    sd = os.path.join(RESULTS, side)
    os.makedirs(sd, exist_ok=True)
    # Warm-up: extracts the install base so that no compared case prints "Extracting...".
    _, _, term, _ = invoke(wrap(binary, root, OUTSIDE, [], ["version"]), OUTSIDE)
    report.add_aux("%s warm-up version" % side, term)
    wsd = side_workspaces(side, cases, prepare=True)
    workspaces = {p: v[0] for p, v in wsd.items()}
    install_dir = os.path.join(root, "install")
    installs = sorted(os.listdir(install_dir)) if os.path.isdir(install_dir) else []
    install_md5 = installs[0] if len(installs) == 1 else None
    before = []
    for case in cases:
        cwd, cmd, ctx = case_command(side, binary, case, workspaces)
        ctx["install_md5"] = install_md5
        if case.fresh_output_base and "ob" in ctx and os.path.lexists(ctx["ob"]):
            record.make_writable_and_remove(ctx["ob"])
        base = os.path.join(sd, case.slug)
        meta = base + (".key" if side == "oracle" else ".capture.json")
        cc.invalidate_key(meta)
        out, err, term, dur = invoke(cmd, cwd)
        for ext, data in (("out", out), ("err", err)):
            with open(base + "." + ext, "wb") as f:
                f.write(data)
        with open(base + ".rc", "w") as f:
            f.write("%d\n" % term.exit_code_like())
        with open(base + ".term", "w") as f:
            json.dump(term.to_dict(), f)
        with open(base + ".cmd", "w") as f:
            f.write(json.dumps({"cwd": cwd, "argv": cmd, "env": cc.clean_env(ENV),
                                "ctx": ctx}) + "\n")
        files = [base + "." + ext for ext in RESULT_EXTS]
        if side == "oracle":
            inputs = wsd[case.cwd][1] if case.cwd in wsd else "outside (empty directory)"
            cc.write_key(meta, oracle_key(case, cwd, cmd, inputs, list(before)), files)
        else:
            if os.path.lexists(base + ".key"):
                os.remove(base + ".key")
            cc.write_capture(meta, blaze, files, extra={"case": case.name})
        before.append(case.slug)
        print("[cmds] %s: %-55s %-16s %6.1fs" % (side, case.name[:55], term, dur), flush=True)


def load(side, case):
    base = os.path.join(RESULTS, side, case.slug)
    try:
        with open(base + ".out", "rb") as f:
            out = f.read()
        with open(base + ".err", "rb") as f:
            err = f.read()
        with open(base + ".term") as f:
            term = cc.Termination.from_dict(json.load(f))
        with open(base + ".cmd") as f:
            ctx = json.load(f)["ctx"]
        if not ctx.get("install_md5"):
            install_dir = os.path.join(ctx["ur"], "install")
            installs = sorted(os.listdir(install_dir)) if os.path.isdir(install_dir) else []
            ctx["install_md5"] = installs[0] if len(installs) == 1 else None
    except (OSError, ValueError, KeyError):
        return None
    if term is None:
        return None
    return {"out": out, "err": err, "term": term, "paths": path_pairs(ctx)}


def check_oracle_keys(cases):
    """{case name: reason} for the stored oracle results that this run may not reuse."""
    wsd = side_workspaces("oracle", cases, prepare=False)
    workspaces = {p: v[0] for p, v in wsd.items()}
    stale = {}
    before = []
    for case in cases:
        cwd, cmd, _ = case_command("oracle", ORACLE_BIN, case, workspaces)
        inputs = wsd[case.cwd][1] if case.cwd in wsd else "outside (empty directory)"
        reason = cc.check_key(os.path.join(RESULTS, "oracle", case.slug + ".key"),
                              oracle_key(case, cwd, cmd, inputs, list(before)))
        if reason:
            stale[case.name] = reason
        before.append(case.slug)
    return stale


# Cases whose declared failure is a crash: everything after the line below is the crash's stack
# trace, Java frames on the oracle's side and a Rust panic with its backtrace on Blaze's, which no
# port can print alike (audit round 4, C2). The trace is a gap: compared separately, a difference
# there makes the case KNOWN-GAP, never IDENTICAL; the lines up to and including the FATAL line
# are compared as usual.
CRASH_TRACE = "FATAL: bazel crashed due to an internal error. Printing stack trace:"
CRASH_TRACE_GAP = {
    "canonicalize-flags outside workspace": "the oracle prints the JVM's NullPointerException "
                                            "trace (SkyframeExecutor.preparePackageLoading), "
                                            "Blaze a Rust panic and backtrace",
}


def split_trace(err):
    """(stderr up to and including the crash line, the trace after it)."""
    text = err.decode("latin-1") if isinstance(err, bytes) else err
    i = text.find(CRASH_TRACE)
    if i < 0:
        return text, ""
    j = i + len(CRASH_TRACE) + 1
    return text[:j], text[j:]


def judge_case(norm, case, o, b):
    """(class, detail, differing streams) of one case from the loaded results."""
    differing, gaps = [], []
    for s, stream in (("out", "stdout"), ("err", "stderr")):
        ot, bt = o[s], b[s]
        if s == "err" and case.name in CRASH_TRACE_GAP:
            (ot, otrace), (bt, btrace) = split_trace(ot), split_trace(bt)
            if otrace != btrace:
                gaps.append("crash_trace (%s)" % CRASH_TRACE_GAP[case.name])
        eq, _ = norm.compare(ot, bt, stream, o["paths"], b["paths"])
        if not eq:
            differing.append(s)
    berr = b["err"].decode("latin-1") if isinstance(b["err"], bytes) else b["err"]
    m = re.search(r"blaze: not ported yet: ([^\n]*)", berr)
    cls, detail = cc.judge(o["term"], b["term"], ["std" + s for s in differing],
                           declared_exit=case.expect_exit,
                           blaze_unported=m.group(1)[:100] if m else None, gaps=gaps)
    return cls, detail, differing


def compare(norm, cases, diff_lines, report, stale=None, blaze=None, check_blaze=False):
    stale = stale or {}
    for case in cases:
        if case.name in stale:
            report.add(case.name, cc.SKIPPED, "stale oracle result: " + stale[case.name])
            continue
        if check_blaze:
            why = cc.check_capture(os.path.join(RESULTS, "blaze", case.slug + ".capture.json"),
                                   blaze)
            if why:
                report.add(case.name, cc.SKIPPED, "stored Blaze result: " + why)
                continue
        o = load("oracle", case)
        b = load("blaze", case)
        if o is None or b is None:
            report.add(case.name, cc.SKIPPED, "no %s result with a recorded termination" % (
                "oracle" if o is None else "blaze"))
            continue
        cls, detail, differing = judge_case(norm, case, o, b)
        if case.name in MEASURES_WRONG_THING:
            detail += "; measures the wrong thing: " + MEASURES_WRONG_THING[case.name]
        report.add(case.name, cls, detail)
        if cls == cc.DIFFERENT and diff_lines:
            for s in ("out", "err"):
                if s in differing:
                    stream = "stdout" if s == "out" else "stderr"
                    ot = norm.apply(o[s], "oracle", stream, o["paths"]).text
                    bt = norm.apply(b[s], "blaze", stream, b["paths"]).text
                    d = list(difflib.unified_diff(
                        ot.splitlines(), bt.splitlines(), "oracle." + s, "blaze." + s,
                        lineterm="", n=1))
                    print("--- %s: %s" % (case.name, s))
                    for line in d[:diff_lines]:
                        print("    " + line[:200])
                    if len(d) > diff_lines:
                        print("    ... (%d more diff lines)" % (len(d) - diff_lines))


def main(argv):
    if argv and argv[0] in ("help", "--help", "-h"):
        print(USAGE, end="")
        return 0
    if argv and argv[0] == "selftest":
        return selftest()
    ap = argparse.ArgumentParser(usage=USAGE, add_help=False)
    ap.add_argument("--side", default="both", choices=["oracle", "blaze", "both"])
    ap.add_argument("--case")
    ap.add_argument("--blaze", default=DEFAULT_BLAZE)
    ap.add_argument("--diff-lines", type=int, default=40)
    ap.add_argument("--json")
    ap.add_argument("--list", action="store_true")
    try:
        args = ap.parse_args(argv)
    except SystemExit:
        return 2
    cases = build_cases()
    if args.case:
        cases = [c for c in cases if re.search(args.case, c.name)]
    if args.list:
        for c in cases:
            print(c.name)
        return 0
    if not cases:
        return cc.empty_selection_error("cmds/compare")
    if shutil.which("systemd-run") is None:
        oc.die("systemd-run not found")
    try:
        oracle_path, oracle_sha = cc.require_oracle(ORACLE_BIN)
        blaze = cc.blaze_identity(os.path.realpath(args.blaze))
    except cc.Refusal as e:
        return cc.refuse("cmds/compare", e)
    report = cc.Report("cmds/compare", blaze=blaze,
                       oracle={"path": oracle_path, "sha256": oracle_sha},
                       selection="%d cases%s, side %s" % (
                           len(cases), " matching %r" % args.case if args.case else "",
                           args.side), tool_files=[os.path.abspath(__file__)],
                       compared="termination, the whole stdout and the whole stderr after the "
                                "exclusion rules listed at the end")
    norm = cc.Normaliser(RULES, path_reason="each side's output user root, workspace copy and "
                         "output base")
    report.add_normaliser(norm)
    for name, why in MEASURES_WRONG_THING.items():
        if any(c.name == name for c in cases):
            report.note("%s measures the wrong thing: %s" % (name, why))
    report.print_header()
    if args.side in ("oracle", "both"):
        run_side("oracle", ORACLE_BIN, cases, report)
    stale = check_oracle_keys(cases)
    if args.side in ("blaze", "both"):
        if stale and args.side == "blaze":
            for name, reason in sorted(stale.items())[:5]:
                print("refused: %s: %s" % (name, reason), file=sys.stderr)
            return cc.refuse("cmds/compare", "%d stored oracle results are stale or unkeyed; "
                             "run with --side both" % len(stale))
        run_side("blaze", blaze["realpath"], cases, report, blaze)
    compare(norm, cases, args.diff_lines, report, stale, blaze,
            check_blaze=args.side == "oracle")
    print()
    report.print_header()
    report.print_rows()
    print()
    report.print_footer()
    if args.json:
        report.write_json(args.json)
    return report.exit_code()


def selftest():
    def argv(blaze, label):
        return ["--case", "^help$", "--blaze", blaze, "--diff-lines", "0"]

    def extra(st, fh, run):
        # C2: the crash case differs only in its stack trace: KNOWN-GAP, not DIFFERENT.
        fatal = CRASH_TRACE.encode() + b"\n"
        o, b = fh.fakes(dict(err=fatal + b"java.lang.NullPointerException\n\tat a.B(B.java:1)\n",
                             code=37),
                        dict(err=fatal + b"thread 'main' panicked at x.rs:1:1\n", code=37))
        rc, rep, log = run(["--case", "^canonicalize-flags outside workspace$", "--blaze", b,
                            "--diff-lines", "0"])
        cl = [r["class"] for r in (rep or {}).get("cases", [])]
        st.check("C2: a crash differing only in its trace is KNOWN-GAP", rc == 1
                 and cl == [cc.KNOWN_GAP], "exit %s, %s" % (rc, cl))
        o, b = fh.fakes(dict(err=fatal + b"trace\n", code=37),
                        dict(err=b"ERROR: other\n" + fatal + b"trace\n", code=37))
        rc, rep, log = run(["--case", "^canonicalize-flags outside workspace$", "--blaze", b,
                            "--diff-lines", "0"])
        cl = [r["class"] for r in (rep or {}).get("cases", [])]
        st.check("C2: a difference before the crash line stays DIFFERENT", cl == [cc.DIFFERENT],
                 "exit %s, %s" % (rc, cl))
        # M7: the fetch cases (warm and empty output base) through the real command line.
        o, b = fh.fakes(dict(out=b"x\n"), dict(out=b"x\n"))
        rc, rep, log = run(["--case", "^fetch brotli (warm|empty output base)$", "--blaze", b,
                            "--diff-lines", "0"])
        cl = [r["class"] for r in (rep or {}).get("cases", [])]
        st.check("M7: fetch cases run through the launcher", rc == 0 and cl == [cc.IDENTICAL] * 2,
                 "exit %s, %s" % (rc, cl))

    return cc.selftest_tool(
        "cmds/compare", os.path.abspath(__file__), argv, extra=extra,
        empty=lambda b, l: ["--case", "^no case has this name$", "--blaze", b],
        reuse=lambda b, l: argv(b, l) + ["--side", "blaze"],
        oracle_outputs=lambda home, l: [os.path.join(home, ".cache", "blaze", "work", "cmds",
                                                     "results", "oracle", "help.out")],
        stored=lambda b, l: argv(b, l) + ["--side", "oracle"])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
