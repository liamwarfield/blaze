class Case:
    def __init__(self, name, argv, cwd="outside", startup=(), fresh_output_base=False):
        self.name = name
        self.argv = list(argv)
        self.cwd = cwd  # "outside" or a project name
        self.startup = list(startup)
        self.fresh_output_base = fresh_output_base
        self.expect_exit = DECLARED_EXIT.get(name)

    @property
    def slug(self):
        return re.sub(r"[^A-Za-z0-9_.=-]+", "_", self.name)


