def load_result(project, side, case, meta):
    base = os.path.join(side_dir(project, side), case.slug)
    if not os.path.isfile(base + ".rc"):
        return None
    with open(base + ".out", "rb") as f:
        out = f.read().decode("utf-8", "surrogateescape")
    with open(base + ".err", "rb") as f:
        err = f.read().decode("utf-8", "surrogateescape")
    rc = int(open(base + ".rc").read().strip())
    facts = oc.read_json(base + ".facts.json") if os.path.isfile(base + ".facts.json") else {}
    ctx = {"ur": meta.get("root"), "install_md5": meta.get("install_md5")}
    keys = case.info_keys()
    nout = normalize(out, "out", ctx, keys)
    nerr = normalize(err, "err", ctx, keys)
    for ext, text in ((".norm.out", nout), (".norm.err", nerr)):
        with open(base + ext, "wb") as f:
            f.write(text.encode("utf-8", "surrogateescape"))
    return {"out": nout, "err": nerr, "rc": rc, "facts": facts, "raw_err": err}


def load_meta(project, side):
    p = os.path.join(side_dir(project, side), "_meta.json")
    return oc.read_json(p) if os.path.isfile(p) else None


UNPORTED_RE = re.compile(r"blaze: not ported yet: ([^\n]*)")
PANIC_RE = re.compile(r"panicked at [^\n]*(?:\n([^\n]*))?")


def first_line(text):
    for line in text.splitlines():
        if line.strip():
            return line.strip()[:110]
    return ""


def is_binary(text):
    return "\x00" in text or sum(1 for ch in text[:4096] if ord(ch) < 9) > 4


def stream_diff(label, a, b):
    if a == b:
        return []
    if is_binary(a) or is_binary(b):
        return ["--- %s: binary output differs (oracle %d chars sha %s, blaze %d chars sha %s)"
                % (label, len(a), hashlib.sha256(a.encode("utf-8", "surrogateescape")).hexdigest()[:12],
                   len(b), hashlib.sha256(b.encode("utf-8", "surrogateescape")).hexdigest()[:12])]
    return list(difflib.unified_diff(a.splitlines(), b.splitlines(), "oracle/" + label,
                                     "blaze/" + label, n=2, lineterm=""))


def parse_info_listing(text):
    """Ordered (key, value) pairs of a `key: value` listing; continuation lines join the value."""
    pairs = []
    for line in text.splitlines():
        m = re.match(r"^([A-Za-z][A-Za-z0-9_.-]*): ?(.*)$", line)
        if m:
            pairs.append([m.group(1), m.group(2)])
        elif pairs:
            pairs[-1][1] += "\n" + line
        else:
            pairs.append(["<unkeyed>", line])
    return [tuple(p) for p in pairs]


def info_subtable(o_out, b_out):
    o = parse_info_listing(o_out)
    b = parse_info_listing(b_out)
    od, bd = dict(o), dict(b)
    rows = []
    for k, v in o:
        if k not in bd:
            rows.append((k, "missing", "blaze lacks key"))
        elif bd[k] == v:
            rows.append((k, "match", ""))
        else:
            rows.append((k, "mismatch", "oracle %r / blaze %r" % (v[:60], bd[k][:60])))
    for k, v in b:
        if k not in od:
            rows.append((k, "extra", "only blaze: %r" % v[:60]))
    common_o = [k for k, _ in o if k in bd]
    common_b = [k for k, _ in b if k in od]
    order = "same" if common_o == common_b else "different"
    return rows, order


def classify(project, case, o, b, mode, diff_lines):
    """Return a result dict for one case."""
    res = {"case": case.name, "slug": case.slug, "argv": case.argv, "startup": case.startup,
           "cwd": case.cwd, "result": None, "detail": "", "diff": []}
    exp = case.expected_rc(project)
    if o is not None:
        res["oracle"] = {"rc": o["rc"], "facts": o["facts"]}
    if b is not None:
        res["blaze"] = {"rc": b["rc"], "facts": b["facts"]}
    if o is None:
        res["result"], res["detail"] = "ORACLE-FAIL", "no stored oracle result (run without --blaze-only)"
        return res
    if exp is not None and o["rc"] != exp:
        res["result"] = "ORACLE-FAIL"
        res["detail"] = "oracle rc %d, expected %d: %s" % (o["rc"], exp, first_line(o["err"]))
        return res
    if mode == "oracle":
        res["result"] = "RECORDED"
        notes = []
        nwarn = len(re.findall(r"(?m)^WARNING: ", o["err"]))
        if nwarn:
            notes.append("%d WARNING" % nwarn)
        if o["facts"].get("lockfile_changed"):
            notes.append("wrote lockfile")
        res["detail"] = "rc %d; %sout: %s" % (
            o["rc"], "".join("[%s] " % n for n in notes),
            first_line(o["out"]) if not is_binary(o["out"]) else "<binary %d chars>" % len(o["out"]))
        return res
    if b is None:
        res["result"], res["detail"] = "BLAZE-CRASH", "no blaze result"
        return res
    m = UNPORTED_RE.search(b["raw_err"])
    if m:
        res["result"], res["detail"] = "BLAZE-UNPORTED", m.group(1).strip()[:110]
        return res
    pm = PANIC_RE.search(b["raw_err"])
    if pm or b["rc"] < 0 or b["rc"] == 101 or b["rc"] >= 128:
        res["result"] = "BLAZE-CRASH"
        res["detail"] = "rc %d: %s" % (b["rc"], (pm.group(1) or pm.group(0)).strip()[:100]
                                       if pm else first_line(b["err"]))
        return res
    diff = []
    parts = []
    if o["rc"] != b["rc"]:
        parts.append("rc %d!=%d" % (o["rc"], b["rc"]))
        diff.append("exit code: oracle %d, blaze %d" % (o["rc"], b["rc"]))
    for label, key in (("stdout", "out"), ("stderr", "err")):
        d = stream_diff(label, o[key], b[key])
        if d:
            parts.append(label)
            diff += d
    # The lockfile hash is cumulative state: once an unported case (module resolution) wrote it
    # on the oracle side, every later case would differ. Compare only whether this case wrote it.
    of = {k: v for k, v in o["facts"].items() if k not in UNCOMPARED_FACTS}
    bf = {k: v for k, v in b["facts"].items() if k not in UNCOMPARED_FACTS}
    if of != bf:
        parts.append("facts")
        for k in sorted(set(of) | set(bf)):
            if o["facts"].get(k) != b["facts"].get(k):
                diff.append("fact %s: oracle %r, blaze %r" % (k, o["facts"].get(k), b["facts"].get(k)))
    if case.info == "full":
        rows, order = info_subtable(o["out"], b["out"])
        res["info_keys"] = [{"key": k, "status": s, "detail": d} for k, s, d in rows]
        res["info_key_order"] = order
        if order != "same":
            parts.append("key order")
    if not parts:
        res["result"] = "MATCH"
        return res
    res["result"] = "MISMATCH"
    res["detail"] = ", ".join(parts)
    if len(diff) > diff_lines:
        diff = diff[:diff_lines] + ["... (%d more diff lines)" % (len(diff) - diff_lines)]
    res["diff"] = diff
    return res


