# ------------------------------------------------------------------------------------------------
# Normalisation. Applied identically to both sides, then the results are compared exactly.
# kind "literal": replace the side's own value (from the side's _meta.json) by the placeholder.
# kind "regex":   re.sub(pattern, repl) on the named streams.
# kind "single":  for `info <key>` with exactly one volatile key, mask every non-empty stdout line.
# Every rule says why erasing the difference is legitimate.
# ------------------------------------------------------------------------------------------------
VOLATILE_INFO_KEYS = [
    "server_pid", "used-heap-size", "used-heap-size-after-gc", "committed-heap-size",
    "max-heap-size", "gc-time", "gc-count", "peak-heap-size",
]

NORMALIZATION_RULES = [
    {"name": "output_user_root", "kind": "literal", "ctx": "ur", "repl": "<UR>",
     "streams": ("out", "err"),
     "why": "Each side runs with its own --output_user_root (so they cannot share servers or "
            "install bases); the root is an input of the run, not behaviour."},
    {"name": "install_md5", "kind": "literal", "ctx": "install_md5", "repl": "<INSTALL_MD5>",
     "streams": ("out", "err"),
     "why": "The install md5 is a checksum of the binary's embedded files; Blaze's archive is a "
            "different binary, so the value differs by design. Taken from each side's own "
            "`info install_md5` (or its single install/ directory)."},
    {"name": "jvm_warning", "kind": "regex",
     "pattern": r"(?m)^OpenJDK 64-Bit Server VM warning: [^\n]*\n", "repl": "",
     "streams": ("err",),
     "why": "Printed by the JVM itself (batch mode inherits the JVM's stderr), not by Bazel "
            "code; Blaze has no JVM."},
    {"name": "info_volatile_lines", "kind": "regex",
     "pattern": r"(?m)^(" + "|".join(re.escape(k) for k in VOLATILE_INFO_KEYS) + r"): .*$",
     "repl": r"\1: <VOLATILE>", "streams": ("out",),
     "why": "Process id, JVM heap and GC numbers change on every run (fresh server each time) "
            "and have no Rust equivalent that could match byte for byte."},
    {"name": "info_volatile_single", "kind": "single", "keys": VOLATILE_INFO_KEYS,
     "repl": "<VOLATILE>", "streams": ("out",),
     "why": "Same values as info_volatile_lines, printed without the `key: ` prefix when a "
            "single key is requested."},
    {"name": "server_log_name", "kind": "regex",
     "pattern": r"java\.log\.([^./\s]+)\.([^./\s]+)\.log\.java\.\d{8}-\d{6}\.\d+",
     "repl": r"java.log.\1.\2.log.java.<YYYYMMDD-HHMMSS>.<PID>", "streams": ("out", "err"),
     "why": "The server log name embeds the server start time and pid; host and user stay."},
    {"name": "client_log_time", "kind": "regex",
     "pattern": r"\[(FATAL|ERROR|WARNING|INFO) \d\d:\d\d:\d\d\.\d{3}", "repl": r"[\1 <TIME>",
     "streams": ("out", "err"),
     "why": "The C++ client prefixes its log lines with the wall-clock time."},
    {"name": "execroot_tmp", "kind": "regex",
     "pattern": r"execroot_tmp_\d+_[0-9a-fA-F-]{36}", "repl": "execroot_tmp_<PID>_<UUID>",
     "streams": ("out", "err"),
     "why": "Temporary directory named after the server pid and a random UUID (clean)."},
    {"name": "client_timings", "kind": "regex",
     "pattern": r"--(startup_time|extract_data_time|command_wait_time|connect_timeout_secs)=\d+",
     "repl": r"--\1=<N>", "streams": ("out", "err"),
     "why": "Client-measured durations passed to the server (wall-clock)."},
    {"name": "invocation_id", "kind": "regex",
     "pattern": r"(Invocation ID: )[0-9a-fA-F-]{36}", "repl": r"\1<UUID>",
     "streams": ("out", "err"),
     "why": "A random UUID per command."},
]


def normalize(text, stream, ctx, info_keys=None):
    """Normalise one stream ('out' or 'err') of one case. ctx: {'ur':..., 'install_md5':...}."""
    for rule in NORMALIZATION_RULES:
        if stream not in rule["streams"]:
            continue
        kind = rule["kind"]
        if kind == "literal":
            value = ctx.get(rule["ctx"])
            if value:
                text = text.replace(value, rule["repl"])
        elif kind == "regex":
            text = re.sub(rule["pattern"], rule["repl"], text)
        elif kind == "single":
            if info_keys and len(info_keys) == 1 and info_keys[0] in rule["keys"]:
                text = re.sub(r"(?m)^.+$", rule["repl"], text)
        else:
            raise ValueError("unknown rule kind " + kind)
    return text


