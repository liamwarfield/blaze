# Running.
# ------------------------------------------------------------------------------------------------
def wrap(binary, root, cwd, startup, argv):
    return [
        "systemd-run", "--user", "--collect", "--wait", "--pipe", "-q",
        "-p", "MemoryMax=" + MEMORY_MAX, "-p", "MemorySwapMax=0",
        "--working-directory=" + cwd,
        "env", "-i", "HOME=" + HOME, "PATH=/usr/bin:/bin", "USER=" + USER,
        binary, "--output_user_root=" + root, "--nohome_rc", "--nosystem_rc",
    ] + list(startup) + list(argv)


def invoke(cmd, timeout=COMMAND_TIMEOUT):
    t0 = time.monotonic()
    try:
        p = subprocess.run(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                           stderr=subprocess.PIPE, timeout=timeout)
        out, err, rc = p.stdout, p.stderr, p.returncode
    except subprocess.TimeoutExpired as e:
        out, err, rc = e.stdout or b"", (e.stderr or b"") + b"\n[compare-info] timed out\n", -9
    return out, err, rc, time.monotonic() - t0


def reset_root(side, binary, root, workspaces):
    if not os.path.isdir(root):
        return
    if os.access(binary, os.X_OK):
        for ws in workspaces:
            if os.path.isdir(ws):
                invoke(wrap(binary, root, ws, [], ["shutdown"]), timeout=120)
    record.make_writable_and_remove(root)
    if os.path.lexists(root):
        oc.die("could not remove %s root %s" % (side, root))


def probe_info_keys():
    """Run the oracle's `help info-keys` with a throwaway root and store the key list."""
    os.makedirs(OUTSIDE, exist_ok=True)
    record.make_writable_and_remove(PROBE_ROOT)
    out, err, rc, _ = invoke(wrap(ORACLE_BIN, PROBE_ROOT, OUTSIDE, [], ["help", "info-keys"]))
    record.make_writable_and_remove(PROBE_ROOT)
    keys = parse_info_keys_help(out.decode("utf-8", "replace")) if rc == 0 else []
    if not keys:
        print("[w1] warning: oracle `help info-keys` failed (rc %d); using fallback keys" % rc)
        return
    os.makedirs(RESULTS, exist_ok=True)
    oc.write_json(os.path.join(RESULTS, "info-keys.json"), {"keys": keys})
    missing = [k for k in FALLBACK_INFO_KEYS if k not in keys]
    extra = [k for k in keys if k not in FALLBACK_INFO_KEYS]
    if missing or extra:
        print("[w1] note: help info-keys vs fallback: missing %s, extra %s" % (missing, extra))


# Facts recorded for reading but not compared (see classify).
UNCOMPARED_FACTS = {"MODULE.bazel.lock"}


def lockfile_fact(ws):
    p = os.path.join(ws, "MODULE.bazel.lock")
    if not os.path.isfile(p):
        return "absent"
    return "sha256:" + oc.sha256_file(p)[:16]


def side_dir(project, side):
    return os.path.join(RESULTS, project, side)


def find_install_md5(root, stdout_bytes):
    v = (stdout_bytes or b"").decode("utf-8", "replace").strip()
    if re.fullmatch(r"[0-9a-f]{32}", v):
        return v
    d = os.path.join(root, "install")
    if os.path.isdir(d):
        subs = sorted(x for x in os.listdir(d) if os.path.isdir(os.path.join(d, x)))
        if len(subs) == 1:
            return subs[0]
    return None


def run_side(project, side, binary, cases, args):
    checkout = os.path.join(oc.CACHE, "corpus", project)
    ws = os.path.join(W1, project)
    root = ROOTS[side]
    print("[w1] %s/%s: preparing workspace %s" % (project, side, ws), flush=True)
    os.makedirs(OUTSIDE, exist_ok=True)
    for name in os.listdir(OUTSIDE):
        record.make_writable_and_remove(os.path.join(OUTSIDE, name))
    fixed = record.prepare_workspace(checkout, ws)
    for f in fixed:
        print("[w1]   workspace fix: " + f)
    ws = os.path.realpath(ws)
    if not args.keep_roots:
        print("[w1] %s/%s: wiping output user root %s" % (project, side, root), flush=True)
        reset_root(side, binary, root, [os.path.join(W1, p) for p in PROJECTS] + [OUTSIDE])
    sd = side_dir(project, side)
    record.make_writable_and_remove(sd)
    os.makedirs(sd)
    sc = {"ws": ws, "root": root}
    install_md5_out = None
    order = []
    prev_lock = lockfile_fact(ws)
    for case in cases:
        cwd = ws if case.cwd == "ws" else OUTSIDE
        cmd = wrap(binary, root, cwd, case.startup, case.argv)
        out, err, rc, dur = invoke(cmd)
        lock = lockfile_fact(ws)
        facts = {"MODULE.bazel.lock": lock, "lockfile_changed": lock != prev_lock}
        prev_lock = lock
        if case.facts:
            facts.update(case.facts(sc))
        base = os.path.join(sd, case.slug)
        with open(base + ".out", "wb") as f:
            f.write(out)
        with open(base + ".err", "wb") as f:
            f.write(err)
        with open(base + ".rc", "w") as f:
            f.write("%d\n" % rc)
        with open(base + ".cmd", "w") as f:
            f.write(json.dumps({"cwd": cwd, "argv": cmd}) + "\n")
        oc.write_json(base + ".facts.json", facts)
        order.append(case.name)
        if case.argv == ["info", "install_md5"] and case.cwd == "ws" and rc == 0:
            install_md5_out = out
        print("[w1] %s/%s: %-55s rc=%-3d %5.1fs" % (project, side, case.name[:55], rc, dur),
              flush=True)
    meta = {
        "project": project, "side": side, "binary": binary, "root": root, "workspace": ws,
        "install_md5": find_install_md5(root, install_md5_out),
        "case_order": order, "roots_wiped": not args.keep_roots,
        "created": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "workspace_fixups": fixed,
    }
    try:
        meta["binary_sha256"] = oc.sha256_file(binary)
    except OSError:
        meta["binary_sha256"] = None
    oc.write_json(os.path.join(sd, "_meta.json"), meta)
    return meta


