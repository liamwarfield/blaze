class Case:
    def __init__(self, name, argv, startup=(), cwd="ws", expect=0, facts=None, info=None):
        self.name = name
        self.argv = list(argv)
        self.startup = list(startup)
        self.cwd = cwd
        self.expect = expect
        self.facts = facts
        self.info = info

    @property
    def slug(self):
        slug = re.sub(r"[^A-Za-z0-9_.=+-]+", "_", self.name).strip("_").lstrip("-")
        return slug[:120]

    def expected_rc(self, project):
        if isinstance(self.expect, dict):
            return self.expect.get(project)
        return self.expect

    def info_keys(self):
        """The info keys requested (non-flag arguments after `info`)."""
        if not self.argv or self.argv[0] != "info":
            return None
        return [a for a in self.argv[1:] if not a.startswith("-")]


def output_base_of(side_ctx):
    ws = os.path.realpath(side_ctx["ws"])
    return os.path.join(side_ctx["root"], hashlib.md5(ws.encode()).hexdigest())


def facts_after_clean(sc):
    ob = output_base_of(sc)
    return {"output_base_exists": os.path.isdir(ob),
            "execroot_exists": os.path.lexists(os.path.join(ob, "execroot"))}


def facts_after_expunge(sc):
    return {"output_base_exists": os.path.lexists(output_base_of(sc))}


def build_cases(info_keys):
    linux_rc = {"re2": 0, "brotli": 2}  # brotli has no .bazelrc, so --config=linux is undefined
    cases = [
        Case("version", ["version"]),
        Case("version --gnu_format", ["version", "--gnu_format"]),
    ]
    for key in info_keys:
        cases.append(Case("info " + key, ["info", key]))
    cases += [
        Case("info", ["info"], info="full"),
        Case("info --show_make_env", ["info", "--show_make_env"], info="full"),
        Case("info release output_base", ["info", "release", "output_base"]),
        # errors
        Case("info nosuchkey", ["info", "nosuchkey"], expect=2),
        Case("info --nosuchflag release", ["info", "--nosuchflag", "release"], expect=2),
        Case("info --config=nonexistent release", ["info", "--config=nonexistent", "release"],
             expect=2),
        # rc handling
        Case("info --announce_rc release", ["info", "--announce_rc", "release"]),
        Case("version --announce_rc", ["version", "--announce_rc"]),
        Case("info --announce_rc --config=linux release",
             ["info", "--announce_rc", "--config=linux", "release"], expect=linux_rc),
        Case("rc-file: info release", ["info", "release"],
             startup=["--bazelrc=" + RC_FILE]),
        Case("rc-file: info --config=foo release",
             ["info", "--config=foo", "release"], startup=["--bazelrc=" + RC_FILE]),
        # canonicalize-flags
        Case("canonicalize-flags build --config=linux --cxxopt=-O2 -c opt",
             ["canonicalize-flags", "--for_command=build", "--", "--config=linux",
              "--cxxopt=-O2", "-c", "opt"]),  # configs are not expanded: rc 0 on brotli too
        Case("canonicalize-flags test --test_output=errors",
             ["canonicalize-flags", "--for_command=test", "--", "--test_output=errors"]),
        # help
        Case("help", ["help"]),
        Case("help info-keys", ["help", "info-keys"]),
        # outside any workspace
        Case("outside: info release", ["info", "release"], cwd="outside", expect=2),
        Case("outside: version", ["version"], cwd="outside"),
        Case("outside: shutdown", ["shutdown"], cwd="outside"),
        # startup option errors
        Case("startup --nosuchstartup version", ["version"], startup=["--nosuchstartup"],
             expect=2),
        # destructive cases last
        Case("clean", ["clean"], facts=facts_after_clean),
        Case("clean --expunge", ["clean", "--expunge"], facts=facts_after_expunge),
        Case("shutdown", ["shutdown"]),
    ]
    names = [c.name for c in cases]
    assert len(names) == len(set(names)), "duplicate case names"
    return cases


def load_info_keys():
    path = os.path.join(RESULTS, "info-keys.json")
    try:
        help_keys = oc.read_json(path)["keys"]
        # Keep the familiar order of the full `info` listing for known keys, then any new ones.
        keys = [k for k in FALLBACK_INFO_KEYS if k in help_keys]
        keys += [k for k in help_keys if k not in keys]
        if keys:
            return keys, "oracle `help info-keys` (" + path + ")"
    except (OSError, ValueError, KeyError):
        pass
    return list(FALLBACK_INFO_KEYS), "built-in fallback list"


def parse_info_keys_help(text):
    keys = []
    for line in text.splitlines():
        m = re.match(r"^([A-Za-z][A-Za-z0-9_-]*)\s{2,}\S|^([A-Za-z][A-Za-z0-9_-]*) \S", line)
        if m:
            keys.append(m.group(1) or m.group(2))
    return keys


