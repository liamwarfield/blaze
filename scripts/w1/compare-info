# Reporting.
# ------------------------------------------------------------------------------------------------
def print_project(project, results):
    print()
    print("=" * 100)
    print("project %s" % project)
    print("=" * 100)
    for r in results:
        if r["diff"]:
            print("\n--- %s: %s (%s)" % (r["case"], r["result"], r["detail"]))
            for line in r["diff"]:
                print("    " + line)
        if r.get("info_keys"):
            bad = [x for x in r["info_keys"] if x["status"] != "match"]
            print("\n--- %s: per-key (%d keys, %d not matching, key order %s)"
                  % (r["case"], len(r["info_keys"]), len(bad), r["info_key_order"]))
            if bad or r["info_key_order"] != "same":
                for x in r["info_keys"]:
                    print("    %-28s %-9s %s" % (x["key"], x["status"], x["detail"]))
    print()
    w = max([len(r["case"]) for r in results] + [4])
    w = min(w, 60)
    print("%-*s | %-14s | %s" % (w, "case", "result", "detail"))
    print("-" * w + "-+-" + "-" * 14 + "-+-" + "-" * 40)
    for r in results:
        print("%-*s | %-14s | %s" % (w, r["case"][:w], r["result"], r["detail"]))


def totals(results):
    t = {}
    for r in results:
        t[r["result"]] = t.get(r["result"], 0) + 1
    return t


# ------------------------------------------------------------------------------------------------
# Self-test of the normaliser and parsers.
# ------------------------------------------------------------------------------------------------
def selftest():
    ok = True

    def check(name, got, want):
        nonlocal ok
        if got != want:
            ok = False
            print("FAIL %s\n  got:  %r\n  want: %r" % (name, got, want))
        else:
            print("ok   %s" % name)

    ctx_o = {"ur": "/h/.cache/blaze/oracle-out/ur-w1", "install_md5": "58cf1ecbff441bac762b0050d6da21e9"}
    ctx_b = {"ur": "/h/.cache/blaze/work/w1/blaze-ur", "install_md5": "0123456789abcdef0123456789abcdef"}
    o = ("install_base: /h/.cache/blaze/oracle-out/ur-w1/install/58cf1ecbff441bac762b0050d6da21e9\n"
         "server_pid: 2207636\nused-heap-size: 41MB\nused-heap-size-after-gc: 30MB\n"
         "server_log: /h/.cache/blaze/oracle-out/ur-w1/8f50/java.log.fedora.liam.log.java.20261117-234100.2207636\n"
         "release: release 9.3.2\n")
    b = ("install_base: /h/.cache/blaze/work/w1/blaze-ur/install/0123456789abcdef0123456789abcdef\n"
         "server_pid: 99\nused-heap-size: 0MB\nused-heap-size-after-gc: 1MB\n"
         "server_log: /h/.cache/blaze/work/w1/blaze-ur/8f50/java.log.fedora.liam.log.java.20261118-000000.99\n"
         "release: release 9.3.2\n")
    no, nb = normalize(o, "out", ctx_o, []), normalize(b, "out", ctx_b, [])
    check("full listing equal after normalisation", no, nb)
    check("install base placeholder", no.splitlines()[0], "install_base: <UR>/install/<INSTALL_MD5>")
    check("server_log mask", no.splitlines()[4],
          "server_log: <UR>/8f50/java.log.fedora.liam.log.java.<YYYYMMDD-HHMMSS>.<PID>")
    check("heap key prefix not confused", no.splitlines()[2:4],
          ["used-heap-size: <VOLATILE>", "used-heap-size-after-gc: <VOLATILE>"])
    check("single volatile key", normalize("2207636\n", "out", ctx_o, ["server_pid"]), "<VOLATILE>\n")
    check("single non-volatile key untouched", normalize("9.3.2\n", "out", ctx_o, ["release"]), "9.3.2\n")
    check("two keys not single-masked",
          normalize("release: 9.3.2\nserver_pid: 5\n", "out", ctx_o, ["release", "server_pid"]),
          "release: 9.3.2\nserver_pid: <VOLATILE>\n")
    check("fatal timestamp",
          normalize("[FATAL 23:41:00.123 src/main/cpp/x.cc:1] Unknown startup option\n", "err", ctx_o),
          "[FATAL <TIME> src/main/cpp/x.cc:1] Unknown startup option\n")
    check("jvm warning dropped",
          normalize("OpenJDK 64-Bit Server VM warning: Options -Xverify:none deprecated.\nINFO: x\n",
                    "err", ctx_o), "INFO: x\n")
    check("jvm warning only on stderr",
          normalize("OpenJDK 64-Bit Server VM warning: y\n", "out", ctx_o),
          "OpenJDK 64-Bit Server VM warning: y\n")
    check("execroot_tmp",
          normalize("execroot_tmp_1234_0a1b2c3d-0000-1111-2222-333344445555/x", "err", ctx_o),
          "execroot_tmp_<PID>_<UUID>/x")
    check("startup_time", normalize("--startup_time=123 --client_cwd=/x", "err", ctx_o),
          "--startup_time=<N> --client_cwd=/x")
    check("workspace path kept",
          normalize("workspace: /h/.cache/blaze/work/w1/re2\n", "out", ctx_o, ["workspace"]),
          "workspace: /h/.cache/blaze/work/w1/re2\n")
    check("parse help info-keys",
          parse_info_keys_help("bazel-bin               Configuration dependent\n"
                               "used-heap-size-after-gc The amount\nrelease                 x\n"),
          ["bazel-bin", "used-heap-size-after-gc", "release"])
    check("parse listing continuation",
          parse_info_listing("a: 1\nb: x\n  y\nc: \n"), [("a", "1"), ("b", "x\n  y"), ("c", "")])
    rows, order = info_subtable("a: 1\nb: 2\nc: 3\n", "b: 2\na: 9\nd: 4\n")
    check("subtable rows", rows, [("a", "mismatch", "oracle '1' / blaze '9'"), ("b", "match", ""),
                                  ("c", "missing", "blaze lacks key"), ("d", "extra", "only blaze: '4'")])
    check("subtable order", order, "different")
    c = Case("info --config=x release", ["info", "--config=x", "release"])
    check("case info keys", c.info_keys(), ["release"])
    check("case slug", Case("outside: info release", []).slug, "outside_info_release")
    # classification
    def res(out="x\n", err="Starting\n", rc=0, facts=None, raw_err=None):
        return {"out": out, "err": err, "rc": rc, "facts": facts or {},
                "raw_err": err if raw_err is None else raw_err}
    c = Case("info release", ["info", "release"])
    check("classify match", classify("re2", c, res(), res(), "compare", 60)["result"], "MATCH")
    r = classify("re2", c, res(), res(err="Starting\nWARNING: z\n", rc=2), "compare", 60)
    check("classify mismatch", (r["result"], r["detail"]), ("MISMATCH", "rc 0!=2, stderr"))
    r = classify("re2", c, res(), res(rc=101, err="thread 'main' panicked at src/x.rs:1:2:\n"
                                       "blaze: not ported yet: InfoCommand.exec\n"), "compare", 60)
    check("classify unported", (r["result"], r["detail"]), ("BLAZE-UNPORTED", "InfoCommand.exec"))
    r = classify("re2", c, res(), res(rc=101, err="thread 'main' panicked at src/x.rs:1:2:\n"
                                       "index out of bounds\n"), "compare", 60)
    check("classify crash", (r["result"], r["detail"]), ("BLAZE-CRASH", "rc 101: index out of bounds"))
    check("classify signal", classify("re2", c, res(), res(rc=-11), "compare", 60)["result"],
          "BLAZE-CRASH")
    check("classify oracle fail", classify("re2", c, res(rc=1), res(), "compare", 60)["result"],
          "ORACLE-FAIL")
    r = classify("re2", Case("clean", ["clean"]), res(facts={"execroot_exists": True}),
                 res(facts={"execroot_exists": False}), "compare", 60)
    check("classify facts", (r["result"], r["detail"]), ("MISMATCH", "facts"))
    for r in NORMALIZATION_RULES:
        if not r.get("why"):
            ok = False
            print("FAIL rule %s has no justification" % r["name"])
    print("selftest: %s" % ("PASS" if ok else "FAIL"))
    return 0 if ok else 1


# ------------------------------------------------------------------------------------------------
def main():
    argv = sys.argv[1:]
    if argv and argv[0] in ("help", "-h", "--help"):
        print(USAGE)
        return 0
    if argv and argv[0] == "selftest":
        return selftest()
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--project", default="all")
    ap.add_argument("--case")
    ap.add_argument("--oracle-only", action="store_true")
    ap.add_argument("--blaze-only", action="store_true")
    ap.add_argument("--blaze", default=DEFAULT_BLAZE)
    ap.add_argument("--keep-roots", action="store_true")
    ap.add_argument("--json")
    ap.add_argument("--diff-lines", type=int, default=60)
    ap.add_argument("--list", action="store_true")
    try:
        args = ap.parse_args(argv)
    except SystemExit:
        print(USAGE, file=sys.stderr)
        return 2
    if args.oracle_only and args.blaze_only:
        oc.die("--oracle-only and --blaze-only exclude each other")
    projects = PROJECTS if args.project == "all" else [args.project]
    for p in projects:
        if p not in PROJECTS:
            oc.die("unknown project %r (have: %s)" % (p, ", ".join(PROJECTS)))
    run_oracle = not args.blaze_only
    run_blaze = not args.oracle_only
    blaze = os.path.abspath(os.path.expanduser(args.blaze))
    if run_oracle and not os.access(ORACLE_BIN, os.X_OK):
        oc.die("oracle binary not executable: " + ORACLE_BIN)
    if run_blaze and not os.access(blaze, os.X_OK) and not args.list:
        oc.die("blaze binary not executable: %s (build it, pass --blaze, or use --oracle-only)" % blaze)
    if shutil.which("systemd-run") is None:
        oc.die("systemd-run not found")

    os.makedirs(RC_DIR, exist_ok=True)
    with open(RC_FILE, "w") as f:
        f.write(RC_CONTENT)
    if run_oracle and not args.list:
        probe_info_keys()
    keys, keys_src = load_info_keys()
    cases = build_cases(keys)
    if args.case:
        rx = re.compile(args.case)
        cases = [c for c in cases if rx.search(c.name)]
    if args.list:
        print("info keys from: " + keys_src)
        for c in cases:
            print("  %-60s cwd=%-7s expect=%s" % (c.name, c.cwd, c.expect))
        return 0
    if not cases:
        oc.die("no case matches --case %r" % args.case)
    print("[w1] %d cases; info keys from %s" % (len(cases), keys_src), flush=True)

    mode = "oracle" if args.oracle_only else "compare"
    report = {"mode": mode, "blaze": blaze if run_blaze else None, "oracle": ORACLE_BIN,
              "projects": {}, "totals": {}}
    all_results = []
    for project in projects:
        if run_oracle:
            run_side(project, "oracle", ORACLE_BIN, cases, args)
        if run_blaze:
            run_side(project, "blaze", blaze, cases, args)
        ometa = load_meta(project, "oracle")
        bmeta = load_meta(project, "blaze") if run_blaze else None
        if ometa and bmeta and args.blaze_only:
            sel = [c.name for c in cases]
            if ometa.get("case_order") != sel or ometa.get("roots_wiped") != bmeta.get("roots_wiped"):
                print("[w1] warning: stored oracle run used a different case sequence or root "
                      "policy; order-dependent output (Extracting..., lockfile) may differ")
        results = []
        for case in cases:
            o = load_result(project, "oracle", case, ometa) if ometa else None
            b = load_result(project, "blaze", case, bmeta) if bmeta else None
            results.append(classify(project, case, o, b, mode, args.diff_lines))
        print_project(project, results)
        t = totals(results)
        print("\n%s totals: %s" % (project, ", ".join("%s %d" % kv for kv in sorted(t.items()))))
        report["projects"][project] = {"results": results, "totals": t,
                                       "oracle_meta": ometa, "blaze_meta": bmeta}
        all_results += results
    t = totals(all_results)
    report["totals"] = t
    print("\nall totals: %s" % ", ".join("%s %d" % kv for kv in sorted(t.items())))
    if args.json:
        oc.write_json(os.path.abspath(args.json), report)
    good = "RECORDED" if mode == "oracle" else "MATCH"
    return 0 if all(r["result"] == good for r in all_results) else 1


if __name__ == "__main__":
    sys.exit(main())
