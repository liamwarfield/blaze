def clean_env():
    return {"HOME": HOME, "PATH": "/usr/bin:/bin"}


def make_writable_and_remove(path):
    if not os.path.lexists(path):
        return
    subprocess.run(["chmod", "-R", "u+w", path], stderr=subprocess.DEVNULL)
    shutil.rmtree(path, ignore_errors=True)
    if os.path.lexists(path):
        subprocess.run(["rm", "-rf", path])


def kill_servers(root):
    if not os.path.isdir(root):
        return
    for name in os.listdir(root):
        pidfile = os.path.join(root, name, "server", "server.pid.txt")
        try:
            pid = int(open(pidfile).read().strip())
        except (OSError, ValueError):
            continue
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            continue
        for _ in range(100):
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                break
            time.sleep(0.1)


def prepare_workspace(checkout, ws):
    """Copy the checkout to ws, restore it to the checkout's git HEAD, add the probe package."""
    os.makedirs(ws, exist_ok=True)
    subprocess.run(
        ["rsync", "-a", "--delete", "--delete-excluded", "--exclude=/bazel-*", "--exclude=/.git",
         checkout.rstrip("/") + "/", ws + "/"], check=True)
    st = subprocess.run(
        ["git", "--no-optional-locks", "-C", checkout, "status", "--porcelain=v1", "-z",
         "--ignored", "--untracked-files=all"], check=True, stdout=subprocess.PIPE).stdout.decode()
    for entry in st.split("\0"):
        if len(entry) < 4:
            continue
        code, path = entry[:2], entry[3:]
        if path.startswith("bazel-") and "/" not in path.rstrip("/"):
            continue
        dest = os.path.join(ws, path)
        if code in ("??", "!!"):
            if os.path.isdir(dest) and not os.path.islink(dest):
                shutil.rmtree(dest)
            elif os.path.lexists(dest):
                os.remove(dest)
        else:
            blob = subprocess.run(["git", "-C", checkout, "show", "HEAD:" + path],
                                  stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            if blob.returncode == 0:
                os.makedirs(os.path.dirname(dest), exist_ok=True)
                with open(dest, "wb") as f:
                    f.write(blob.stdout)
    shutil.copytree(PROBE_DIR, os.path.join(ws, "blaze_tests_probe"))


def side_dirs(side):
    return (os.path.join(CACHE, "work", "tests-compare", side, PROJECT),
            os.path.join(CACHE, "oracle-out", "tests-compare-" + side))


def path_pairs(side):
    ws, root = side_dirs(side)
    return [(os.path.join(root, hashlib.md5(ws.encode()).hexdigest()), "<OUTPUT_BASE>"),
            (root, "<OUTPUT_USER_ROOT>"), (ws, "<WORKSPACE>")]


def test_results(bep_path):
    """The testResult events of a build event JSON file, in stream order."""
    out = []
    if not os.path.isfile(bep_path):
        return out
    for line in open(bep_path, encoding="utf-8", errors="replace"):
        line = line.strip()
        if not line:
            continue
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        tid = ev.get("id", {}).get("testResult")
        if tid is None:
            continue
        status = ev.get("testResult", {}).get("status", "?")
        out.append([tid.get("label"), tid.get("run", 0), tid.get("shard", 0),
                    tid.get("attempt", 0), status])
    return out


def prepare_side(side):
    """Fresh work copy and output base; returns (ws, root)."""
    ws, root = side_dirs(side)
    kill_servers(root)
    make_writable_and_remove(ws)
    make_writable_and_remove(os.path.join(root, hashlib.md5(ws.encode()).hexdigest()))
    prepare_workspace(os.path.join(CORPUS, PROJECT), ws)
    return ws, root


def case_argv(startup, command, bep, args):
    return startup + [command, "--repository_cache=" + REPO_CACHE, "--color=no",
                      "--curses=no", "--build_event_json_file=" + bep] + args


def oracle_key(cases, out_dir):
    root = os.path.join(CACHE, "oracle-out", "tests-compare-oracle")
    startup = [cc.PINNED_ORACLE, "--output_user_root=" + root, "--nohome_rc", "--nosystem_rc"]
    return cc.cache_key(
        None, cc.pinned_sha256(),
        [case_argv(startup, c[2], os.path.join(out_dir, c[0] + ".bep.json"), c[3])
         for c in cases], clean_env(),
        {"re2": cc.tree_digest(os.path.join(CORPUS, PROJECT)), "probe": cc.tree_digest(PROBE_DIR)},
        extra={"cases": [[c[0], c[4]] for c in cases]})


def case_files(out_dir, cases):
    return [os.path.join(out_dir, c[0] + ext) for c in cases
            for ext in (".stdout", ".stderr", ".json", ".bep.json")]


def run_side(side, binary, cases, out_dir, report):
    ws, root = prepare_side(side)
    os.makedirs(out_dir, exist_ok=True)
    startup = [binary, "--output_user_root=" + root, "--nohome_rc", "--nosystem_rc"]
    for (cid, _desc, command, args, ordered) in cases:
        report.add_aux("%s clean before %s" % (side, cid), cc.run(
            startup + ["clean"], ws, timeout=TIMEOUT, mode="scope", tag="tests-clean").term)
        bep = os.path.join(out_dir, cid + ".bep.json")
        if os.path.exists(bep):
            os.remove(bep)
        cmd = case_argv(startup, command, bep, args)
        print("[tests-compare] %s %s" % (side, cid), flush=True)
        r = cc.run(cmd, ws, timeout=TIMEOUT, mode="scope", tag="tests-compare",
                   stdout_path=os.path.join(out_dir, cid + ".stdout"),
                   stderr_path=os.path.join(out_dir, cid + ".stderr"))
        if not os.path.exists(bep):
            open(bep, "w").close()
        ran = test_results(bep)
        with open(os.path.join(out_dir, cid + ".json"), "w") as f:
            json.dump({"argv": cmd, "duration_s": r.duration, "termination": r.term.to_dict(),
                       "ran": ran if ordered else sorted(ran)}, f, indent=1)
        print("[tests-compare]   %s in %.1fs" % (r.term, r.duration), flush=True)
    report.add_aux("%s shutdown" % side, cc.run(
        startup + ["shutdown"], ws, timeout=600, mode="scope", tag="tests-shutdown").term)


def load_case(out_dir, cid):
    try:
        with open(os.path.join(out_dir, cid + ".json")) as f:
            rec = json.load(f)
        with open(os.path.join(out_dir, cid + ".stdout"), "rb") as f:
            rec["stdout"] = f.read()
        with open(os.path.join(out_dir, cid + ".stderr"), "rb") as f:
            rec["stderr"] = f.read()
    except (OSError, ValueError):
        return None
    return rec


def judge(norm, cid, o, b):
    differing, gaps = [], []
    for stream in ("stdout", "stderr"):
        eq, g = norm.compare(o[stream], b[stream], stream, path_pairs("oracle"),
                             path_pairs("blaze"))
        if not eq:
            differing.append(stream)
        gaps += g
    if o.get("ran") != b.get("ran"):
        differing.append("ran (test results)")
    return cc.judge(cc.Termination.from_dict(o.get("termination")),
                    cc.Termination.from_dict(b.get("termination")), differing,
                    declared_exit=DECLARED_EXIT.get(cid),
                    blaze_unported=cc.unported_message(b["stderr"]), gaps=sorted(set(gaps)))


def main(argv):
    if not argv or argv[0] in ("help", "--help", "-h"):
        print(USAGE)
        return 0
    if argv[0] == "selftest":
        return selftest()
    if argv[0] == "list":
        for c in CASES:
            print("%-30s %s" % (c[0], c[1]))
        return 0
    binary, oracle, label, only, skip_oracle, oracle_only = None, ORACLE, "tests-1", [], False, False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--binary":
            binary = os.path.abspath(argv[i + 1]); i += 2
        elif a == "--oracle":
            oracle = os.path.abspath(argv[i + 1]); i += 2
        elif a == "--label":
            label = argv[i + 1]; i += 2
        elif a == "--case":
            only.append(argv[i + 1]); i += 2
        elif a == "--skip-oracle":
            skip_oracle = True; i += 1
        elif a == "--oracle-only":
            oracle_only = True; i += 1
        else:
            print("unknown argument: %s\n\n%s" % (a, USAGE), file=sys.stderr)
            return 2
    if binary is None and not oracle_only:
        print(USAGE, file=sys.stderr)
        return 2
    base = os.path.join(CACHE, "tests-compare", label)
    cases = [c for c in CASES if not only or c[0] in only]
    if not cases:
        return cc.empty_selection_error("tests/compare")
    try:
        oracle, oracle_sha = cc.require_oracle(oracle)
        blaze = None if oracle_only else cc.blaze_identity(binary)
    except cc.Refusal as e:
        return cc.refuse("tests/compare", e)
    report = cc.Report("tests/compare", blaze=blaze, oracle={"path": oracle, "sha256": oracle_sha},
                       selection="label %s, %d cases%s%s%s" % (
                           label, len(cases), " (--case %s)" % ",".join(only) if only else "",
                           ", oracle outputs reused" if skip_oracle else "",
                           ", oracle only" if oracle_only else ""),
                       tool_files=[os.path.abspath(__file__)],
                       compared="termination, the whole stdout and stderr after the exclusion "
                                "rules listed at the end, the test results of the BEP")
    norm = cc.Normaliser(RULES)
    report.add_normaliser(norm)
    report.print_header()
    odir, bdir = os.path.join(base, "oracle"), os.path.join(base, "blaze")
    key_path = os.path.join(odir, "oracle.key")
    if skip_oracle:
        try:
            cc.require_fresh(key_path, oracle_key(cases, odir))
        except cc.Refusal as e:
            return cc.refuse("tests/compare", e)
    else:
        cc.invalidate_key(key_path)
        run_side("oracle", oracle, cases, odir, report)
        cc.write_key(key_path, oracle_key(cases, odir), case_files(odir, cases))
    if oracle_only:
        for c in cases:
            o = load_case(odir, c[0])
            report.add(c[0], cc.SKIPPED, "oracle recorded only (%s)" % (
                cc.Termination.from_dict(o["termination"]) if o else "no output"))
        report.print_footer()
        return report.exit_code()
    run_side("blaze", blaze["path"], cases, bdir, report)
    cc.write_capture(os.path.join(bdir, "capture.json"), blaze, case_files(bdir, cases))
    for c in cases:
        o, b = load_case(odir, c[0]), load_case(bdir, c[0])
        if o is None or b is None:
            report.add(c[0], cc.SKIPPED, "no %s output" % ("oracle" if o is None else "blaze"))
            continue
        cls, detail = judge(norm, c[0], o, b)
        report.add(c[0], cls, detail)
    report.write_json(os.path.join(base, "results.json"))
    print()
    report.print_rows()
    report.print_footer()
    print("results: %s" % os.path.join(base, "results.json"))
    return report.exit_code()


def selftest():
    def argv(blaze, label):
        return ["--binary", blaze, "--case", CASES[0][0], "--label", label]

    def extra(st, fh, run):
        fh.fakes(dict(out=b"same\n"), dict(out=b"same\n"))
        rc, rep, log = run(["--oracle-only", "--case", CASES[0][0], "--label",
                            "selftest-oracle-only"])
        st.check("--oracle-only (nothing judged) never exits 0", rc == 1, "exit %s" % rc)

    return cc.selftest_tool(
        "tests/compare", os.path.abspath(__file__), argv,
        empty=lambda b, l: ["--binary", b, "--case", "no-such-case", "--label", l],
        reuse=lambda b, l: argv(b, l) + ["--skip-oracle"],
        oracle_outputs=lambda home, l: [os.path.join(home, ".cache", "blaze", "tests-compare",
                                                     l, "oracle", CASES[0][0] + ".stdout")],
        extra=extra)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
