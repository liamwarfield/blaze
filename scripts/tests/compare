PROGRESS_RE = re.compile(
    r"^(INFO: (Analyzed|Invocation ID|Streaming|Elapsed time|From |Running|Starting clean|"
    r"Reading|Current date|Options provided|Found )|Loading:|Analyzing:|Computing main repo|"
    r"Starting local Bazel server|"
    r"\[[0-9,]+ / [0-9,]+\]|Target //|  bazel-|Aspect |DEBUG: )")
UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")


def summary_lines(stderr):
    out = []
    for line in stderr.splitlines():
        if not line.strip() or PROGRESS_RE.match(line):
            continue
        out.append(line)
    return out


def clean_env():
    return {"HOME": HOME, "PATH": "/usr/bin:/bin"}


def make_writable_and_remove(path):
    if not os.path.lexists(path):
        return
    subprocess.run(["chmod", "-R", "u+w", path], stderr=subprocess.DEVNULL)
    shutil.rmtree(path, ignore_errors=True)
    if os.path.lexists(path):
        subprocess.run(["rm", "-rf", path])


def kill_servers(root):
    if not os.path.isdir(root):
        return
    for name in os.listdir(root):
        pidfile = os.path.join(root, name, "server", "server.pid.txt")
        try:
            pid = int(open(pidfile).read().strip())
        except (OSError, ValueError):
            continue
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            continue
        for _ in range(100):
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                break
            time.sleep(0.1)


def prepare_workspace(checkout, ws):
    """Copy the checkout to ws, restore it to the checkout's git HEAD, add the probe package."""
    os.makedirs(ws, exist_ok=True)
    subprocess.run(
        ["rsync", "-a", "--delete", "--delete-excluded", "--exclude=/bazel-*", "--exclude=/.git",
         checkout.rstrip("/") + "/", ws + "/"], check=True)
    st = subprocess.run(
        ["git", "--no-optional-locks", "-C", checkout, "status", "--porcelain=v1", "-z",
         "--ignored", "--untracked-files=all"], check=True, stdout=subprocess.PIPE).stdout.decode()
    for entry in st.split("\0"):
        if len(entry) < 4:
            continue
        code, path = entry[:2], entry[3:]
        if path.startswith("bazel-") and "/" not in path.rstrip("/"):
            continue
        dest = os.path.join(ws, path)
        if code in ("??", "!!"):
            if os.path.isdir(dest) and not os.path.islink(dest):
                shutil.rmtree(dest)
            elif os.path.lexists(dest):
                os.remove(dest)
        else:
            blob = subprocess.run(["git", "-C", checkout, "show", "HEAD:" + path],
                                  stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            if blob.returncode == 0:
                os.makedirs(os.path.dirname(dest), exist_ok=True)
                with open(dest, "wb") as f:
                    f.write(blob.stdout)
    shutil.copytree(PROBE_DIR, os.path.join(ws, "blaze_tests_probe"))


def normaliser(ws, root):
    output_base_hash = hashlib.md5(ws.encode()).hexdigest()

    def norm(text):
        text = text.replace(os.path.join(root, output_base_hash), "<OUTPUT_BASE>")
        text = text.replace(root, "<OUTPUT_USER_ROOT>")
        text = text.replace(ws, "<WORKSPACE>")
        text = re.sub(r"<OUTPUT_USER_ROOT>/install/[0-9a-f]{32}", "<INSTALL_BASE>", text)
        text = UUID_RE.sub("<UUID>", text)
        text = re.sub(r"\b\d+(\.\d+)?s\b", "<T>s", text)
        text = re.sub(r"\((\d+) ms( total)?\)", lambda m: "(<N> ms%s)" % (m.group(2) or ""), text)
        return text
    return norm


def test_results(bep_path):
    """The testResult events of a build event JSON file, in stream order."""
    out = []
    if not os.path.isfile(bep_path):
        return out
    for line in open(bep_path, encoding="utf-8", errors="replace"):
        line = line.strip()
        if not line:
            continue
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        tid = ev.get("id", {}).get("testResult")
        if tid is None:
            continue
        status = ev.get("testResult", {}).get("status", "?")
        out.append([tid.get("label"), tid.get("run", 0), tid.get("shard", 0),
                    tid.get("attempt", 0), status])
    return out


def prepare_side(side):
    """Fresh work copy and output base; returns (ws, root, tree digest of the work copy)."""
    ws = os.path.join(CACHE, "work", "tests-compare", side, PROJECT)
    root = os.path.join(CACHE, "oracle-out", "tests-compare-" + side)
    kill_servers(root)
    make_writable_and_remove(ws)
    make_writable_and_remove(os.path.join(root, hashlib.md5(ws.encode()).hexdigest()))
    prepare_workspace(os.path.join(CORPUS, PROJECT), ws)
    return ws, root, cc.tree_digest(ws)


def case_argv(startup, command, bep, args):
    return startup + [command, "--repository_cache=" + REPO_CACHE, "--color=no",
                      "--curses=no", "--build_event_json_file=" + bep] + args


def oracle_key(cases, digest, out_dir):
    root = os.path.join(CACHE, "oracle-out", "tests-compare-oracle")
    startup = [cc.PINNED_ORACLE, "--output_user_root=" + root, "--nohome_rc", "--nosystem_rc"]
    return cc.cache_key(
        cc.tool_sha256(os.path.abspath(__file__)), cc.pinned_sha256(),
        [case_argv(startup, c[2], os.path.join(out_dir, c[0] + ".bep.json"), c[3])
         for c in cases], clean_env(), digest, extra={"cases": [[c[0], c[4]] for c in cases]})


def run_side(side, binary, cases, out_dir):
    ws, root, digest = prepare_side(side)
    norm = normaliser(ws, root)
    os.makedirs(out_dir, exist_ok=True)
    startup = [binary, "--output_user_root=" + root, "--nohome_rc", "--nosystem_rc"]
    results = {}
    for (cid, _desc, command, args, ordered) in cases:
        cc.run(startup + ["clean"], ws, timeout=TIMEOUT, mode="scope", tag="tests-clean")
        bep = os.path.join(out_dir, cid + ".bep.json")
        if os.path.exists(bep):
            os.remove(bep)
        cmd = case_argv(startup, command, bep, args)
        print("[tests-compare] %s %s" % (side, cid), flush=True)
        r = cc.run(cmd, ws, timeout=TIMEOUT, mode="scope", tag="tests-compare")
        rc, out, err, dur = r.rc, r.out, r.err, r.duration
        with open(os.path.join(out_dir, cid + ".stdout"), "wb") as f:
            f.write(out)
        with open(os.path.join(out_dir, cid + ".stderr"), "wb") as f:
            f.write(err)
        ran = test_results(bep)
        rec = {
            "argv": cmd, "duration_s": dur,
            "exit": rc,
            "termination": r.term.to_dict(),
            "unported": cc.unported_message(err),
            "summary": summary_lines(norm(err.decode("latin-1"))),
            "found": [l for l in norm(err.decode("latin-1")).splitlines()
                      if l.startswith("INFO: Found ")],
            "ran": ran if ordered else sorted(ran),
            "stdout": norm(out.decode("latin-1")),
        }
        results[cid] = rec
        with open(os.path.join(out_dir, cid + ".norm.json"), "w") as f:
            json.dump(rec, f, indent=1)
        print("[tests-compare]   %s in %.1fs" % (r.term, dur), flush=True)
    cc.run(startup + ["shutdown"], ws, timeout=600, mode="scope", tag="tests-shutdown")
    if side == "oracle":
        cc.write_key(os.path.join(out_dir, "oracle.key"), oracle_key(cases, digest, out_dir))
    return results


def compare(oracle, blaze):
    """MATCH/DIFF per field; `exit` compares the recorded terminations."""
    out = {}
    for f in ("exit", "summary", "found", "ran", "stdout"):
        if f == "exit":
            ot = cc.Termination.from_dict(oracle.get("termination"))
            bt = cc.Termination.from_dict(blaze.get("termination"))
            out[f] = "MATCH" if ot is not None and ot == bt else "DIFF"
        else:
            out[f] = "MATCH" if oracle.get(f) == blaze.get(f) else "DIFF"
    return out


def judge(cid, o, b, cmp_):
    return cc.judge(cc.Termination.from_dict(o.get("termination")),
                    cc.Termination.from_dict(b.get("termination")),
                    [f for f, v in cmp_.items() if v == "DIFF" and f != "exit"],
                    declared_exit=DECLARED_EXIT.get(cid), blaze_unported=b.get("unported"))


def main(argv):
    if not argv or argv[0] in ("help", "--help", "-h"):
        print(USAGE)
        return 0
    if argv[0] == "selftest":
        return selftest()
    if argv[0] == "list":
        for c in CASES:
            print("%-30s %s" % (c[0], c[1]))
        return 0
    binary, oracle, label, only, skip_oracle, oracle_only = None, ORACLE, "tests-1", [], False, False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--binary":
            binary = os.path.abspath(argv[i + 1]); i += 2
        elif a == "--oracle":
            oracle = os.path.abspath(argv[i + 1]); i += 2
        elif a == "--label":
            label = argv[i + 1]; i += 2
        elif a == "--case":
            only.append(argv[i + 1]); i += 2
        elif a == "--skip-oracle":
            skip_oracle = True; i += 1
        elif a == "--oracle-only":
            oracle_only = True; i += 1
        else:
            print("unknown argument: %s\n\n%s" % (a, USAGE), file=sys.stderr)
            return 2
    if binary is None and not oracle_only:
        print(USAGE, file=sys.stderr)
        return 2
    base = os.path.join(CACHE, "tests-compare", label)
    cases = [c for c in CASES if not only or c[0] in only]
    if not cases:
        return cc.empty_selection_error("tests/compare")
    try:
        oracle, oracle_sha = cc.require_oracle(oracle)
        blaze = None if oracle_only else cc.blaze_identity(binary)
    except cc.Refusal as e:
        return cc.refuse("tests/compare", e)
    report = cc.Report("tests/compare", blaze=blaze, oracle={"path": oracle, "sha256": oracle_sha},
                       selection="label %s, %d cases%s" % (
                           label, len(cases), " (--case %s)" % ",".join(only) if only else ""),
                       tool_files=[os.path.abspath(__file__)])
    report.print_header()
    odir = os.path.join(base, "oracle")
    if skip_oracle:
        try:
            cc.require_fresh(os.path.join(odir, "oracle.key"),
                             oracle_key(cases, prepare_side("blaze")[2], odir))
        except cc.Refusal as e:
            return cc.refuse("tests/compare", e)
        ores = {c[0]: json.load(open(os.path.join(odir, c[0] + ".norm.json"))) for c in cases}
    else:
        ores = run_side("oracle", oracle, cases, odir)
    if oracle_only:
        unrecorded = []
        for c in cases:
            t = cc.Termination.from_dict(ores[c[0]].get("termination"))
            if t is None or t.kind in ("unrecorded", "not-run"):
                unrecorded.append(c[0])
            print("| %s | %s |" % (c[0], t))
        print("recorded the oracle only; nothing compared")
        return 1 if unrecorded else 0
    bres = run_side("blaze", blaze["path"], cases, os.path.join(base, "blaze"))
    table = []
    all_results = {}
    for c in cases:
        cmp_ = compare(ores[c[0]], bres[c[0]])
        cls, detail = judge(c[0], ores[c[0]], bres[c[0]], cmp_)
        report.add(c[0], cls, detail)
        table.append((c[0], ores[c[0]], bres[c[0]], cmp_, cls))
        all_results[c[0]] = {"oracle": ores[c[0]], "blaze": bres[c[0]], "compare": cmp_,
                             "class": cls, "detail": detail}
    report.write_json(os.path.join(base, "results.json"), extra={"results": all_results})
    print()
    print("| case | oracle | blaze | exit | summary | found | ran | stdout | class |")
    print("| --- | --- | --- | --- | --- | --- | --- | --- | --- |")
    for cid, o, b, cmp_, cls in table:
        print("| %s | %s | %s | %s | %s | %s | %s | %s | %s |" % (
            cid, cc.Termination.from_dict(o.get("termination")),
            cc.Termination.from_dict(b.get("termination")), cmp_["exit"], cmp_["summary"],
            cmp_["found"], cmp_["ran"], cmp_["stdout"], cls))
    print()
    report.print_rows()
    report.print_footer()
    print("results: %s" % os.path.join(base, "results.json"))
    return report.exit_code()


def selftest():
    def run_pair(ofake, bfake, wd):
        cc.require_oracle(ofake)
        recs = {}
        for side, fake in (("oracle", ofake), ("blaze", bfake)):
            r = cc.run([fake, "test"], wd, mode="scope", tag="selftest")
            norm = normaliser(wd, os.path.join(wd, "ur"))
            e = norm(r.err.decode("latin-1"))
            recs[side] = {"termination": r.term.to_dict(), "unported": cc.unported_message(r.err),
                          "summary": summary_lines(e),
                          "found": [l for l in e.splitlines() if l.startswith("INFO: Found ")],
                          "ran": [], "stdout": norm(r.out.decode("latin-1"))}
        cmp_ = compare(recs["oracle"], recs["blaze"])
        return judge("selftest", recs["oracle"], recs["blaze"], cmp_)

    def empty_selection():
        with open(os.devnull, "w") as null:
            old = sys.stderr
            sys.stderr = null
            try:
                return main(["--binary", "/bin/true", "--case", "no-such-case"])
            finally:
                sys.stderr = old

    def extra(st):
        legacy = {"exit": 0, "summary": [], "found": [], "ran": [], "stdout": ""}
        st.check("a legacy record without termination never matches",
                 compare(legacy, dict(legacy))["exit"] == "DIFF")

    return cc.selftest("tests/compare", run_pair=run_pair, empty_selection=empty_selection,
                       extra=extra, mode="scope")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
