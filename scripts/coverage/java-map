def snake(name):
    """PORTING.md "Names": camelCase -> snake_case."""
    out = []
    for i, c in enumerate(name):
        if c.isupper() and i > 0:
            prev = name[i - 1]
            nxt = name[i + 1] if i + 1 < len(name) else ""
            if prev.islower() or prev.isdigit() or (prev.isupper() and nxt.islower()):
                out.append("_")
        out.append(c.lower())
    return "".join(out)


def java_files(root):
    out = []
    for dp, dns, fns in os.walk(root):
        dns.sort()
        for f in sorted(fns):
            if f.endswith(".java"):
                out.append(os.path.relpath(os.path.join(dp, f), root))
    return sorted(out)


def first_rule(rules, path, stem):
    for r in rules:
        reason, pat = r[0], r[1]
        if re.search(pat, path):
            return r
    return None


def cluster_of(path):
    for name, pats in CLUSTER_RULES:
        for pat in pats:
            if re.search(pat, path):
                return name
    return "other"


def top_package(path):
    parts = path.split("/")
    if path.startswith(L):
        return "lib/" + parts[5] if len(parts) > 6 else "lib/(root)"
    if path.startswith("net/starlark/java/"):
        return "net/starlark/" + (parts[3] if len(parts) > 4 else "(root)")
    if path.startswith("com/google/devtools/common/options/"):
        return "common/options"
    if path.startswith("com/google/devtools/build/skyframe/"):
        return "build/skyframe"
    if path.startswith("com/google/devtools/build/docgen/"):
        return "build/docgen"
    return "/".join(parts[:-1])


