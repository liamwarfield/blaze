def cpp_map(M):
    rows = []
    refs = collections.Counter()
    for mk in M.rust.markers:
        if mk["path"] and mk["path"].startswith("src/main/cpp/"):
            refs[mk["path"][len("src/main/cpp/"):]] += 1
    for dp, dns, fns in os.walk(CPP):
        dns.sort()
        for f in sorted(fns):
            if not f.endswith((".cc", ".h")):
                continue
            rel = os.path.relpath(os.path.join(dp, f), CPP)
            src = open(os.path.join(dp, f), encoding="utf-8", errors="replace").read()
            nc, _ = strip_java(src)
            loc = sum(1 for ln in nc.split("\n") if ln.strip())
            os_only = bool(re.search(r"windows|darwin|bsd|_mac", rel))
            rows.append((rel, loc, refs[rel], os_only))
    return sorted(rows)


def proto_map():
    rows = []
    build_rs = open(f"{CRATES}/blaze_protos/build.rs").read()
    for f in sorted(os.listdir(PROTO)):
        if f.endswith(".proto"):
            loc = sum(1 for ln in open(os.path.join(PROTO, f)) if ln.strip() and not ln.strip().startswith("//"))
            rows.append((f, loc, f"src/main/protobuf/{f}" in build_rs))
    return rows


