class Model:
    pass


def build_model():
    M = Model()
    M.files = java_files(MAIN)
    M.parsed = {}
    for f in M.files:
        M.parsed[f] = parse_java(open(os.path.join(MAIN, f), encoding="utf-8", errors="replace").read())
    M.test_files = java_files(TEST)
    M.test_parsed = {}
    for f in M.test_files:
        M.test_parsed[f] = parse_java(open(os.path.join(TEST, f), encoding="utf-8", errors="replace").read())
    M.rust = scan_rust()

    # indexes
    by_name = collections.defaultdict(set)   # simple file stem -> files
    by_type = collections.defaultdict(set)   # any type simple name -> files
    for f in M.files:
        by_name[os.path.basename(f)[:-5]].add(f)
        for cp, k, a, b in M.parsed[f].types:
            by_type[cp.split(".")[-1]].add(f)
    M.by_name, M.by_type = by_name, by_type
    basename = collections.defaultdict(set)
    for f in M.files:
        basename[os.path.basename(f)].add(f)
    test_set = set(M.test_files)

    # method marks: (file, idx) -> set of kinds ("name","line")
    M.marks = collections.defaultdict(set)
    M.type_marked = set()
    M.file_markers = collections.Counter()
    M.file_marker_crates = collections.defaultdict(collections.Counter)
    M.marker_cat = collections.Counter()
    unresolved = []

    def resolve_member(f, member, jline):
        """Return (category, [method idx]) for a marker into main file f."""
        P = M.parsed[f]
        meths = P.methods
        in_range = None
        if jline is not None:
            cands = [(b - a, i) for i, (cp, nm, a, b, k, t) in enumerate(meths) if a <= jline <= b]
            if cands:
                in_range = min(cands)[1]
        if member:
            mem = re.sub(r"[\[(].*$", "", member).strip(".,;:`")
            comps = [c for c in mem.split(".") if c]
        else:
            comps = []
        if comps:
            last = comps[-1]
            clsc = comps[:-1]
            ctor = last in ("<init>", "new") or (clsc and last == clsc[-1])
            def cpmatch(cp):
                if not clsc:
                    return True
                cps = cp.split(".")
                return cps[-len(clsc):] == clsc or cps[-1] == clsc[-1]
            if ctor:
                named = [i for i, m in enumerate(meths) if m[4] == "ctor" and cpmatch(m[0])]
                if not named and any(cpmatch(cp) for cp, k, a, b in P.types):
                    return "type: implicit constructor (class declares none)", []
            else:
                named = [i for i, m in enumerate(meths) if m[1] == last and cpmatch(m[0])]
                if not named:
                    named = [i for i, m in enumerate(meths) if m[1] == last]
            if named:
                if in_range is not None and in_range in named:
                    return "method: name and line agree", [in_range]
                if jline is None:
                    return "method: by name (no line)", named
                return "method: by name (line elsewhere)", named
            is_type = any(cp.split(".")[-1] == last for cp, k, a, b in P.types)
            if is_type:
                M.type_marked.add((f, last))
            if is_type or (not clsc and last in by_type):
                if in_range is not None:
                    return "type: names a class (line inside a method)", []
                return "type: names a class", []
            if last in P.idents or last in ("<clinit>", "static"):
                if in_range is not None:
                    return "field/other: identifier in file (line inside a method)", [in_range]
                return "field/other: identifier in file", []
            if len(comps) == 1 and last.islower() and last not in P.idents:
                return "file-level: path followed by prose", []
            if in_range is not None:
                return "method: by line only (name not found: renamed or wrong)", [in_range]
            return "UNRESOLVED: name not in file, line not in a method", []
        if in_range is not None:
            return "method: by line (no member named)", [in_range]
        return "file-level: no member, line outside methods", []

    for mk in M.rust.markers:
        path, member, jline = mk["path"], mk["member"], mk["jline"]
        target = None
        if path:
            p = re.sub(r"^.*?src/main/java/", "", path)
            if p.startswith("src/") or path.endswith((".cc", ".h", ".c", ".proto")):
                cat = "non-Java: C++/native/proto source"
                M.marker_cat[cat] += 1
                continue
            p2 = re.sub(r"^.*?src/test/java/", "", path)
            if p in M.parsed:
                target = p
            elif p2 in test_set or p2.endswith("Test.java") and any(t.endswith("/" + os.path.basename(p2)) for t in [p2]):
                cat = "test: names a src/test/java file"
                if p2 not in test_set and not any(t.endswith("/" + os.path.basename(p2)) for t in M.test_files):
                    cat = "UNRESOLVED: test file not found"
                    unresolved.append((mk, cat))
                M.marker_cat[cat] += 1
                continue
            elif "/" not in p and p in basename and len(basename[p]) == 1:
                target = next(iter(basename[p]))
            else:
                suf = [f for f in M.files if f.endswith("/" + p)]
                if len(suf) == 1:
                    target = suf[0]
                else:
                    tsuf = [f for f in M.test_files if f.endswith("/" + p) or f == p]
                    if tsuf:
                        cat = "test: names a src/test/java file"
                    elif not re.match(r"(com/google/devtools/|net/starlark/)", p):
                        cat = "library: JDK, protobuf, gRPC or other non-Bazel source"
                    elif len(basename.get(os.path.basename(p), ())) == 1:
                        target = next(iter(basename[os.path.basename(p)]))
                    else:
                        cat = "UNRESOLVED: Bazel file not found"
                    if target:
                        c2, idxs = resolve_member(target, member, None)
                        cat = "stale path (file moved), by file name: " + c2
                        M.marker_cat[cat] += 1
                        if "UNRESOLVED" in c2:
                            unresolved.append((mk, cat))
                        M.file_markers[target] += 1
                        M.file_marker_crates[target][mk["crate"]] += 1
                        for i in idxs:
                            M.marks[(target, i)].add("name")
                        continue
                    M.marker_cat[cat] += 1
                    if cat.startswith("UNRESOLVED"):
                        unresolved.append((mk, cat))
                    continue
            cat, idxs = resolve_member(target, member, jline)
        else:
            mem = re.sub(r"[\[(].*$", "", member).strip(".,;:`")
            comps = mem.split(".")
            cands = set()
            if comps[0] in by_name:
                cands = set(by_name[comps[0]])
            elif comps[0] in by_type:
                cands = set(by_type[comps[0]])
            if not cands:
                tcand = [t for t in M.test_files if os.path.basename(t)[:-5] == comps[0]]
                cat = "test: names a src/test/java class (no path)" if tcand else "library or prose: no path, not a Bazel class (JDK, Guava, ...)"
                M.marker_cat[cat] += 1
                continue
            res = []
            for f in sorted(cands):
                c, idxs = resolve_member(f, mem, None)
                if not c.startswith("UNRESOLVED"):
                    res.append((f, c, idxs))
            withm = [r for r in res if r[2]]
            if len(withm) == 1:
                target, cat, idxs = withm[0]
                cat = "pathless: " + cat
            elif len(res) >= 1 and not withm:
                target, cat, idxs = res[0][0], "pathless: " + res[0][1], []
                if len(res) > 1:
                    cat = "pathless: ambiguous class, non-method"
            elif len(withm) > 1:
                cat = "pathless: AMBIGUOUS (several files define it)"
                M.marker_cat[cat] += 1
                unresolved.append((mk, cat))
                continue
            else:
                cat = "UNRESOLVED: no path, member not found"
                M.marker_cat[cat] += 1
                unresolved.append((mk, cat))
                continue
        M.marker_cat[cat] += 1
        if cat.startswith("UNRESOLVED"):
            unresolved.append((mk, cat))
        M.file_markers[target] += 1
        M.file_marker_crates[target][mk["crate"]] += 1
        for i in idxs:
            M.marks[(target, i)].add("line" if "line only" in cat or "by line" in cat else "name")
    M.unresolved = unresolved
    ov = collections.Counter((f, M.parsed[f].methods[i][0], M.parsed[f].methods[i][1]) for (f, i) in M.marks)
    allov = collections.Counter((f, m[0], m[1]) for f in M.files for m in M.parsed[f].methods)
    M.overload_name_only = sum(1 for (f, i), k in M.marks.items() if k == {"name"}
                               and allov[(f, M.parsed[f].methods[i][0], M.parsed[f].methods[i][1])] > 1)

    # An abstract method counts as marked when a marked method of the same name exists in a
    # class that directly extends or implements its type (Starlark API interfaces are ported
    # through their implementations).
    implementors = collections.defaultdict(set)   # type simple name -> files
    for f in M.files:
        for t, sups in M.parsed[f].supers.items():
            for sname in sups:
                implementors[sname].add(f)
    marked_names = collections.defaultdict(set)
    for (f, i) in list(M.marks):
        marked_names[f].add(M.parsed[f].methods[i][1])
    M.impl_marked = 0
    # Parameterless abstract accessors of an @AutoValue / @AutoOneOf class or a record whose
    # type is named by a marker count as marked ("type"): they become fields or variants.
    M.auto_marked = 0
    for f in M.files:
        if not any(tf == f for tf, _ in M.type_marked):
            continue
        src = open(os.path.join(MAIN, f), encoding="utf-8", errors="replace").read().split("\n")
        if not re.search(r"@AutoValue|@AutoOneOf|\brecord\s", "\n".join(src)):
            continue
        for i, (cp, nm, a, b, k, t) in enumerate(M.parsed[f].methods):
            if k == "abstract" and (f, i) not in M.marks and (f, cp.split(".")[-1]) in M.type_marked \
                    and re.search(r"\b" + re.escape(nm) + r"\s*\(\s*\)", " ".join(src[a - 1:b])):
                M.marks[(f, i)].add("type")
                M.auto_marked += 1
    for f in M.files:
        meths = M.parsed[f].methods
        for i, (cp, nm, a, b, k, t) in enumerate(meths):
            if k != "abstract" or (f, i) in M.marks:
                continue
            tname = cp.split(".")[-1]
            if any(nm in marked_names[g] for g in implementors.get(tname, ()) if g != f):
                M.marks[(f, i)].add("impl")
                M.impl_marked += 1

    # unported sites, skipped comments, ignore reasons -> files
    def files_for_class_ref(name):
        comps = re.sub(r"[\[(].*$", "", name).split(".")
        c0 = comps[0]
        if c0 in by_name:
            return sorted(by_name[c0])
        if c0 in by_type:
            return sorted(by_type[c0])
        return []

    M.unported_sites = collections.Counter()
    M.unported_unattributed = 0
    M.unported_ambiguous = 0
    M.unported_test = 0
    test_stems = set(os.path.basename(t)[:-5] for t in M.test_files)
    M.unported_unattr_names = collections.Counter()
    for rel, no, cr, name in M.rust.unported:
        fs = files_for_class_ref(name)
        if not fs:
            if re.split(r"[.(\s]", name)[0] in test_stems:
                M.unported_test += 1
            else:
                M.unported_unattributed += 1
                M.unported_unattr_names[name] += 1
            continue
        if len(fs) > 1:
            M.unported_ambiguous += 1
        M.unported_sites[fs[0]] += 1
    M.skipped_sites = collections.Counter()
    M.skip_marked = 0
    M.skipped_reasons = collections.defaultdict(list)
    for rel, no, cr, reason, near, ctx in M.rust.skipped:
        f = None
        if near:
            p = re.sub(r"^.*?src/main/java/", "", near)
            f = p if p in M.parsed else None
        if not f:
            for ident in IDENT_CAMEL.findall(reason):
                if ident in by_name and len(by_name[ident]) == 1:
                    f = next(iter(by_name[ident]))
                    break
        if f:
            M.skipped_sites[f] += 1
            M.skipped_reasons[f].append(reason)
        # `// PORT: skipped, <why>: Class.method` marks that method as handled ("skipped").
        for cm in re.finditer(r"\b([A-Z][\w$]*)\.([a-z][\w$]*)\b", reason):
            for g in by_name.get(cm.group(1), ()):
                for i, m in enumerate(M.parsed[g].methods):
                    if m[1] == cm.group(2) and (g, i) not in M.marks:
                        M.marks[(g, i)].add("skipped")
                        M.skip_marked += 1
    M.ignore_by_class = collections.Counter()
    for rel, no, cr, fn, ign, reason in M.rust.tests:
        if ign and reason:
            for ident in set(IDENT_CAMEL.findall(reason)):
                if ident in by_name and len(by_name[ident]) == 1:
                    M.ignore_by_class[next(iter(by_name[ident]))] += 1

    # per-file classification
    M.rows = {}
    for f in M.files:
        P = M.parsed[f]
        meths = P.methods
        eff = list(range(len(meths)))
        marked = [i for i in eff if (f, i) in M.marks]
        all_marked = sum(1 for i in range(len(meths)) if (f, i) in M.marks)
        touched = M.file_markers[f] > 0 or M.unported_sites[f] > 0 or M.skipped_sites[f] > 0
        if eff:
            ratio = len(marked) / len(eff)
            if ratio > 0.5 and M.unported_sites[f] == 0:
                status = "PORTED"
            elif marked or touched:
                status = "PARTIAL"
            else:
                status = "UNTOUCHED"
        else:
            status = "PORTED" if M.file_markers[f] and not M.unported_sites[f] else ("PARTIAL" if touched else "UNTOUCHED")
        reason, rule = "", ""
        if status != "PORTED":
            r = first_rule(SCOPE_RULES, f, None)
            has_body = any(m[4] != "abstract" for m in meths)
            if r:
                reason, rule = r[0], r[2]
            elif f.endswith("package-info.java"):
                reason, rule = "GENERATED_OR_TRIVIAL", "package-info"
            elif not has_body and P.loc <= TRIVIAL_MAX_LOC:
                reason, rule = "GENERATED_OR_TRIVIAL", f"no method bodies, loc <= {TRIVIAL_MAX_LOC}"
            else:
                reason, rule = "NEEDED", ""
        # code lines inside unmarked methods (outermost ranges), plus the unmarked share of
        # code lines outside any method
        inside = [0] * (len(P.codeline) + 2)
        for i, m in enumerate(meths):
            v = 2 if (f, i) in M.marks else 1
            for ln in range(m[2], m[3] + 1):
                if inside[ln] == 0:
                    inside[ln] = v
        um = sum(1 for ln, c in enumerate(P.codeline, 1) if c and inside[ln] == 1)
        outside = sum(1 for ln, c in enumerate(P.codeline, 1) if c and inside[ln] == 0)
        share = (len(eff) - len(marked)) / len(eff) if eff else 1.0
        unmarked_loc = um + round(outside * share)
        if status == "UNTOUCHED":
            unmarked_loc = P.loc
        M.rows[f] = dict(unmarked_loc=unmarked_loc, path=f, package=P.package, loc=P.loc, methods=len(meths),
                         eff=len(eff), methods_marked=all_marked, eff_marked=len(marked),
                         status=status, reason=reason, rule=rule,
                         unported_sites=M.unported_sites[f], skipped=M.skipped_sites[f],
                         ignored_tests=M.ignore_by_class[f], markers=M.file_markers[f],
                         cluster=cluster_of(f) if reason == "NEEDED" else "",
                         topkg=top_package(f), doc=P.doc)
    # owning crate
    dir_crates = collections.defaultdict(collections.Counter)
    for f in M.files:
        d = os.path.dirname(f)
        for cr, n in M.file_marker_crates[f].items():
            dir_crates[d][cr] += n
    for f in M.files:
        row = M.rows[f]
        if M.file_marker_crates[f]:
            cr = sorted(M.file_marker_crates[f].items(), key=lambda kv: (-kv[1], kv[0]))[0][0]
            basis = "markers"
        else:
            cr, basis = "", ""
            d = os.path.dirname(f)
            hop = 0
            while d:
                if dir_crates[d]:
                    cr = sorted(dir_crates[d].items(), key=lambda kv: (-kv[1], kv[0]))[0][0]
                    basis = "package" if hop == 0 else "ancestor"
                    break
                d = os.path.dirname(d)
                hop += 1
            plan = next((c for pat, c in PLAN_CRATES if re.search(pat, f)), "")
            if basis == "ancestor" and plan:
                cr, basis = plan, "plan"
            if not cr:
                cr, basis = plan or "-", "plan" if plan else "-"
        row["crate"], row["crate_basis"] = cr, basis
    return M


