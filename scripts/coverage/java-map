            buf.write(f"{f}\t{cp}\t{nm}\t{k}\t{a}\t{b}\t{mk}\n")
    with open(f"{out}/java-methods.tsv.gz", "wb") as fh:
        with gzip.GzipFile(filename="java-methods.tsv", mode="wb", fileobj=fh, mtime=0) as gz:
            gz.write(buf.getvalue().encode())
    tests_md, trows = gen_tests(M)
    with open(f"{out}/java-tests.tsv", "w") as fh:
        fh.write("test_class\tproduction_class\tproduction_status\tcrate\ttest_methods\tmatched_in_named_file\tmatched_anywhere\tmatched_all_ignored\n")
        for r in trows:
            fh.write(f'{r["test"]}\t{r["prod"]}\t{r["prod_status"]}\t{r["crate"]}\t{r["tests"]}\t{r["matched"]}\t{r["matched_any"]}\t{r["ignored"]}\n')
    with open(f"{out}/markers-unresolved.tsv", "w") as fh:
        fh.write("category\trust_file\trust_line\tmarker\n")
        for mk, cat in sorted(M.unresolved, key=lambda x: (x[1], x[0]["rs"], x[0]["line"])):
            fh.write(f'{cat}\t{mk["rs"]}\t{mk["line"]}\t{mk["text"][:200]}\n')
    sections = {
        "SOURCE": (f"Rust tree measured: {label}. Java: {SRC.replace(HOME, '~')} (pin in UPSTREAM.json). "
                   f"Generated by `scripts/coverage/java-map build`."),
        "TOTALS": gen_totals(M),
        "MARKERS": gen_markers(M),
        "PACKAGES": gen_packages(M),
        "LARGEST": gen_largest(M),
        "CLUSTERS": gen_clusters(M),
        "TESTS": tests_md,
