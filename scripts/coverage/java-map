MARK_PATH_RE = re.compile(r"Java:\s*`?((?:[\w$-]+/)*[\w$-]+\.(?:java|cc|h|c|proto))`?(?::(\d+)(?:-\d+)?)?(?:\s+`?([\w$.<>\[\]]+))?")
MARK_BARE_RE = re.compile(r"Java:\s*`?([A-Z][\w$]*(?:\.[\w$<>]+)+)")
UNPORTED_RE = re.compile(r'(?:\bunported!\(\s*"|\bunimplemented!\(\s*"Java:\s*)([^"]*)"')
SKIP_RE = re.compile(r"//+\s*PORT:\s*skipped,?\s*(.*)")
IDENT_CAMEL = re.compile(r"\b([A-Z][a-z0-9]+[A-Za-z0-9]*|[A-Z]{2,}[a-z][A-Za-z0-9]*)\b")


def crate_of(path):
    rel = os.path.relpath(path, CRATES)
    return rel.split(os.sep)[0]


def rust_files():
    out = []
    for dp, dns, fns in os.walk(CRATES):
        dns[:] = sorted(d for d in dns if not (d in ("target", "third_party") and dp == CRATES))
        for f in sorted(fns):
            if f.endswith(".rs"):
                out.append(os.path.join(dp, f))
    return out


class RustScan:
    def __init__(self):
        self.markers = []      # dict(rs, line, crate, path, jline, member, text)
        self.unported = []     # (rs, line, crate, name)
        self.skipped = []      # (rs, line, crate, reason, near_marker_path)
        self.tests = []        # (rs, line, crate, fn, ignored, reason)


def scan_rust():
    rs = RustScan()
    for f in rust_files():
        try:
            text = open(f, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        cr = crate_of(f)
        rel = os.path.relpath(f, os.path.dirname(CRATES))
        lines = text.split("\n")
        for m in UNPORTED_RE.finditer(text):
            ls = text.rfind("\n", 0, m.start()) + 1
            prefix = text[ls:m.start()]
            if "//" in prefix and prefix.count('"') % 2 == 0:
                continue
            if "macro_rules!" in text[max(0, m.start() - 300):m.start()] and "$" in m.group(1):
                continue
            rs.unported.append((rel, text.count("\n", 0, m.start()) + 1, cr, m.group(1).strip()))
        last_marker = []   # (line, path)
        attrs = []
        attr_buf = None
        for no, line in enumerate(lines, 1):
            s = line.strip()
            ci = line.find("//")
            if ci >= 0 and "Java:" in line[ci:]:
                com = line[ci:]
                found = False
                for m in MARK_PATH_RE.finditer(com):
                    found = True
                    rs.markers.append(dict(rs=rel, line=no, crate=cr, path=m.group(1),
                                           jline=int(m.group(2)) if m.group(2) else None,
                                           member=m.group(3), text=com.strip()))
                    last_marker.append((no, m.group(1)))
                if not found:
                    for m in MARK_BARE_RE.finditer(com):
                        rs.markers.append(dict(rs=rel, line=no, crate=cr, path=None, jline=None,
                                               member=m.group(1), text=com.strip()))
            sm = SKIP_RE.search(line)
            if sm:
                near = [p for (l, p) in last_marker if no - 6 <= l <= no]
                rs.skipped.append((rel, no, cr, sm.group(1).strip(), near[-1] if near else None, lines[max(0, no - 6):no]))
            # tests
            if attr_buf is not None:
                attr_buf += " " + s
                if attr_balanced(attr_buf):
                    attrs.append(attr_buf)
                    attr_buf = None
                continue
            if s.startswith("#[") or s.startswith("#!["):
                if attr_balanced(s):
                    attrs.append(s)
                else:
                    attr_buf = s
                continue
            fm = re.match(r"(?:pub(?:\([^)]*\))?\s+)?(?:async\s+)?(?:unsafe\s+)?fn\s+(\w+)", s)
            if fm:
                if any(re.match(r"#\[(?:\w+::)*test\b", a) for a in attrs):
                    ign = [a for a in attrs if a.startswith("#[ignore")]
                    reason = None
                    if ign:
                        rm = re.search(r'#\[ignore\s*=\s*"((?:[^"\\]|\\.)*)"', ign[0])
                        reason = rm.group(1) if rm else ""
                    rs.tests.append((rel, no, cr, fm.group(1), bool(ign), reason))
                attrs = []
            elif s and not s.startswith("//"):
                attrs = []
    return rs


def attr_balanced(s):
    d = 0
    instr = False
    i = 0
    while i < len(s):
        c = s[i]
        if instr:
            if c == "\\":
                i += 2
                continue
            if c == '"':
                instr = False
        elif c == '"':
            instr = True
        elif c == "[":
            d += 1
        elif c == "]":
            d -= 1
        i += 1
    return d <= 0 and not instr


