STATUSES = ["PORTED", "PARTIAL", "UNTOUCHED"]
REASONS = ["NEEDED", "GENERATED_OR_TRIVIAL", "TEST_SUPPORT", "JVM_ONLY", "OUT_OF_SCOPE_OS",
           "OUT_OF_SCOPE_BY_CONTRACT", "STARLARK_RUST_DECISION"]


def unported_lines(r):
    """Code lines of a NEEDED file not yet covered: all if UNTOUCHED; if PARTIAL, the code lines
    inside unmarked methods (outermost method wins for nested classes' methods) plus the unmarked
    share of code lines outside methods. An estimate: a marked method may be ported in part."""
    if r["reason"] != "NEEDED":
        return 0
    return r["unmarked_loc"]


def md_table(head, rows):
    out = ["| " + " | ".join(head) + " |", "| " + " | ".join("---" for _ in head) + " |"]
    for r in rows:
        out.append("| " + " | ".join(str(x) for x in r) + " |")
    return "\n".join(out)


def gen_totals(M):
    rows = list(M.rows.values())
    out = []
    t = []
    for s in STATUSES:
        rs = [r for r in rows if r["status"] == s]
        t.append((s, len(rs), sum(r["loc"] for r in rs), sum(r["eff"] for r in rs),
                  sum(r["eff_marked"] for r in rs)))
    t.append(("total", len(rows), sum(r["loc"] for r in rows), sum(r["eff"] for r in rows),
              sum(r["eff_marked"] for r in rows)))
    out.append("By status. Methods include abstract ones. An abstract method also counts as marked when the method of the same name in a direct subtype is marked (impl), or when it is a parameterless accessor of an @AutoValue/@AutoOneOf class whose type a marker names (type).\n")
    out.append(md_table(["status", "files", "lines", "methods", "methods marked"], t))
    t = []
    for rsn in REASONS:
        for s in ("PARTIAL", "UNTOUCHED"):
            rs = [r for r in rows if r["status"] == s and r["reason"] == rsn]
            if rs:
                t.append((rsn, s, len(rs), sum(r["loc"] for r in rs), sum(r["eff"] for r in rs),
                          sum(r["eff"] - r["eff_marked"] for r in rs),
                          sum(unported_lines(r) for r in rs)))
    held = [r for r in rows if r["status"] == "PARTIAL" and r["eff"] and r["eff_marked"] / r["eff"] > 0.5]
    out.append(f"\nOf the PARTIAL files, {len(held)} ({sum(r['loc'] for r in held)} lines) have most methods "
               f"marked and are PARTIAL only because an `unported!` site names their class.\n")
    out.append("\nNot PORTED, by reason:\n")
    out.append(md_table(["reason", "status", "files", "lines", "methods", "methods unmarked",
                         "unported lines (est.)"], t))
    return "\n".join(out)


def gen_packages(M):
    agg = collections.OrderedDict()
    for r in M.rows.values():
        a = agg.setdefault(r["topkg"], collections.Counter())
        a["files"] += 1
        a["loc"] += r["loc"]
        a[r["status"]] += 1
        a["ported_loc"] += r["loc"] if r["status"] == "PORTED" else 0
        a["eff"] += r["eff"]
        a["eff_marked"] += r["eff_marked"]
        if r["reason"] == "NEEDED":
            a["needed_files"] += 1
            a["needed_unported"] += unported_lines(r)
        elif r["reason"]:
            a["oos_loc"] += r["loc"]
        a["unported_sites"] += r["unported_sites"]
    rows = sorted(agg.items(), key=lambda kv: (-kv[1]["needed_unported"], kv[0]))
    t = [(k, a["files"], a["loc"], a["PORTED"], a["PARTIAL"], a["UNTOUCHED"],
          f'{a["eff_marked"]}/{a["eff"]}', a["needed_files"], a["needed_unported"], a["oos_loc"],
          a["unported_sites"]) for k, a in rows]
    return md_table(["package", "files", "lines", "PORTED", "PARTIAL", "UNTOUCHED",
                     "methods marked", "NEEDED files not ported", "NEEDED unported lines (est.)",
                     "lines out of scope", "unported! sites"], t)


def gen_largest(M, n=60):
    rs = [r for r in M.rows.values() if r["reason"] == "NEEDED"]
    rs.sort(key=lambda r: (-unported_lines(r), r["path"]))
    t = []
    for r in rs[:n]:
        t.append((r["path"].replace(L, "lib/"), r["status"], r["loc"],
                  f'{r["eff_marked"]}/{r["eff"]}', r["cluster"], (r["doc"] or "(no class comment)").replace("|", "\\|")))
    return md_table(["file", "status", "lines", "marked", "cluster", "what it does (class comment)"], t)


def cluster_stats(M):
    files = {r["path"]: r for r in M.rows.values() if r["reason"] == "NEEDED"}
    cl = collections.defaultdict(list)
    for f, r in files.items():
        cl[r["cluster"]].append(r)
    # dependencies: imports from files of cluster A to NEEDED-not-ported files of cluster B
    cls_file = {}
    for f in M.files:
        cls_file[f[:-5].replace("/", ".")] = f
    deps = collections.defaultdict(collections.Counter)
    for f, r in files.items():
        for imp in M.parsed[f].imports:
            g = cls_file.get(imp)
            while g is None and "." in imp:
                imp = imp.rsplit(".", 1)[0]
                g = cls_file.get(imp)
            if g and g in files and files[g]["cluster"] != r["cluster"]:
                deps[r["cluster"]][files[g]["cluster"]] += 1
        # same-package references are not imported: count simple-name uses
        pkgdir = os.path.dirname(f)
        idents = M.parsed[f].idents
        for g in M.by_name:
            pass
    for f, r in files.items():
        pkgdir = os.path.dirname(f)
        idents = M.parsed[f].idents
        for g, rg in files.items():
            if g != f and os.path.dirname(g) == pkgdir and rg["cluster"] != r["cluster"] \
                    and os.path.basename(g)[:-5] in idents:
                deps[r["cluster"]][rg["cluster"]] += 1
    return cl, deps


def gen_clusters(M):
    cl, deps = cluster_stats(M)
    order = [c for c, _ in CLUSTER_RULES]
    t = []
    for c in sorted(cl, key=lambda c: -sum(unported_lines(r) for r in cl[c])):
        rs = cl[c]
        d = ", ".join(f"{k} ({v})" for k, v in sorted(deps[c].items(), key=lambda kv: (-kv[1], kv[0]))[:6])
        t.append((c, len(rs), sum(1 for r in rs if r["status"] == "UNTOUCHED"),
                  sum(r["loc"] for r in rs), sum(unported_lines(r) for r in rs),
                  sum(r["eff"] - r["eff_marked"] for r in rs), sum(r["unported_sites"] for r in rs), d or "-"))
    return md_table(["cluster", "NEEDED files not ported", "of them UNTOUCHED", "lines",
                     "unported lines (est.)", "unmarked methods", "unported! sites",
                     "depends on (import edges into other clusters' unported files)"], t)


def gen_markers(M):
    t = sorted(M.marker_cat.items(), key=lambda kv: (kv[0].startswith("UNRESOLVED"), -kv[1], kv[0]))
    tot = sum(M.marker_cat.values())
    rows = [(k, v, f"{100*v/tot:.1f}%") for k, v in t] + [("total", tot, "100%")]
    s = md_table(["marker resolves to", "markers", "share"], rows)
    s += (f"\n\nMethods marked by name only whose name has overloads in the same class (a marker "
          f"without a matching line marks every overload, so some of these may be unported): "
          f"{M.overload_name_only}.")
    s += (f"\n\n`unported!` sites: {len(M.rust.unported)}; attributed to a Java file by class name: "
          f"{len(M.rust.unported) - M.unported_unattributed - M.unported_test} ({M.unported_ambiguous} of them by a class name "
          f"that several files define: first file taken); naming a Java test class: {M.unported_test}; "
          f"not attributable: {M.unported_unattributed}.\n"
          f"`// PORT: skipped` comments: {len(M.rust.skipped)}; attributed to a Java file: "
          f"{sum(M.skipped_sites.values())}.\n")
    return s


def gen_tests(M):
    rows, reasons = test_map(M)
    tot = collections.Counter()
    for r in rows:
        for k in ("tests", "matched", "matched_any", "ignored"):
            tot[k] += r[k]
    rust_total = len(M.rust.tests)
    rust_ign = sum(1 for t in M.rust.tests if t[4])
    s = (f"Java test classes `src/test/java/.../FooTest.java` whose production class `Foo` is PORTED or "
         f"PARTIAL: {len(rows)} (of {sum(1 for t in M.test_files if t.endswith('Test.java'))} `*Test.java` files in "
         f"the pinned source tree).\n\n")
    s += md_table(["", "count"], [
        ("@Test methods in those classes", tot["tests"]),
        ("with a Rust #[test] of the snake_case name in a file named after the class", tot["matched"]),
        ("with a Rust #[test] of that name anywhere in crates/", tot["matched_any"]),
        ("of the matched, every matching Rust test is #[ignore]", tot["ignored"]),
        ("Rust #[test] functions in crates/ (all)", rust_total),
        ("Rust #[test] functions marked #[ignore] (all)", rust_ign),
    ])
    s += "\n\nTop 30 `#[ignore]` reasons among the matched tests:\n\n"
    s += md_table(["reason (first 110 chars)", "tests"],
                  [(k.replace("|", "\\|"), v) for k, v in sorted(reasons.items(), key=lambda kv: (-kv[1], kv[0]))[:30]])
    allr = collections.Counter(norm_reason(t[5]) for t in M.rust.tests if t[4])
    s += "\n\nTop 30 `#[ignore]` reasons over all Rust tests in crates/:\n\n"
    s += md_table(["reason (first 110 chars)", "tests"],
                  [(k.replace("|", "\\|"), v) for k, v in sorted(allr.items(), key=lambda kv: (-kv[1], kv[0]))[:30]])
    return s, rows


def gen_cpp(M):
    rows = cpp_map(M)
    lin = [r for r in rows if not r[3]]
    t = [(r[0], r[1], r[2], "OS-only" if r[3] else "") for r in rows]
    s = (f"C++ client (`src/main/cpp`): {len(rows)} files, {sum(r[1] for r in rows)} lines; "
         f"Linux-relevant {len(lin)} files, {sum(r[1] for r in lin)} lines; named by a marker: "
         f"{sum(1 for r in lin if r[2])} files ({sum(r[1] for r in lin if r[2])} lines).\n\n")
