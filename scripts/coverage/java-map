        "RULES": gen_rules(),
    }
    readme = f"{out}/README.md"
    text = open(readme).read() if os.path.exists(readme) else ""
    for k, v in sections.items():
        b, e = f"<!-- BEGIN GENERATED {k} -->", f"<!-- END GENERATED {k} -->"
        block = f"{b}\n{v}\n{e}"
        if b in text:
            text = re.sub(re.escape(b) + r".*?" + re.escape(e), lambda _: block, text, flags=re.S)
        else:
            text += f"\n\n## {k.title()}\n\n{block}\n"
    with open(readme, "w") as fh:
        fh.write(text)


def gen_rules():
    t = [(r[0], "`" + r[1].replace(L, "lib/").replace("|", "\\|") + "`", r[2]) for r in SCOPE_RULES]
    s = md_table(["reason", "path regex (lib/ = com/google/devtools/build/lib/)", "why"], t)
    s += f"\n\nThen: `package-info.java`, or no method with a body and at most {TRIVIAL_MAX_LOC} lines of code: GENERATED_OR_TRIVIAL. Everything else: NEEDED.\n\nClusters (first match wins):\n\n"
    s += md_table(["cluster", "patterns"], [(c, "<br>".join("`" + p.replace(L, "lib/").replace("|", "\\|") + "`" for p in ps)) for c, ps in CLUSTER_RULES])
    return s


