def find_java():
    if os.environ.get("JAVA"):
        return os.environ["JAVA"]
    best = None
    for d in sorted(os.listdir("/usr/lib/jvm")) if os.path.isdir("/usr/lib/jvm") else []:
        j = f"/usr/lib/jvm/{d}/bin/java"
        mm = re.search(r"(\d+)", d)
        if os.path.exists(j) and mm:
            v = int(mm.group(1))
            if v >= 21 and (best is None or v > best[0]):
                best = (v, j)
    return best[1] if best else "java"


def check_parser(n=None):
    files = java_files(MAIN)
    if n:
        step = max(1, len(files) // n)
        files = files[::step][:n]
    tool = os.path.join(os.path.dirname(os.path.abspath(__file__)), "JavaMethods.java")
    res = subprocess.run([find_java(), tool, MAIN], input="\n".join(files), capture_output=True,
                         text=True, check=True)
    ref = collections.defaultdict(set)
    for ln in res.stdout.splitlines():
        p, cp, nm, a, b, k = ln.split("\t")
        ref[p].add((cp, nm, int(a), int(b)))
    tot_ref = tot_mine = both = name_only = 0
    worst = []
    for f in files:
        P = parse_java(open(os.path.join(MAIN, f), encoding="utf-8", errors="replace").read())
        mine = set((cp, nm, a, b) for cp, nm, a, b, k, t in P.methods)
        r = ref[f]
        tot_ref += len(r)
        tot_mine += len(mine)
        both += len(mine & r)
        mk = collections.Counter((cp, nm) for cp, nm, a, b in mine)
        rk = collections.Counter((cp, nm) for cp, nm, a, b in r)
        name_only += sum((mk & rk).values())
        diff = len(r ^ mine)
        if diff:
            worst.append((diff, f, sorted(r - mine)[:3], sorted(mine - r)[:3]))
    print(f"files: {len(files)}")
    print(f"javac methods: {tot_ref}  java-map methods: {tot_mine}")
    print(f"exact (class, name, start, end) agreement: {both} ({100*both/max(1,tot_ref):.2f}% of javac)")
    print(f"(class, name) agreement ignoring lines: {name_only} ({100*name_only/max(1,tot_ref):.2f}%)")
    print(f"missed by java-map: {tot_ref-name_only}; extra in java-map: {tot_mine-name_only}")
    print(f"files with any difference: {len(worst)}")
    for d, f, a, b in sorted(worst, reverse=True)[:25]:
        print(f"  {d:4d} {f}\n       javac-only {a}\n       java-map-only {b}")


def show_file(path):
    M = build_model() if os.environ.get("JAVA_MAP_MARKS") else None
    root = MAIN if os.path.exists(os.path.join(MAIN, path)) else TEST
    P = parse_java(open(os.path.join(root, path), encoding="utf-8", errors="replace").read())
    print(f"loc {P.loc}  types {len(P.types)}  methods {len(P.methods)}  unknown-blocks {P.unknown}")
    print(f"doc: {P.doc}")
    for t in P.types:
        print("  type", t)
    for i, m in enumerate(P.methods):
        mk = ",".join(sorted(M.marks.get((path, i), ()))) if M else ""
        print("  ", m, mk)


def main(argv):
    if len(argv) < 2 or argv[1] in ("help", "-h", "--help"):
        print(__doc__)
        return 0
    cmd = argv[1]
    global CRATES
    if "--crates" in argv:
        CRATES = os.path.abspath(argv[argv.index("--crates") + 1])
    label = argv[argv.index("--label") + 1] if "--label" in argv else "working tree of " + REPO
    if cmd == "build":
        out = f"{REPO}/docs/coverage"
        if "--out" in argv:
            out = argv[argv.index("--out") + 1]
        M = build_model()
        write_outputs(M, out, label)
        print(gen_totals(M))
        return 0
    if cmd == "summary":
        M = build_model()
        print(gen_totals(M))
        print()
        print(gen_markers(M))
        print(gen_clusters(M))
        return 0
    if cmd == "check-parser":
        check_parser(int(argv[2]) if len(argv) > 2 else None)
        return 0
    if cmd == "file":
        show_file(argv[2])
        return 0
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
