def test_map(M):
    rust_by_name = collections.defaultdict(list)
    for t in M.rust.tests:
        rust_by_name[t[3]].append(t)
    rows = []
    reasons = collections.Counter()
    for tf in M.test_files:
        if not tf.endswith("Test.java"):
            continue
        prod = tf[:-len("Test.java")] + ".java"
        if prod not in M.rows:
            continue
        st = M.rows[prod]["status"]
        if st not in ("PORTED", "PARTIAL"):
            continue
        P = M.test_parsed[tf]
        cls = os.path.basename(tf)[:-5]
        tests = [m for m in P.methods if m[5]]
        cls_snake = snake(cls)
        prod_snake = snake(os.path.basename(prod)[:-5])
        n_strict = n_loose = n_ign = 0
        for cp, nm, a, b, k, _ in tests:
            sn = snake(nm)
            cands = rust_by_name.get(sn, [])
            strict = [c for c in cands if cls_snake in c[0] or prod_snake in c[0]
                      or cls_snake.replace("_test", "") in c[0]]
            pick = strict or cands
            if strict:
                n_strict += 1
            if cands:
                n_loose += 1
            if pick and all(c[4] for c in pick):
                n_ign += 1
                reasons[norm_reason(pick[0][5])] += 1
        rows.append(dict(test=tf, prod=prod, prod_status=st, crate=M.rows[prod]["crate"],
                         tests=len(tests), matched=n_strict, matched_any=n_loose, ignored=n_ign))
    return rows, reasons


def norm_reason(r):
    if r is None:
        return "(no reason)"
    r = re.sub(r"\s+", " ", re.sub(r"\\\s*", " ", r)).strip()
    return r[:110]


