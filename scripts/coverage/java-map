# --------------------------------------------------------------------------------------------
# Java lexing and parsing
# --------------------------------------------------------------------------------------------

def strip_java(src):
    """Return (nocomment, blank): comments -> spaces; in blank also string/char contents."""
    n = len(src)
    nc = list(src)
    bl = list(src)
    i = 0
    while i < n:
        c = src[i]
        if c == "/" and i + 1 < n and src[i + 1] == "/":
            j = src.find("\n", i)
            j = n if j < 0 else j
            for k in range(i, j):
                nc[k] = bl[k] = " "
            i = j
        elif c == "/" and i + 1 < n and src[i + 1] == "*":
            j = src.find("*/", i + 2)
            j = n if j < 0 else j + 2
            for k in range(i, j):
                if src[k] != "\n":
                    nc[k] = bl[k] = " "
            i = j
        elif c == '"' and src.startswith('"""', i):
            j = src.find('"""', i + 3)
            while j > 0 and src[j - 1] == "\\" and src[j - 2] != "\\":
                j = src.find('"""', j + 1)
            j = n if j < 0 else j + 3
            for k in range(i + 3, j - 3):
                if src[k] != "\n":
                    bl[k] = " "
            i = j
        elif c == '"' or c == "'":
            j = i + 1
            while j < n and src[j] != c and src[j] != "\n":
                j += 2 if src[j] == "\\" else 1
            for k in range(i + 1, min(j, n)):
                bl[k] = " "
            i = j + 1
        else:
            i += 1
    return "".join(nc), "".join(bl)


KEYWORDS = {"if", "for", "while", "switch", "catch", "synchronized", "return", "new", "else",
            "try", "do", "throw", "assert", "case", "default", "yield"}
TYPE_RE = re.compile(r"(?:^|[\s;}])(?:@\s*)?\b(class|interface|enum)\s+([A-Za-z_$][\w$]*)")
RECORD_RE = re.compile(r"(?:^|[\s;}])\brecord\s+([A-Za-z_$][\w$]*)\s*(?:<[^()]*>)?\s*\(")
ANNOT_RE = re.compile(r"@\s*(?!interface\b)[\w$]+(?:\s*\.\s*[\w$]+)*")


class Parsed:
    __slots__ = ("codeline", "supers", "methods", "types", "idents", "loc", "lines", "doc", "unknown", "imports",
                 "package")


def remove_annotations(h):
    """Drop `@Name(args)` from a header string (balanced parens)."""
    out = []
    i = 0
    while True:
        m = ANNOT_RE.search(h, i)
        if not m:
            out.append(h[i:])
            break
        out.append(h[i:m.start()])
        j = m.end()
        k = j
        while k < len(h) and h[k].isspace():
            k += 1
        if k < len(h) and h[k] == "(":
            d = 0
            while k < len(h):
                if h[k] == "(":
                    d += 1
                elif h[k] == ")":
                    d -= 1
                    if d == 0:
                        k += 1
                        break
                k += 1
            j = k
        out.append(" ")
        i = j
    return "".join(out)


def parse_java(src):
    nocomment, blank = strip_java(src)
    p = Parsed()
    p.lines = src.count("\n") + 1
    p.codeline = [bool(ln.strip()) for ln in nocomment.split("\n")]
    p.loc = sum(p.codeline)
    p.methods = []   # (classpath, name, start, end, kind, is_test)
    p.types = []     # (classpath, kind, start, end)
    p.unknown = 0
    p.supers = {}
    p.idents = set(re.findall(r"[A-Za-z_$][\w$]*", blank))
    p.imports = re.findall(r"^\s*import\s+(?:static\s+)?([\w.]+)\s*;", blank, re.M)
    pm = re.search(r"^\s*package\s+([\w.]+)\s*;", blank, re.M)
    p.package = pm.group(1) if pm else ""
    m = re.search(r"/\*\*((?:(?!\*/).)*)\*/\s*(?://[^\n]*\n\s*|@[^\n]*\n\s*)*(?:(?:public|final|abstract|sealed|non-sealed)\s+)*(?:class|interface|enum|record|@interface)\s", src, re.S)
    p.doc = clean_doc(m.group(1)) if m else ""
    if not p.doc:
        m = re.search(r"@StarlarkBuiltin\((?:[^()]|\([^()]*\))*?doc\s*=\s*((?:\"(?:[^\"\\]|\\.)*\"\s*\+?\s*)+)", src, re.S)
        if m:
            p.doc = clean_doc("".join(re.findall(r'"((?:[^"\\]|\\.)*)"', m.group(1))))
    if not p.doc:
        m = re.search(r"((?:^\s*//[^\n]*\n)+)\s*(?:@[^\n]*\n\s*)*(?:(?:public|final|abstract|sealed)\s+)*(?:class|interface|enum|record)\s", src, re.M)
        if m and "Copyright" not in m.group(1):
            p.doc = clean_doc(re.sub(r"^\s*//\s?", "", m.group(1), flags=re.M))

    n = len(blank)
    line_at = [0] * (n + 1)
    ln = 1
    for i, ch in enumerate(blank):
        line_at[i] = ln
        if ch == "\n":
            ln += 1
    line_at[n] = ln
    match = {}
    st = []
    for i, ch in enumerate(blank):
        if ch in "({[":
            st.append(i)
        elif ch in ")}]":
            if st:
                match[st.pop()] = i
    def close(i):
        return match.get(i, n - 1)

    def first_nonspace(a, b):
        while a < b and blank[a].isspace():
            a += 1
        return a

    def body(a, b, stack, kind):
        i = a
        if kind == "enum":
            # constants section up to the first ';' at this depth (or end of body)
            while i < b:
                ch = blank[i]
                if ch in "({[":
                    i = close(i) + 1
                    continue
                if ch == ";":
                    i += 1
                    break
                i += 1
        hstart = i
        has_eq = False
        while i < b:
            ch = blank[i]
            if ch == "(" or ch == "[":
                i = close(i) + 1
                continue
            if ch == "=":
                has_eq = True
                i += 1
                continue
            if ch == ";" or ch == "{":
                hs = first_nonspace(hstart, i)
                header = blank[hs:i]
                if ch == "{" and has_eq:
                    i = close(i) + 1
                    continue
                h = " ".join(remove_annotations(header).split())
                if ch == "{":
                    end = close(i)
                    tm = TYPE_RE.search(" " + h)
                    rm = RECORD_RE.search(" " + h)
                    if tm or rm:
                        if tm and (not rm or tm.start() <= rm.start()):
                            k, name = tm.group(1), tm.group(2)
                        else:
                            k, name = "record", rm.group(1)
                        cp = stack + [name]
                        p.types.append((".".join(cp), k, line_at[hs], line_at[end]))
                        sm = re.search(r"\b(?:extends|implements)\b(.*)$", h)
                        if sm:
                            sup = re.sub(r"<[^<>]*>", "", re.sub(r"<[^<>]*>", "", re.sub(r"<[^<>]*>", "", sm.group(1))))
                            p.supers.setdefault(name, set()).update(
                                w for w in re.findall(r"[A-Za-z_$][\w$]*", sup)
                                if w not in ("extends", "implements", "permits"))
                        body(i + 1, end, cp, k)
                    else:
                        meth = method_header(h, stack)
                        if meth:
                            name, mk = meth
                            p.methods.append((".".join(stack), name, line_at[hs], line_at[end],
                                              mk, "@Test" in header.replace(" ", "")))
                        elif h in ("", "static"):
                            pass
                        else:
                            p.unknown += 1
                    i = end + 1
                else:
                    if not has_eq:
                        meth = method_header(h, stack)
                        if meth:
                            name, mk = meth
                            if mk != "ctor":
                                p.methods.append((".".join(stack), name, line_at[hs],
                                                  line_at[i], "abstract", False))
                    i += 1
                hstart = i
                has_eq = False
                continue
            if ch == "}":
                i += 1
                hstart = i
                has_eq = False
                continue
            i += 1

    # top level
    body(0, n, [], "top")
    return p


def method_header(h, stack):
    """If header h (annotations removed) declares a method or constructor, return (name, kind)."""
    if not stack:
        return None
    cls = stack[-1]
    k = h.find("(")
    if k < 0:
        # record compact constructor: `public Foo`
        words = h.split()
        if words and words[-1] == cls and all(w in ("public", "private", "protected") for w in words[:-1]):
            return cls, "ctor"
        return None
    pre = h[:k].rstrip()
    mm = re.search(r"([A-Za-z_$][\w$]*)$", pre)
    if not mm:
        return None
    name = mm.group(1)
    if name in KEYWORDS:
        return None
    # after the parameter list: only `throws ...`, `[]`, `default ...`
    d = 0
    j = k
    while j < len(h):
        if h[j] == "(":
            d += 1
        elif h[j] == ")":
            d -= 1
            if d == 0:
                break
        j += 1
    rest = h[j + 1:].strip()
    if rest and not re.match(r"^(throws\b|default\b|\[\s*\])", rest):
        return None
    before = pre[:mm.start()].strip()
    if re.search(r"[=.]$", before) or "->" in before:
        return None
    if name == cls and not re.search(r"[\w>\]]\s*$", before.replace("public", "").replace("private", "").replace("protected", "").strip() or ""):
        return name, "ctor"
    if not before:
        return (name, "ctor") if name == cls else None
    return name, "method"


def clean_doc(s):
    s = re.sub(r"^\s*\*\s?", "", s, flags=re.M)
    s = re.sub(r"\{@\w+\s+([^}]*)\}", r"\1", s)
    s = re.sub(r"<[^>]+>", "", s)
    s = " ".join(s.split())
    s = re.split(r"(?<=[a-z0-9)`'\"])\.\s", s + " ", maxsplit=1)[0].strip().rstrip(".")
    return s[:200]


