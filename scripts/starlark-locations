#!/usr/bin/env python3
"""Records Bazel 9.3.2's error tracebacks for Starlark snippets. See `starlark-locations help`."""

import os
import re
import shutil
import subprocess
import sys

USAGE = """\
usage: scripts/starlark-locations record [CASEDIR]
       scripts/starlark-locations help

CASEDIR (default crates/blaze_starlark/tests/data/locations) holds NAME.bzl files, each
failing during .bzl initialization. `record` copies every case into its own package of a scratch
workspace (~/.cache/blaze/oracle-out/starlark-locations/ws/NAME/{NAME.bzl,BUILD}, the BUILD file
loads the .bzl), runs the oracle (Bazel 9.3.2) once as
`bazel query --keep_going //...` under systemd-run (MemoryMax=8G), and writes NAME.oracle.txt
next to each case: the `Traceback ...` / `Error...` block Bazel printed for that .bzl, with the
workspace path replaced by `<WS>`. Cases without a traceback get the text `NO ERROR`.

The expected outputs are the oracle's; crates/blaze_starlark/tests/traceback_locations_test.rs compares
blaze_starlark's EvalError rendering with them."""

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
ORACLE = os.path.expanduser("~/.cache/blaze/oracle/bazel-9.3.2-linux-x86_64")
BASE = os.path.expanduser("~/.cache/blaze/oracle-out/starlark-locations")


def record(casedir):
    cases = sorted(f[:-4] for f in os.listdir(casedir) if f.endswith(".bzl"))
    ws = os.path.join(BASE, "ws")
    shutil.rmtree(ws, ignore_errors=True)
    os.makedirs(ws)
    open(os.path.join(ws, "MODULE.bazel"), "w").close()
    for c in cases:
        os.makedirs(os.path.join(ws, c))
        shutil.copy(os.path.join(casedir, c + ".bzl"), os.path.join(ws, c, c + ".bzl"))
        with open(os.path.join(ws, c, "BUILD"), "w") as f:
            f.write('load(":%s.bzl", "nope")\n' % c)
    home = os.path.expanduser("~")
    argv = ["systemd-run", "--user", "--scope", "--collect", "--quiet", "-p", "MemoryMax=8G",
            "-p", "MemorySwapMax=0",
            ORACLE, "--output_user_root=" + os.path.join(BASE, "ur"), "--nohome_rc",
            "--nosystem_rc", "query", "--keep_going", "--color=no", "--curses=no",
            "--repository_cache=" + home + "/.cache/blaze/repo-cache", "//..."]
    env = {"HOME": home, "PATH": "/usr/bin:/bin"}
    for k in ("XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS"):
        if k in os.environ:
            env[k] = os.environ[k]
    p = subprocess.run(argv, cwd=ws, env=env, capture_output=True, text=True)
    err = p.stderr.replace(ws, "<WS>")
    with open(os.path.join(BASE, "stderr.txt"), "w") as f:
        f.write(err)
    # Blocks: "ERROR: Traceback (most recent call last):" ... up to the line starting "Error".
    blocks = {}
    lines = err.split("\n")
    i = 0
    while i < len(lines):
        line = lines[i]
        m = None
        if line.startswith("ERROR: Traceback") or line.startswith("ERROR: <WS>/"):
            start = i
            text = [line[len("ERROR: "):]]
            if line.startswith("ERROR: Traceback"):
                i += 1
                while i < len(lines) and not lines[i].startswith("Error"):
                    text.append(lines[i])
                    i += 1
                if i < len(lines):
                    text.append(lines[i])
            block = "\n".join(text)
            for c in cases:
                if ("<WS>/%s/%s.bzl" % (c, c)) in block:
                    blocks.setdefault(c, block)
                    break
        i += 1
    for c in cases:
        with open(os.path.join(casedir, c + ".oracle.txt"), "w") as f:
            f.write(blocks.get(c, "NO ERROR") + "\n")
    print("recorded %d cases (%d with an error) from %s" % (len(cases), len(blocks), ORACLE))


def main():
    args = sys.argv[1:]
    if not args or args[0] == "help":
        print(USAGE)
        return
    if args[0] == "record":
        casedir = args[1] if len(args) > 1 else os.path.join(
            ROOT, "crates/blaze_starlark/tests/data/locations")
        record(os.path.abspath(casedir))
        return
    print(USAGE)
    sys.exit(2)


if __name__ == "__main__":
    main()
