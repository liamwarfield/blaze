#!/usr/bin/env python3
"""commit-msg hook: write the protected-path approval into the commit message.

When the commit touches a protected path (scripts/gate/protected-paths.txt) and
$BLAZE_PROTECTED_OK approved it, the trailer `Protected-Paths-OK: <text>` is appended, so the
approval is in the history. Without an approval the commit is rejected here too.
`git commit --no-verify` skips both hooks; nobody uses it in this repository.
Usage: scripts/git-hooks/commit-msg <commit message file>
       scripts/git-hooks/commit-msg help
"""
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
sys.path.insert(0, os.path.join(ROOT, "scripts", "gate"))

import protected  # noqa: E402


def main(argv):
    if len(argv) != 1 or argv[0] in ("help", "-h", "--help"):
        print(__doc__)
        return 0 if argv else 2
    try:
        bad = protected.violations(protected.staged_changes(), protected.committed_rules())
    except Exception as e:
        print("commit-msg: cannot check protected paths: %s\nCOMMIT REJECTED." % e, file=sys.stderr)
        return 1
    if not bad:
        return 0
    ok = protected.approval()
    if ok is None:
        print("commit-msg: %d staged changes to protected paths and no approval.\n%s" % (
            len(bad), protected.rule_text()), file=sys.stderr)
        return 1
    with open(argv[0]) as f:
        message = f.read()
    with open(argv[0], "w") as f:
        f.write(protected.add_trailer(message, ok))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
