#!/usr/bin/env python3
"""Scenario probes: run a scratch workspace's command list on the oracle or on Blaze. See `probe help`."""

import difflib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(os.path.dirname(HERE))
SCENARIOS = os.path.join(HERE, "scenarios")
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "oracle"))

USAGE = """\
usage: scripts/w4/probe list
       scripts/w4/probe <oracle|blaze> <scenario> [--only N]   transcript on stdout
       scripts/w4/probe record <scenario>                      oracle transcript -> ORACLE.txt
       scripts/w4/probe compare <scenario> [--only N] [--messages|--masked]
                                                               runs Blaze, compares with ORACLE.txt,
                                                               saves Blaze's transcript (see below)
       scripts/w4/probe compare-all [--messages|--masked] [--skip a,b]
                                                               compare for every recorded scenario
       scripts/w4/probe recount <sha12> [--skip a,b]           the three counts from saved transcripts
                                                               (no run)
       scripts/w4/probe masks                                  prints the masked line classes
       scripts/w4/probe help

A scenario is a directory scripts/w4/scenarios/<name>/ with
  ws/         the workspace (MODULE.bazel, BUILD.bazel files, .bzl files, sources)
  COMMANDS    one step per line (# comments, blank lines ignored), shell-quoted:
                run <command> [args...]   exit code, full stdout, full stderr
                aquery [args...]          `aquery --output=jsonproto --include_param_files
                                          --include_file_write_contents`; one JSON line per action
                                          in output order (ids resolved, scripts/oracle summary),
                                          then the full stderr
                cat <path>                file content, path relative to the workspace
                stat <path>               type and octal mode
  ORACLE.txt  the transcript of the oracle (Bazel 9.3.2), written by `record`; the expected output.

Transcript of a run step:
  === N: <step>
  exit <code>
  --- stdout
  <stdout, normalised>
  --- stderr
  <every stderr line, in order, normalised>

Normalisation (run-specific values only): paths (<WS>, <OUTPUT_BASE>, <OUTPUT_USER_ROOT>, <HOME>),
sandbox numbers, durations (<DUR>), UUIDs, ANSI escapes and carriage-return redraws; dropped
stderr lines are only the rate-limited progress lines whose number and content depend on timing
("Computing main repo mapping:", "Loading:", "Analyzing:", "Fetching ...", "[n / m] ...",
"Building:", "Testing:", blank lines). Action keys of SourceSymlinkManifest and SymlinkTree actions
(they fingerprint absolute paths) are printed as <path-dependent>. Nothing else is dropped, so
a step matches only when exit code, stdout and stderr are identical.

compare prints one line per step (MATCH or DIFF, with a unified diff for each DIFF), then
`probe <scenario>: M of N steps match` and exits 1 when any step differs. Three views are
counted for every step:
  full      the whole normalised transcript of the step.
  masked    the full view with the line classes Blaze cannot match by design replaced on both
            sides (each class is listed by `probe masks`, with the reason; nothing else changes,
            order is kept).
  messages  exit code, stdout, and the complete text (every line, not only the first) of each
            ERROR/WARNING/DEBUG/INFO/FAILED message and build-result line, as a sorted list.
--masked / --messages make compare print the diff of that view (and decide the exit status).
compare-all and recount print, per scenario, the three counts and the totals; compare-all exits 1
on any difference in the chosen view (full by default). The totals are split by step kind: steps
that run the binary (`run`, `aquery`) and file checks (`cat`, `stat`, which read the workspace
after the binary ran), so that a count of identical steps says how many of them ran the binary.
Scenarios left out by --skip, and (recount) scenarios without a saved transcript, are named in the
summary with their oracle step counts: they are not in the denominator.

Every compare saves Blaze's transcript next to ORACLE.txt as BLAZE-<sha12>.txt, where <sha12>
is the first 12 hex digits of the sha256 of the Blaze binary; the file starts with `#` lines
naming the binary, its sha256, the git commit (and whether the tree was dirty) and the date, so
the counts can be re-derived with `probe recount <sha12>` (a run with --only N saves
BLAZE-<sha12>.only-N.txt, which recount ignores).

Each run copies ws/ to ~/.cache/blaze/work/probe-<scenario> (the same path for both binaries, so
do not record and compare one scenario at the same time), uses the output user root
~/.cache/blaze/oracle-out/ur-probe-<scenario>-<oracle|blaze>, startup options --nohome_rc
--nosystem_rc, command options --repository_cache=~/.cache/blaze/repo-cache --color=no --curses=no,
env HOME and PATH=/usr/bin:/bin, each command in a systemd-run scope (MemoryMax=8G), then
`shutdown`. Both the workspace copy and the output user root are deleted first, so every run
starts cold. Environment: BLAZE (binary, default target/debug/blaze).
"""

ORACLE = os.path.expanduser("~/.cache/blaze/oracle/bazel-9.3.2-linux-x86_64")
# Rate-limited progress output: present or absent depending on timing.
PROGRESS = re.compile(
    r"^(Computing main repo mapping:|Loading:|Analyzing:|Fetching |Building:|Testing:|"
    r"\[[\d,]+ / [\d,]+\])"
)
ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
UUID = re.compile(r"\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\b")
# --messages: lines that start a message; following lines that start none of these continue it.
MESSAGE_START = re.compile(r"^(ERROR: |WARNING: |DEBUG: |INFO: |FAILED: |FAIL: |Target |Aspect |"
                           r"Use --verbose_failures |//\S+ +\S|@\S+ +\S|Executed \d|There were tests|"
                           r"Starting local |Extracting |Server terminated|Another command)")
MESSAGE_KEEP = re.compile(r"^(ERROR: |WARNING: |DEBUG: |INFO: |FAILED: |FAIL: |Target |Aspect |"
                          r"Use --verbose_failures |//\S+ +\S|@\S+ +\S|Executed \d|There were tests)")
MESSAGE_DROP = re.compile(r"^INFO: (Elapsed time|Invocation ID|Streaming build results|Build Event Protocol)"
                          r"|discarding analysis cache|^WARNING: Running Bazel server needs to be killed")
# Action keys of these mnemonics fingerprint absolute paths (see scripts/oracle/README.md).
PATH_DEPENDENT_KEYS = {"SourceSymlinkManifest", "SymlinkTree"}

# The masked view (analysis review R3-2): line classes Blaze cannot match by design, each with
# the reason. A stderr line that matches a class completely is replaced by the class's
# placeholder (or dropped when the placeholder is None) in both transcripts; nothing else changes.
MASKS = [
    ("server start",
     re.compile(r"(Extracting Bazel installation\.\.\.|"
                r"Starting local Bazel server \(9\.3\.2\) and connecting to it\.\.\.)"),
     None,
     "Blaze has no persistent server until W8 (decisions.md 2026-11-18): every command starts "
     "one, so the line appears on every step instead of the first."),
    ("critical path",
     re.compile(r"INFO: Elapsed time: <DUR>(, Critical Path: <DUR>)?"),
     "INFO: Elapsed time: <DUR><masked: critical path>",
     "The critical path is not computed (CriticalPathComponent is not ported)."),
    ("warm-server counts",
     re.compile(r"(INFO: Analyzed (target \S+|\d+ targets)) \(\d+ packages? loaded, \d+ targets? "
                r"configured\)\."),
     r"\1 (<masked: warm-server counts>).",
     "Package and configured-target counts of a step depend on what the previous steps left in "
     "the server's graph; Blaze starts cold on every step."),
    ("warm-server analysis cache",
     re.compile(r"WARNING: Build options? .* (has|have) changed, discarding analysis cache \(this "
                r"can be expensive, see https://bazel\.build/advanced/performance/"
                r"iteration-speed\)\."),
     None,
     "Printed when a warm server drops its analysis cache; Blaze has no cache across commands."),
    ("failed-build process count",
     re.compile(r"INFO: (0 processes|1 process: 1 internal)\."),
     "INFO: <masked: process count of a build without spawns>",
     "After a failed analysis Bazel prints `1 process: 1 internal.` where Blaze prints `0 "
     "processes.` (the execution summary; execution owner). Both texts map to one placeholder, "
     "so this view cannot tell them apart."),
]


def die(msg):
    sys.stderr.write("probe: %s\n" % msg)
    sys.exit(2)


class Run:
    def __init__(self, who, scenario):
        self.who = who
        self.dir = os.path.join(SCENARIOS, scenario)
        if not os.path.isdir(os.path.join(self.dir, "ws")):
            die("no scenario %r (see `probe list`)" % scenario)
        self.binary = ORACLE if who == "oracle" else os.environ.get("BLAZE", os.path.join(ROOT, "target/debug/blaze"))
        self.ws = os.path.expanduser("~/.cache/blaze/work/probe-%s" % scenario)
        self.ur = os.path.expanduser("~/.cache/blaze/oracle-out/ur-probe-%s-%s" % (scenario, who))
        self.home = os.path.expanduser("~")

    def prepare(self):
        # A fresh workspace copy and a fresh output user root: action counts and cache hits in the
        # transcript must not depend on earlier runs. (chmod -R does not follow the symlinks it
        # meets while walking, so the convenience symlinks and the execroot are safe.)
        if os.path.isdir(self.ur):
            self.exec("shutdown", [], common=False)
        for path in (self.ws, self.ur):
            if os.path.lexists(path):
                subprocess.run(["chmod", "-R", "u+w", path], check=False)
                shutil.rmtree(path)
        shutil.copytree(os.path.join(self.dir, "ws"), self.ws, symlinks=True)

    def exec(self, command, args, common=True):
        argv = ["systemd-run", "--user", "--scope", "--collect", "--quiet", "-p", "MemoryMax=8G",
                "-p", "MemorySwapMax=0", "env", "-i", "HOME=" + self.home, "PATH=/usr/bin:/bin",
                self.binary, "--output_user_root=" + self.ur, "--nohome_rc", "--nosystem_rc", command]
        if common:
            argv += ["--repository_cache=" + self.home + "/.cache/blaze/repo-cache", "--color=no", "--curses=no"]
        argv += args
        p = subprocess.run(argv, cwd=self.ws, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        return p.returncode, p.stdout.decode("utf-8", "replace"), p.stderr.decode("utf-8", "replace")

    def norm(self, text):
        text = re.sub(re.escape(self.ur) + r"/[0-9a-f]{32}", "<OUTPUT_BASE>", text)
        text = text.replace(self.ur, "<OUTPUT_USER_ROOT>").replace(self.ws, "<WS>").replace(self.home, "<HOME>")
        text = re.sub(r"/sandbox/([a-z-]+)/\d+/", r"/sandbox/\1/<N>/", text)
        text = re.sub(r"\b\d+(\.\d+)?m?s\b", "<DUR>", text)
        text = UUID.sub("<UUID>", text)
        return text

    @staticmethod
    def raw_aquery(stdout):
        """A raw `aquery --output=jsonproto` document: blank the path-dependent action keys."""
        if not stdout.startswith("{"):
            return stdout
        try:
            doc = json.loads(stdout)
        except ValueError:
            return stdout
        if not isinstance(doc.get("actions"), list):
            return stdout
        for a in doc["actions"]:
            if a.get("mnemonic") in PATH_DEPENDENT_KEYS and "actionKey" in a:
                a["actionKey"] = "<path-dependent>"
        return json.dumps(doc, indent=2) + "\n"

    def stderr_lines(self, err):
        out = []
        for raw in err.splitlines():
            line = ANSI.sub("", raw)
            if "\r" in line:
                line = line.split("\r")[-1]
            line = line.rstrip()
            if not line or PROGRESS.match(line):
                continue
            out.append(self.norm(line))
        return out

    def step(self, kind, args, out):
        if kind == "run":
            code, stdout, stderr = self.exec(args[0], args[1:])
            out.append("exit %d" % code)
            out.append("--- stdout")
            stdout = self.norm(self.raw_aquery(stdout))
            if stdout:
                out.append(stdout.rstrip("\n"))
            out.append("--- stderr")
            out.extend(self.stderr_lines(stderr))
        elif kind == "aquery":
            import surfaces  # scripts/oracle
            code, stdout, stderr = self.exec("aquery", ["--output=jsonproto", "--include_param_files",
                                                        "--include_file_write_contents"] + args)
            out.append("exit %d" % code)
            out.append("--- stdout")
            try:
                doc = json.loads(stdout)
            except ValueError:
                doc = None
            if doc is not None:
                for primary, rec in surfaces.aquery_summary(doc).items():
                    if rec.get("mnemonic") in PATH_DEPENDENT_KEYS:
                        rec["actionKey"] = "<path-dependent>"
                    out.append(self.norm(json.dumps({"primaryOutput": primary, **rec}, sort_keys=True)))
            elif stdout:
                out.append(self.norm(stdout).rstrip("\n"))
            out.append("--- stderr")
            out.extend(self.stderr_lines(stderr))
        elif kind == "cat":
            path = os.path.join(self.ws, args[0])
            try:
                with open(path, "rb") as f:
                    out.append(self.norm(f.read().decode("utf-8", "replace")).rstrip("\n"))
            except OSError as e:
                out.append("cannot read: %s" % type(e).__name__)
        elif kind == "stat":
            path = os.path.join(self.ws, args[0])
            try:
                st = os.stat(path)
                kind_name = "dir" if os.path.isdir(path) else "file"
                out.append("%s %o" % (kind_name, st.st_mode & 0o7777))
            except OSError as e:
                out.append("cannot stat: %s" % type(e).__name__)
        else:
            die("unknown step kind %r" % kind)

    def transcript(self, only=None):
        self.prepare()
        out = []
        n = 0
        with open(os.path.join(self.dir, "COMMANDS")) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                n += 1
                if only is not None and n != only:
                    continue
                out.append("=== %d: %s" % (n, line))
                parts = shlex.split(line)
                self.step(parts[0], parts[1:], out)
        self.exec("shutdown", [], common=False)
        return "\n".join(out) + "\n"


def split_steps(text):
    """Transcript -> ordered {header: body lines}."""
    steps = {}
    header = None
    for line in text.splitlines():
        if line.startswith("=== ") and re.match(r"^=== \d+: ", line):
            header = line
            steps[header] = []
        elif header is not None:
            steps[header].append(line)
    return steps


def messages_view(body):
    """--messages: exit, stdout, and the sorted complete messages of the stderr section."""
    if "--- stderr" not in body:
        return body
    i = body.index("--- stderr")
    head, err = body[:i + 1], body[i + 1:]
    blocks = []
    for line in err:
        if MESSAGE_START.match(line) or not blocks:
            blocks.append([line])
        else:
            blocks[-1].append(line)
    kept = ["\n".join(b) for b in blocks if MESSAGE_KEEP.match(b[0]) and not MESSAGE_DROP.search(b[0])]
    return head + sorted(kept)


def masked_view(body):
    """The masked view: the stderr lines of a MASKS class replaced (or dropped)."""
    if "--- stderr" not in body:
        return body
    i = body.index("--- stderr")
    out = body[:i + 1]
    for line in body[i + 1:]:
        for _, pattern, placeholder, _ in MASKS:
            m = pattern.fullmatch(line)
            if m:
                if placeholder is not None:
                    out.append(m.expand(placeholder))
                break
        else:
            out.append(line)
    return out


VIEWS = {"full": lambda body: body, "masked": masked_view, "messages": messages_view}
# Step kinds (first word of a COMMANDS line): the ones that run the binary, and file checks.
STEP_CLASSES = {"run": "binary", "aquery": "binary", "cat": "file", "stat": "file"}
CLASS_TEXT = {"binary": "steps that run the binary (run, aquery)", "file": "file checks (cat, stat)"}


def step_class(header):
    m = re.match(r"^=== \d+: (\S+)", header)
    return STEP_CLASSES.get(m.group(1) if m else "", "binary")


def binary_id(path):
    """(sha256 hex, first 12 hex digits) of the binary."""
    import hashlib
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest(), h.hexdigest()[:12]


def save_transcript(scenario, binary, text, only):
    sha, sha12 = binary_id(binary)
    git = lambda *a: subprocess.run(["git", "-C", ROOT] + list(a), stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL).stdout.decode().strip()
    dirty = "dirty" if git("status", "--porcelain", "--untracked-files=no") else "clean"
    import datetime
    header = ["# probe transcript of Blaze (scripts/w4/probe compare)",
              "# binary %s" % binary,
              "# sha256 %s" % sha,
              "# tree %s (%s)" % (git("rev-parse", "HEAD"), dirty),
              "# date %s" % datetime.datetime.now().isoformat(timespec="seconds")]
    name = "BLAZE-%s%s.txt" % (sha12, "" if only is None else ".only-%d" % only)
    path = os.path.join(SCENARIOS, scenario, name)
    with open(path, "w") as f:
        f.write("\n".join(header) + "\n" + text)
    return path


def count(want, got, view_shown=None, quiet=True):
    """Per view, the steps of `want` whose body equals `got`'s; prints MATCH/DIFF lines (and
    the diff of `view_shown` unless quiet)."""
    counts = {v: 0 for v in VIEWS}
    # Per step class: {"steps": oracle steps, <view>: matching steps}.
    counts["classes"] = {c: dict({"steps": 0}, **{v: 0 for v in VIEWS}) for c in CLASS_TEXT}
    for header, want_body in want.items():
        cls = counts["classes"][step_class(header)]
        cls["steps"] += 1
        got_body = got.get(header)
        if got_body is None:
            print("%s  DIFF (step missing from Blaze's transcript)" % header)
            continue
        for v, f in VIEWS.items():
            if f(want_body) == f(got_body):
                counts[v] += 1
                cls[v] += 1
        if view_shown is None:
            continue
        a, b = VIEWS[view_shown](want_body), VIEWS[view_shown](got_body)
        if a == b:
            if not quiet:
                print("%s  MATCH" % header)
        else:
            print("%s  DIFF" % header)
            if not quiet:
                sys.stdout.writelines(l + "\n" for l in difflib.unified_diff(a, b, "oracle", "blaze", lineterm=""))
    for header in got:
        if header not in want:
            print("%s  DIFF (step not in ORACLE.txt)" % header)
    return counts


def read_oracle(scenario, only=None):
    with open(os.path.join(SCENARIOS, scenario, "ORACLE.txt")) as f:
        want = split_steps(f.read())
    if only is not None:
        want = {h: b for h, b in want.items() if h.startswith("=== %d: " % only)}
    return want


def compare(scenario, only=None, view="full", quiet=False):
    """Runs Blaze, saves its transcript; returns ({view: matching steps}, total steps)."""
    want = read_oracle(scenario, only)
    run = Run("blaze", scenario)
    text = run.transcript(only)
    saved = save_transcript(scenario, run.binary, text, only)
    counts = count(want, split_steps(text), view, quiet)
    b = counts["classes"]["binary"]
    print("probe %s: %d of %d steps match%s (masked %d, messages %d; of them running the binary: %d of %d; "
          "saved %s)"
          % (scenario, counts[view], len(want), "" if view == "full" else " (%s view)" % view,
             counts["masked"], counts["messages"], b[view], b["steps"], os.path.relpath(saved, ROOT)))
    return counts, len(want)


def print_table(rows, left_out=()):
    """rows: [(scenario, counts, oracle steps)]; left_out: [(scenario, why, oracle steps)] that are
    not in the denominator."""
    print("%-28s %11s %11s %11s" % ("scenario", "full", "masked", "messages"))
    tot = {v: 0 for v in VIEWS}
    classes = {c: dict({"steps": 0}, **{v: 0 for v in VIEWS}) for c in CLASS_TEXT}
    total_n = 0
    for name, counts, n in rows:
        print("%-28s %4d / %-4d %4d / %-4d %4d / %-4d %s"
              % (name, counts["full"], n, counts["masked"], n, counts["messages"], n,
                 "MATCH" if counts["full"] == n else "DIFF"))
        for v in VIEWS:
            tot[v] += counts[v]
        for c, k in counts["classes"].items():
            for key in k:
                classes[c][key] += k[key]
        total_n += n
    print("probe: %d scenarios, %d steps; full %d, masked %d, messages %d (%d scenarios fully match)"
          % (len(rows), total_n, tot["full"], tot["masked"], tot["messages"],
             sum(1 for _, c, n in rows if c["full"] == n)))
    for c, text in CLASS_TEXT.items():
        k = classes[c]
        print("  %-42s %4d steps; full %d, masked %d, messages %d"
              % (text + ":", k["steps"], k["full"], k["masked"], k["messages"]))
    for name, why, n in left_out:
        print("  not counted: %s (%s; %d oracle steps)" % (name, why, n))
    tot["classes"] = classes
    return tot, total_n


def recorded_scenarios(skip):
    return [name for name in sorted(os.listdir(SCENARIOS))
            if name not in skip and os.path.exists(os.path.join(SCENARIOS, name, "ORACLE.txt"))]


def skipped_scenarios(skip):
    """[(scenario, why, oracle steps)] for the recorded scenarios that --skip leaves out."""
    return [(name, "--skip", len(read_oracle(name))) for name in sorted(skip)
            if os.path.exists(os.path.join(SCENARIOS, name, "ORACLE.txt"))]


def main(argv):
    if len(argv) < 2 or argv[1] in ("help", "--help", "-h"):
        sys.stdout.write(USAGE)
        return 0
    cmd = argv[1]
    view = "messages" if "--messages" in argv else "masked" if "--masked" in argv else "full"
    skip = set()
    if "--skip" in argv:
        skip = set(argv[argv.index("--skip") + 1].split(","))
    if cmd == "list":
        for name in sorted(os.listdir(SCENARIOS)):
            if os.path.isdir(os.path.join(SCENARIOS, name, "ws")):
                recorded = os.path.exists(os.path.join(SCENARIOS, name, "ORACLE.txt"))
                print("%s%s" % (name, "" if recorded else "  (no ORACLE.txt)"))
        return 0
    if cmd == "masks":
        for name, pattern, placeholder, reason in MASKS:
            print("%s\n  line:   %s\n  becomes: %s\n  why:    %s"
                  % (name, pattern.pattern, "(dropped)" if placeholder is None else placeholder, reason))
        return 0
    if cmd == "compare-all":
        rows = []
        for name in recorded_scenarios(skip):
            counts, n = compare(name, view=view, quiet=True)
            rows.append((name, counts, n))
        tot, total_n = print_table(rows, skipped_scenarios(skip))
        return 0 if tot[view] == total_n else 1
    if cmd == "recount":
        if len(argv) < 3:
            die("missing <sha12>; see `probe help`")
        sha12 = argv[2]
        rows = []
        left_out = skipped_scenarios(skip)
        for name in recorded_scenarios(skip):
            path = os.path.join(SCENARIOS, name, "BLAZE-%s.txt" % sha12)
            if not os.path.exists(path):
                print("%s: no BLAZE-%s.txt" % (name, sha12))
                left_out.append((name, "no saved transcript", len(read_oracle(name))))
                continue
            with open(path) as f:
                got = split_steps(f.read())
            want = read_oracle(name)
            rows.append((name, count(want, got), len(want)))
        print_table(rows, left_out)
        return 0
    if len(argv) < 3:
        die("missing scenario; see `probe help`")
    scenario = argv[2]
    only = None
    if "--only" in argv:
        only = int(argv[argv.index("--only") + 1])
    expected = os.path.join(SCENARIOS, scenario, "ORACLE.txt")
    if cmd in ("oracle", "blaze"):
        sys.stdout.write(Run(cmd, scenario).transcript(only))
        return 0
    if cmd == "record":
        text = Run("oracle", scenario).transcript()
        with open(expected, "w") as f:
            f.write(text)
        print("wrote %s (%d lines)" % (expected, text.count("\n")))
        return 0
    if cmd == "compare":
        counts, n = compare(scenario, only, view)
        return 0 if counts[view] == n else 1
    die("unknown command %r; see `probe help`" % cmd)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
