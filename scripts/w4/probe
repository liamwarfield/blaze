def die(msg):
    sys.stderr.write("probe: %s\n" % msg)
    sys.exit(2)


HOME = os.path.expanduser("~")
STATE = os.path.join(HOME, ".cache", "blaze", "work", "w4-probe")
LOCK = os.path.join(STATE, "lock")
HOLDER = os.path.join(STATE, "lock.holder.json")
CLIENTS = os.path.join(STATE, "clients")
LOCKED_COMMANDS = ("oracle", "blaze", "record", "record-all", "compare", "compare-all")


def _holder():
    try:
        with open(HOLDER) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def take_lock(argv):
    """Registers this run and takes the probe lock, waiting (and saying who holds it)."""
    os.makedirs(CLIENTS, exist_ok=True)
    with open(os.path.join(CLIENTS, str(os.getpid())), "w") as f:
        f.write("%s %s\n" % (cc._proc_start(os.getpid()), " ".join(argv)))
    fd = os.open(LOCK, os.O_RDWR | os.O_CREAT, 0o644)
    shown, t0 = None, time.time()
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except BlockingIOError:
            h = _holder()
            if json.dumps(h, sort_keys=True) != shown:
                shown = json.dumps(h, sort_keys=True)
                sys.stderr.write("probe: waiting for the lock, held by %s\n" % (
                    "pid %s since %s: %s" % (h.get("pid"), h.get("start"), h.get("argv"))
                    if h else "an unknown process"))
                sys.stderr.flush()
            time.sleep(1)
    if shown is not None:
        sys.stderr.write("probe: got the lock after %.0fs\n" % (time.time() - t0))
    tmp = HOLDER + ".%d.tmp" % os.getpid()
    with open(tmp, "w") as f:
        json.dump({"pid": os.getpid(), "argv": " ".join(argv),
                   "start": datetime.datetime.now().isoformat(timespec="seconds")}, f)
    os.replace(tmp, HOLDER)
    return fd


def release(fd):
    try:
        if (_holder() or {}).get("pid") == os.getpid():
            os.remove(HOLDER)
        os.remove(os.path.join(CLIENTS, str(os.getpid())))
    except OSError:
        pass
    fcntl.flock(fd, fcntl.LOCK_UN)
    os.close(fd)


def _registered():
    """{pid} of the registered runs whose recorded start time still matches the process (a
    file left by a killed run does not hide an unrelated process that reuses its pid)."""
    out = set()
    if not os.path.isdir(CLIENTS):
        return out
    for name in os.listdir(CLIENTS):
        if not name.isdigit():
            continue
        try:
            start = open(os.path.join(CLIENTS, name)).read().split(" ", 1)[0]
        except OSError:
            continue
        if cc._proc_start(int(name)) == start:
            out.add(int(name))
    return out


def _probe_args(args):
    """The arguments after the probe script in a command line, or None when the command line
    does not run scripts/w4/probe (directly, or as a Python interpreter's script argument after
    any interpreter options)."""
    if args and args[0].endswith("w4/probe"):
        return args[1:]
    if len(args) > 1 and os.path.basename(args[0]).startswith("python"):
        i = 1
        while i < len(args) and args[i].startswith("-"):
            i += 2 if args[i] in ("-W", "-X", "-c", "-m") else 1
        if i < len(args) and args[i].endswith("w4/probe"):
            return args[i + 1:]
    return None


def unlocked_probes():
    """Other scripts/w4/probe processes that did not register (they do not take the lock) and
    run a command that uses the shared directories."""
    me, ancestors = os.getpid(), set()
    p = me
    while p and p > 1:
        ancestors.add(p)
        try:
            p = int(open("/proc/%d/stat" % p).read().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            break
    registered = _registered()
    found = []
    for pid in os.listdir("/proc"):
        if not pid.isdigit() or int(pid) in ancestors or int(pid) in registered:
            continue
        try:
            args = [a.decode(errors="replace") for a in
                    open("/proc/%s/cmdline" % pid, "rb").read().split(b"\0") if a]
        except OSError:
            continue
        rest = _probe_args(args)
        if rest is None:
            continue
        while rest and rest[0] == "--scenarios":
            rest = rest[2:]
        if rest and rest[0] in LOCKED_COMMANDS:
            found.append("pid %s: %s" % (pid, " ".join(args)[:200]))
    return found


class Unlocked(Exception):
    pass


def refuse_if_unlocked(when):
    found = unlocked_probes()
    if found:
        raise Unlocked("refused to score (%s): another probe process uses the shared work "
                       "directories without the lock:\n  %s" % (when, "\n  ".join(found)))


# ---------------------------------------------------------------------------------------------
# Running a scenario.

def term_text(term):
    """The transcript line of a termination (without the free-text detail, which goes to
    stderr): `exit N`, `signal NAME`, `oom-kill`, `timeout`, `unrecorded`."""
    if term.kind == "exit":
        return "exit %d" % term.code
    if term.kind == "signal":
        return "signal %s" % term.sig
    return term.kind


def parse_term(line):
    """A Termination from a transcript's termination line, or None."""
    m = re.match(r"^exit (-?\d+)$", line or "")
    if m:
        return cc.Termination("exit", int(m.group(1)))
    m = re.match(r"^signal (\S+)$", line or "")
    if m:
        return cc.Termination("signal", None, m.group(1))
    if line in ("oom-kill", "timeout", "unrecorded"):
        return cc.Termination(line)
    return None


class Run:
    def __init__(self, who, scenario, binary):
        self.who = who
        self.dir = os.path.join(SCENARIOS, scenario)
        if not os.path.isdir(os.path.join(self.dir, "ws")):
            die("no scenario %r (see `probe list`)" % scenario)
        self.binary = binary
        self.ws = os.path.join(HOME, ".cache/blaze/work/probe-%s" % scenario)
        self.ur = os.path.join(HOME, ".cache/blaze/oracle-out/ur-probe-%s-%s" % (scenario, who))
        self.home = HOME
        self.aux = []  # (what, Termination) of shutdown commands

    def prepare(self):
        # A fresh workspace copy and a fresh output user root: action counts and cache hits in the
        # transcript must not depend on earlier runs. (chmod -R does not follow the symlinks it
        # meets while walking, so the convenience symlinks and the execroot are safe.)
        if os.path.isdir(self.ur) and os.path.isdir(self.ws):
            term = self.exec("shutdown", [], common=False)[0]
            self.aux.append(("shutdown before", term))
        for path in (self.ws, self.ur):
            if os.path.lexists(path):
                subprocess.run(["chmod", "-R", "u+w", path], check=False)
                shutil.rmtree(path)
        shutil.copytree(os.path.join(self.dir, "ws"), self.ws, symlinks=True)

    def exec(self, command, args, common=True):
        argv = [self.binary, "--output_user_root=" + self.ur, "--nohome_rc", "--nosystem_rc",
                command]
        if common:
            argv += ["--repository_cache=" + self.home + "/.cache/blaze/repo-cache", "--color=no",
                     "--curses=no"]
        argv += args
        r = cc.run(argv, self.ws, timeout=STEP_TIMEOUT, mode="scope", memory_max=MEMORY_MAX,
                   tag="probe-" + self.who)
        if not r.term.normal:
            sys.stderr.write("probe: %s %s: %s\n" % (self.who, command, r.term))
        return r.term, r.out.decode("utf-8", "replace"), r.err.decode("utf-8", "replace")

    def norm(self, text):
        text = re.sub(re.escape(self.ur) + r"/[0-9a-f]{32}", "<OUTPUT_BASE>", text)
        text = text.replace(self.ur, "<OUTPUT_USER_ROOT>").replace(self.ws, "<WS>").replace(self.home, "<HOME>")
        text = re.sub(r"/sandbox/([a-z-]+)/\d+/", r"/sandbox/\1/<N>/", text)
        text = re.sub(r"\b\d+(\.\d+)?m?s\b", "<DUR>", text)
        text = UUID.sub("<UUID>", text)
        return text

    @staticmethod
    def raw_aquery(stdout):
        """A raw `aquery --output=jsonproto` document: blank the path-dependent action keys."""
        if not stdout.startswith("{"):
            return stdout
        try:
            doc = json.loads(stdout)
        except ValueError:
            return stdout
        if not isinstance(doc.get("actions"), list):
            return stdout
        for a in doc["actions"]:
            if a.get("mnemonic") in PATH_DEPENDENT_KEYS and "actionKey" in a:
                a["actionKey"] = "<path-dependent>"
        return json.dumps(doc, indent=2) + "\n"

    def stderr_lines(self, err):
        out = []
        for raw in err.splitlines():
            line = ANSI.sub("", raw)
            if "\r" in line:
                line = line.split("\r")[-1]
            line = line.rstrip()
            if not line or PROGRESS.match(line):
                continue
            out.append(self.norm(line))
        return out

    def step(self, kind, args, out):
        if kind == "run":
            term, stdout, stderr = self.exec(args[0], args[1:])
            out.append(term_text(term))
            out.append("--- stdout")
            stdout = self.norm(self.raw_aquery(stdout))
            if stdout:
                out.append(stdout.rstrip("\n"))
            out.append("--- stderr")
            out.extend(self.stderr_lines(stderr))
        elif kind == "aquery":
            import surfaces  # scripts/oracle
            term, stdout, stderr = self.exec("aquery", ["--output=jsonproto", "--include_param_files",
                                                        "--include_file_write_contents"] + args)
            out.append(term_text(term))
            out.append("--- stdout")
            try:
                doc = json.loads(stdout)
            except ValueError:
                doc = None
            if doc is not None:
                for primary, rec in surfaces.aquery_summary(doc).items():
                    if rec.get("mnemonic") in PATH_DEPENDENT_KEYS:
                        rec["actionKey"] = "<path-dependent>"
                    out.append(self.norm(json.dumps({"primaryOutput": primary, **rec}, sort_keys=True)))
            elif stdout:
                out.append(self.norm(stdout).rstrip("\n"))
            out.append("--- stderr")
            out.extend(self.stderr_lines(stderr))
        elif kind == "cat":
            path = os.path.join(self.ws, args[0])
            try:
                with open(path, "rb") as f:
                    out.append(self.norm(f.read().decode("utf-8", "replace")).rstrip("\n"))
            except OSError as e:
                out.append("cannot read: %s" % type(e).__name__)
        elif kind == "stat":
            path = os.path.join(self.ws, args[0])
            try:
                st = os.stat(path)
                kind_name = "dir" if os.path.isdir(path) else "file"
                out.append("%s %o" % (kind_name, st.st_mode & 0o7777))
            except OSError as e:
                out.append("cannot stat: %s" % type(e).__name__)
        else:
            die("unknown step kind %r" % kind)

    def transcript(self, only=None):
        self.prepare()
        out = []
        n = 0
        with open(os.path.join(self.dir, "COMMANDS")) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                n += 1
                if only is not None and n != only:
                    continue
                out.append("=== %d: %s" % (n, line))
                parts = shlex.split(line)
                self.step(parts[0], parts[1:], out)
        term = self.exec("shutdown", [], common=False)[0]
        self.aux.append(("shutdown after", term))
        return "\n".join(out) + "\n"


# ---------------------------------------------------------------------------------------------
# Transcripts, views and the three-view counts.

def split_steps(text):
    """Transcript -> ordered {header: body lines}."""
    steps = {}
    header = None
    for line in text.splitlines():
        if line.startswith("=== ") and re.match(r"^=== \d+: ", line):
            header = line
            steps[header] = []
        elif header is not None:
            steps[header].append(line)
    return steps


def messages_view(body):
    """--messages: exit, stdout, and the sorted complete messages of the stderr section."""
    if "--- stderr" not in body:
        return body
    i = body.index("--- stderr")
    head, err = body[:i + 1], body[i + 1:]
    blocks = []
    for line in err:
        if MESSAGE_START.match(line) or not blocks:
            blocks.append([line])
        else:
            blocks[-1].append(line)
    kept = ["\n".join(b) for b in blocks if MESSAGE_KEEP.match(b[0]) and not MESSAGE_DROP.search(b[0])]
    return head + sorted(kept)


def masked_view(body, fired=None):
    """The masked view: the stderr lines of a MASKS class replaced (or dropped). fired: a set
    that receives the names of the classes that matched a line."""
    if "--- stderr" not in body:
        return body
    i = body.index("--- stderr")
    out = body[:i + 1]
    for line in body[i + 1:]:
        for name, pattern, placeholder, _ in MASKS:
            m = pattern.fullmatch(line)
            if m:
                if fired is not None:
                    fired.add(name)
                if placeholder is not None:
                    out.append(m.expand(placeholder))
                break
        else:
            out.append(line)
    return out


VIEWS = {"full": lambda body: body, "masked": masked_view, "messages": messages_view}
# Step kinds (first word of a COMMANDS line): the ones that run the binary, and file checks.
STEP_CLASSES = {"run": "binary", "aquery": "binary", "cat": "file", "stat": "file"}
CLASS_TEXT = {"binary": "steps that run the binary (run, aquery)", "file": "file checks (cat, stat)"}


def step_class(header):
    m = re.match(r"^=== \d+: (\S+)", header)
    return STEP_CLASSES.get(m.group(1) if m else "", "binary")


def count(want, got, view_shown=None, quiet=True):
    """Per view, the steps of `want` whose body equals `got`'s; prints MATCH/DIFF lines (and
    the diff of `view_shown` unless quiet). The three-view table; the classes are judge_step's."""
    counts = {v: 0 for v in VIEWS}
    # Per step class: {"steps": oracle steps, <view>: matching steps}.
    counts["classes"] = {c: dict({"steps": 0}, **{v: 0 for v in VIEWS}) for c in CLASS_TEXT}
    for header, want_body in want.items():
        cls = counts["classes"][step_class(header)]
        cls["steps"] += 1
        got_body = got.get(header)
        if got_body is None:
            print("%s  DIFF (step missing from Blaze's transcript)" % header)
            continue
        for v, f in VIEWS.items():
            if f(want_body) == f(got_body):
                counts[v] += 1
                cls[v] += 1
        if view_shown is None:
            continue
        a, b = VIEWS[view_shown](want_body), VIEWS[view_shown](got_body)
        if a == b:
            if not quiet:
                print("%s  MATCH" % header)
        else:
            print("%s  DIFF" % header)
            if not quiet:
                sys.stdout.writelines(l + "\n" for l in difflib.unified_diff(a, b, "oracle", "blaze", lineterm=""))
    for header in got:
        if header not in want:
            print("%s  DIFF (step not in ORACLE.txt)" % header)
    return counts


def print_table(rows, left_out=()):
    """rows: [(scenario, counts, oracle steps)]; left_out: [(scenario, why, oracle steps)] that are
    not in the denominator."""
    print("%-28s %11s %11s %11s" % ("scenario", "full", "masked", "messages"))
    tot = {v: 0 for v in VIEWS}
    classes = {c: dict({"steps": 0}, **{v: 0 for v in VIEWS}) for c in CLASS_TEXT}
    total_n = 0
    for name, counts, n in rows:
        print("%-28s %4d / %-4d %4d / %-4d %4d / %-4d %s"
              % (name, counts["full"], n, counts["masked"], n, counts["messages"], n,
                 "MATCH" if counts["full"] == n else "DIFF"))
        for v in VIEWS:
            tot[v] += counts[v]
        for c, k in counts["classes"].items():
            for key in k:
                classes[c][key] += k[key]
        total_n += n
    print("probe: %d scenarios, %d steps; full %d, masked %d, messages %d (%d scenarios fully match)"
          % (len(rows), total_n, tot["full"], tot["masked"], tot["messages"],
             sum(1 for _, c, n in rows if c["full"] == n)))
    for c, text in CLASS_TEXT.items():
        k = classes[c]
        print("  %-42s %4d steps; full %d, masked %d, messages %d"
              % (text + ":", k["steps"], k["full"], k["masked"], k["messages"]))
    for name, why, n in left_out:
        print("  not counted: %s (%s; %d oracle steps)" % (name, why, n))
    tot["classes"] = classes
    return tot, total_n


def judge_step(header, want_body, got_body):
    """(class, detail) of one step (see `help`)."""
    if got_body is None:
        return cc.DIFFERENT, "step missing from Blaze's transcript"
    if step_class(header) == "file":
        if want_body == got_body:
            return cc.IDENTICAL, "file check"
        return cc.DIFFERENT, "file check differs"
    ot = parse_term(want_body[0] if want_body else None)
    bt = parse_term(got_body[0] if got_body else None)
    if ot is None:
        return cc.SKIPPED, "no termination line in ORACLE.txt for this step"
    if bt is None:
        return cc.DIFFERENT, "no termination line in Blaze's transcript"
    err = got_body[got_body.index("--- stderr") + 1:] if "--- stderr" in got_body else []
    unported = cc.unported_message("\n".join(err))
    differing, gaps, reduced = [], [], None
    if want_body[1:] == got_body[1:]:
        pass
    else:
        fired = set()
        if masked_view(want_body, fired)[1:] == masked_view(got_body, fired)[1:]:
            gaps = ["mask: " + n for n in sorted(fired)]
        elif messages_view(want_body)[1:] == messages_view(got_body)[1:]:
            reduced = "equal only in the messages view (exit code, stdout, the sorted list of " \
                      "messages; other stderr lines and the order not compared)"
        else:
            def section(body, name):
                if "--- stderr" not in body:
                    return body[1:]
                i = body.index("--- stderr")
                return body[1:i] if name == "stdout" else body[i + 1:]
            differing = [n for n in ("stdout", "stderr")
                         if section(want_body, n) != section(got_body, n)] or ["body"]
    return cc.judge(ot, bt, differing, blaze_unported=unported, gaps=gaps, reduced=reduced)


# ---------------------------------------------------------------------------------------------
# The anchored oracle record.

def scenario_dir(scenario):
    return os.path.join(SCENARIOS, scenario)


def oracle_paths(scenario):
    d = scenario_dir(scenario)
    return os.path.join(d, "ORACLE.txt"), os.path.join(d, "ORACLE.key.json")


def oracle_key(scenario, oracle_sha):
    """The key of a scenario's ORACLE.txt (see `help`)."""
    d = scenario_dir(scenario)
    ws = os.path.join(HOME, ".cache/blaze/work/probe-%s" % scenario)
    ur = os.path.join(HOME, ".cache/blaze/oracle-out/ur-probe-%s-oracle" % scenario)
    argv = ["<oracle>", "--output_user_root=" + ur, "--nohome_rc", "--nosystem_rc", "<command>",
            "--repository_cache=" + HOME + "/.cache/blaze/repo-cache", "--color=no", "--curses=no"]
    return cc.cache_key(cc.tool_sha256(THIS), oracle_sha, argv, cc.clean_env(),
                        {"ws": cc.tree_digest(os.path.join(d, "ws"), skip_top=()),
                         "COMMANDS": cc.sha256_file(os.path.join(d, "COMMANDS"))},
                        extra={"scenario": scenario, "workspace_copy": ws,
                               "memory_max": MEMORY_MAX, "timeout": STEP_TIMEOUT})


def check_oracle_record(scenario, oracle_sha):
    """None when the scenario's ORACLE.txt is anchored by a fresh key; else the reason."""
    txt, key = oracle_paths(scenario)
    if not os.path.exists(txt):
        return "no ORACLE.txt for %s" % scenario
    return cc.check_key(key, oracle_key(scenario, oracle_sha))


def read_oracle(scenario, only=None):
    with open(oracle_paths(scenario)[0]) as f:
        want = split_steps(f.read())
    if only is not None:
        want = {h: b for h, b in want.items() if h.startswith("=== %d: " % only)}
    return want


def record(scenario, oracle, oracle_sha, report):
    txt, key = oracle_paths(scenario)
    cc.invalidate_key(key)
    run = Run("oracle", scenario, oracle)
    text = run.transcript()
    tmp = txt + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, txt)
    bad = [(w, t) for w, t in run.aux if not t.normal]
    for w, t in run.aux:
        report.add_aux("%s %s" % (scenario, w), t)
    if bad:
        print("probe: %s: ORACLE.txt written but NOT anchored (an auxiliary command ended "
              "abnormally: %s)" % (scenario, "; ".join("%s %s" % (w, t) for w, t in bad)))
        return False
    cc.write_key(key, oracle_key(scenario, oracle_sha), [txt])
    print("wrote %s (%d lines) and its key %s" % (txt, text.count("\n"), key))
    return True


# ---------------------------------------------------------------------------------------------
# Blaze transcripts and their captures.

def save_transcript(scenario, blaze, text, only, oracle_sha):
    sha12 = blaze["sha256"][:12]
    repo = cc.repo_state()
    header = ["# probe transcript of Blaze (scripts/w4/probe compare)",
              "# binary %s" % blaze["path"],
              "# sha256 %s" % blaze["sha256"],
              "# tree %s (%s)" % (repo["commit"], {True: "dirty", False: "clean"}.get(
                  repo["dirty"], "?")),
              "# date %s" % datetime.datetime.now().isoformat(timespec="seconds")]
    name = "%s%s.txt" % (scenario, "" if only is None else ".only-%d" % only)
    os.makedirs(os.path.join(STATE, sha12), exist_ok=True)
    path = os.path.join(STATE, sha12, name)
    cap = path + ".capture.json"
    cc.invalidate_key(cap)
    with open(path, "w") as f:
        f.write("\n".join(header) + "\n" + text)
    try:
        with open(oracle_paths(scenario)[1]) as f:
            okey = json.load(f).get("digest")
    except (OSError, ValueError):
        okey = None
    cc.write_capture(cap, blaze, [path], extra={
        "scenario": scenario, "only": only, "repo": repo, "tool_sha256": cc.tool_sha256(THIS),
        "compare_common_sha256": cc.MODULE_SHA256, "oracle_sha256": oracle_sha,
        "oracle_key_digest": okey})
    return path


def judge_scenario(scenario, want, got, report, view, quiet):
    """Adds one row per oracle step; returns the three-view counts."""
    counts = count(want, got, view, quiet)
    for header, want_body in want.items():
        cls, detail = judge_step(header, want_body, got.get(header))
        report.add("%s %s" % (scenario, header[4:]), cls, detail, scenario=scenario,
                   step_kind=step_class(header))
    for header in got:
        if header not in want:
            report.add("%s %s" % (scenario, header[4:]), cc.DIFFERENT, "step not in ORACLE.txt",
                       scenario=scenario, step_kind=step_class(header))
    return counts


def compare(scenario, blaze, oracle_sha, report, only=None, view="full", quiet=False):
    """Runs Blaze, saves its transcript, judges every step; returns (three-view counts, steps)."""
    want = read_oracle(scenario, only)
    run = Run("blaze", scenario, blaze["path"])
    text = run.transcript(only)
    for w, t in run.aux:
        report.add_aux("%s %s" % (scenario, w), t)
    saved = save_transcript(scenario, blaze, text, only, oracle_sha)
    counts = judge_scenario(scenario, want, split_steps(text), report, view, quiet)
    b = counts["classes"]["binary"]
    print("probe %s: full view %d of %d steps (masked %d, messages %d; of them running the "
          "binary: %d of %d; saved %s)" % (scenario, counts["full"], len(want), counts["masked"],
                                           counts["messages"], b["full"], b["steps"], saved))
    return counts, len(want)


def kind_footer(report):
    """The class counts split by step kind (steps that run the binary, file checks)."""
    lines = []
    for kind, text in CLASS_TEXT.items():
        rows = [r for r in report.rows if r.get("step_kind") == kind]
        c = {}
        for r in rows:
            c[r["class"]] = c.get(r["class"], 0) + 1
        lines.append("%s: %d steps; %s" % (text, len(rows), ", ".join(
            "%s %d" % (k.lower(), c[k]) for k in cc.CLASSES if c.get(k)) or "none"))
    return lines


# ---------------------------------------------------------------------------------------------
# Command line.

def recorded_scenarios(skip):
    return [name for name in sorted(os.listdir(SCENARIOS))
            if name not in skip and os.path.exists(os.path.join(SCENARIOS, name, "ORACLE.txt"))]


def all_scenarios(skip):
    return [name for name in sorted(os.listdir(SCENARIOS))
            if name not in skip and os.path.isfile(os.path.join(SCENARIOS, name, "COMMANDS"))]


def skipped_scenarios(skip):
    """[(scenario, why, oracle steps)] for the recorded scenarios that --skip leaves out."""
    return [(name, "--skip", len(read_oracle(name))) for name in sorted(skip)
            if os.path.exists(os.path.join(SCENARIOS, name, "ORACLE.txt"))]


def blaze_binary(opts):
    return opts.get("binary") or os.environ.get("BLAZE") or os.path.join(ROOT, "target/debug/blaze")


def parse(argv):
    """(command, positional, options) of argv (without the program name)."""
    opts, pos = {"view": "full", "skip": set()}, []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--scenarios", "--binary", "--only", "--skip", "--json"):
            if i + 1 >= len(argv):
                die("%s needs a value" % a)
            v = argv[i + 1]
            if a == "--only":
                opts["only"] = int(v)
            elif a == "--skip":
                opts["skip"] = set(x for x in v.split(",") if x)
            else:
                opts[a[2:]] = v
            i += 2
            continue
        if a in ("--messages", "--masked"):
            opts["view"] = a[2:]
        elif a.startswith("-") and a not in ("-h",):
            die("unknown option %r; see `probe help`" % a)
        else:
            pos.append(a)
        i += 1
    return (pos[0] if pos else "help"), pos[1:], opts


def main(argv):
    global SCENARIOS
    cmd, pos, opts = parse(argv[1:])
    if cmd in ("help", "--help", "-h"):
        sys.stdout.write(USAGE)
        return 0
    if opts.get("scenarios"):
        SCENARIOS = os.path.abspath(opts["scenarios"])
    if cmd == "selftest":
        return selftest()
    if cmd == "list":
        for name in sorted(os.listdir(SCENARIOS)):
            if os.path.isdir(os.path.join(SCENARIOS, name, "ws")):
                recorded = os.path.exists(os.path.join(SCENARIOS, name, "ORACLE.txt"))
                keyed = os.path.exists(oracle_paths(name)[1])
                print("%s%s" % (name, "" if recorded and keyed else "  (no ORACLE.txt)"
                                if not recorded else "  (ORACLE.txt without a key)"))
        return 0
    if cmd == "masks":
        for name, pattern, placeholder, reason in MASKS:
            print("%s\n  line:   %s\n  becomes: %s\n  why:    %s"
                  % (name, pattern.pattern, "(dropped)" if placeholder is None else placeholder, reason))
        return 0
    if cmd in LOCKED_COMMANDS:
        lock = take_lock(argv)
        try:
            refuse_if_unlocked("at the start")
            return locked_main(cmd, pos, opts)
        except Unlocked as e:
            return cc.refuse(TOOL, e)
        except cc.Refusal as e:
            return cc.refuse(TOOL, e)
        finally:
            release(lock)
    if cmd == "recount":
        try:
            return recount(pos, opts)
        except cc.Refusal as e:
            return cc.refuse(TOOL, e)
    die("unknown command %r; see `probe help`" % cmd)


def new_report(blaze, oracle, oracle_sha, selection, compared):
    rep = cc.Report(TOOL, blaze=blaze, oracle={"path": oracle, "sha256": oracle_sha},
                    selection=selection, tool_files=[THIS], compared=compared)
    rep.print_header()
    return rep


COMPARED = ("per oracle step: the termination, stdout and every kept stderr line in order (full "
            "view); KNOWN-GAP when equal only with the mask classes of `probe masks`, "
            "IDENTICAL-REDUCED when equal only in the messages view")


def finish(report, opts):
    for line in kind_footer(report):
        report.note(line)
    report.print_rows()
    report.print_footer()
    if opts.get("json"):
        report.write_json(opts["json"])
    return report.exit_code()


def locked_main(cmd, pos, opts):
    oracle, oracle_sha = cc.require_oracle()
    if cmd in ("record", "record-all"):
        names = all_scenarios(opts["skip"]) if cmd == "record-all" else pos[:1]
        if not names:
            return cc.empty_selection_error(TOOL, "scenarios")
        rep = cc.Report(TOOL, oracle={"path": oracle, "sha256": oracle_sha},
                        selection="record " + ",".join(names), tool_files=[THIS],
                        compared="nothing (recording the oracle)")
        rep.print_header()
        ok = True
        for name in names:
            ok = record(name, oracle, oracle_sha, rep) and ok
        bad = [a for a in rep.aux if a["abnormal"]]
        for a in bad:
            print("probe: auxiliary %s: %s" % (a["what"], a["termination"]))
        if rep.changed_files():
            print("probe: changed on disk during the run: %s" % ", ".join(rep.changed_files()))
            return 2
        print("probe: recorded %d scenario(s)%s" % (len(names), "" if ok else
                                                     "; some NOT anchored (see above)"))
        return 0 if ok else 1
    if cmd in ("oracle", "blaze"):
        if not pos:
            die("missing scenario; see `probe help`")
        if cmd == "oracle":
            binary = oracle
        else:
            binary = cc.blaze_identity(blaze_binary(opts))["path"]
        run = Run(cmd, pos[0], binary)
        sys.stdout.write(run.transcript(opts.get("only")))
        for w, t in run.aux:
            print("# %s: %s" % (w, t), file=sys.stderr)
        return 0 if all(t.normal for _, t in run.aux) else 1
    blaze = cc.blaze_identity(blaze_binary(opts))
    if cmd == "compare":
        if not pos:
            die("missing scenario; see `probe help`")
        names = pos[:1]
    else:
        names = recorded_scenarios(opts["skip"])
        if not names:
            return cc.empty_selection_error(TOOL, "recorded scenarios")
    stale = [(n, why) for n in names for why in [check_oracle_record(n, oracle_sha)] if why]
    if stale:
        raise cc.Refusal("ORACLE.txt not anchored for %d scenario(s); run `probe record <name>` "
                         "first:\n  %s" % (len(stale), "\n  ".join("%s: %s" % s for s in stale)))
    left = skipped_scenarios(opts["skip"]) if cmd == "compare-all" else []
    rep = new_report(blaze, oracle, oracle_sha, "%s %s%s%s" % (
        cmd, ",".join(names) if cmd == "compare" else "%d recorded scenarios" % len(names),
        " --only %d" % opts["only"] if opts.get("only") else "",
        " (left out: %s)" % ", ".join(n for n, _, _ in left) if left else ""), COMPARED)
    rows = []
    for name in names:
        counts, n = compare(name, blaze, oracle_sha, rep, opts.get("only") if cmd == "compare"
                            else None, opts["view"], quiet=(cmd == "compare-all"))
        rows.append((name, counts, n))
    refuse_if_unlocked("before scoring")
    print_table(rows, left)
    for name, why, n in left:
        rep.note("not counted: %s (%s; %d oracle steps)" % (name, why, n))
    return finish(rep, opts)


def recount(pos, opts):
    """Re-judges saved transcripts of the binary named with --binary (see `help`)."""
    if not pos:
        die("missing <sha12>; see `probe help`")
    sha12 = pos[0]
    if not opts.get("binary"):
        die("recount needs --binary B, the binary whose saved transcripts are judged")
    oracle, oracle_sha = cc.require_oracle()
    blaze = cc.blaze_identity(opts["binary"])
    if blaze["sha256"][:12] != sha12:
        raise cc.Refusal("--binary %s has sha256 %s, not %s..." % (blaze["path"], blaze["sha256"],
                                                                   sha12))
    names = recorded_scenarios(opts["skip"])
    if not names:
        return cc.empty_selection_error(TOOL, "recorded scenarios")
    rep = new_report(blaze, oracle, oracle_sha, "recount %s, %d recorded scenarios" % (
        sha12, len(names)), COMPARED + "; re-judged from saved transcripts")
    rep.reclassify_only = True
    rows, left, trees = [], list(skipped_scenarios(opts["skip"])), {}
    for name in names:
        path = os.path.join(STATE, sha12, name + ".txt")
        want = read_oracle(name)
        why = check_oracle_record(name, oracle_sha)
        if why is None:
            if not os.path.exists(path):
                why = "no saved transcript %s" % path
            else:
                why = cc.check_capture(path + ".capture.json", blaze)
        if why is None:
            cap = json.load(open(path + ".capture.json"))
            with open(oracle_paths(name)[1]) as f:
                okey = json.load(f).get("digest")
            if (cap.get("extra") or {}).get("oracle_key_digest") != okey:
                rep.note("%s: the transcript was judged against another ORACLE.txt record than "
                         "the present one" % name)
            r = (cap.get("extra") or {}).get("repo") or {}
            trees.setdefault("%s (%s)" % (r.get("commit"), {True: "dirty", False: "clean"}.get(
                r.get("dirty"), "?")), []).append(name)
        if why is not None:
            for header in want:
                rep.add("%s %s" % (name, header[4:]), cc.SKIPPED, why, scenario=name,
                        step_kind=step_class(header))
            left.append((name, why[:80], len(want)))
            continue
        with open(path) as f:
            got = split_steps(f.read())
        rows.append((name, judge_scenario(name, want, got, rep, None, True), len(want)))
    print_table(rows, left)
    rep.note("the repository line of the header names the checkout at recount time; the "
             "transcripts were recorded at: %s" % ("; ".join(
                 "%s: %d scenario(s)" % (t, len(n)) for t, n in sorted(trees.items())) or "none"))
    return finish(rep, opts)


