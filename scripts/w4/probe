# Selftest.

def selftest():
    """The real command line against fake binaries, a fake HOME and a temporary scenarios
    directory."""
    st = cc.Selftest(TOOL)
    fh = cc.FakeHome("w4-probe")
    me = THIS
    sdir = os.path.join(fh.root, "scenarios")
    os.makedirs(os.path.join(sdir, "s1", "ws"))
    with open(os.path.join(sdir, "s1", "ws", "MODULE.bazel"), "w") as f:
        f.write("")
    with open(os.path.join(sdir, "s1", "COMMANDS"), "w") as f:
        f.write("# selftest scenario\nrun build //:x\naquery //:x\ncat MODULE.bazel\n"
                "stat MODULE.bazel\n")

    def run(args, pin=None):
        return fh.run_tool(me, ["--scenarios", sdir] + args, pin=pin)

    def classes(rep, kind="binary"):
        return [r["class"] for r in (rep or {}).get("cases", []) if r.get("step_kind") == kind]

    def show(rc, rep):
        return "exit %s, %s" % (rc, ", ".join("%s %d" % kv for kv in
                                              (rep or {}).get("denominator", {}).items() if kv[1]))
    try:
        o, b = fh.fakes(dict(out=b"x"), dict(out=b"x"))
        subprocess.run([b, "build"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        st.check("tripwire trips on a direct launch", fh.tripped())
        if fh.tripped():
            os.remove(fh.tripfile)
        for name, ospec, bspec, ok, what in cc.SCENARIOS:
            o, b = fh.fakes(ospec, bspec)
            rc0, _, log0 = run(["record", "s1"])
            rc, rep, log = run(["compare", "s1", "--binary", b])
            st.check("scenario %s" % name, rc0 == 0 and ok(rc, classes(rep)),
                     "record exit %s; %s; want %s" % (rc0, show(rc, rep), what))
        # The masked view is KNOWN-GAP, the messages view IDENTICAL-REDUCED.
        err = b"INFO: Analyzed target //:x (6 packages loaded, 12 targets configured).\n"
        o, b = fh.fakes(dict(out=b"o\n", err=err),
                        dict(out=b"o\n", err=b"Starting local Bazel server (9.3.2) and "
                             b"connecting to it...\nINFO: Analyzed target //:x (1 package "
                             b"loaded, 2 targets configured).\n"))
        run(["record", "s1"])
        rc, rep, log = run(["compare", "s1", "--binary", b])
        st.check("masked view: a step equal only with the masks is KNOWN-GAP",
                 rc == 1 and set(classes(rep)) == {cc.KNOWN_GAP}, show(rc, rep))
        o, b = fh.fakes(dict(out=b"o\n", err=b"INFO: a\nINFO: b\n"),
                        dict(out=b"o\n", err=b"INFO: b\nINFO: a\n"))
        run(["record", "s1"])
        rc, rep, log = run(["compare", "s1", "--binary", b])
        st.check("messages view: equal only as sorted messages is IDENTICAL-REDUCED",
                 rc == 1 and set(classes(rep)) == {cc.REDUCED}, show(rc, rep))
        # Anchors: the record and its key.
        o, b = fh.fakes(dict(out=b"same\n"), dict(out=b"same\n"))
        rc, _, _ = run(["record", "s1"], pin="0" * 64)
        st.check("record refuses a wrong oracle (exit 2)", rc == 2, "exit %s" % rc)
        rc, _, _ = run(["record", "s1"])
        rc, rep, _ = run(["compare", "s1", "--binary", b])
        st.check("compare after record passes", rc == 0, show(rc, rep))
        rc, rep, _ = run(["compare", "s1", "--binary", o])
        st.check("the oracle as the binary under test refused (exit 2)", rc == 2, "exit %s" % rc)
        rc, rep, _ = run(["compare", "s1", "--binary", b], pin="0" * 64)
        st.check("compare refuses a wrong oracle (exit 2)", rc == 2, "exit %s" % rc)
        txt, key = os.path.join(sdir, "s1", "ORACLE.txt"), os.path.join(sdir, "s1",
                                                                         "ORACLE.key.json")
        with open(txt, "a") as f:
            f.write("tampered\n")
        rc, _, _ = run(["compare", "s1", "--binary", b])
        st.check("a changed ORACLE.txt is refused (exit 2)", rc == 2, "exit %s" % rc)
        run(["record", "s1"])
        with open(os.path.join(sdir, "s1", "ws", "BUILD"), "w") as f:
            f.write("# changed after the record\n")
        rc, _, _ = run(["compare", "s1", "--binary", b])
        st.check("a changed ws/ refuses the old record (exit 2)", rc == 2, "exit %s" % rc)
        os.remove(os.path.join(sdir, "s1", "ws", "BUILD"))
        run(["record", "s1"])
        os.remove(key)
        rc, _, _ = run(["compare-all", "--binary", b])
        st.check("an ORACLE.txt without a key is refused (exit 2)", rc == 2, "exit %s" % rc)
        # compare-all and recount.
        run(["record", "s1"])
        rc, rep, _ = run(["compare-all", "--binary", b])
        st.check("compare-all passes on equal fakes", rc == 0, show(rc, rep))
        sha12 = cc.sha256_file(b)[:12]
        rc, rep, _ = run(["recount", sha12, "--binary", b])
        st.check("recount never exits 0", rc == 1 and rep and rep["reclassify_only"],
                 show(rc, rep))
        notes = " ".join((rep or {}).get("notes", []))
        st.check("recount names the transcripts' trees, not only the present HEAD",
                 "transcripts were recorded at" in notes, notes[:200])
        other = cc.make_fake(os.path.join(fh.home, "bin", "other"), token=fh.token,
                             tripfile=fh.tripfile, out=b"same\n", role="other")
        rc, rep, _ = run(["recount", cc.sha256_file(other)[:12], "--binary", other])
        st.check("recount: transcripts of another binary are SKIPPED",
                 rc == 1 and set(r["class"] for r in (rep or {}).get("cases", [])) == {cc.SKIPPED},
                 show(rc, rep))
        transcript = os.path.join(fh.cache, "work", "w4-probe", sha12, "s1.txt")
        with open(transcript, "a") as f:
            f.write("tampered\n")
        rc, rep, _ = run(["recount", sha12, "--binary", b])
        st.check("recount: a changed transcript is SKIPPED",
                 set(r["class"] for r in (rep or {}).get("cases", [])) == {cc.SKIPPED},
                 show(rc, rep))
        # The lock: a second run waits while it is held.
        os.makedirs(os.path.join(fh.cache, "work", "w4-probe"), exist_ok=True)
        lockfd = os.open(os.path.join(fh.cache, "work", "w4-probe", "lock"),
                         os.O_RDWR | os.O_CREAT, 0o644)
        fcntl.flock(lockfd, fcntl.LOCK_EX)
        env = dict(os.environ, HOME=fh.home, COMPARE_COMMON_SELFTEST=fh.token,
                   COMPARE_COMMON_SELFTEST_PIN=cc.sha256_file(fh.oracle))
        env.pop("COMPARE_COMMON_TRIPWIRE", None)
        p = subprocess.Popen([me, "--scenarios", sdir, "compare", "s1", "--binary", b],
                             cwd=fh.root, env=env, stdout=subprocess.PIPE,
                             stderr=subprocess.STDOUT)
        time.sleep(4)
        waiting = p.poll() is None
        fcntl.flock(lockfd, fcntl.LOCK_UN)
        os.close(lockfd)
        out = p.communicate(timeout=300)[0].decode("latin-1")
        st.check("lock: a run waits while the lock is held, then runs",
                 waiting and "waiting for the lock" in out and p.returncode == 0,
                 "waited %s, exit %s" % (waiting, p.returncode))
        # A probe process that does not hold the lock makes a run refuse to score.
        fake_dir = os.path.join(fh.root, "old", "w4")
        os.makedirs(fake_dir)
        with open(os.path.join(fake_dir, "probe"), "w") as f:
            f.write("import time\ntime.sleep(60)\n")
        old = subprocess.Popen(["/usr/bin/python3", "-B", os.path.join(fake_dir, "probe"),
                                "compare", "x"])
        try:
            time.sleep(0.5)
            rc, _, _ = run(["compare", "s1", "--binary", b])
            st.check("an unlocked probe process (python3 -B <probe>) makes a run refuse",
                     rc == 2, "exit %s" % rc)
        finally:
            old.kill()
            old.wait()
        st.check("no process started outside the launcher", not fh.tripped(),
                 open(fh.tripfile).read()[:200] if fh.tripped() else "")
    except Exception as e:  # noqa: BLE001 - a crash of the selftest is a failure
        import traceback
        traceback.print_exc()
        st.check("selftest ran to the end", False, "%s: %s" % (type(e).__name__, e))
    finally:
        if st.failures:
            print("  (fake HOME kept for inspection: %s)" % fh.root)
        else:
            fh.remove()
    return st.finish()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
