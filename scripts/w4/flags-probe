#!/usr/bin/env bash
# Starlark-flag probe: 71 cquery command lines with user-defined flags (bool/int/string/string_list/
# allow_multiple/repeatable/label flags, an alias to a flag, alias chains and cycles, string_set
# flags, scope attributes, select() on flag_values, an exec-configured tool, .bazelrc with Starlark
# flags and a --flag_alias), each run twice: deps() with --output=label_kind and //:t with
# --output=jsonproto. It is the probe scenario scripts/w4/scenarios/flags-probe (workspace ws/,
# steps COMMANDS, oracle transcript ORACLE.txt); this script forwards to scripts/w4/probe.
# usage: scripts/w4/flags-probe <oracle|blaze> [--only N]     transcript on stdout
#        scripts/w4/flags-probe record                        oracle transcript -> ORACLE.txt
#        scripts/w4/flags-probe compare [--only N] [--messages]
#                                                             full transcripts compared step by
#                                                             step; summary; exit 1 on any DIFF
#        scripts/w4/flags-probe help
# See `scripts/w4/probe help` for the transcript format and the normalisation.
set -euo pipefail
if [[ "${1:-help}" == "help" || "${1:-}" == "--help" ]]; then sed -n '2,14p' "$0"; exit 0; fi
here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cmd="$1"; shift
case "$cmd" in
  oracle|blaze|record|compare) exec "$here/probe" "$cmd" flags-probe "$@" ;;
  *) echo "flags-probe: unknown command '$cmd' (see flags-probe help)" >&2; exit 2 ;;
esac
