load(":defs.bzl", "lib")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "opt",
    values = {"compilation_mode": "opt"},
)

filegroup(
    name = "texts",
    srcs = [
        "one.txt",
        "three.txt",
        "two.txt",
    ],
)

lib(
    name = "base",
    srcs = [":texts"],
)

lib(
    name = "mid",
    srcs = ["four.txt"],
    deps = [
        ":base",
        "//b/c:leaf",
    ],
)

alias(
    name = "mid_alias",
    actual = ":mid",
)

lib(
    name = "sel",
    srcs = select({
        ":opt": ["five.txt"],
        "//conditions:default": ["six.txt"],
    }),
    deps = [":mid_alias"],
)

genrule(
    name = "gen",
    srcs = [
        ":sel",
        "seven.txt",
    ],
    outs = ["gen.out"],
    cmd = "$(location //tools:tool) $(SRCS) > $@",
    tools = ["//tools:tool"],
)

lib(
    name = "top",
    srcs = [
        "eight.txt",
        ":gen",
    ],
    deps = [
        ":sel",
        "//a:x",
        "//a:y",
    ],
)
