# Aspects (aspects wave): attribute aspects along `deps` and through an alias, required_providers
# filtering (filegroup, source file), aspect-on-aspect (required_aspect_providers; two aspect
# descriptors on the upper aspect's actions), apply_to_generating_rules on an output file,
# top-level --aspects with --aspects_parameters and --output_groups, and three analysis errors
# (an upper aspect on a target the lower aspect skipped, a wrong return type, a duplicate provider).
run cquery "deps(//:consume)" --output=label_kind
run cquery "deps(//:consume_top)" --output=label_kind
# aquery prints the actions of every ASPECT node that hangs off a printed target in the server's
# graph, also those analysed by earlier commands; Blaze has no persistent server, so each aquery
# starts from a fresh one here.
run shutdown
aquery "deps(//:consume)"
# Not recorded: `aquery "deps(//:consume_top)"`. A target with two aspect values (collect, and
# top on collect) prints their actions in the iteration order of a HashSet<AspectValue>
# (ConfiguredTargetValueAccessor.getAspectValues; AspectValue has identity hashCode), which
# differs between runs of the oracle itself (4 recordings: 2 orders).
run shutdown
run aquery //:a --aspects=//:defs.bzl%collect --output=jsonproto
run build //:consume //:consume_top //:consume_gen
cat bazel-bin/consume.txt
cat bazel-bin/consume_top.txt
cat bazel-bin/consume_gen.txt
cat bazel-bin/a.collect.txt
cat bazel-bin/a.top.txt
run build --nobuild //:a --aspects=//:defs.bzl%param_aspect --aspects_parameters=mode=b
run build --nobuild //:a --aspects=//:defs.bzl%param_aspect --aspects_parameters=mode=c
run build --nobuild //:a --aspects=//:defs.bzl%nonexistent
run build --nobuild //:a --aspects=//:missing.bzl%x
run build //:a --aspects=//:defs.bzl%param_aspect --aspects_parameters=mode=b --output_groups=param
cat bazel-bin/a.param.b.txt
run build //:a --aspects=//:defs.bzl%collect,//:defs.bzl%top --output_groups=collect
run build --nobuild //:consume_top_plain
run build --nobuild //:consume_bad
run build --nobuild //:consume_dup
