CollectInfo = provider(fields = ["files", "labels"])
TopInfo = provider(fields = ["files"])
ParamInfo = provider(fields = ["mode"])
LibInfo = provider(fields = ["name"])

def _lib_impl(ctx):
    out = ctx.actions.declare_file(ctx.label.name + ".lib")
    ctx.actions.write(out, "lib " + str(ctx.label) + "\n")
    return [DefaultInfo(files = depset([out])), LibInfo(name = ctx.label.name)]

lib = rule(
    implementation = _lib_impl,
    attrs = {
        "deps": attr.label_list(),
        "srcs": attr.label_list(allow_files = True),
    },
    provides = [LibInfo],
)

# Returns LibInfo without advertising it: `collect` (required_providers = [LibInfo]) skips it.
lib_plain = rule(
    implementation = _lib_impl,
    attrs = {"deps": attr.label_list()},
)

def _collect_impl(target, ctx):
    out = ctx.actions.declare_file(ctx.label.name + ".collect.txt")
    deps = getattr(ctx.rule.attr, "deps", [])
    labels = [str(ctx.label)]
    transitive = []
    for dep in deps:
        if CollectInfo in dep:
            labels.extend(dep[CollectInfo].labels)
            transitive.append(dep[CollectInfo].files)
    ctx.actions.write(out, "\n".join([ctx.rule.kind, str(ctx.aspect_ids)] + labels) + "\n")
    files = depset([out], transitive = transitive)
    return [
        CollectInfo(files = files, labels = labels),
        OutputGroupInfo(collect = files),
    ]

collect = aspect(
    implementation = _collect_impl,
    attr_aspects = ["deps", "actual"],
    required_providers = [LibInfo],
    provides = [CollectInfo],
)

def _top_impl(target, ctx):
    out = ctx.actions.declare_file(ctx.label.name + ".top.txt")
    inputs = target[CollectInfo].files
    ctx.actions.run_shell(
        outputs = [out],
        inputs = inputs,
        command = "cat $@ > " + out.path,
        arguments = [ctx.actions.args().add_all(inputs)],
        mnemonic = "TopCat",
        progress_message = "Top %{label}",
    )
    transitive = [dep[TopInfo].files for dep in getattr(ctx.rule.attr, "deps", []) if TopInfo in dep]
    return [TopInfo(files = depset([out], transitive = transitive))]

top = aspect(
    implementation = _top_impl,
    attr_aspects = ["deps"],
    required_aspect_providers = [CollectInfo],
)

def _gen_aspect_impl(target, ctx):
    return [CollectInfo(files = depset(), labels = ["generated by " + str(ctx.label)])]

gen_aspect = aspect(
    implementation = _gen_aspect_impl,
    apply_to_generating_rules = True,
)

def _param_impl(target, ctx):
    out = ctx.actions.declare_file(ctx.label.name + ".param." + ctx.attr.mode + ".txt")
    ctx.actions.write(out, "mode " + ctx.attr.mode + " tool " + str(ctx.attr._tool.label) + "\n")
    return [ParamInfo(mode = ctx.attr.mode), OutputGroupInfo(param = depset([out]))]

param_aspect = aspect(
    implementation = _param_impl,
    attr_aspects = ["deps"],
    attrs = {
        "mode": attr.string(values = ["a", "b"], default = "a"),
        "_tool": attr.label(default = "//:tool.txt", allow_single_file = True),
    },
)

def _consume_impl(ctx):
    out = ctx.actions.declare_file(ctx.label.name + ".txt")
    lines = []
    inputs = []
    for dep in ctx.attr.deps:
        if CollectInfo in dep:
            lines.append(str(dep.label) + ": " + ",".join(dep[CollectInfo].labels))
            inputs.append(dep[CollectInfo].files)
        else:
            lines.append(str(dep.label) + ": no CollectInfo")
        if TopInfo in dep:
            inputs.append(dep[TopInfo].files)
            lines.append(str(dep.label) + ": TopInfo")
    all_inputs = depset(transitive = inputs)
    ctx.actions.run_shell(
        outputs = [out],
        inputs = all_inputs,
        command = "printf '%s\\n' \"$@\" > " + out.path,
        arguments = lines + [ctx.actions.args().add_all(all_inputs)],
        mnemonic = "Consume",
    )
    return [DefaultInfo(files = depset([out]))]

consume = rule(
    implementation = _consume_impl,
    attrs = {"deps": attr.label_list(aspects = [collect], allow_files = True)},
)

consume_top = rule(
    implementation = _consume_impl,
    attrs = {"deps": attr.label_list(aspects = [collect, top])},
)

consume_gen = rule(
    implementation = _consume_impl,
    attrs = {"deps": attr.label_list(aspects = [gen_aspect], allow_files = True)},
)

def _bad_impl(target, ctx):
    return 1

bad_aspect = aspect(implementation = _bad_impl)

consume_bad = rule(
    implementation = _consume_impl,
    attrs = {"deps": attr.label_list(aspects = [bad_aspect])},
)

def _dup_impl(target, ctx):
    return [LibInfo(name = "dup")]

dup_aspect = aspect(implementation = _dup_impl)

consume_dup = rule(
    implementation = _consume_impl,
    attrs = {"deps": attr.label_list(aspects = [dup_aspect])},
)
