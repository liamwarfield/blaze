#!/usr/bin/env python3
"""Compares Blaze's aquery on workerd (or on any part of it) with the oracle's recording.

usage: scripts/workerd/aquery-compare '<query expression>' [--out DIR] [--raw FILE] [--full]
                                      [--make-unresolved-symlinks] [--order]
       scripts/workerd/aquery-compare index      (build the per-action index of the oracle record)
       scripts/workerd/aquery-compare help

Runs `scripts/workerd/run blaze aquery '<expr>' --output=jsonproto --include_param_files
--include_file_write_contents` (the recording's command; `--raw FILE` reads a saved stdout
instead), turns the output into one record per action with the referee's own code
(scripts/oracle/surfaces.py aquery_summary, keyed by primary output), and compares each record
with the action of the same key in the oracle recording
(~/.cache/blaze/oracle-records/oracle-9.3.2/workerd/norm/aquery_actions.json, the aquery of
deps(//src/workerd/server:workerd) on the built output base). An expression that selects part of
the target's closure is compared against the oracle's actions with the same keys, so analysis
work can be checked before the whole target analyses. `--full` also counts oracle actions that
Blaze did not print (use it with the recorded expression).

`paramFiles` depends on the order of the dump (Bazel lists a parameter file under an action only
when the action that writes it was printed earlier: ActionGraphDump.paramFileNameToContentMap),
and the order of a partial expression is not the recording's. Without --full, `paramFiles` is
therefore compared only for the files both sides list.

Output-base and workspace paths of both sides are replaced by <OB> and <WS>. Prints counts
(identical, different, not in the oracle record), a histogram of differing fields per mnemonic,
and writes DIR/diff.jsonl (one differing action per line: key, fields, both values) and
DIR/extra.txt. DIR defaults to ~/.cache/blaze/work/workerd-logs/aquery-compare. Exit 0 only when
every compared action is identical, nothing is extra and (with --full) nothing is missing.
`--make-unresolved-symlinks` first creates, in Blaze's execroot, the symlinks that the
`UnresolvedSymlink` actions of the expression would create (from Blaze's own aquery of
`mnemonic("^UnresolvedSymlink$", <expr>)`: output path and `unresolvedSymlinkTarget`). Without
them `--include_file_write_contents` makes aquery exit 8 ("build interrupted") on an output base
that was never built, in Bazel and in Blaze alike (docs/workerd.md): `SourceManifestAction` reads
the link targets from disk. It stands in for running those actions; nothing else is written.

`--order` (with `--full`, after the per-action comparison) also compares the referee's
`__order__` items (surfaces.py aquery_order: the order of the actions, each action's id-valued
fields, and the lists targets, artifacts, depSetOfFiles, pathFragments, configuration,
ruleClasses, aspectDescriptors as printed, ids included) between Blaze's output and the oracle's
normalised container norm/aquery_deps_jsonproto.json. It loads two 0.5 GB JSON documents one
after the other: run it in a memory-capped scope (`systemd-run --user --collect --wait --pipe
--same-dir -p MemoryMax=14G -p MemorySwapMax=0 ...`).

This is a development aid, not the referee: scores come from scripts/oracle.
Environment: BLAZE (binary), as scripts/workerd/run.
"""

import json
import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
sys.path.insert(0, os.path.join(ROOT, "scripts", "oracle"))
HOME = os.path.expanduser("~")
RECORD = os.path.join(HOME, ".cache/blaze/oracle-records/oracle-9.3.2/workerd")
LOGS = os.path.join(HOME, ".cache/blaze/work/workerd-logs")
INDEX = os.path.join(LOGS, "oracle-aquery.jsonl")
ORACLE_UR = "<BINARY_DIR>-out/ur-workerd/"
BLAZE_UR = os.path.join(HOME, ".cache/blaze/oracle-out/ur-workerd-blaze") + "/"


def canon_text(s, pairs):
    for a, b in pairs:
        if a in s:
            s = s.replace(a, b)
    return s


def canon(obj, pairs):
    if isinstance(obj, str):
        return canon_text(obj, pairs)
    if isinstance(obj, list):
        return [canon(x, pairs) for x in obj]
    if isinstance(obj, dict):
        return {canon_text(k, pairs): canon(v, pairs) for k, v in obj.items()}
    return obj


def output_base_prefix(user_root_prefix, text):
    """The `<user root>/<md5>` prefix found in `text`, if any."""
    i = text.find(user_root_prefix)
    if i < 0:
        return None
    rest = text[i + len(user_root_prefix):]
    return user_root_prefix + rest.split("/", 1)[0]


def oracle_pairs():
    ob = None
    for d in sorted(os.listdir(os.path.join(HOME, ".cache/blaze/oracle-out/ur-workerd"))):
        if d != "install":
            ob = ORACLE_UR + d
    pairs = []
    if ob:
        pairs.append((ob, "<OB>"))
    pairs.append(("<HOME>/.cache/blaze/work/workerd", "<WS>"))
    return pairs


def blaze_pairs():
    ob = None
    for d in sorted(os.listdir(BLAZE_UR)):
        if d != "install":
            ob = BLAZE_UR + d
    pairs = []
    if ob:
        pairs.append((ob, "<OB>"))
    pairs.append((os.path.join(HOME, ".cache/blaze/work/workerd-blaze"), "<WS>"))
    return pairs


def build_index():
    os.makedirs(LOGS, exist_ok=True)
    with open(os.path.join(RECORD, "norm", "aquery_actions.json")) as f:
        doc = json.load(f)
    pairs = oracle_pairs()
    offsets = {}
    with open(INDEX + ".tmp", "w") as out:
        for key, rec in doc.items():
            key = canon_text(key, pairs)
            offsets[key] = out.tell()
            out.write(json.dumps(canon(rec, pairs), sort_keys=True))
            out.write("\n")
    os.replace(INDEX + ".tmp", INDEX)
    with open(INDEX + ".idx", "w") as f:
        json.dump(offsets, f)
    print(f"indexed {len(offsets)} oracle actions into {INDEX}")


def load_index():
    if not os.path.exists(INDEX + ".idx"):
        # The record is 1.1 GB of JSON: index it once, in a memory-capped scope.
        subprocess.run(
            ["systemd-run", "--user", "--collect", "--wait", "--quiet", "--pipe", "-p", "MemoryMax=12G",
             "-p", "MemorySwapMax=0", sys.executable, "-I", os.path.abspath(__file__), "index"],
            check=True,
        )
    with open(INDEX + ".idx") as f:
        return json.load(f)


def make_unresolved_symlinks(expr, out_dir):
    listing = os.path.join(out_dir, "unresolved-symlinks.aquery.json")
    with open(listing, "w") as stdout, open(listing + ".stderr", "w") as stderr:
        rc = subprocess.run(
            [os.path.join(ROOT, "scripts/workerd/run"), "blaze", "aquery",
             'mnemonic("^UnresolvedSymlink$", %s)' % expr, "--output=jsonproto"],
            stdout=stdout, stderr=stderr, stdin=subprocess.DEVNULL,
        ).returncode
    if rc != 0:
        print(f"blaze aquery of the UnresolvedSymlink actions: exit {rc} (see {listing}.stderr)")
        return 1
    import surfaces  # noqa: E402

    with open(listing) as f:
        summary = surfaces.aquery_summary(json.load(f))
    output_base = None
    for d in sorted(os.listdir(BLAZE_UR)):
        if d != "install":
            output_base = os.path.join(BLAZE_UR, d)
    execroot = os.path.join(output_base, "execroot", "_main")
    made = 0
    for key, rec in summary.items():
        target = rec.get("unresolvedSymlinkTarget")
        if rec.get("mnemonic") != "UnresolvedSymlink" or target is None:
            print(f"unexpected action {key}: {rec.get('mnemonic')}")
            return 1
        link = os.path.join(execroot, key)
        os.makedirs(os.path.dirname(link), exist_ok=True)
        if os.path.lexists(link):
            os.remove(link)
        os.symlink(target, link)
        made += 1
    print(f"created {made} unresolved symlinks under {execroot}")
    return 0


def diff_fields(a, b):
    return sorted(k for k in set(a) | set(b) if a.get(k) != b.get(k))


def main(argv):
    if not argv or argv[0] in ("help", "--help", "-h"):
        print(__doc__)
        return 0
    if argv[0] == "index":
        build_index()
        return 0
    expr = argv[0]
    out_dir = os.path.join(LOGS, "aquery-compare")
    raw = None
    full = False
    make_symlinks = False
    order = False
    i = 1
    while i < len(argv):
        if argv[i] == "--out":
            out_dir = argv[i + 1]
            i += 2
        elif argv[i] == "--raw":
            raw = argv[i + 1]
            i += 2
        elif argv[i] == "--full":
            full = True
            i += 1
        elif argv[i] == "--make-unresolved-symlinks":
            make_symlinks = True
            i += 1
        elif argv[i] == "--order":
            order = True
            i += 1
        else:
            print(f"unknown argument {argv[i]}", file=sys.stderr)
            return 2
    os.makedirs(out_dir, exist_ok=True)
    if make_symlinks:
        rc = make_unresolved_symlinks(expr, out_dir)
        if rc != 0:
            return rc
    if raw is None:
        raw = os.path.join(out_dir, "blaze.aquery.json")
        with open(raw, "w") as stdout, open(os.path.join(out_dir, "blaze.aquery.stderr"), "w") as stderr:
            rc = subprocess.run(
                [os.path.join(ROOT, "scripts/workerd/run"), "blaze", "aquery", expr, "--output=jsonproto",
                 "--include_param_files", "--include_file_write_contents"],
                stdout=stdout, stderr=stderr, stdin=subprocess.DEVNULL,
            ).returncode
        if rc != 0:
            with open(os.path.join(out_dir, "blaze.aquery.stderr")) as f:
                tail = f.read().splitlines()
            first = next((l for l in tail if "not ported yet" in l or "panicked" in l or l.startswith("ERROR")), "")
            print(f"blaze aquery exit {rc}: {first[:400]}")
            return 1
    import surfaces  # noqa: E402  (the referee's extractor)

    with open(raw) as f:
        doc = json.load(f)
    blaze_order = None
    if order:
        doc = canon(doc, blaze_pairs())
        blaze_order = surfaces.aquery_order(doc, list(surfaces.aquery_summary(doc)))
    summary = canon(surfaces.aquery_summary(doc), blaze_pairs())
    del doc
    offsets = load_index()
    identical = 0
    different = 0
    extra = []
    hist = {}
    seen = set()
    with open(INDEX) as oracle, open(os.path.join(out_dir, "diff.jsonl"), "w") as diff_out:
        for key, rec in summary.items():
            if key not in offsets:
                extra.append((key, rec.get("mnemonic"), rec.get("target")))
                continue
            seen.add(key)
            oracle.seek(offsets[key])
            want = json.loads(oracle.readline())
            if not full and "paramFiles" in want and "paramFiles" in rec:
                theirs = {p.get("execPath") for p in want["paramFiles"]}
                ours = {p.get("execPath") for p in rec["paramFiles"]}
                want["paramFiles"] = [p for p in want["paramFiles"] if p.get("execPath") in ours]
                rec["paramFiles"] = [p for p in rec["paramFiles"] if p.get("execPath") in theirs]
            if want == rec:
                identical += 1
                continue
            different += 1
            fields = diff_fields(want, rec)
            for field in fields:
                k = (rec.get("mnemonic"), field)
                hist[k] = hist.get(k, 0) + 1
            diff_out.write(json.dumps({
                "key": key, "mnemonic": rec.get("mnemonic"), "target": rec.get("target"), "fields": fields,
                "oracle": {f: want.get(f) for f in fields}, "blaze": {f: rec.get(f) for f in fields},
            }, sort_keys=True))
            diff_out.write("\n")
    with open(os.path.join(out_dir, "extra.txt"), "w") as f:
        for key, mnemonic, target in extra:
            f.write(f"{mnemonic}\t{target}\t{key}\n")
    missing = [k for k in offsets if k not in seen] if full else []
    if full:
        with open(os.path.join(out_dir, "missing.txt"), "w") as f:
            for k in missing:
                f.write(k + "\n")
    print(f"blaze actions: {len(summary)}; oracle actions: {len(offsets)}")
    print(f"identical: {identical}; different: {different}; not in the oracle record: {len(extra)}"
          + (f"; missing from blaze: {len(missing)}" if full else ""))
    for (mnemonic, field), n in sorted(hist.items(), key=lambda kv: (-kv[1], str(kv[0]))):
        print(f"  {n:6d}  {mnemonic}.{field}")
    extra_hist = {}
    for _, mnemonic, _ in extra:
        extra_hist[mnemonic] = extra_hist.get(mnemonic, 0) + 1
    for mnemonic, n in sorted(extra_hist.items(), key=lambda kv: -kv[1]):
        print(f"  {n:6d}  extra {mnemonic}")
    print(f"details: {out_dir}/diff.jsonl, extra.txt" + (", missing.txt" if full else ""))
    order_ok = True
    if order:
        del summary
        with open(os.path.join(RECORD, "norm", "aquery_deps_jsonproto.json")) as f:
            oracle_doc = canon(json.load(f), oracle_pairs())
        oracle_order = surfaces.aquery_order(oracle_doc, list(surfaces.aquery_summary(oracle_doc)))
        del oracle_doc
        for name in sorted(set(oracle_order) | set(blaze_order)):
            a = (oracle_order.get(name) or {}).get("order")
            b = (blaze_order.get(name) or {}).get("order")
            if a == b:
                print(f"  {name}: equal ({len(a)} entries)")
                continue
            order_ok = False
            if a is None or b is None:
                print(f"  {name}: only on one side")
                continue
            n = next((j for j, (x, y) in enumerate(zip(a, b)) if x != y), min(len(a), len(b)))
            same = sum(1 for x, y in zip(a, b) if x == y)
            print(f"  {name}: DIFFERENT (oracle {len(a)}, blaze {len(b)} entries, {same} equal positions); "
                  f"first difference at {n}: oracle {json.dumps(a[n:n + 1])[:300]} blaze {json.dumps(b[n:n + 1])[:300]}")
    return 0 if different == 0 and not extra and not missing and order_ok else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
