#!/usr/bin/env python3
"""textproto/compare: check Blaze's protobuf TextFormat printer and parser against Bazel's output.

Usage:
  scripts/textproto/compare files <bep|cquery|aquery|single> <message type> <binary> <text>
  scripts/textproto/compare run <project> --binary B --out DIR [--steps build,cquery,aquery]
  scripts/textproto/compare check DIR
  scripts/textproto/compare bep-e2e <project> <reference DIR> <candidate DIR> [--verbose]
  scripts/textproto/compare selftest
  scripts/textproto/compare help

files    Prints <binary> (the binary output of a Bazel invocation) with Blaze's printer
         (target/debug/blaze-textproto, built with `scripts/cargo-capped build -p blaze_protos
         --bin blaze-textproto`; override with $BLAZE_TEXTPROTO) and compares the result byte
         for byte with <text> (the text output of the same invocation). Then round-trips every
         record: parse(print(m)) == m (Message.equals). Framings: see `blaze-textproto help`.
run      Runs binary B (the oracle or a Blaze binary) on a fresh copy of the corpus project, as
         scripts/oracle/record does (clean env, --nohome_rc --nosystem_rc, shared repository
         cache, memory cap): `mod graph`, then the project command with
         --build_event_text_file, --build_event_binary_file and --build_event_json_file; then
         cquery P --output=proto|textproto and aquery deps(P) --output=proto|textproto (P = the
         project's patterns joined with " + "); then `info` for the path context and
         `shutdown`. Writes DIR/{bep.txt,bep.pb,bep.json,cquery.pb,cquery.txt,aquery.pb,
         aquery.txt,*.stderr,exit_codes.json,context.json}. The workspace is
         ~/.cache/blaze/work/textproto-<DIR name>/<project>, the output user root
         ~/.cache/blaze/oracle-out/textproto-<DIR name> (both wiped first).
         Every command runs through scripts/lib/compare_common.py (a --scope unit with a
         supervisor), so exit_codes.json holds how each step really ended (`exit N`, `signal
         NAME`, `oom-kill`, `timeout`); provenance.json names the binary, its sha256, whether
         it is the pinned oracle, the repository HEAD and dirty flag, the terminations of
         `mod graph`, `info` and `shutdown`, and the sha256 of every file of DIR. Before the
         first step, run removes provenance.json, exit_codes.json, binary.txt and every other
         file it writes from DIR; provenance.json is written last.
check    `files` on every pair DIR holds (bep, cquery, aquery), and checks that the text BEP
         parsed back (blaze-textproto bep-text-to-json) equals DIR/bep.json event by event, in
         order. A pair whose records (or events) are equal only when sorted is
         IDENTICAL-REDUCED with the number of positions that differ, never IDENTICAL; so is a
         pair whose exit codes are legacy numbers (how the step ended is not fully known). A
         file whose digest differs from provenance.json refuses the check (exit 2); a DIR
         whose provenance holds no digests gets a SKIPPED `files-anchored` row (the check
         fails).
         Every step that produced a pair must have ended with exit 0 (exit_codes.json): a
         pair whose step failed, crashed or is missing is SKIPPED with the reason and makes the
         check fail, unless EXPECTED_GAPS (in this script) names the pair. DIR must have been
         recorded by the pinned oracle (its sha256 in UPSTREAM.json): a directory recorded by
         another binary is checked only for consistency with itself, the report says so, and
         the check never passes on it.
bep-e2e  Compares the --build_event_text_file of two runs: each is parsed back to JSON events
         and normalised with the referee's BEP normaliser (scripts/oracle/surfaces.normalise_bep,
         each run with its own path/user/host context), then compared item by item with the
         referee's allow list for the project, plus the progress skeleton (as scripts/bep-compare;
         also reported as a multiset, since the order of announcements varies between runs and
         even between two transports of one oracle run).

bep-e2e  refuses a reference DIR not recorded by the pinned oracle, and either DIR whose files are
         not all anchored by its provenance.json digests; judges the build step's termination
         on both sides (compare_common.judge).
selftest proves the guards with fake binaries (no real build): a crashed step, an empty
         pair, a non-oracle directory, signal deaths, the wrong oracle.

Exit status (check, bep-e2e): 0 only when something was compared and everything compared is
identical with no undeclared skip; 1 otherwise; 2 on a usage error or a refusal.
Python 3 standard library only.
"""
import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import shlex
import socket
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(os.path.dirname(HERE))
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(ROOT, "scripts", "lib"))
import compare_common as cc  # noqa: E402
sys.path.insert(0, os.path.join(ROOT, "scripts", "oracle"))
import oracle_common as oc  # noqa: E402
import oracle_compare as cmp  # noqa: E402
import surfaces  # noqa: E402
from normalise import Context  # noqa: E402


def load_record_module():
    path = os.path.join(ROOT, "scripts", "oracle", "record")
    loader = importlib.machinery.SourceFileLoader("oracle_record", path)
    spec = importlib.util.spec_from_loader("oracle_record", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def tool():
    return os.environ.get("BLAZE_TEXTPROTO") or os.path.join(ROOT, "target", "debug", "blaze-textproto")


PAIRS = [
    # name, framing, message type, binary file, text file
    ("bep", "bep", "build_event_stream.BuildEvent", "bep.pb", "bep.txt"),
    ("cquery", "cquery", "analysis.CqueryResult", "cquery.pb", "cquery.txt"),
    ("aquery", "aquery", "analysis.ActionGraphContainer", "aquery.pb", "aquery.txt"),
]
# The `run` steps (keys of exit_codes.json) that write each pair.
PAIR_STEPS = {
    "bep": ["build"],
    "cquery": ["cquery_proto", "cquery_textproto"],
    "aquery": ["aquery_proto", "aquery_textproto"],
}
# Pairs that `check` may skip without failing: {pair name: why}. Empty: every recorded step is
# expected to produce its pair.
EXPECTED_GAPS = {}


AQUERY_LABELS = (b"artifacts", b"actions", b"targets", b"dep_set_of_files", b"configuration",
                 b"aspect_descriptors", b"rule_classes", b"path_fragments")


def split_records(framing, data):
    """The records of a text output (each with its framing), in output order."""
    if framing == "bep":
        # `event {\n` ... `}\n\n`; strings never hold a raw newline.
        parts = data.split(b"}\n\nevent {\n")
        return [(b"" if i == 0 else b"event {\n") + part + (b"}\n\n" if i < len(parts) - 1 else b"")
                for i, part in enumerate(parts)]
    if framing == "aquery":
        # `<ActionGraphContainer field> {\n` at column 0 starts a record; no message inside one
        # has a field with one of these names.
        records, cur = [], []
        for line in data.splitlines(keepends=True):
            if any(line == l + b" {\n" for l in AQUERY_LABELS) and cur:
                records.append(b"".join(cur))
                cur = []
            cur.append(line)
        if cur:
            records.append(b"".join(cur))
        return records
    return None


def compare_files(framing, msg_type, binary, text, label=None):
    """Prints and round-trips; returns True when identical. Sets compare_files.waived when the
    printer's bytes were not compared (aquery: two invocations number records differently), and
    compare_files.reordered to the number of positions at which the records differ when they
    are equal only as a sorted list (record order ignored: a reduced comparison)."""
    compare_files.waived = False
    compare_files.reordered = 0
    label = label or os.path.basename(text)
    p = subprocess.run([tool(), "print", framing, msg_type, binary], stdout=subprocess.PIPE,
                       stderr=subprocess.PIPE)
    if p.returncode != 0:
        print("%s: blaze-textproto print failed: %s" % (label, p.stderr.decode(errors="replace").strip()))
        return False
    with open(text, "rb") as f:
        expected = f.read()
    got = p.stdout
    ok = got == expected
    if ok:
        print("%s: printer IDENTICAL (%d bytes)" % (label, len(expected)))
    elif split_records(framing, expected) is not None and \
            sorted(split_records(framing, expected)) == sorted(split_records(framing, got)):
        n = len(split_records(framing, expected))
        moved = sum(1 for x, y in zip(split_records(framing, expected), split_records(framing, got)) if x != y)
        print("%s: printer equal per record only (%d records, %d bytes); record order differs at "
              "%d positions (order ignored: IDENTICAL-REDUCED)" % (label, n, len(expected), moved))
        ok = True
        compare_files.reordered = max(moved, 1)
    else:
        i = next((k for k in range(min(len(got), len(expected))) if got[k] != expected[k]),
                 min(len(got), len(expected)))
        line = expected[:i].count(b"\n") + 1
        print("%s: printer DIFFERS at byte %d (line %d); expected %d bytes, got %d" % (
            label, i, line, len(expected), len(got)))
        print("  expected: %r" % expected[max(0, i - 80):i + 80])
        print("  got:      %r" % got[max(0, i - 80):i + 80])
    rp = subprocess.run([tool(), "reprint", framing, msg_type, text], stdout=subprocess.PIPE,
                        stderr=subprocess.PIPE)
    reprinted = rp.returncode == 0 and rp.stdout == expected
    print("%s: print(parse(text)) %s" % (
        label, "IDENTICAL to the text (%d bytes)" % len(expected) if reprinted else
        "DIFFERS: " + (rp.stderr.decode(errors="replace").strip()[:2000] or "%d vs %d bytes" % (
            len(rp.stdout), len(expected)))))
    if framing == "aquery" and not ok:
        # aquery numbers its records in output order, which differs between two invocations
        # (parallel output): the binary and text outputs cannot be compared byte for byte; the
        # printer is judged by print(parse(text)) on the text output.
        print("%s: (binary and text are separate aquery invocations with differently numbered "
              "records; not compared)" % label)
        ok = True
        compare_files.waived = True
    ok = ok and reprinted
    r = subprocess.run([tool(), "roundtrip", framing, msg_type, binary], stdout=subprocess.PIPE,
                       stderr=subprocess.PIPE)
    summary = r.stdout.decode().strip()
    print("%s: round trip %s (%s)" % (label, "OK" if r.returncode == 0 else "DIFFERS", summary))
    if r.returncode != 0:
        print(r.stderr.decode(errors="replace")[:4000])
    return ok and r.returncode == 0


def cmd_files(argv):
    if len(argv) != 4:
        print(__doc__)
        return 2
    return 0 if compare_files(*argv) else 1


def run_logged(argv, cwd, out_path, err_path):
    """Runs argv in a --scope unit (the server stays up between steps); returns the
    compare_common.Termination recorded inside the unit."""
    return cc.run(argv, cwd, mode="scope", stdout_path=out_path, stderr_path=err_path,
                  tag="textproto").term


LEGACY_NOTE = "legacy exit code (recorded before 2026-11-19): how the step ended beyond its " \
    "exit code (OOM kill, signal through a wrapper) was not recorded"


def step_term(value):
    """A step's termination from exit_codes.json: a Termination dict (this script), or a plain
    number (recorded before 2026-11-19 by an earlier version: a negative number is a signal; an
    OOM kill was not recorded)."""
    if isinstance(value, dict):
        return cc.Termination.from_dict(value)
    if isinstance(value, int):
        if value < 0:
            return cc.Termination("signal", 128 - value, "SIG%d" % -value,
                                  detail="legacy record")
        return cc.Termination("exit", value, detail="legacy record: OOM not checked")
    return None


# The files `run` writes into DIR (every one is removed before the first step, so a rewrite never
# leaves an earlier run's file under the new provenance; audit 4r2, B2).
RUN_FILES = ["bep.txt", "bep.pb", "bep.json", "cquery.pb", "cquery.txt", "aquery.pb",
             "aquery.txt", "info.txt", "context.json", "exit_codes.json", "binary.txt",
             "provenance.json"] + ["%s.%s" % (k, x) for k in (
                 "mod_graph", "build", "cquery_proto", "cquery_textproto", "aquery_proto",
                 "aquery_textproto", "info", "shutdown") for x in ("stdout", "stderr")]


def dir_files(d):
    """The digests of DIR's files that provenance.json anchors: every regular file but itself."""
    return {n: cc.sha256_file(os.path.join(d, n)) for n in sorted(os.listdir(d))
            if n != "provenance.json" and os.path.isfile(os.path.join(d, n))}


def anchored(d):
    """None when provenance.json of d holds the digest of every file it names and none changed;
    otherwise the reason (no digests: an older run; a file changed, is missing or was added)."""
    try:
        with open(os.path.join(d, "provenance.json")) as f:
            files = json.load(f).get("files")
    except (OSError, ValueError):
        return "no provenance.json"
    if not files:
        return "provenance.json holds no file digests (recorded before audit 4r2, B2)"
    now = dir_files(d)
    changed = sorted(n for n in set(files) | set(now) if files.get(n) != now.get(n))
    if changed:
        return "files changed, missing or added since the run wrote provenance.json: %s" % (
            ", ".join(changed[:5]))
    return None


def read_provenance(d):
    """{"binary", "sha256", "oracle"} of the binary that recorded d (provenance.json, else the
    older binary.txt), or None."""
    pj = os.path.join(d, "provenance.json")
    if os.path.exists(pj):
        with open(pj) as f:
            p = json.load(f)
        return {"binary": p["binary"]["path"], "sha256": p["binary"]["sha256"],
                "oracle": p["binary"]["sha256"] == cc.pinned_sha256(),
                "auxiliary": p.get("auxiliary") or {}}
    bt = os.path.join(d, "binary.txt")
    if os.path.exists(bt):
        words = open(bt).read().split()
        if len(words) >= 2:
            return {"binary": words[0], "sha256": words[1],
                    "oracle": words[1] == cc.pinned_sha256()}
    return None


def cmd_run(argv):
    ap = argparse.ArgumentParser(prog="compare run")
    ap.add_argument("project")
    ap.add_argument("--binary", required=True)
    ap.add_argument("--out", required=True)
    ap.add_argument("--steps", default="build,cquery,aquery")
    a = ap.parse_args(argv)
    steps = set(a.steps.split(","))
    rec = load_record_module()
    spec = oc.load_projects()[a.project] if hasattr(oc, "load_projects") else \
        json.load(open(os.path.join(ROOT, "corpus", "projects.json")))["projects"][a.project]
    out = os.path.abspath(a.out)
    os.makedirs(out, exist_ok=True)
    # B2 (audit 4r2): the provenance and the exit codes go first, then every file an earlier
    # run wrote here, so an interrupted rewrite leaves no file under an older provenance.
    for n in ["provenance.json", "exit_codes.json", "binary.txt"] + RUN_FILES:
        if os.path.lexists(os.path.join(out, n)):
            os.remove(os.path.join(out, n))
    name = os.path.basename(out.rstrip("/"))
    binary = os.path.abspath(oc.expand(a.binary))
    if not os.path.isfile(binary):
        return cc.refuse("textproto run", "binary %s does not exist" % binary)
    binary_sha = cc.sha256_file(binary)
    ws = os.path.join(oc.WORK, "textproto-" + name, a.project)
    root = os.path.join(oc.OUTPUT_ROOTS, "textproto-" + name)
    rec.kill_servers(root)
    rec.make_writable_and_remove(root)
    os.makedirs(root)
    rec.prepare_workspace(oc.expand(spec["checkout"]), ws)
    ws = os.path.realpath(ws)
    verb, patterns = spec["commands"][0][0], spec["commands"][0][1:]
    expr = " + ".join(patterns)
    startup = [binary, "--output_user_root=" + root, "--nohome_rc", "--nosystem_rc"]
    common = ["--repository_cache=" + oc.REPO_CACHE, "--color=no", "--curses=no"]
    cmds = [("mod_graph", ["mod", "graph", "--output=json"], None)]
    if "build" in steps:
        cmds.append(("build", [verb] + patterns + [
            "--build_event_text_file=" + os.path.join(out, "bep.txt"),
            "--build_event_binary_file=" + os.path.join(out, "bep.pb"),
            "--build_event_json_file=" + os.path.join(out, "bep.json"),
        ], None))
    if "cquery" in steps:
        cmds += [("cquery_proto", ["cquery", expr, "--output=proto"], "cquery.pb"),
                 ("cquery_textproto", ["cquery", expr, "--output=textproto"], "cquery.txt")]
    if "aquery" in steps:
        flags = ["--include_param_files", "--include_file_write_contents"]
        cmds += [("aquery_proto", ["aquery", "deps(%s)" % expr, "--output=proto"] + flags, "aquery.pb"),
                 ("aquery_textproto", ["aquery", "deps(%s)" % expr, "--output=textproto"] + flags,
                  "aquery.txt")]
    cmds.append(("info", ["info", "output_base", "execution_root", "install_base"], "info.txt"))
    codes = {}
    for key, args, stdout_name in cmds:
        verb_ = args[0]
        argv_ = startup + [verb_] + common + args[1:]
        stdout_path = os.path.join(out, stdout_name or (key + ".stdout"))
        term = run_logged(argv_, ws, stdout_path, os.path.join(out, key + ".stderr"))
        codes[key] = term.to_dict()
        print("[textproto] %s %s: %s" % (a.project, key, term), flush=True)
    codes["shutdown"] = run_logged(startup + ["shutdown"], ws,
                                   os.path.join(out, "shutdown.stdout"),
                                   os.path.join(out, "shutdown.stderr")).to_dict()
    rec.kill_servers(root)
    info = rec.parse_info(open(os.path.join(out, "info.txt"), encoding="utf-8", errors="replace").read())
    output_base = info.get("output_base") or os.path.join(root, hashlib.md5(ws.encode()).hexdigest())
    paths = {
        "execroot": info.get("execution_root") or os.path.join(output_base, "execroot", "_main"),
        "output_base": output_base,
        "install_base": info.get("install_base"),
        "output_user_root": root,
        "workspace": ws,
        "record_dir": out,
        "binary": binary,
        "binary_dir": os.path.dirname(binary),
        "home": oc.HOME,
    }
    user = os.environ.get("USER") or os.path.basename(oc.HOME)
    host = socket.gethostname().split(".")[0]
    with open(os.path.join(out, "context.json"), "w") as f:
        json.dump(Context(paths, user, host).to_dict(), f, indent=1)
    with open(os.path.join(out, "exit_codes.json"), "w") as f:
        json.dump(codes, f, indent=1)
    with open(os.path.join(out, "binary.txt"), "w") as f:
        f.write("%s %s\n" % (binary, binary_sha))
    tmp = os.path.join(out, "provenance.json.tmp")
    with open(tmp, "w") as f:
        json.dump({"binary": {"path": binary, "sha256": binary_sha,
                              "is_pinned_oracle": binary_sha == cc.pinned_sha256()},
                   "repo": cc.repo_state(), "project": a.project, "steps": sorted(steps),
                   "tool_sha256": cc.tool_sha256(os.path.abspath(__file__)),
                   "compare_common_sha256": cc.MODULE_SHA256,
                   "auxiliary": {k: codes[k] for k in ("mod_graph", "info", "shutdown")
                                 if k in codes},
                   "date": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                   "files": {n: h for n, h in dir_files(out).items()
                             if n != "provenance.json.tmp"}}, f, indent=1)
    os.replace(tmp, os.path.join(out, "provenance.json"))
    bad = [k for k, v in codes.items() if not step_term(v).ok]
    if bad:
        print("[textproto] steps that did not exit 0: %s" % ", ".join(
            "%s (%s)" % (k, step_term(codes[k])) for k in bad))
    return 1 if bad else 0


def text_bep_events(path):
    p = subprocess.run([tool(), "bep-text-to-json", path], stdout=subprocess.PIPE,
                       stderr=subprocess.PIPE)
    if p.returncode != 0:
        raise SystemExit("bep-text-to-json %s: %s" % (path, p.stderr.decode(errors="replace")))
    return [json.loads(l) for l in p.stdout.decode("utf-8").splitlines() if l.strip()]


def cmd_check(argv, report_out=None):
    if len(argv) != 1:
        print(__doc__)
        return 2
    d = argv[0]
    prov = read_provenance(d)
    rep = cc.Report("textproto check %s" % d,
                    blaze={"path": tool(), "sha256": cc.sha256_file(tool())
                           if os.path.exists(tool()) else None},
                    oracle={"path": prov["binary"], "sha256": prov["sha256"]}
                    if prov and prov["oracle"] else None,
                    selection="pairs %s, bep text against bep.json; %s recorded by %s" % (
                        ", ".join(p[0] for p in PAIRS), d,
                        "%s sha256 %s" % (prov["binary"], prov["sha256"]) if prov else "?"),
                    tool_files=[os.path.abspath(__file__)])
    rep.prov["blaze"]["role"] = "blaze-textproto (the printer under test)"
    rep.print_header()
    self_only = not (prov and prov["oracle"])
    if self_only:
        print("  NOTE: %s was not recorded by the pinned oracle (%s): the check compares that "
              "binary's own text with Blaze's printer; it is not oracle evidence and never "
              "passes" % (d, prov["sha256"] if prov else "no provenance"))
    why = anchored(d)
    if why is not None and why.startswith("files changed"):
        return cc.refuse("textproto check", "%s: %s" % (d, why))
    if why is not None:
        rep.add("files-anchored", cc.SKIPPED, why + ": the files cannot be tied to the binary "
                "the provenance names")
    for k, v in sorted((prov or {}).get("auxiliary", {}).items()):
        t = step_term(v)
        if t is not None:
            rep.add_aux(k, t)
    try:
        with open(os.path.join(d, "exit_codes.json")) as f:
            codes = json.load(f)
    except (OSError, ValueError):
        codes = None
    for name, framing, msg_type, binary, text in PAIRS:
        legacy = codes is not None and any(isinstance(codes.get(k), int)
                                           for k in PAIR_STEPS[name])
        b, t = os.path.join(d, binary), os.path.join(d, text)
        if codes is None:
            reason = "no exit_codes.json: the steps' terminations are unknown"
        else:
            steps = PAIR_STEPS[name]
            missing = [k for k in steps if k not in codes]
            failed = ["%s %s" % (k, step_term(codes[k])) for k in steps
                      if k in codes and not (step_term(codes[k]) and step_term(codes[k]).ok)]
            reason = None
            if len(missing) == len(steps):
                reason = "step(s) %s not recorded (not selected with --steps)" % ", ".join(steps)
            elif missing:
                reason = "step(s) %s missing from exit_codes.json" % ", ".join(missing)
            elif failed:
                reason = "step(s) did not exit 0: %s" % "; ".join(failed)
        if reason is None and not (os.path.exists(b) and os.path.exists(t)):
            reason = "%s or %s not recorded" % (binary, text)
        if reason is None and os.path.getsize(b) == 0 and os.path.getsize(t) == 0:
            reason = "both files empty"
        if reason is not None:
            if legacy:
                reason += "; " + LEGACY_NOTE
            if name in EXPECTED_GAPS:
                rep.add(name, cc.DECLARED_GAP, "%s (declared: %s)" % (reason, EXPECTED_GAPS[name]))
            else:
                rep.add(name, cc.SKIPPED, reason)
            print("%s: SKIPPED: %s" % (name, reason))
            continue
        same = compare_files(framing, msg_type, b, t,
                             label="%s/%s" % (os.path.basename(d.rstrip("/")), name))
        note = "; " + LEGACY_NOTE if legacy else ""
        if same and compare_files.waived:
            rep.add(name, cc.REDUCED, "printer bytes not compared (the binary and text outputs "
                    "are two aquery invocations that number records differently); reprint of "
                    "the text and round trip of the binary only" + note)
        elif same and compare_files.reordered:
            rep.add(name, cc.REDUCED, "printer equal per record, record order ignored (differs "
                    "at %d positions); reprint, round trip%s" % (compare_files.reordered, note))
        elif same and legacy:
            rep.add(name, cc.REDUCED, "printer, reprint, round trip" + note)
        else:
            rep.add(name, cc.IDENTICAL if same else cc.DIFFERENT,
                    "printer, reprint, round trip")
    jp, tp = os.path.join(d, "bep.json"), os.path.join(d, "bep.txt")
    if os.path.exists(jp) and os.path.exists(tp) and \
            not any(r["case"] == "bep" and r["class"] in (cc.SKIPPED, cc.DECLARED_GAP)
                    for r in rep.rows):
        from_text = text_bep_events(tp)
        with open(jp, encoding="utf-8") as f:
            from_json = [json.loads(l) for l in f if l.strip()]
        ct = [oc.canonical(x) for x in from_text]
        cj = [oc.canonical(x) for x in from_json]
        same = sorted(ct) == sorted(cj)
        moved = sum(1 for x, y in zip(ct, cj) if x != y) + abs(len(ct) - len(cj))
        print("bep: text parsed back == bep.json: %s (%d / %d events%s)" % (
            ("IDENTICAL" if not moved else "equal only as a multiset (IDENTICAL-REDUCED)")
            if same else "DIFFERS", len(from_text), len(from_json),
            "; order differs at %d positions" % moved if same and moved else ""))
        if not same:
            missing = sorted(set(cj) - set(ct))
            extra = sorted(set(ct) - set(cj))
            for x in missing[:3]:
                print("  only in json: %s" % x[:600])
            for x in extra[:3]:
                print("  only in text: %s" % x[:600])
        if same and moved:
            rep.add("bep-text-vs-json", cc.REDUCED, "%d / %d events equal as a multiset; event "
                    "order ignored (differs at %d positions)" % (len(from_text), len(from_json),
                                                                 moved))
        else:
            rep.add("bep-text-vs-json", cc.IDENTICAL if same else cc.DIFFERENT,
                    "%d / %d events in order" % (len(from_text), len(from_json)))
    else:
        rep.add("bep-text-vs-json", cc.SKIPPED, "bep pair skipped or bep.json/bep.txt missing")
    if self_only:
        rep.add("recorded-by-oracle", cc.SKIPPED,
                "directory not recorded by the pinned oracle: no oracle evidence")
    print()
    rep.print_rows()
    rep.print_footer()
    if report_out is not None:
        report_out.append(rep)
    return rep.exit_code()


def progress_skeleton(events):
    out = []
    for e in events:
        if "progress" in e.get("id", {}):
            children = [{"namedSet": {}} if "namedSet" in c else c for c in e.get("children", [])]
            out.append({"id": e["id"], "children": children, "last": bool(e.get("lastMessage"))})
    return out


def cmd_bep_e2e(argv):
    ap = argparse.ArgumentParser(prog="compare bep-e2e")
    ap.add_argument("project")
    ap.add_argument("reference")
    ap.add_argument("candidate")
    ap.add_argument("--verbose", action="store_true")
    ap.add_argument("--binary", help="the Blaze binary that recorded the candidate")
    a = ap.parse_args(argv)

    def load(d):
        ctx = Context.from_dict(json.load(open(os.path.join(d, "context.json"))))
        events = text_bep_events(os.path.join(d, "bep.txt"))
        return events, surfaces.normalise_bep(ctx, events)

    ref_prov, cand_prov = read_provenance(a.reference), read_provenance(a.candidate)
    if not (ref_prov and ref_prov["oracle"]):
        return cc.refuse("textproto bep-e2e", "reference %s was not recorded by the pinned oracle "
                         "(%s)" % (a.reference, ref_prov["sha256"] if ref_prov else
                                   "no provenance"))
    if not cand_prov:
        return cc.refuse("textproto bep-e2e", "candidate %s has no provenance: the binary that "
                         "recorded it is unknown" % a.candidate)
    if cand_prov["oracle"] or cand_prov["sha256"] == cc.PINNED_SHA256:
        return cc.refuse("textproto bep-e2e", "candidate %s was recorded by the oracle" %
                         a.candidate)
    for role, d in (("reference", a.reference), ("candidate", a.candidate)):
        why = anchored(d)
        if why is not None:
            return cc.refuse("textproto bep-e2e", "%s %s: %s" % (role, d, why))
    named = None
    if a.binary:
        try:
            named = cc.blaze_identity(a.binary)
        except cc.Refusal as e:
            return cc.refuse("textproto bep-e2e", e)
        if named["sha256"] != cand_prov["sha256"]:
            return cc.refuse("textproto bep-e2e", "candidate %s was recorded by sha256 %s, not "
                             "by the named %s" % (a.candidate, cand_prov["sha256"], a.binary))
    rep = cc.Report("textproto bep-e2e %s" % a.project,
                    blaze={"path": cand_prov["binary"], "sha256": cand_prov["sha256"]},
                    oracle={"path": ref_prov["binary"], "sha256": ref_prov["sha256"]},
                    selection="%s against %s" % (a.candidate, a.reference),
                    tool_files=[os.path.abspath(__file__)],
                    compared="the build's termination, its BEP text (referee normaliser and "
                             "allow list) and progress skeleton, the build's whole stderr after "
                             "the exclusion rules listed at the end")
    norm = cc.Normaliser(cc.VOLATILE_RULES + cc.B1_GAP_RULES)
    rep.add_normaliser(norm)
    if named is None:
        rep.add("candidate-binary", cc.SKIPPED, "the binary that recorded the candidate was not "
                "named (--binary)")
    for role, prov in (("oracle", ref_prov), ("blaze", cand_prov)):
        for k, v in sorted(prov.get("auxiliary", {}).items()):
            t = step_term(v)
            if t is not None:
                rep.add_aux("%s %s" % (role, k), t)
    rep.print_header()

    def build_term(d):
        try:
            return step_term(json.load(open(os.path.join(d, "exit_codes.json"))).get("build"))
        except (OSError, ValueError):
            return None
    ot, bt = build_term(a.reference), build_term(a.candidate)
    if ot is None or bt is None or not os.path.exists(os.path.join(a.candidate, "bep.txt")):
        rep.add("bep", cc.SKIPPED, "build step termination or bep.txt missing (oracle %s, "
                "blaze %s)" % (ot, bt))
        rep.print_rows()
        rep.print_footer()
        return rep.exit_code()
    ref_events, ref = load(a.reference)
    cand_events, cand = load(a.candidate)
    allow = cmp.AllowList()
    counts = {"MATCH": 0, "ALLOWED": 0, "DIFF": 0, "MISSING": 0, "EXTRA": 0}
    for key in sorted(set(ref) | set(cand)):
        if key not in cand:
            kind, paths = "MISSING", []
        elif key not in ref:
            kind, paths = "EXTRA", []
        elif oc.canonical(ref[key]) == oc.canonical(cand[key]):
            counts["MATCH"] += 1
            continue
        else:
            kind, paths = "DIFF", cmp.diff_paths(ref[key], cand[key])
        if allow.match(a.project, "bep", key, kind, paths):
            counts["ALLOWED"] += 1
            continue
        counts[kind] += 1
        print("%s %s" % (kind, key[:160]))
        if kind == "DIFF":
            for line in cmp.describe_diff(ref[key], cand[key], paths)[: (40 if a.verbose else 8)]:
                print(line)
    po, pc = progress_skeleton(ref_events), progress_skeleton(cand_events)
    progress_ok = oc.canonical(po) == oc.canonical(pc)
    # Which progress event announces which event depends on thread timing; even one oracle
    # invocation's text and JSON files differ in it. The multiset ignores that order.
    multiset_ok = sorted(oc.canonical(x) for x in po) == sorted(oc.canonical(x) for x in pc)
    if not progress_ok:
        print("PROGRESS skeleton differs in order: reference %d events, candidate %d" % (len(po), len(pc)))
        for x, y in zip(po, pc):
            if x != y:
                print("  - %s\n  + %s" % (oc.canonical(x), oc.canonical(y)))
    print("%s bep text: %d items: %s; progress skeleton %s in order, %s as a multiset (%d events)" % (
        a.project, len(set(ref) | set(cand)), ", ".join("%s %d" % kv for kv in counts.items()),
        "MATCH" if progress_ok else "DIFF", "MATCH" if multiset_ok else "DIFF", len(pc)))
    bad = counts["DIFF"] + counts["MISSING"] + counts["EXTRA"]
    differing = (["bep items (%d)" % bad] if bad else []) + \
        ([] if progress_ok else ["progress skeleton order"])
    def ctx_pairs(d):
        try:
            paths = json.load(open(os.path.join(d, "context.json"))).get("paths", {})
        except (OSError, ValueError):
            return []
        return [(v, "<%s>" % k.upper()) for k, v in paths.items() if v and len(v) > 1]

    def raw(d, n):
        try:
            return open(os.path.join(d, n), "rb").read()
        except OSError:
            return b""
    eq, gaps = norm.compare(raw(a.reference, "build.stderr"), raw(a.candidate, "build.stderr"),
                            "stderr", ctx_pairs(a.reference), ctx_pairs(a.candidate))
    if not eq:
        differing.append("build stderr")
    cls, detail = cc.judge(ot, bt, differing, gaps=gaps)
    rep.add("bep", cls, detail)
    rep.print_rows()
    rep.print_footer()
    return rep.exit_code()


def main(argv):
    if len(argv) < 2 or argv[1] in ("help", "--help", "-h"):
        print(__doc__)
        return 0 if len(argv) >= 2 else 2
    sub, rest = argv[1], argv[2:]
    if sub == "files":
        return cmd_files(rest)
    if sub == "run":
        return cmd_run(rest)
    if sub == "check":
        return cmd_check(rest)
    if sub == "bep-e2e":
        return cmd_bep_e2e(rest)
    if sub == "selftest":
        return selftest()
    print(__doc__)
    return 2


def _fake_with(path, fh, line, role):
    """A compare_common fake with one more shell line run before it prints anything."""
    lines = cc.fake_script(out=b"", token=fh.token, tripfile=fh.tripfile, role=role).split("\n")
    at = next(i for i, x in enumerate(lines) if x.startswith("cmd="))
    lines.insert(at, line)
    with open(path, "w") as f:
        f.write("\n".join(lines))
    os.chmod(path, 0o755)
    return path


def selftest_b2(st, fh, me):
    """B2 (audit 4r2): a rewrite removes the old provenance first; digests anchor the files."""
    d = os.path.join(fh.root, "rec-rewrite")
    o, _ = fh.fakes(dict(out=b"x"), dict(out=b"x"))
    fh.run_tool(me, ["run", "brotli", "--binary", o, "--out", d, "--steps", "cquery"])
    st.check("B2: provenance.json holds the files' digests",
             "cquery.pb" in json.load(open(os.path.join(d, "provenance.json"))).get("files", {}))
    marker = os.path.join(fh.root, "stale-provenance")
    b = _fake_with(os.path.join(fh.home, "bin", "blaze-rewrite"), fh,
                   # During the first step (mod graph), before any output of this run.
                   'case " $* " in *" mod "*) for f in provenance.json exit_codes.json '
                   'binary.txt cquery.pb cquery.txt; do [ -e %s/$f ] && echo $f >> %s; done;; '
                   'esac' % (shlex.quote(d), shlex.quote(marker)),
                   "blaze-rewrite")
    fh.run_tool(me, ["run", "brotli", "--binary", b, "--out", d, "--steps", "cquery"])
    st.check("B2: no earlier provenance, exit code or output is present while a rewrite runs",
             not os.path.exists(marker),
             open(marker).read().replace("\n", " ") if os.path.exists(marker) else "")
    # A changed file refuses check and bep-e2e; a directory without digests cannot pass.
    o, _ = fh.fakes(dict(out=b"x"), dict(out=b"x"))
    t = os.path.join(fh.root, "rec-tamper")
    fh.run_tool(me, ["run", "brotli", "--binary", o, "--out", t, "--steps", "build"])
    with open(os.path.join(t, "build.stderr"), "ab") as f:
        f.write(b"tampered\n")
    rc, _, log = fh.run_tool(me, ["check", t])
    st.check("B2: check refuses a directory whose files changed (exit 2)", rc == 2,
             "exit %s" % rc)
    cand = os.path.join(fh.root, "rec-cand")
    rc, _, log = fh.run_tool(me, ["bep-e2e", "brotli", t, cand])
    st.check("B2: bep-e2e refuses a reference whose files changed (exit 2)", rc == 2,
             "exit %s" % rc)
    pj = os.path.join(t, "provenance.json")
    prov = json.load(open(pj))
    prov.pop("files")
    with open(pj, "w") as f:
        json.dump(prov, f)
    rc, rep, log = fh.run_tool(me, ["check", t])
    rows = {r["case"]: r for r in (rep or {}).get("cases", [])}
    st.check("B2: a directory without digests gets a SKIPPED files-anchored row",
             rc == 1 and rows.get("files-anchored", {}).get("class") == cc.SKIPPED,
             "exit %s, %s" % (rc, rows.get("files-anchored")))


def selftest_b4(st, fh, me):
    """B4 and T6 (audit 4r2): order-free equality is IDENTICAL-REDUCED; legacy codes say so."""
    d = os.path.join(fh.root, "rec-order")
    os.makedirs(d)
    text = b"event {\n  a: 1\n}\n\nevent {\n  b: 2\n}\n\n"
    swapped = b"event {\n  b: 2\n}\n\nevent {\n  a: 1\n}\n\n"
    files = {"bep.txt": text, "bep.pb": b"pb", "printed.bin": swapped,
             "bep.json": b'{"a": 1}\n{"b": 2}\n', "parsed.json": b'{"b": 2}\n{"a": 1}\n'}
    for n, data in files.items():
        with open(os.path.join(d, n), "wb") as f:
            f.write(data)
    tp = os.path.join(fh.root, "fake-textproto")
    with open(tp, "w") as f:
        f.write("#!/bin/bash\ncase \"$1\" in\n print) cat %s/printed.bin;;\n reprint) cat \"$4\";;\n"
                " roundtrip) echo 2 records;;\n bep-text-to-json) cat %s/parsed.json;;\nesac\n"
                % (d, d))
    os.chmod(tp, 0o755)

    def provenance(codes):
        with open(os.path.join(d, "exit_codes.json"), "w") as f:
            json.dump(codes, f)
        with open(os.path.join(d, "provenance.json"), "w") as f:
            json.dump({"binary": {"path": fh.oracle, "sha256": cc.sha256_file(fh.oracle)},
                       "files": dir_files(d)}, f)
    old = os.environ.get("BLAZE_TEXTPROTO")
    os.environ["BLAZE_TEXTPROTO"] = tp
    try:
        fh.fakes(dict(out=b"x"), dict(out=b"x"))
        provenance({"build": {"kind": "exit", "code": 0}})
        rc, rep, log = fh.run_tool(me, ["check", d])
        rows = {r["case"]: r for r in (rep or {}).get("cases", [])}
        st.check("B4: bep records equal only when sorted are IDENTICAL-REDUCED",
                 rows.get("bep", {}).get("class") == cc.REDUCED, str(rows.get("bep")))
        st.check("B4: bep events equal only as a multiset are IDENTICAL-REDUCED",
                 rows.get("bep-text-vs-json", {}).get("class") == cc.REDUCED and rc == 1,
                 "exit %s, %s" % (rc, rows.get("bep-text-vs-json")))
        provenance({"build": 0})
        rc, rep, log = fh.run_tool(me, ["check", d])
        rows = {r["case"]: r for r in (rep or {}).get("cases", [])}
        st.check("T6: a legacy exit code is named on the row",
                 "legacy exit code" in rows.get("bep", {}).get("detail", ""),
                 str(rows.get("bep")))
    finally:
        if old is None:
            os.environ.pop("BLAZE_TEXTPROTO", None)
        else:
            os.environ["BLAZE_TEXTPROTO"] = old


def selftest():
    """The real command lines (`run`, `check`, `bep-e2e`) against fake binaries."""
    st = cc.Selftest("textproto/compare")
    fh = cc.FakeHome("textproto")
    me = os.path.abspath(__file__)
    try:
        o, b = fh.fakes(dict(out=b"x"), dict(out=b"x"))
        st.check("tripwire trips on a direct launch",
                 subprocess.run([b, "build"], capture_output=True).returncode == 99
                 and fh.tripped())
        if fh.tripped():
            os.remove(fh.tripfile)
        # B3-1 through the real path: the aquery steps crash (exit 101) and print nothing.
        o, b = fh.fakes(dict(out=b""), dict(out=b""), when=[("aquery", 101)])
        rec = os.path.join(fh.root, "rec-crash")
        rc, _, log = fh.run_tool(me, ["run", "brotli", "--binary", o, "--out", rec,
                                      "--steps", "aquery"])
        st.check("run reports the steps that did not exit 0", rc == 1, "exit %s (%s)" % (rc, log))
        rc, rep, log = fh.run_tool(me, ["check", rec])
        rows = {r["case"]: r for r in (rep or {}).get("cases", [])}
        st.check("check: crashed aquery steps fail the run", rc == 1, "exit %s" % rc)
        st.check("check: the aquery pair is SKIPPED with exit 101",
                 rows.get("aquery", {}).get("class") == cc.SKIPPED
                 and "exit 101" in rows.get("aquery", {}).get("detail", ""),
                 rows.get("aquery", {}).get("detail", "no row"))
        # A death by SIGPIPE recorded by the launcher is not an exit 0.
        o, b = fh.fakes(dict(out=b"x", sig="PIPE"), dict(out=b"x"))
        rec2 = os.path.join(fh.root, "rec-sigpipe")
        fh.run_tool(me, ["run", "brotli", "--binary", o, "--out", rec2, "--steps", "cquery"])
        rc, rep, log = fh.run_tool(me, ["check", rec2])
        rows = {r["case"]: r for r in (rep or {}).get("cases", [])}
        st.check("check: a SIGPIPE step is SKIPPED, run fails",
                 rc == 1 and "SIGPIPE" in rows.get("cquery", {}).get("detail", ""),
                 rows.get("cquery", {}).get("detail", "no row"))
        # A directory recorded by another binary never passes.
        o, b = fh.fakes(dict(out=b"x"), dict(out=b"x"))
        rec3 = os.path.join(fh.root, "rec-blaze")
        fh.run_tool(me, ["run", "brotli", "--binary", b, "--out", rec3, "--steps", "cquery"])
        rc, rep, log = fh.run_tool(me, ["check", rec3])
        st.check("check: a directory recorded by Blaze fails", rc == 1, "exit %s" % rc)
        # bep-e2e refusals.
        refd = os.path.join(fh.root, "rec-ref")
        fh.run_tool(me, ["run", "brotli", "--binary", o, "--out", refd, "--steps", "build"])
        cand = os.path.join(fh.root, "rec-cand")
        fh.run_tool(me, ["run", "brotli", "--binary", b, "--out", cand, "--steps", "build"])
        rc, _, _ = fh.run_tool(me, ["bep-e2e", "brotli", refd, refd])
        st.check("bep-e2e: a candidate recorded by the oracle is refused", rc == 2, "exit %s" % rc)
        rc, _, _ = fh.run_tool(me, ["bep-e2e", "brotli", cand, cand])
        st.check("bep-e2e: a reference not recorded by the oracle is refused", rc == 2,
                 "exit %s" % rc)
        other = cc.make_fake(os.path.join(fh.home, "bin", "other"), token=fh.token,
                             tripfile=fh.tripfile, role="other")
        rc, _, _ = fh.run_tool(me, ["bep-e2e", "brotli", refd, cand, "--binary", other])
        st.check("bep-e2e: a candidate of another binary is refused", rc == 2, "exit %s" % rc)
        rc, _, _ = fh.run_tool(me, ["bep-e2e", "brotli", refd, cand], pin="0" * 64)
        st.check("bep-e2e: wrong pin refuses the reference", rc == 2, "exit %s" % rc)
        selftest_b2(st, fh, me)
        selftest_b4(st, fh, me)
        st.check("no process started outside the launcher", not fh.tripped(),
                 open(fh.tripfile).read()[:200] if fh.tripped() else "")
    except Exception as e:  # noqa: BLE001
        import traceback
        traceback.print_exc()
        st.check("selftest ran to the end", False, str(e))
    finally:
        if not st.failures:
            fh.remove()
        else:
            print("  (fake HOME kept: %s)" % fh.root)
    return st.finish()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
