class Side:
    def __init__(self, name, binary, root, env, daemon):
        self.name = name
        self.binary = binary
        self.root = root
        self.ws = os.path.join(root, "ws")
        self.out_root = os.path.join(root, "ur")
        self.daemon = daemon
        self.env = {"HOME": HOME, "PATH": "/usr/bin:/bin"}
        self.env.update(env)

    def path(self, rel):
        return os.path.join(self.root, rel)

    def run(self, args, env=None, timeout=900, interrupt_after=None, during=None):
        e = dict(self.env)
        if env:
            e.update(env)
        cmd = [self.binary, "--output_user_root=" + self.out_root, "--nohome_rc",
               "--nosystem_rc"]
        if self.daemon:
            cmd.append("--max_idle_secs=900")
        p = subprocess.Popen(cmd + args, cwd=self.ws, env=e, stdout=subprocess.PIPE,
                             stderr=subprocess.PIPE)
        timer = None
        if during is not None:
            delay, fn = during
            timer = threading.Timer(delay, fn)
            timer.start()
        if interrupt_after is not None:
            time.sleep(interrupt_after)
            p.send_signal(signal.SIGINT)
        try:
            out, err = p.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            p.kill()
            out, err = p.communicate()
            return 124, out.decode("utf-8", "replace"), err.decode("utf-8", "replace")
        finally:
            if timer is not None:
                timer.join()
        return p.returncode, out.decode("utf-8", "replace"), err.decode("utf-8", "replace")

    def bazel_bin(self):
        code, out, _ = self.run(["info", "--symlink_prefix=/", "bazel-bin"])
        return out.strip() if code == 0 else None

    def shutdown(self):
        if not self.daemon:
            return
        try:
            self.run(["shutdown"], timeout=120)
        except Exception:
            pass
        if not os.path.isdir(self.out_root):
            return
        for d in os.listdir(self.out_root):
            try:
                pid = int(read(os.path.join(self.out_root, d, "server", "server.pid.txt")))
                with open("/proc/%d/cmdline" % pid, "rb") as f:
                    if self.out_root in f.read().decode("utf-8", "replace"):
                        os.kill(pid, signal.SIGKILL)
            except Exception:
                pass


