def output_tree(side, bb):
    """{relative path: (sha256 or link target, exec bit)} of every file under bazel-bin."""
    result = {}
    if not bb or not os.path.isdir(bb):
        return result
    for d, dirs, fs in os.walk(bb):
        for f in fs + [x for x in dirs if os.path.islink(os.path.join(d, x))]:
            p = os.path.join(d, f)
            rel = os.path.relpath(p, bb)
            if os.path.islink(p):
                target = os.readlink(p)
                target = target.replace(side.out_root, "<OUT_ROOT>").replace(side.root, "<ROOT>")
                target = re.sub(r"\b[0-9a-f]{32}\b", "<HASH>", target)
                result[rel] = ("link:" + target, False)
                continue
            h = hashlib.sha256()
            with open(p, "rb") as fh:
                h.update(fh.read())
            result[rel] = (h.hexdigest(), os.access(p, os.X_OK))
    return result


VOLATILE = [
    re.compile(r"^(Loading|Analyzing|Computing main repo mapping|Fetching|Building|Starting local|Extracting)\b"),
    re.compile(r"^\[[\d,]+ / [\d,]+\]"),
    re.compile(r"^INFO: (Invocation ID|Elapsed time|Streaming build results|Reading rc options|Current date)"),
    re.compile(r"^\s*$"),
    re.compile(r"^Another command .* is running"),
    re.compile(r"^(Server terminated|Starting local Bazel server|.* still trying to connect)"),
]


def norm_lines(text, side):
    lines = []
    for line in text.splitlines():
        line = line.replace(side.out_root, "<OUT_ROOT>").replace(side.root, "<ROOT>")
        line = re.sub(r"\b[0-9a-f]{32}\b", "<HASH>", line)
        line = re.sub(r"\d+\.\d+s\b", "<T>s", line)
        if any(r.search(line) for r in VOLATILE):
            continue
        lines.append(line)
    return lines


def problem_lines(text, side):
    return sorted({
        l for l in norm_lines(text, side)
        if (l.startswith("ERROR:") or l.startswith("WARNING:"))
        and "discarding analysis cache" not in l
        and l != "WARNING: Target pattern parsing failed."
    })


# ---------------------------------------------------------------------------------------------
# Edits. An edit is decided once (with the round's random numbers) and applied to every side's
# copy as a function of the side's root directory.


class Editor:
    def __init__(self, rng, roots):
        self.rng = rng
        self.master = roots[0]  # decisions read A's copy; all copies are equal between rounds
        self.counter = 0
        self.extra_pkgs = []
        self.broken = None
        # Command options set by edits.
        self.opts = {}

    def m(self, rel):
        return os.path.join(self.master, rel)

    def txt_files(self):
        out = []
        for i in range(4):
            for f in sorted(os.listdir(self.m("ws/pkg%d" % i))):
                if f.endswith(".txt"):
                    out.append("ws/pkg%d/%s" % (i, f))
        return out

    def toggle(self, key, value):
        if key in self.opts:
            del self.opts[key]
            return "%s off" % key
        self.opts[key] = value
        return "%s on" % key

    def edit(self):
        """Returns (description, op(root) or None)."""
        self.counter += 1
        n = self.counter
        r = self.rng
        if self.broken is not None and r.random() < 0.7:
            rel = self.broken
            self.broken = None
            return "repair " + rel, lambda root: replace_in(root, rel, "this is not starlark(\n", "")
        kind = r.choice(KINDS)
        files = self.txt_files()
        if kind == "same-size":
            rel = r.choice(files)
            text = read(self.m(rel))
            i = r.randrange(len(text) - 1)
            c = r.choice([x for x in "abcdefgh" if x != text[i]])
            new = text[:i] + c + text[i + 1:]
            return "same-size rewrite " + rel, lambda root: write(os.path.join(root, rel), new)
        if kind == "double-edit":
            rel = r.choice(files)
            text = read(self.m(rel))

            def op(root):
                write(os.path.join(root, rel), text.replace("a", "x", 1))
                write(os.path.join(root, rel), text.replace("a", "y", 1))
            return "two same-size rewrites at once " + rel, op
        if kind == "append":
            rel = r.choice(files)
            return "append " + rel, lambda root: append(root, rel, "line %d\n" % n)
        if kind == "touch":
            rel = r.choice(files)
            return "touch " + rel, lambda root: os.utime(os.path.join(root, rel), None)
        if kind == "add-glob":
            rel = "ws/pkg%d/n%d.txt" % (r.randrange(4), n)
            return "add glob file " + rel, lambda root: write(os.path.join(root, rel), "new %d\n" % n)
        if kind == "del-glob":
            cands = [f for f in files if os.path.basename(f) != "a.txt"]
            if not cands:
                return "nothing", None
            rel = r.choice(cands)
            return "delete glob file " + rel, lambda root: os.remove(os.path.join(root, rel))
        if kind == "add-pkg":
            name = "ws/extra%d" % n
            self.extra_pkgs.append(name)

            def op(root):
                write(os.path.join(root, name, "BUILD"),
                      'genrule(name = "x", srcs = glob(["*.in"]), outs = ["x.out"], '
                      'cmd = "echo %d > $@; cat $(SRCS) >> $@")\n' % n)
                write(os.path.join(root, name, "a.in"), "in\n")
            return "add package " + name, op
        if kind == "del-pkg":
            if not self.extra_pkgs:
                return "nothing", None
            name = self.extra_pkgs.pop(r.randrange(len(self.extra_pkgs)))
            return "delete package " + name, lambda root: shutil.rmtree(os.path.join(root, name))
        if kind == "build-edit":
            i = r.randrange(4)
            rel = "ws/pkg%d/BUILD" % i
            text = read(self.m(rel))
            if "deps = " in text and r.random() < 0.5:
                new = re.sub(r', deps = \["[^"]*"\]', "", text)
                return "remove dep " + rel, lambda root: write(os.path.join(root, rel), new)
            new = pkg_build(i)
            if LOAD_LINE in text:
                new = LOAD_LINE + new + LOAD_USE
            new += "# edit %d\n" % n
            return "rewrite " + rel, lambda root: write(os.path.join(root, rel), new)
        if kind == "bzl-edit":
            old = re.search(r'SUFFIX = "([^"]*)"', read(self.m("ws/defs.bzl"))).group(1)
            return "edit defs.bzl", lambda root: replace_in(root, "ws/defs.bzl", old, "suffix-%d" % n)
        if kind == "inner-bzl-edit":
            return "edit inner.bzl (loaded by defs.bzl)", lambda root: write(
                os.path.join(root, "ws/inner.bzl"), 'INNER = "inner-%d"\n' % n)
        if kind == "extra-bzl-edit":
            return "edit extra.bzl", lambda root: write(
                os.path.join(root, "ws/extra.bzl"), 'EXTRA = "extra-%d"\n' % n)
        if kind == "load-toggle":
            rel = "ws/pkg2/BUILD"
            text = read(self.m(rel))
            if LOAD_LINE in text:
                new = text.replace(LOAD_LINE, "").replace(LOAD_USE, "")
                return "remove load() from " + rel, lambda root: write(os.path.join(root, rel), new)
            new = LOAD_LINE + text + LOAD_USE
            return "add load() to " + rel, lambda root: write(os.path.join(root, rel), new)
        if kind == "rule-edit":
            new = re.sub(r'content = "[^"]*"', 'content = "w-%d"' % n, read(self.m("ws/BUILD.bazel")))
            return "edit rule attribute", lambda root: write(os.path.join(root, "ws/BUILD.bazel"), new)
        if kind == "pm-edit":
            new = re.sub(r"pm=\d+", "pm=%d" % n, read(self.m("ws/platform_mappings")))
            return "edit platform_mappings", lambda root: write(
                os.path.join(root, "ws/platform_mappings"), new)
        if kind == "ext-edit":
            return "edit external module file", lambda root: write(
                os.path.join(root, "ext/data.txt"), "ext data %d\n" % n)
        if kind == "repo-input-edit":
            return "edit file the repository rule reads", lambda root: write(
                os.path.join(root, "ws/repo_input.txt"), "input-%d\n" % n)
        if kind == "module-ext2":
            text = read(self.m("ws/MODULE.bazel"))
            if EXT2_DEP in text:
                new = text.replace(EXT2_DEP, "# EXT2\n")
                desc = "MODULE.bazel: remove bazel_dep extmod2"
            else:
                new = text.replace("# EXT2\n", EXT2_DEP)
                desc = "MODULE.bazel: add bazel_dep extmod2"
            return desc, lambda root: write(os.path.join(root, "ws/MODULE.bazel"), new)
        if kind == "module-comment":
            return "MODULE.bazel: comment", lambda root: append(root, "ws/MODULE.bazel", "# %d\n" % n)
        if kind == "lockfile-delete":
            def op(root):
                p = os.path.join(root, "ws/MODULE.bazel.lock")
                if os.path.exists(p):
                    os.remove(p)
            return "delete MODULE.bazel.lock", op
        if kind == "break":
            if self.broken is not None:
                return "nothing", None
            rel = "ws/pkg%d/BUILD" % r.randrange(4)
            self.broken = rel
            return "break " + rel, lambda root: append(root, rel, "this is not starlark(\n")
        # Symlinks.
        if kind == "sym-retarget":
            cur = os.readlink(self.m("ws/sym/link.txt"))
            new = {"t1.data": "t2.data", "t2.data": "../pkg0/a.txt"}.get(cur, "t1.data")

            def op(root):
                p = os.path.join(root, "ws/sym/link.txt")
                os.remove(p)
                os.symlink(new, p)
            return "retarget sym/link.txt -> " + new, op
        if kind == "sym-target-edit":
            rel = "ws/sym/" + r.choice(["t1.data", "t2.data"])
            return "edit symlink target " + rel, lambda root: append(root, rel, "more %d\n" % n)
        if kind == "swap-file-dir":
            p = "ws/swp/x"
            if os.path.isdir(self.m(p)):
                def op(root):
                    shutil.rmtree(os.path.join(root, p))
                    write(os.path.join(root, p), "x file %d\n" % n)
                return "swp/x: directory -> file", op

            def op(root):
                os.remove(os.path.join(root, p))
                write(os.path.join(root, p, "z"), "z %d\n" % n)
            return "swp/x: file -> directory", op
        # BUILD files under a globbed directory, .bazelignore, REPO.bazel.
        if kind == "sub-build-toggle":
            rel = "ws/globber/sub/BUILD"
            if not os.path.isdir(self.m("ws/globber/sub")):
                return "nothing", None
            if os.path.exists(self.m(rel)):
                return "remove " + rel, lambda root: os.remove(os.path.join(root, rel))
            return "add " + rel, lambda root: write(os.path.join(root, rel), "")
        if kind == "bazelignore-toggle":
            text = read(self.m("ws/.bazelignore"))
            new = "" if "ign" in text else "ign\n"
            return ".bazelignore: %r" % new, lambda root: write(os.path.join(root, "ws/.bazelignore"), new)
        if kind == "repo-bazel-toggle":
            text = read(self.m("ws/REPO.bazel"))
            new = "" if text else 'ignore_directories(["ign2"])\n'
            return "REPO.bazel: %r" % new, lambda root: write(os.path.join(root, "ws/REPO.bazel"), new)
        # C++ headers (discovered inputs).
        if kind == "header-edit":
            return "edit cc/lib.h", lambda root: write(
                os.path.join(root, "ws/cc/lib.h"), "#define LIB_V %d\nint lib();\n" % (n % 9 + 1))
        if kind == "header-same-size":
            text = read(self.m("ws/cc/inc_b/val.h"))
            new = re.sub(r"VAL \d", "VAL %d" % (n % 9), text)
            return "same-size edit cc/inc_b/val.h", lambda root: write(
                os.path.join(root, "ws/cc/inc_b/val.h"), new)
        if kind == "header-shadow":
            rel = "ws/cc/inc_a/val.h"
            if os.path.exists(self.m(rel)):
                return "remove " + rel, lambda root: os.remove(os.path.join(root, rel))
            return "add " + rel + " (earlier on the include path)", lambda root: write(
                os.path.join(root, rel), "#define VAL 7\n")
        # Directories (renames and re-creations, for --watchfs).
        if kind == "dir-rename":
            a, b = "ws/globber/sub", "ws/globber/sub2"
            if not os.path.isdir(self.m(a)):
                a, b = b, a
            return "mv %s %s" % (a, b), lambda root: os.rename(os.path.join(root, a), os.path.join(root, b))
        if kind == "dir-recreate":
            d = "ws/globber/tmp"

            def op(root):
                os.makedirs(os.path.join(root, d))
                os.rmdir(os.path.join(root, d))
            return "mkdir and rmdir " + d, op
        if kind == "dir-deep":
            d = "ws/globber/n1"
            if os.path.isdir(self.m(d)):
                return "rm -r " + d, lambda root: shutil.rmtree(os.path.join(root, d))
            return "mkdir -p %s/n2 with a file" % d, lambda root: write(
                os.path.join(root, d, "n2/n.txt"), "n %d\n" % n)
        # Options.
        if kind == "define":
            v = r.choice([None, "a", "b"])
            self.opts.pop("define", None)
            if v:
                self.opts["define"] = ["--define=mode=" + v]
            return "define mode=%s" % v, None
        if kind == "action-env":
            v = r.choice([None, "one", "two"])
            self.opts.pop("action_env", None)
            if v:
                self.opts["action_env"] = ["--action_env=I3_ACTION_ENV=" + v]
            return "action env %s" % v, None
        if kind == "copt":
            return self.toggle("opt", ["-c", "opt"]), None
        if kind == "flag":
            self.opts["flag"] = ["--//:flag=f-%d" % n]
            return "--//:flag=f-%d" % n, None
        if kind == "platforms":
            return self.toggle("platforms", ["--platforms=//:p"]), None
        if kind == "deleted-packages":
            return self.toggle("deleted_packages", ["--deleted_packages=pkg3"]), None
        if kind == "package-path":
            return self.toggle("package_path", ["--package_path=%workspace%:{root}/pp"]), None
        if kind == "repo-env":
            v = r.choice([None, "x", "y"])
            self.opts.pop("repo_env", None)
            if v:
                self.opts["repo_env"] = ["--repo_env=I3_REPO_ENV=" + v]
            return "repo env %s" % v, None
        if kind == "override-repository":
            return self.toggle("override", ["--override_repository=+envext+envrepo={root}/ovr"]), None
        if kind == "disk-cache":
            return self.toggle("disk_cache", ["--disk_cache={root}/disk-cache"]), None
        if kind == "invocation-id":
            return self.toggle("invocation_id", ["--invocation_id=" + INVOCATION_ID]), None
        if kind == "watchfs":
            return self.toggle("watchfs", ["--watchfs"]), None
        raise ValueError(kind)

    def options(self, root):
        out = []
        for key in sorted(self.opts):
            out += [a.replace("{root}", root) for a in self.opts[key]]
        return out


def append(root, rel, text):
    with open(os.path.join(root, rel), "a") as f:
        f.write(text)


def replace_in(root, rel, old, new):
    p = os.path.join(root, rel)
    write(p, read(p).replace(old, new))


# Edit kinds with their weights. Round 1 S2-5: symlinks (1), BUILD under a globbed directory,
# .bazelignore and REPO.bazel (2), headers (3), other commands and options (4: the commands are
# drawn separately), load graph and module edits (5). Round 2: invocation ids, --watchfs with
# renames and re-creations (writes racing a command and interrupts are drawn separately).
KIND_WEIGHTS = {
    "same-size": 4, "double-edit": 2, "append": 3, "touch": 2, "add-glob": 2, "del-glob": 2,
    "add-pkg": 1, "del-pkg": 1, "build-edit": 2, "bzl-edit": 1, "inner-bzl-edit": 1,
    "extra-bzl-edit": 1, "load-toggle": 1, "rule-edit": 1, "pm-edit": 1, "ext-edit": 1,
    "repo-input-edit": 1, "module-ext2": 1, "module-comment": 1, "lockfile-delete": 1,
    "break": 1, "sym-retarget": 2, "sym-target-edit": 2, "swap-file-dir": 2,
    "sub-build-toggle": 2, "bazelignore-toggle": 1, "repo-bazel-toggle": 1, "header-edit": 2,
    "header-same-size": 2, "header-shadow": 2, "dir-rename": 2, "dir-recreate": 1,
    "dir-deep": 1, "define": 1, "action-env": 1, "copt": 1, "flag": 1, "platforms": 1,
    "deleted-packages": 1, "package-path": 1, "repo-env": 1, "override-repository": 1,
    "disk-cache": 1, "invocation-id": 2, "watchfs": 2,
}
KINDS = [k for k, w in KIND_WEIGHTS.items() for _ in range(w)]

OTHER_COMMANDS = ["query", "cquery", "test", "fetch"]


# ---------------------------------------------------------------------------------------------
# The run.


def build_args(editor, side):
    return COMMON + editor.options(side.root) + ["--keep_going", "--", "//..."]


def compare_trees(ta, tother, both_ways):
    """Paths where A differs from the other side (intermediates skipped)."""
    paths = set(tother)
    if both_ways:
        paths |= set(ta)
    return sorted(p for p in paths if not INTERMEDIATE.search(p) and ta.get(p) != tother.get(p))


def cmd_run(a):
    root = os.path.join(WORK, str(a.seed))
    os.makedirs(root, exist_ok=True)
    rng = random.Random(a.seed)
    env_a = {"BLAZE_SERVER_MODE": "daemon"}
    if a.failsafe == "off":
        env_a["BLAZE_INCREMENTAL_REMOTE_FAILSAFE"] = "off"
    side_a = Side("A", a.blaze, os.path.join(root, "a"), env_a, daemon=True)
    side_o = Side("O", a.oracle, os.path.join(root, "o"), {}, daemon=True)
    side_b = Side("B", a.blaze, os.path.join(root, "b"), {"BLAZE_INCREMENTAL": "none"},
                  daemon=False)
    sides = [side_a, side_o, side_b]
    for s in sides:
        remove_tree(s.out_root)
        generate(s.root)
        os.makedirs(s.out_root, exist_ok=True)
        if s.daemon:
            write(os.path.join(s.out_root, ".keep-server"), "scripts/incremental/fuzz\n")
    editor = Editor(rng, [s.root for s in sides])
    counts = {"rounds": 0, "vs_oracle": 0, "vs_clean": 0, "msgdiff": 0, "skipped": 0}
    log = open(os.path.join(root, "log.txt"), "w")

    def say(line):
        print(line)
        log.write(line + "\n")
        log.flush()

    def compare(what, results, i):
        (ca, oa, ea), (co, oo, eo), (cb, ob, eb) = results
        bba, bbo, bbb = side_a.bazel_bin(), side_o.bazel_bin(), side_b.bazel_bin()
        ta, to, tb = output_tree(side_a, bba), output_tree(side_o, bbo), output_tree(side_b, bbb)
        vs_o, vs_b, notes = [], [], []
        # With a repeated --invocation_id Bazel's own result can be stale (Skymeld's BuildDriver
        # nodes depend on BUILD_ID only) or a crash (an NPE in ExecutionProgressReceiver when
        # two builds in a row have the same id): the oracle's differences are printed only.
        # A difference against the clean build is still excused where A equals the oracle (a
        # state Bazel keeps too, such as a deleted runfiles entry).
        id_reused = "invocation_id" in editor.opts
        oracle_agrees = (lambda same: same)
        if ca != co:
            vs_o.append("exit %d (A) vs %d (oracle)" % (ca, co))
        for p in compare_trees(ta, to, True):
            vs_o.append("output %s: A %s oracle %s" % (p, ta.get(p), to.get(p)))
        if ca != cb and not oracle_agrees(ca == co):
            vs_b.append("exit %d (A) vs %d (clean)" % (ca, cb))
        pa, po, pb = problem_lines(ea, side_a), problem_lines(eo, side_o), problem_lines(eb, side_b)
        if pa != pb and not oracle_agrees(pa == po):
            vs_b.append("messages: A %s clean %s" % (pa, pb))
        if pa != po:
            notes.append("msgdiff: A %s oracle %s" % (pa, po))
        for p in compare_trees(ta, tb, False):
            if not oracle_agrees(ta.get(p) == to.get(p)):
                vs_b.append("output %s: A %s clean %s" % (p, ta.get(p), tb.get(p)))
        if id_reused and vs_o:
            notes += ["oracle (repeated invocation id, not counted): " + x for x in vs_o]
            vs_o = []
        state = "OK" if not vs_o and not vs_b else "MISMATCH"
        say("%4d %-58s %s" % (i, what[:58], state))
        for x in vs_o:
            say("      vs oracle: " + x)
        for x in vs_b:
            say("      vs clean:  " + x)
        for x in notes:
            say("      " + x)
        counts["vs_oracle"] += bool(vs_o)
        counts["vs_clean"] += bool(vs_b)
        counts["msgdiff"] += bool(notes)
        counts["rounds"] += 1

    def build_all(skip_a=False, race=None, interrupt=None):
        results = []
        for s in sides:
            env = {}
            if s is side_b:
                s.run(["clean"])
            if s is side_a and skip_a:
                r = s.run(["build"] + build_args(editor, s), env=env, during=race,
                          interrupt_after=interrupt)
            else:
                r = s.run(["build"] + build_args(editor, s), env=env)
            results.append(r)
        return results

    try:
        for i in range(a.rounds):
            what, op = editor.edit()
            if op:
                for s in sides:
                    op(s.root)
            # Output tampering (A and O alike; B is clean anyway).
            if rng.random() < 0.08:
                bba, bbo = side_a.bazel_bin(), side_o.bazel_bin()
                if bba and bbo:
                    cands = sorted(p for p in output_tree(side_a, bba)
                                   if not INTERMEDIATE.search(p)
                                   and os.path.lexists(os.path.join(bbo, p)))
                    if cands:
                        rel = rng.choice(cands)
                        modify = rng.random() < 0.5 and not os.path.islink(os.path.join(bba, rel))
                        for bb in (bba, bbo):
                            p = os.path.join(bb, rel)
                            if modify:
                                os.chmod(p, 0o644)
                                with open(p, "a") as f:
                                    f.write("tampered\n")
                            else:
                                if not os.path.islink(p):
                                    os.chmod(os.path.dirname(p), 0o755)
                                os.remove(p)
                        what += "; %s output %s" % ("modify" if modify else "delete", rel)
            # Another command first (A and O).
            if rng.random() < 0.12:
                c = rng.choice(OTHER_COMMANDS)
                out = []
                for s in (side_a, side_o):
                    if c in ("query",):
                        args = [c, "--color=no", "--curses=no"] + [
                            x for x in editor.options(s.root)
                            if x.startswith(("--package_path", "--deleted_packages",
                                             "--repo_env", "--override_repository",
                                             "--invocation_id", "--watchfs"))] + ["//..."]
                    elif c == "fetch":
                        args = [c, "--color=no", "--curses=no",
                                "--repository_cache=" + REPO_CACHE, "--all"]
                    elif c == "test":
                        args = [c] + build_args(editor, s)[:-3] + ["--", "//:t"]
                    else:
                        args = [c] + build_args(editor, s)
                    code, so, se = s.run(args)
                    out.append((code, sorted(norm_lines(so, s)) if c in ("query", "cquery") else []))
                if out[0] != out[1]:
                    counts["vs_oracle"] += 1
                    say("%4d %-58s MISMATCH" % (i, c))
                    say("      vs oracle: %s: A %s oracle %s" % (c, out[0], out[1]))
                else:
                    say("%4d %-58s OK" % (i, c + " (exit %d)" % out[0][0]))
            x = rng.random()
            if x < 0.05:
                # A write racing the start of A's command, then a compared build of all sides.
                rel = rng.choice(editor.txt_files())
                text = read(side_a.path(rel)) + "race %d\n" % i
                delay = rng.uniform(0.0, 0.6)
                build_all(skip_a=True, race=(delay, lambda: write(side_a.path(rel), text)))
                for s in (side_o, side_b):
                    write(s.path(rel), text)
                counts["skipped"] += 1
                say("%4d %-58s (A not compared)" % (i, what + "; race " + rel))
                compare("  build after the race", build_all(), i)
            elif x < 0.08:
                delay = rng.uniform(0.2, 3.0)
                build_all(skip_a=True, interrupt=delay)
                counts["skipped"] += 1
                say("%4d %-58s (A not compared)" % (i, what + "; SIGINT after %.1fs" % delay))
                compare("  build after the interrupt", build_all(), i)
            else:
                compare(what, build_all(), i)
    finally:
        for s in sides:
            s.shutdown()
            try:
                os.remove(os.path.join(s.out_root, ".keep-server"))
            except OSError:
                pass
        say("rounds %d mismatches: vs oracle %d, vs clean %d; msgdiff %d; races and interrupts "
            "%d (seed %d)" % (counts["rounds"], counts["vs_oracle"], counts["vs_clean"],
                             counts["msgdiff"], counts["skipped"], a.seed))
        log.close()
    if not a.keep:
        for s in sides:
            remove_tree(s.root)
    return 0 if counts["vs_oracle"] == 0 and counts["vs_clean"] == 0 else 1


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("help", "-h", "--help"):
        print(__doc__)
        return 0
    if sys.argv[1] == "kinds":
        for k, w in KIND_WEIGHTS.items():
            print("%-22s weight %d" % (k, w))
        print("other commands (12%% of rounds): %s" % ", ".join(OTHER_COMMANDS))
        print("output tampering 8%; racing write 5%; SIGINT 3%")
        return 0
    ap = argparse.ArgumentParser(prog="scripts/incremental/fuzz")
    sub = ap.add_subparsers(dest="cmd")
    r = sub.add_parser("run")
    r.add_argument("--blaze", default=DEFAULT_BLAZE)
    r.add_argument("--oracle", default=ORACLE)
    r.add_argument("--rounds", type=int, default=500)
    r.add_argument("--seed", type=int, default=1)
    r.add_argument("--failsafe", default="on", choices=["on", "off"])
    r.add_argument("--keep", action="store_true")
    a = ap.parse_args()
    if a.cmd == "run":
        return cmd_run(a)
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main())
