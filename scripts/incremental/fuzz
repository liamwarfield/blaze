def generate(side_root):
    for d in ("ws", "ext", "ext2", "pp", "ovr"):
        remove_tree(os.path.join(side_root, d))
    for rel, text in files_of_workspace().items():
        write(os.path.join(side_root, rel), text)
    os.symlink("t1.data", os.path.join(side_root, "ws/sym/link.txt"))
    if os.path.exists(BROTLI_LOCK):
        # Registry file hashes, so that module resolution needs no network.
        shutil.copyfile(BROTLI_LOCK, os.path.join(side_root, "ws/MODULE.bazel.lock"))


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(text)


def read(path):
    with open(path) as f:
        return f.read()


def remove_tree(path):
    if os.path.lexists(path):
        subprocess.run(["chmod", "-R", "u+w", path], capture_output=True)
        if os.path.isdir(path) and not os.path.islink(path):
            shutil.rmtree(path)
        else:
            os.remove(path)


