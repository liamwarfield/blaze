def side_paths(side, project):
    ws = os.path.join(WORK, side, project)
    our = os.path.join(CACHE, "oracle-out", "mod-compare-" + side)
    return ws, our


def sync_workspace(project, ws):
    os.makedirs(ws, exist_ok=True)
    cfg = PROJECTS[project]
    checkout = os.path.join(CACHE, "corpus", cfg.get("base", project))
    subprocess.run(["rsync", "-a", "--delete", "--exclude=/bazel-*", "--exclude=/.git",
                    checkout + "/", ws + "/"], check=True)
    for rel, content in cfg.get("overlay", {}).items():
        with open(os.path.join(ws, rel), "w") as f:
            f.write(content)
    if cfg.get("module_append"):
        with open(os.path.join(ws, "MODULE.bazel"), "a") as f:
            f.write(cfg["module_append"])


def mod_argv(binary, our, args):
    cmd = [binary, "--output_user_root=" + our, "--nohome_rc", "--nosystem_rc"]
    if args:
        cmd += ["mod", args[0], "--repository_cache=" + REPO_CACHE, "--color=no",
                "--curses=no"] + args[1:]
    else:
        cmd += ["mod", "--repository_cache=" + REPO_CACHE, "--color=no", "--curses=no"]
    return cmd


def run(binary, side, project, args):
    """(compare_common.Termination, stdout, stderr) of one `mod` command in a --scope unit."""
    ws, our = side_paths(side, project)
    p = cc.run(mod_argv(binary, our, args), ws, timeout=3600, mode="scope", tag="mod-compare")
    return p.term, p.out, p.err


_digests = {}


def oracle_key(project, args, before):
    cfg = PROJECTS[project]
    base = cfg.get("base", project)
    if base not in _digests:
        _digests[base] = cc.tree_digest(os.path.join(CACHE, "corpus", base))
    _, our = side_paths("oracle", project)
    # Raw captures: this tool's sha256 is not part of the key (overlays are in PROJECTS).
    return cc.cache_key(None, cc.pinned_sha256(),
                        mod_argv(cc.PINNED_ORACLE, our, args), cc.clean_env(), _digests[base],
                        extra={"project": project, "cases_before": before,
                               "overlay": {k: v for k, v in cfg.items() if k != "cases"}})


RULES = cc.VOLATILE_RULES + [
    cc.Rule("output_base_hash", r"<OUR>/[0-9a-f]{32}", "output base names are the md5 of the "
            "work copy's path, which differs between the sides", repl="<OUR>/<MD5>",
            streams=("stdout", "stderr"))]


def path_pairs(side, project):
    ws, our = side_paths(side, project)
    return [(os.path.realpath(our), "<OUR>"), (our, "<OUR>"), (os.path.realpath(ws), "<WS>"),
            (ws, "<WS>")]


def result_dir(side, project):
    d = os.path.join(WORK, "results", side, project)
    os.makedirs(d, exist_ok=True)
    return d


def shutdown(project, report):
    ws, our = side_paths("oracle", project)
    report.add_aux("oracle %s shutdown" % project, cc.run(
        [ORACLE, "--output_user_root=" + our, "--nohome_rc", "--nosystem_rc", "shutdown"],
        ws, timeout=600, mode="scope", tag="mod-shutdown").term)


CAPTURE_EXTS = ("rc", "out", "err", "term", "module")


def capture(binary, side, project, name, args, report, blaze, before=()):
    ws, _ = side_paths(side, project)
    d = result_dir(side, project)
    meta = os.path.join(d, name + (".key" if side == "oracle" else ".capture.json"))
    cc.invalidate_key(meta)
    for ext in CAPTURE_EXTS:
        if os.path.exists(os.path.join(d, name + "." + ext)):
            os.remove(os.path.join(d, name + "." + ext))
    if side == "oracle":
        # Every case starts a new server: Blaze has none, and a server that already evaluated
        # a module extension does not repeat its warnings.
        shutdown(project, report)
    if args and args[0] == "tidy":
        sync_workspace(project, ws)
    term, out, err = run(binary, side, project, args)
    files = {"rc": str(term.exit_code_like()).encode() + b"\n", "out": out, "err": err,
             "term": json.dumps(term.to_dict()).encode()}
    if args and args[0] == "tidy":
        with open(os.path.join(ws, "MODULE.bazel"), "rb") as f:
            files["module"] = f.read()
    for ext, data in files.items():
        with open(os.path.join(d, name + "." + ext), "wb") as f:
            f.write(data)
    paths = [os.path.join(d, name + "." + ext) for ext in files]
    if side == "oracle":
        cc.write_key(meta, oracle_key(project, args, list(before)), paths)
    else:
        cc.write_capture(meta, blaze, paths, extra={"project": project, "case": name})
    if args and args[0] == "tidy":
        sync_workspace(project, ws)


def load(side, project, name):
    d = result_dir(side, project)
    res = {}
    for ext in CAPTURE_EXTS:
        p = os.path.join(d, name + "." + ext)
        if os.path.exists(p):
            with open(p, "rb") as f:
                res[ext] = f.read()
    return res


def term_of(res):
    try:
        return cc.Termination.from_dict(json.loads(res["term"]))
    except (KeyError, ValueError):
        return None


def judge(norm, project, name):
    """compare_common class of one case."""
    o, b = load("oracle", project, name), load("blaze", project, name)
    if not o or not b:
        return cc.SKIPPED, "no capture on the %s side" % ("oracle" if not o else "blaze")
    differing = []
    for ext, stream in (("out", "stdout"), ("err", "stderr"), ("module", "stdout")):
        if ext not in o and ext not in b:
            continue
        eq, _ = norm.compare(o.get(ext, b""), b.get(ext, b""), stream,
                             path_pairs("oracle", project), path_pairs("blaze", project))
        if not eq:
            differing.append({"out": "stdout", "err": "stderr"}.get(ext, ext))
    return cc.judge(term_of(o), term_of(b), differing,
                    declared_exit=DECLARED_EXIT.get("%s/%s" % (project, name)),
                    blaze_unported=cc.unported_message(b.get("err", b"")))


def show(spec):
    project, name = spec.split("/", 1)
    import difflib
    norm = cc.Normaliser(RULES)
    o, b = load("oracle", project, name), load("blaze", project, name)
    for ext in ("rc", "out", "err", "module"):
        if ext not in o and ext not in b:
            continue
        stream = "stderr" if ext == "err" else "stdout"
        ov = norm.apply(o.get(ext, b""), "oracle", stream,
                        path_pairs("oracle", project)).text.splitlines(True)
        bv = norm.apply(b.get(ext, b""), "blaze", stream,
                        path_pairs("blaze", project)).text.splitlines(True)
        sys.stdout.writelines(difflib.unified_diff(ov, bv, "oracle/" + name + "." + ext,
                                                   "blaze/" + name + "." + ext))


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("help", "--help", "-h"):
        print(USAGE, end="")
        return 0
    if len(sys.argv) > 1 and sys.argv[1] == "selftest":
        return selftest()
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--project", action="append", choices=sorted(PROJECTS))
    ap.add_argument("--case", action="append")
    ap.add_argument("--blaze", default=os.path.join(ROOT, "target", "debug", "blaze"))
    ap.add_argument("--side", default="both", choices=["oracle", "blaze", "both", "none"])
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--show")
    ap.add_argument("--json")
    a = ap.parse_args()
    if a.show:
        show(a.show)
        return 0
    import fnmatch
    projects = a.project or list(PROJECTS)
    sides = {"both": ["oracle", "blaze"], "none": []}.get(a.side, [a.side])
    selected = {}
    for project in projects:
        cfg = PROJECTS[project]
        selected[project] = [(n, [x.format(**cfg) for x in args]) for n, args in cfg["cases"]
                             if not a.case or any(fnmatch.fnmatch(n, g) for g in a.case)]
    if a.list:
        for project in projects:
            for n, args in selected[project]:
                print("%s/%s: mod %s" % (project, n, " ".join(
                    repr(x) if x == "" or " " in x else x for x in args)))
        return 0
    if not any(selected.values()):
        return cc.empty_selection_error("mod/compare")
    try:
        oracle, oracle_sha = cc.require_oracle(ORACLE)
        blaze = cc.blaze_identity(a.blaze)
    except cc.Refusal as e:
        return cc.refuse("mod/compare", e)
    binaries = {"oracle": oracle, "blaze": blaze["path"]}
    report = cc.Report("mod/compare", blaze=blaze, oracle={"path": oracle, "sha256": oracle_sha},
                       selection="projects %s, %d cases, side %s" % (
                           ",".join(projects), sum(len(v) for v in selected.values()), a.side),
                       tool_files=[os.path.abspath(__file__)],
                       compared="termination, the whole stdout, stderr and (tidy) MODULE.bazel "
                                "after the exclusion rules listed at the end")
    norm = cc.Normaliser(RULES, path_reason="each side's output user root and work copy")
    report.add_normaliser(norm)
    report.reclassify_only = not sides
    report.print_header()
    for project in projects:
        cases = selected[project]
        stale = {}
        if "oracle" not in sides:
            before = []
            for n, args in cases:
                reason = cc.check_key(os.path.join(result_dir("oracle", project), n + ".key"),
                                      oracle_key(project, args, list(before)))
                if reason:
                    stale[n] = "stale oracle capture: " + reason
                before.append(n)
            if stale and "blaze" in sides:
                for n, r in sorted(stale.items())[:5]:
                    print("refused: %s/%s: %s" % (project, n, r), file=sys.stderr)
                return cc.refuse("mod/compare", "%d stored oracle captures of %s are stale or "
                                 "unkeyed; run with --side both" % (len(stale), project))
        if "blaze" not in sides:
            for n, _ in cases:
                reason = cc.check_capture(
                    os.path.join(result_dir("blaze", project), n + ".capture.json"), blaze)
                if reason and n not in stale:
                    stale[n] = "stored Blaze capture: " + reason
        for side in sides:
            ws, _ = side_paths(side, project)
            sync_workspace(project, ws)
            report.add_aux("%s %s warm-up mod graph" % (side, project),
                           run(binaries[side], side, project, ["graph"])[0])
            before = []
            for n, args in cases:
                capture(binaries[side], side, project, n, args, report, blaze, before)
                before.append(n)
        for n, _ in cases:
            if n in stale:
                cls, detail = cc.SKIPPED, stale[n]
            else:
                cls, detail = judge(norm, project, n)
            report.add("%s/%s" % (project, n), cls, detail)
            print("%-8s %-28s %s %s" % (project, n, cls, detail))
    if "oracle" in sides:
        for project in projects:
            shutdown(project, report)
    print()
    report.print_footer()
    if a.json:
        report.write_json(a.json)
    return report.exit_code()


def selftest():
    def argv(blaze, label):
        return ["--blaze", blaze, "--project", "brotli", "--case",
                PROJECTS["brotli"]["cases"][0][0]]

    def extra(st, fh, run):
        o, b = fh.fakes(dict(out=b"same\n"), dict(out=b"same\n"))
        rc, rep, log = run(argv(b, "x"))
        rc2, rep2, log2 = run(argv(b, "x") + ["--side", "none"])
        st.check("--side none with the binary that made the captures never exits 0",
                 rc == 0 and rc2 == 1, "fresh run exit %s, --side none exit %s" % (rc, rc2))
        rc3, rep3, log3 = run(argv(b, "x") + ["--side", "blaze"])
        st.check("--side blaze reuses fresh oracle captures", rc3 == 0, "exit %s" % rc3)
        d = os.path.join(fh.cache, "work", "mod-compare", "results", "oracle", "brotli")
        with open(os.path.join(d, PROJECTS["brotli"]["cases"][0][0] + ".out"), "ab") as f:
            f.write(b"tampered")
        rc4, rep4, log4 = run(argv(b, "x") + ["--side", "blaze"])
        st.check("--side blaze refuses a changed oracle capture", rc4 == 2, "exit %s" % rc4)
        # M7: the tidy fixture and its MODULE.bazel comparison through the real command line.
        o, b = fh.fakes(dict(out=b"same\n"), dict(out=b"same\n"))
        rc5, rep5, log5 = run(["--blaze", b, "--project", "brotli-tidy", "--case", "tidy"])
        cl = [r["class"] for r in (rep5 or {}).get("cases", [])]
        st.check("M7: mod tidy runs through the launcher", rc5 == 0 and cl
                 and set(cl) == {cc.IDENTICAL}, "exit %s, %s" % (rc5, cl))

    return cc.selftest_tool(
        "mod/compare", os.path.abspath(__file__), argv,
        empty=lambda b, l: ["--blaze", b, "--case", "no-such-case", "--side", "none"],
        stored=lambda b, l: argv(b, l) + ["--side", "oracle"],
        extra=extra)


if __name__ == "__main__":
    sys.exit(main())
