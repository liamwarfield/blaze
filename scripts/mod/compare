    ("show_unknown_canonical", ["show_repo", "@@nonexistent+"]),
    ("show_unknown_module", ["show_repo", "nonexistent@1.0"]),
    ("show_too_many", ["show_repo", "--all_repos", "@rules_cc"]),
    ("show_all_visible", ["show_repo", "--all_visible_repos"]),
    ("show_all_repos", ["show_repo", "--all_repos"]),
    ("show_all_repos_jsonproto", ["show_repo", "--all_repos", "--output=streamed_jsonproto"]),
    ("show_none", ["show_repo"]),
    ("graph", ["graph"]),
    ("graph_json", ["graph", "--output=json"]),
    ("graph_graph", ["graph", "--output=graph"]),
    ("graph_verbose", ["graph", "--verbose"]),
    ("graph_extension_info", ["graph", "--extension_info=all"]),
    ("graph_extra_arg", ["graph", "foo"]),
    ("deps", ["deps", "rules_cc"]),
    ("deps_root", ["deps", "<root>"]),
    ("all_paths", ["all_paths", "platforms"]),
    ("path", ["path", "platforms"]),
    ("explain", ["explain", "platforms"]),
    ("explain_json", ["explain", "platforms", "--output=json"]),
