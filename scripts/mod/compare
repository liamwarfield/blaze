def side_paths(side, project):
    ws = os.path.join(WORK, side, project)
    our = os.path.join(CACHE, "oracle-out", "mod-compare-" + side)
    return ws, our


def sync_workspace(project, ws):
    os.makedirs(ws, exist_ok=True)
    cfg = PROJECTS[project]
    checkout = os.path.join(CACHE, "corpus", cfg.get("base", project))
    subprocess.run(["rsync", "-a", "--delete", "--exclude=/bazel-*", "--exclude=/.git",
                    checkout + "/", ws + "/"], check=True)
    for rel, content in cfg.get("overlay", {}).items():
        with open(os.path.join(ws, rel), "w") as f:
            f.write(content)
    if cfg.get("module_append"):
        with open(os.path.join(ws, "MODULE.bazel"), "a") as f:
            f.write(cfg["module_append"])


def mod_argv(binary, our, args):
    cmd = [binary, "--output_user_root=" + our, "--nohome_rc", "--nosystem_rc"]
    if args:
        cmd += ["mod", args[0], "--repository_cache=" + REPO_CACHE, "--color=no",
                "--curses=no"] + args[1:]
    else:
        cmd += ["mod", "--repository_cache=" + REPO_CACHE, "--color=no", "--curses=no"]
    return cmd


def run(binary, side, project, args):
    """(compare_common.Termination, stdout, stderr) of one `mod` command in a --scope unit."""
    ws, our = side_paths(side, project)
    p = cc.run(mod_argv(binary, our, args), ws, timeout=3600, mode="scope", tag="mod-compare")
    return p.term, p.out, p.err


_digests = {}


def oracle_key(project, args, before):
    cfg = PROJECTS[project]
    base = cfg.get("base", project)
    if base not in _digests:
        _digests[base] = cc.tree_digest(os.path.join(CACHE, "corpus", base))
    _, our = side_paths("oracle", project)
    # Raw captures: this tool's sha256 is not part of the key (overlays are in PROJECTS).
    return cc.cache_key(None, cc.pinned_sha256(),
                        mod_argv(cc.PINNED_ORACLE, our, args), cc.clean_env(), _digests[base],
                        extra={"project": project, "cases_before": before,
                               "overlay": {k: v for k, v in cfg.items() if k != "cases"}})


def normalise(data, side, project):
    ws, our = side_paths(side, project)
    out = data
    for real, tag in ((os.path.realpath(our), b"<OUR>"), (our, b"<OUR>"),
                      (os.path.realpath(ws), b"<WS>"), (ws, b"<WS>")):
        out = out.replace(real.encode(), tag)
    out = re.sub(rb"<OUR>/([0-9a-f]{32})", b"<OUR>/<MD5>", out)
    start = b"Starting local Bazel server (9.3.2) and connecting to it...\n"
    if out.startswith(start):
        out = out[len(start):]
    out = re.sub(rb"<OUR>/install/([0-9a-f]{32})", b"<OUR>/install/<MD5>", out)
    return out


def strip_ui(err):
    """stderr without the UI's progress lines (" no actions running", printed by the oracle's
    UiStateTracker while work runs longer than its progress interval) and without the newline
    UiEventHandler.completeBuild writes when stdout ended without one."""
    lines = [l for l in err.split(b"\n") if l != b" no actions running"]
    out = b"\n".join(lines)
    while out.endswith(b"\n\n"):
        out = out[:-1]
    if out == b"\n":
        out = b""
    return out


def result_dir(side, project):
    d = os.path.join(WORK, "results", side, project)
    os.makedirs(d, exist_ok=True)
    return d


def shutdown(project):
    ws, our = side_paths("oracle", project)
    cc.run([ORACLE, "--output_user_root=" + our, "--nohome_rc", "--nosystem_rc", "shutdown"],
           ws, timeout=600, mode="scope", tag="mod-shutdown")


def capture(binary, side, project, name, args, before=()):
    ws, _ = side_paths(side, project)
    if side == "oracle":
        # Every case starts a new server: Blaze has none, and a server that already evaluated
        # a module extension does not repeat its warnings.
        shutdown(project)
    if args and args[0] == "tidy":
        sync_workspace(project, ws)
    term, out, err = run(binary, side, project, args)
    d = result_dir(side, project)
    files = {"rc": str(term.exit_code_like()).encode() + b"\n", "out": out, "err": err,
             "term": json.dumps(term.to_dict()).encode()}
    if side == "oracle":
        cc.write_key(os.path.join(d, name + ".key"), oracle_key(project, args, list(before)))
    if args and args[0] == "tidy":
        with open(os.path.join(ws, "MODULE.bazel"), "rb") as f:
            files["module"] = f.read()
    for ext, data in files.items():
        with open(os.path.join(d, name + "." + ext), "wb") as f:
            f.write(data)
    if args and args[0] == "tidy":
        sync_workspace(project, ws)


def load(side, project, name):
    d = result_dir(side, project)
    res = {}
    for ext in ("rc", "out", "err", "module", "term"):
        p = os.path.join(d, name + "." + ext)
        if os.path.exists(p):
            with open(p, "rb") as f:
                res[ext] = f.read()
    return res


def compare(project, name):
    o, b = load("oracle", project, name), load("blaze", project, name)
    if not o or not b:
        return "MISSING", []
    diffs, raw, ui_only = [], True, True
    ot, bt = term_of(o), term_of(b)
    if ot is None or ot != bt:
        diffs.append("termination")
        raw = ui_only = False
    for ext in ("out", "err", "module"):
        if ext not in o and ext not in b:
            continue
        ov, bv = o.get(ext, b""), b.get(ext, b"")
        if ov != bv:
            raw = False
        on, bn = normalise(ov, "oracle", project), normalise(bv, "blaze", project)
        if on != bn:
            diffs.append(ext)
            if ext != "err" or strip_ui(on) != strip_ui(bn):
                ui_only = False
    if diffs:
        return ("DIFF-UI" if ui_only else "DIFF"), diffs
    return ("MATCH (raw)" if raw else "MATCH"), []


def term_of(res):
    try:
        return cc.Termination.from_dict(json.loads(res["term"]))
    except (KeyError, ValueError):
        return None


def judge(project, name, status, diffs):
    """compare_common class of one case from compare()'s status."""
    if status == "MISSING":
        return cc.SKIPPED, "no capture on one side"
    o, b = load("oracle", project, name), load("blaze", project, name)
    cls, detail = cc.judge(term_of(o), term_of(b), [d for d in diffs if d != "termination"],
                           declared_exit=DECLARED_EXIT.get("%s/%s" % (project, name)),
                           blaze_unported=cc.unported_message(b.get("err", b"")))
    if status == "DIFF-UI" and cls == cc.DIFFERENT:
        detail += " (UI lines only)"
    if status == "MATCH (raw)" and cls == cc.IDENTICAL:
        detail = (detail + "; " if detail else "") + "raw bytes identical"
    return cls, detail


def show(spec):
    project, name = spec.split("/", 1)
    import difflib
    o, b = load("oracle", project, name), load("blaze", project, name)
    for ext in ("rc", "out", "err", "module"):
        if ext not in o and ext not in b:
            continue
        ov = normalise(o.get(ext, b""), "oracle", project).decode("latin-1").splitlines(True)
        bv = normalise(b.get(ext, b""), "blaze", project).decode("latin-1").splitlines(True)
        sys.stdout.writelines(difflib.unified_diff(ov, bv, "oracle/" + name + "." + ext,
                                                   "blaze/" + name + "." + ext))


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("help", "--help", "-h"):
        print(USAGE, end="")
        return 0
    if len(sys.argv) > 1 and sys.argv[1] == "selftest":
        return selftest()
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--project", action="append", choices=sorted(PROJECTS))
    ap.add_argument("--case", action="append")
    ap.add_argument("--blaze", default=os.path.join(ROOT, "target", "debug", "blaze"))
    ap.add_argument("--side", default="both", choices=["oracle", "blaze", "both", "none"])
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--show")
    ap.add_argument("--json")
    a = ap.parse_args()
    if a.show:
        show(a.show)
        return 0
    import fnmatch
    projects = a.project or list(PROJECTS)
    sides = {"both": ["oracle", "blaze"], "none": []}.get(a.side, [a.side])
    selected = {}
    for project in projects:
        cfg = PROJECTS[project]
        selected[project] = [(n, [x.format(**cfg) for x in args]) for n, args in cfg["cases"]
                             if not a.case or any(fnmatch.fnmatch(n, g) for g in a.case)]
    if a.list:
        for project in projects:
            for n, args in selected[project]:
                print("%s/%s: mod %s" % (project, n, " ".join(
                    repr(x) if x == "" or " " in x else x for x in args)))
        return 0
    if not any(selected.values()):
        return cc.empty_selection_error("mod/compare")
    try:
        oracle, oracle_sha = cc.require_oracle(ORACLE)
        if "blaze" in sides:
            blaze = cc.blaze_identity(a.blaze)
        else:
            # Re-comparing stored captures: name the binary that made them, not --blaze.
            made = set()
            for project in projects:
                try:
                    with open(os.path.join(result_dir("blaze", project), "binary.json")) as f:
                        made.add(json.dumps(json.load(f), sort_keys=True))
                except (OSError, ValueError):
                    made.add(json.dumps({"path": "unknown (captured before 2026-11-19)",
                                         "sha256": None}))
            blaze = json.loads(made.pop()) if len(made) == 1 else {
                "path": "several binaries: %s" % "; ".join(sorted(made)), "sha256": None}
    except cc.Refusal as e:
        return cc.refuse("mod/compare", e)
    binaries = {"oracle": oracle, "blaze": blaze["path"]}
    report = cc.Report("mod/compare", blaze=blaze, oracle={"path": oracle, "sha256": oracle_sha},
                       selection="projects %s, %d cases, side %s" % (
                           ",".join(projects), sum(len(v) for v in selected.values()), a.side),
                       tool_files=[os.path.abspath(__file__)])
    report.print_header()
    for project in projects:
        cases = selected[project]
        stale = {}
        if "oracle" not in sides:
            before = []
            for n, args in cases:
                reason = cc.check_key(os.path.join(result_dir("oracle", project), n + ".key"),
                                      oracle_key(project, args, list(before)))
                if reason:
                    stale[n] = reason
                before.append(n)
            if stale and "blaze" in sides:
                for n, r in sorted(stale.items())[:5]:
                    print("refused: %s/%s: %s" % (project, n, r), file=sys.stderr)
                return cc.refuse("mod/compare", "%d stored oracle captures of %s are stale or "
                                 "unkeyed; run with --side both" % (len(stale), project))
        for side in sides:
            ws, _ = side_paths(side, project)
            sync_workspace(project, ws)
            run(binaries[side], side, project, ["graph"])  # warm-up, discarded
            before = []
            for n, args in cases:
                capture(binaries[side], side, project, n, args, before)
                before.append(n)
            if side == "blaze":
                with open(os.path.join(result_dir("blaze", project), "binary.json"), "w") as f:
                    json.dump({"path": blaze["path"], "sha256": blaze["sha256"]}, f)
        for n, _ in cases:
            if n in stale:
                cls, detail = cc.SKIPPED, "stale oracle capture: " + stale[n]
            else:
                status, diffs = compare(project, n)
                cls, detail = judge(project, n, status, diffs)
            report.add("%s/%s" % (project, n), cls, detail)
            print("%-8s %-28s %s %s" % (project, n, cls, detail))
    if "oracle" in sides:
        for project in projects:
            shutdown(project)
    print()
    report.print_footer()
    if a.json:
        report.write_json(a.json)
    return report.exit_code()


def selftest():
    def run_pair(ofake, bfake, wd):
        cc.require_oracle(ofake)
        res = {}
        for side, fake in (("oracle", ofake), ("blaze", bfake)):
            p = cc.run(mod_argv(fake, os.path.join(wd, "our"), ["graph"]), wd, mode="scope",
                       tag="selftest")
            res[side] = (p.term, p.out, p.err)
        (ot, oo, oe), (bt, bo, be) = res["oracle"], res["blaze"]
        return cc.judge(ot, bt, [n for n, x, y in (("out", oo, bo), ("err", oe, be)) if x != y],
                        blaze_unported=cc.unported_message(be))

    def empty_selection():
        old_argv = sys.argv
        sys.argv = ["compare", "--case", "no-such-case", "--side", "none"]
        with open(os.devnull, "w") as null:
            old = sys.stderr
            sys.stderr = null
            try:
                return main()
            finally:
                sys.stderr = old
                sys.argv = old_argv

    def extra(st):
        st.check("a capture without .term has no termination", term_of({"rc": b"0\n"}) is None)

    return cc.selftest("mod/compare", run_pair=run_pair, empty_selection=empty_selection,
                       extra=extra, mode="scope")


if __name__ == "__main__":
    sys.exit(main())
