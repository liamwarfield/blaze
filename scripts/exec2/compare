#!/usr/bin/env python3
"""Compare unused_inputs_list pruning and C++ compile action templates between the oracle
(Bazel 9.3.2) and Blaze. See `compare help`."""

import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time

USAGE = """\
usage: scripts/exec2/compare --binary <blaze> [--oracle <bazel>] [--case pruning|tree-cc]...
                             [--label NAME] [--skip-oracle]
       scripts/exec2/compare list
       scripts/exec2/compare selftest
       scripts/exec2/compare help

Runs fixed command sequences (see `list`) with the oracle and with Blaze, each side on its own
work copy of brotli (~/.cache/blaze/work/exec2-compare/brotli, recreated for each side and case,
so action keys that contain the workspace path agree: rsync of the read-only checkout minus
bazel-* and .git, plus the probe package scripts/exec2/probe as //blaze_exec2_probe) and its own output user root (~/.cache/blaze/oracle-out/exec2-<side>), with a
clean environment (HOME, PATH=/usr/bin:/bin), --nohome_rc --nosystem_rc, the shared repository
cache, --color=no --curses=no, under systemd-run --user --scope -p MemoryMax=12G
-p MemorySwapMax=0. Each case starts from a fresh output base.

The oracle runs `shutdown` after every command, so each build starts a new server and, as in
Blaze (one process per command), only the on-disk action cache carries state between builds.

Cases:
  pruning  ctx.actions.run(unused_inputs_list=...): build; mark b.input unused; change b.input
           (pruned: must not re-run); change c.input (must re-run, b used again). Then aquery.
  tree-cc  cc_library with sources from a tree artifact (CppCompileActionTemplate) linked into
           a cc_binary: aquery of both targets, build, run the binary, null build, change the
           generator's input, build.

Compared per step (rule `paths`: workspace, output user root, output base):
  exit       the termination (exit code, or signal, OOM kill, timeout)
  stderr     in full, after the exclusion rules of scripts/lib/compare_common.py
             (VOLATILE_RULES; both sides run every command on a fresh server, so no
             server-state rule applies), listed in the report with the lines each changed or
             removed on each side
  spawns     --execution_log_json_file, one entry per spawn: mnemonic, target label, argv,
             environment, inputs (path, digest), listed outputs, actual outputs (path, digest),
             sorted by the first listed output
  files      sha256 of the step's files of interest (outputs, the unused inputs list, objects)
  stdout     in full after the same rules: program output (run steps), aquery text (aquery
             steps)

Guards (scripts/lib/compare_common.py): every command runs under a supervisor in the scope that
records how it really ended (`exit N`, `signal NAME`, `oom-kill`, `timeout`); `exit` compares
those. --oracle must be the pinned oracle (UPSTREAM.json). An empty selection is an error. Each
step is one case: IDENTICAL (termination and every field equal; the oracle exited 0, or
DECLARED_EXIT names the step with that exit code), DIFFERENT, BOTH-FAILED (equal failures not
declared), NOT-PORTED, ORACLE-UNEXPECTED, SKIPPED.

Output: a header (repository HEAD and dirty flag, both binaries' paths and sha256), a table, the
denominator; raw and normalised records under ~/.cache/blaze/exec2-compare/<label>/<side>/<case>/
and results.json (with provenance and denominator). Exit 0 only when at least one step was
compared and every selected step is IDENTICAL; 1 otherwise; 2 on a usage error or a refusal.
--skip-oracle reuses the oracle records of an earlier run with the same --label only when
<label>/oracle/<case>/oracle.key, written after the oracle's files were complete, holds this
run's key (oracle sha256, this tool's sha256 (it holds the setup steps that edit the workspace
between commands), every argv and the environment, the digests of the brotli checkout and the
probe) and every file it anchors is unchanged; otherwise it refuses. The terminations of the
`shutdown` commands are listed (an abnormal one fails the run).
selftest drives this command line with fake binaries (compare_common.selftest_tool).
"""

HOME = os.path.expanduser("~")
CACHE = os.path.join(HOME, ".cache", "blaze")
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
import compare_common as cc  # noqa: E402

# Steps ("<case>/<step>") whose non-zero exit is the behaviour under test, with the oracle's exit
# code. Equal failures of a step not listed here are BOTH-FAILED. Left to the case list's owner.
DECLARED_EXIT = {}
ORACLE = os.path.join(CACHE, "oracle", "bazel-9.3.2-linux-x86_64")
REPO_CACHE = os.path.join(CACHE, "repo-cache")
PROBE_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "probe")
CORPUS = os.path.join(CACHE, "corpus")
PKG = "blaze_exec2_probe"
P = "//" + PKG
TIMEOUT = 3600

UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")


def write(ws, rel, text):
    path = os.path.join(ws, PKG, rel)
    with open(path, "w") as f:
        f.write(text)


# Each step: (id, kind, args, setup, files). kind: build | aquery | run.
# setup(ws) edits the workspace before the step; files are paths (relative to the workspace,
# through the bazel-bin/bazel-out convenience symlinks) whose sha256 is recorded.
PRUNING_FILES = ["bazel-bin/%s/output.out" % PKG, "bazel-bin/%s/output.unused" % PKG]
CASES = {
    "pruning": [
        ("build-1", "build", [P + ":output"],
         lambda ws: (write(ws, "a.input", "contentA\n"), write(ws, "b.input", "contentB\n"),
                     write(ws, "c.input", "contentC\n")), PRUNING_FILES),
        ("b-unused", "build", [P + ":output"],
         lambda ws: write(ws, "b.input", "unused\n"), PRUNING_FILES),
        ("b-changed-pruned", "build", [P + ":output"],
         lambda ws: write(ws, "b.input", "newContentB\n"), PRUNING_FILES),
        ("c-unused", "build", [P + ":output"],
         lambda ws: write(ws, "c.input", "unused\n"), PRUNING_FILES),
        ("aquery", "aquery", ["--output=text", P + ":output"], None, []),
    ],
    "tree-cc": [
        ("aquery-lib", "aquery", ["--output=text", P + ":treelib"], None, []),
        ("aquery-bin", "aquery", ["--output=text", P + ":treebin"], None, []),
        ("build-1", "build", [P + ":treebin"], None,
         ["bazel-bin/%s/treebin" % PKG, "bazel-bin/%s/libtreelib.a" % PKG,
          "bazel-bin/%s/_pic_objs/treelib/gen_tree_dir" % PKG,
          "bazel-bin/%s/_objs/treelib/gen_tree_dir" % PKG]),
        ("run-1", "run", [P + ":treebin"], None, []),
        ("null-build", "build", [P + ":treebin"], None, []),
        ("template-changed", "build", [P + ":treebin"],
         lambda ws: write(ws, "template.txt", "7\n"),
         ["bazel-bin/%s/treebin" % PKG, "bazel-bin/%s/libtreelib.a" % PKG]),
        ("run-2", "run", [P + ":treebin"], None, []),
    ],
}


def clean_env():
    return {"HOME": HOME, "PATH": "/usr/bin:/bin"}


def make_writable_and_remove(path):
    if not os.path.lexists(path):
        return
    subprocess.run(["chmod", "-R", "u+w", path], stderr=subprocess.DEVNULL)
    shutil.rmtree(path, ignore_errors=True)
    if os.path.lexists(path):
        subprocess.run(["rm", "-rf", path])


def prepare_workspace(ws):
    """Copy brotli to ws (minus bazel-* and .git) and add the probe package."""
    make_writable_and_remove(ws)
    os.makedirs(ws, exist_ok=True)
    subprocess.run(
        ["rsync", "-a", "--delete", "--exclude=/bazel-*", "--exclude=/.git",
         os.path.join(CORPUS, "brotli") + "/", ws + "/"], check=True)
    shutil.copytree(PROBE_DIR, os.path.join(ws, PKG), symlinks=True)


def sha256_of(path):
    """sha256 of a file, or of a directory as a sorted list of (relative path, sha256)."""
    if os.path.isdir(path):
        entries = []
        for root, _dirs, files in os.walk(path):
            for name in sorted(files):
                p = os.path.join(root, name)
                entries.append((os.path.relpath(p, path), sha256_of(p)))
        return sorted(entries)
    if not os.path.exists(path):
        return None
    with open(path, "rb") as f:
        return hashlib.sha256(f.read()).hexdigest()


RULES = list(cc.VOLATILE_RULES)


def normaliser(ws, root):
    """Path replacement for the spawn records (the execution log)."""
    output_base_hash = hashlib.md5(ws.encode()).hexdigest()

    def norm(text):
        text = text.replace(os.path.join(root, output_base_hash), "<OUTPUT_BASE>")
        text = text.replace(root, "<OUTPUT_USER_ROOT>")
        text = text.replace(ws, "<WORKSPACE>")
        text = re.sub(r"<OUTPUT_USER_ROOT>/install/[0-9a-f]{32}", "<INSTALL_BASE>", text)
        return UUID_RE.sub("<UUID>", text)
    return norm


def side_dirs(side):
    return (os.path.join(CACHE, "work", "exec2-compare", "brotli"),
            os.path.join(CACHE, "oracle-out", "exec2-" + side))


def path_pairs(side):
    ws, root = side_dirs(side)
    return [(os.path.join(root, hashlib.md5(ws.encode()).hexdigest()), "<OUTPUT_BASE>"),
            (root, "<OUTPUT_USER_ROOT>"), (ws, "<WORKSPACE>")]


def read_json_stream(path):
    """The concatenated JSON objects of --execution_log_json_file."""
    if not os.path.exists(path):
        return None
    text = open(path, encoding="latin-1").read()
    dec = json.JSONDecoder()
    out, i = [], 0
    while True:
        while i < len(text) and text[i].isspace():
            i += 1
        if i >= len(text):
            break
        obj, i = dec.raw_decode(text, i)
        out.append(obj)
    return out


def spawn_summary(spawns, norm):
    if spawns is None:
        return None
    rows = []
    for s in spawns:
        def files(key):
            return [(f.get("path"), (f.get("digest") or {}).get("hash"))
                    for f in s.get(key, [])]
        rows.append({
            "mnemonic": s.get("mnemonic"),
            "targetLabel": s.get("targetLabel"),
            "args": [norm(a) for a in s.get("commandArgs", [])],
            "env": sorted((e.get("name"), norm(e.get("value", "")))
                          for e in s.get("environmentVariables", [])),
            "inputs": files("inputs"),
            "listedOutputs": s.get("listedOutputs", []),
            "actualOutputs": files("actualOutputs"),
        })
    rows.sort(key=lambda r: (r["listedOutputs"][:1], r["mnemonic"] or ""))
    return rows


def step_argv(base, kind, log, args):
    cmd = base + [kind, "--repository_cache=" + REPO_CACHE, "--color=no", "--curses=no"]
    if kind in ("build", "run"):
        cmd.append("--execution_log_json_file=" + log)
    return cmd + args


def oracle_key(case, out_dir):
    root = os.path.join(CACHE, "oracle-out", "exec2-oracle")
    base = [cc.PINNED_ORACLE, "--output_user_root=" + root, "--nohome_rc", "--nosystem_rc"]
    return cc.cache_key(
        cc.tool_sha256(os.path.abspath(__file__)), cc.pinned_sha256(),
        [step_argv(base, kind, os.path.join(out_dir, sid + ".execlog.json"), args)
         for (sid, kind, args, _setup, _files) in CASES[case]], clean_env(),
        {"brotli": cc.tree_digest(os.path.join(CORPUS, "brotli")),
         "probe": cc.tree_digest(PROBE_DIR)},
        extra={"case": case, "steps": [[s[0], s[4]] for s in CASES[case]]})


def case_files(out_dir, case):
    return [os.path.join(out_dir, s[0] + ext) for s in CASES[case]
            for ext in (".stdout", ".stderr", ".json", ".execlog.json")]


def run_case(side, binary, case, out_dir, report):
    # Both sides use the same workspace path (one after the other): some action keys (source
    # manifests, runfiles trees) contain the absolute workspace path.
    ws, root = side_dirs(side)
    base = [binary, "--output_user_root=" + root, "--nohome_rc", "--nosystem_rc"]
    report.add_aux("%s %s shutdown before" % (side, case), cc.run(
        base + ["shutdown"], ws if os.path.isdir(ws) else HOME, timeout=600, mode="scope",
        tag="exec2-shutdown").term)
    make_writable_and_remove(os.path.join(root, hashlib.md5(ws.encode()).hexdigest()))
    prepare_workspace(ws)
    norm = normaliser(ws, root)
    os.makedirs(out_dir, exist_ok=True)
    for (sid, kind, args, setup, files) in CASES[case]:
        if setup is not None:
            setup(ws)
        log = os.path.join(out_dir, sid + ".execlog.json")
        if os.path.exists(log):
            os.remove(log)
        cmd = step_argv(base, kind, log, args)
        print("[exec2-compare] %s %s/%s" % (side, case, sid), flush=True)
        r = cc.run(cmd, ws, timeout=TIMEOUT, mode="scope", tag="exec2-compare",
                   stdout_path=os.path.join(out_dir, sid + ".stdout"),
                   stderr_path=os.path.join(out_dir, sid + ".stderr"))
        # Every command ends with a fresh server for the oracle (Blaze has none).
        report.add_aux("%s %s/%s shutdown" % (side, case, sid), cc.run(
            base + ["shutdown"], ws, timeout=600, mode="scope", tag="exec2-shutdown").term)
        if not os.path.exists(log):
            open(log, "w").close()
        rec = {
            "argv": cmd, "duration_s": r.duration, "termination": r.term.to_dict(),
            "spawns": spawn_summary(read_json_stream(log), norm) if kind != "aquery" else None,
            "files": {f: sha256_of(os.path.join(ws, f)) for f in files},
        }
        with open(os.path.join(out_dir, sid + ".json"), "w") as f:
            json.dump(rec, f, indent=1)
        print("[exec2-compare]   %s in %.1fs" % (r.term, r.duration), flush=True)


def load_step(out_dir, sid):
    try:
        with open(os.path.join(out_dir, sid + ".json")) as f:
            rec = json.load(f)
        with open(os.path.join(out_dir, sid + ".stdout"), "rb") as f:
            rec["stdout"] = f.read()
        with open(os.path.join(out_dir, sid + ".stderr"), "rb") as f:
            rec["stderr"] = f.read()
    except (OSError, ValueError):
        return None
    return rec


def judge(norm, step, o, b):
    differing = []
    for stream in ("stdout", "stderr"):
        eq, _ = norm.compare(o[stream], b[stream], stream, path_pairs("oracle"),
                             path_pairs("blaze"))
        if not eq:
            differing.append(stream)
    for f in ("spawns", "files"):
        if json.dumps(o.get(f), sort_keys=True) != json.dumps(b.get(f), sort_keys=True):
            differing.append(f)
    return cc.judge(cc.Termination.from_dict(o.get("termination")),
                    cc.Termination.from_dict(b.get("termination")), differing,
                    declared_exit=DECLARED_EXIT.get(step),
                    blaze_unported=cc.unported_message(b["stderr"]))


def main(argv):
    if not argv or argv[0] in ("help", "--help", "-h"):
        print(USAGE)
        return 0
    if argv[0] == "selftest":
        return selftest()
    if argv[0] == "list":
        for c, steps in CASES.items():
            print("%-8s %s" % (c, ", ".join(s[0] for s in steps)))
        return 0
    binary, oracle, label, only, skip_oracle = None, ORACLE, "exec2-1", [], False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--binary":
            binary = os.path.abspath(argv[i + 1]); i += 2
        elif a == "--oracle":
            oracle = os.path.abspath(argv[i + 1]); i += 2
        elif a == "--label":
            label = argv[i + 1]; i += 2
        elif a == "--case":
            only.append(argv[i + 1]); i += 2
        elif a == "--skip-oracle":
            skip_oracle = True; i += 1
        else:
            print("unknown argument: %s\n\n%s" % (a, USAGE), file=sys.stderr)
            return 2
    if binary is None:
        print(USAGE, file=sys.stderr)
        return 2
    cases = [c for c in CASES if not only or c in only]
    if not cases:
        return cc.empty_selection_error("exec2/compare")
    try:
        oracle, oracle_sha = cc.require_oracle(oracle)
        blaze = cc.blaze_identity(binary)
    except cc.Refusal as e:
        return cc.refuse("exec2/compare", e)
    base = os.path.join(CACHE, "exec2-compare", label)
    report = cc.Report("exec2/compare", blaze=blaze, oracle={"path": oracle, "sha256": oracle_sha},
                       selection="label %s, cases %s%s" % (
                           label, ",".join(cases), ", oracle outputs reused" if skip_oracle
                           else ""), tool_files=[os.path.abspath(__file__)],
                       compared="per step: termination, the whole stdout and stderr after the "
                                "exclusion rules listed at the end, the spawns of the execution "
                                "log, the sha256 of the step's files")
    norm = cc.Normaliser(RULES)
    report.add_normaliser(norm)
    report.print_header()
    for case in cases:
        odir = os.path.join(base, "oracle", case)
        bdir = os.path.join(base, "blaze", case)
        key_path = os.path.join(odir, "oracle.key")
        if skip_oracle:
            try:
                cc.require_fresh(key_path, oracle_key(case, odir))
            except cc.Refusal as e:
                return cc.refuse("exec2/compare", e)
        else:
            cc.invalidate_key(key_path)
            run_case("oracle", oracle, case, odir, report)
            cc.write_key(key_path, oracle_key(case, odir), case_files(odir, case))
        run_case("blaze", blaze["path"], case, bdir, report)
        cc.write_capture(os.path.join(bdir, "capture.json"), blaze, case_files(bdir, case))
        for (sid, *_rest) in CASES[case]:
            o, b = load_step(odir, sid), load_step(bdir, sid)
            if o is None or b is None:
                report.add("%s/%s" % (case, sid), cc.SKIPPED, "no %s output" % (
                    "oracle" if o is None else "blaze"))
                continue
            cls, detail = judge(norm, "%s/%s" % (case, sid), o, b)
            report.add("%s/%s" % (case, sid), cls, detail)
    os.makedirs(base, exist_ok=True)
    report.write_json(os.path.join(base, "results.json"))
    print()
    report.print_rows()
    report.print_footer()
    print("results: %s" % os.path.join(base, "results.json"))
    return report.exit_code()


def selftest():
    first = next(iter(CASES))

    def argv(blaze, label):
        return ["--binary", blaze, "--case", first, "--label", label]

    def extra(st, fh, run):
        # M7: every case of the list (tree-cc included) through the real command line.
        for case in [c for c in CASES if c != first]:
            o, b = fh.fakes(dict(out=b"same\n"), dict(out=b"same\n"))
            rc, rep, log = run(["--binary", b, "--case", case, "--label", "selftest-" + case])
            cl = sorted(set(r["class"] for r in (rep or {}).get("cases", [])))
            st.check("M7: case %s runs through the launcher" % case, rc == 0
                     and cl == [cc.IDENTICAL], "exit %s, %s" % (rc, cl))

    return cc.selftest_tool(
        "exec2/compare", os.path.abspath(__file__), argv, extra=extra,
        empty=lambda b, l: ["--binary", b, "--case", "no-such-case", "--label", l],
        reuse=lambda b, l: argv(b, l) + ["--skip-oracle"],
        oracle_outputs=lambda home, l: [os.path.join(
            home, ".cache", "blaze", "exec2-compare", l, "oracle", first,
            CASES[first][0][0] + ".stdout")])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
