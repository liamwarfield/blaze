def clean_env():
    return {"HOME": HOME, "PATH": "/usr/bin:/bin"}


def case_argv(binary, root, args):
    cmd = [binary, "--output_user_root=" + root, "--nohome_rc", "--nosystem_rc"]
    cmd += [args[0], "--repository_cache=" + REPO_CACHE, "--color=no", "--curses=no"]
    return cmd + args[1:]


def oracle_key(cases):
    root = os.path.join(CACHE, "oracle-out", "config-compare-oracle")
    return cc.cache_key(cc.tool_sha256(os.path.abspath(__file__)), cc.pinned_sha256(),
                        [case_argv(cc.PINNED_ORACLE, root, c[2]) for c in cases], clean_env(),
                        cc.tree_digest(PROBE_DIR),
                        extra={"cases": [[c[0], c[3]] for c in cases]})


def make_writable_and_remove(path):
    if not os.path.lexists(path):
        return
    subprocess.run(["chmod", "-R", "u+w", path], stderr=subprocess.DEVNULL)
    shutil.rmtree(path, ignore_errors=True)
    if os.path.lexists(path):
        subprocess.run(["rm", "-rf", path])


SUMMARY_RE = re.compile(
    r"^(ERROR:|WARNING:|DEBUG:|INFO: Build completed|INFO: Build did NOT|INFO: ToolchainResolution|"
    r"INFO: Target |FAILED:|\s+ToolchainResolution:)")


def normaliser(ws, root):
    output_base = os.path.join(root, hashlib.md5(ws.encode()).hexdigest())

    def norm(text):
        text = text.replace(output_base, "<OUTPUT_BASE>")
        text = text.replace(root, "<OUTPUT_USER_ROOT>")
        text = text.replace(ws, "<WORKSPACE>")
        return text
    return norm


CONTINUATION_STOP_RE = re.compile(
    r"^(INFO:|ERROR:|WARNING:|DEBUG:|Loading|Analyzing|Computing|Starting|Extracting|FAILED:)")


def summary_lines(stderr):
    """The summary lines, each with its continuation lines (the lines of a multi-line event up to
    the next event or progress line)."""
    out = []
    in_event = False
    for line in stderr.splitlines():
        if SUMMARY_RE.match(line) and "discarding analysis cache" not in line:
            out.append(line)
            in_event = line.startswith(("ERROR:", "WARNING:", "DEBUG:", "INFO: ToolchainResolution"))
        elif in_event and not CONTINUATION_STOP_RE.match(line):
            out.append(line)
        else:
            in_event = False
    return out


def run_side(side, binary, cases, out_dir):
    ws = os.path.join(CACHE, "work", "config-compare", side)
    root = os.path.join(CACHE, "oracle-out", "config-compare-" + side)
    subprocess.run([binary, "--output_user_root=" + root, "--nohome_rc", "--nosystem_rc",
                    "shutdown"], cwd=HOME, env=clean_env(), stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL)
    make_writable_and_remove(ws)
    make_writable_and_remove(os.path.join(root, hashlib.md5(ws.encode()).hexdigest()))
    os.makedirs(ws)
    subprocess.run(["rsync", "-a", "--delete", PROBE_DIR + "/", ws + "/"], check=True)
    norm = normaliser(ws, root)
    os.makedirs(out_dir, exist_ok=True)
    results = {}
    for (cid, _desc, args, files) in cases:
        saved = {}
        for rel, content in files.items():
            path = os.path.join(ws, rel)
            saved[rel] = open(path, "rb").read() if os.path.exists(path) else None
            if content is None:
                if os.path.exists(path):
                    os.remove(path)
            else:
                with open(path, "w") as f:
                    f.write(content)
        cmd = case_argv(binary, root, args)
        print("[config-compare] %s %s" % (side, cid), flush=True)
        r = cc.run(cmd, ws, timeout=TIMEOUT, mode="scope", tag="config-compare")
        rc, out, err, dur = r.rc, r.out, r.err, r.duration
        for rel, content in saved.items():
            path = os.path.join(ws, rel)
            if content is None:
                if os.path.exists(path):
                    os.remove(path)
            else:
                with open(path, "wb") as f:
                    f.write(content)
        with open(os.path.join(out_dir, cid + ".stdout"), "wb") as f:
            f.write(out)
        with open(os.path.join(out_dir, cid + ".stderr"), "wb") as f:
            f.write(err)
        rec = {
            "argv": cmd, "duration_s": dur, "exit": rc, "termination": r.term.to_dict(),
            "stdout": norm(out.decode("latin-1")),
            "summary": summary_lines(norm(err.decode("latin-1"))),
            "unported": cc.unported_message(err),
        }
        results[cid] = rec
        with open(os.path.join(out_dir, cid + ".norm.json"), "w") as f:
            json.dump(rec, f, indent=1)
        print("[config-compare]   %s in %.1fs" % (r.term, dur), flush=True)
    cc.run([binary, "--output_user_root=" + root, "--nohome_rc", "--nosystem_rc", "shutdown"],
           ws, timeout=600, mode="scope", tag="config-compare-shutdown")
    return results


def compare_fields(o, b):
    """MATCH/DIFF per field; `exit` compares the recorded terminations."""
    row = {}
    for f in ("exit", "stdout", "summary"):
        if f == "exit":
            ot = cc.Termination.from_dict(o.get("termination"))
            bt = cc.Termination.from_dict(b.get("termination"))
            row[f] = "MATCH" if ot is not None and ot == bt else "DIFF"
        else:
            row[f] = "MATCH" if o.get(f) == b.get(f) else "DIFF"
    return row


def judge(cid, o, b, row):
    return cc.judge(cc.Termination.from_dict(o.get("termination")),
                    cc.Termination.from_dict(b.get("termination")),
                    [f for f, v in row.items() if v == "DIFF" and f != "exit"],
                    declared_exit=DECLARED_EXIT.get(cid), blaze_unported=b.get("unported"))


def main(argv):
    if not argv or argv[0] in ("help", "--help", "-h"):
        print(USAGE)
        return 0
    if argv[0] == "selftest":
        return selftest()
    if argv[0] == "list":
        for (cid, desc, args, files) in CASES:
            print("%-22s %s\n%22s   %s%s" % (cid, desc, "", " ".join(args),
                                              "  files: " + ", ".join(files) if files else ""))
        return 0
    binary = None
    oracle = ORACLE
    only = []
    label = "default"
    skip_oracle = False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--binary":
            binary = os.path.abspath(argv[i + 1]); i += 2
        elif a == "--oracle":
            oracle = os.path.abspath(argv[i + 1]); i += 2
        elif a == "--case":
            only.append(argv[i + 1]); i += 2
        elif a == "--label":
            label = argv[i + 1]; i += 2
        elif a == "--skip-oracle":
            skip_oracle = True; i += 1
        else:
            print("unknown argument: " + a, file=sys.stderr)
            return 2
    if binary is None:
        print("--binary is required", file=sys.stderr)
        return 2
    cases = [c for c in CASES if not only or c[0] in only]
    if not cases:
        return cc.empty_selection_error("config/compare")
    try:
        oracle, oracle_sha = cc.require_oracle(oracle)
        blaze = cc.blaze_identity(binary)
    except cc.Refusal as e:
        return cc.refuse("config/compare", e)
    base = os.path.join(CACHE, "config-compare", label)
    report = cc.Report("config/compare", blaze=blaze,
                       oracle={"path": oracle, "sha256": oracle_sha},
                       selection="label %s, %d cases%s" % (
                           label, len(cases), " (--case %s)" % ",".join(only) if only else ""),
                       tool_files=[os.path.abspath(__file__)])
    report.print_header()
    key_path = os.path.join(base, "oracle", "oracle.key")
    if skip_oracle:
        try:
            cc.require_fresh(key_path, oracle_key(cases))
        except cc.Refusal as e:
            return cc.refuse("config/compare", e)
        oracle_results = json.load(open(os.path.join(base, "results.json")))["oracle"]
    else:
        oracle_results = run_side("oracle", oracle, cases, os.path.join(base, "oracle"))
        cc.write_key(key_path, oracle_key(cases))
    blaze_results = run_side("blaze", blaze["path"], cases, os.path.join(base, "blaze"))
    table = {}
    for (cid, _d, _a, _f) in cases:
        o, b = oracle_results.get(cid, {}), blaze_results[cid]
        row = compare_fields(o, b)
        cls, detail = judge(cid, o, b, row)
        report.add(cid, cls, detail)
        table[cid] = dict(row, **{"class": cls})
        print("%-22s %s  %s" % (cid, "  ".join("%s=%s" % kv for kv in row.items()), cls))
    report.write_json(os.path.join(base, "results.json"),
                      extra={"oracle": oracle_results, "blaze": blaze_results, "table": table})
    print()
    report.print_rows()
    report.print_footer()
    return report.exit_code()


def selftest():
    def run_pair(ofake, bfake, wd):
        cc.require_oracle(ofake)
        recs = {}
        for side, fake in (("oracle", ofake), ("blaze", bfake)):
            r = cc.run([fake, "cquery"], wd, mode="scope", tag="selftest")
            norm = normaliser(wd, os.path.join(wd, "ur"))
            recs[side] = {"exit": r.rc, "termination": r.term.to_dict(),
                          "stdout": norm(r.out.decode("latin-1")),
                          "summary": summary_lines(norm(r.err.decode("latin-1"))),
                          "unported": cc.unported_message(r.err)}
        row = compare_fields(recs["oracle"], recs["blaze"])
        return judge("selftest", recs["oracle"], recs["blaze"], row)

    def empty_selection():
        with open(os.devnull, "w") as null:
            old = sys.stderr
            sys.stderr = null
            try:
                return main(["--binary", "/bin/true", "--case", "no-such-case"])
            finally:
                sys.stderr = old

    def extra(st):
        legacy = {"exit": 0, "stdout": "", "summary": []}
        st.check("a legacy record without termination never matches",
                 compare_fields(legacy, dict(legacy))["exit"] == "DIFF")
        kp = os.path.join(st.dir, "oracle.key")
        cc.write_key(kp, oracle_key(CASES[:2]))
        st.check("--skip-oracle refuses another case sequence",
                 cc.check_key(kp, oracle_key(CASES[:3])) is not None)

    return cc.selftest("config/compare", run_pair=run_pair, empty_selection=empty_selection,
                       extra=extra, mode="scope")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
