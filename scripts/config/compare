def clean_env():
    return {"HOME": HOME, "PATH": "/usr/bin:/bin"}


def case_argv(binary, root, args):
    cmd = [binary, "--output_user_root=" + root, "--nohome_rc", "--nosystem_rc"]
    cmd += [args[0], "--repository_cache=" + REPO_CACHE, "--color=no", "--curses=no"]
    return cmd + args[1:]


def oracle_key(cases):
    root = os.path.join(CACHE, "oracle-out", "config-compare-oracle")
    return cc.cache_key(None, cc.pinned_sha256(),
                        [case_argv(cc.PINNED_ORACLE, root, c[2]) for c in cases], clean_env(),
                        cc.tree_digest(PROBE_DIR),
                        extra={"cases": [[c[0], c[3]] for c in cases]})


def make_writable_and_remove(path):
    if not os.path.lexists(path):
        return
    subprocess.run(["chmod", "-R", "u+w", path], stderr=subprocess.DEVNULL)
    shutil.rmtree(path, ignore_errors=True)
    if os.path.lexists(path):
        subprocess.run(["rm", "-rf", path])


RULES = cc.VOLATILE_RULES + cc.B1_GAP_RULES


def side_dirs(side):
    return (os.path.join(CACHE, "work", "config-compare", side),
            os.path.join(CACHE, "oracle-out", "config-compare-" + side))


def path_pairs(side):
    ws, root = side_dirs(side)
    return [(os.path.join(root, hashlib.md5(ws.encode()).hexdigest()), "<OUTPUT_BASE>"),
            (root, "<OUTPUT_USER_ROOT>"), (ws, "<WORKSPACE>")]


def case_files(out_dir, cases):
    return [os.path.join(out_dir, c[0] + ext) for c in cases
            for ext in (".stdout", ".stderr", ".json")]


def run_side(side, binary, cases, out_dir, report):
    ws, root = side_dirs(side)
    report.add_aux("%s shutdown before" % side, cc.run(
        [binary, "--output_user_root=" + root, "--nohome_rc", "--nosystem_rc", "shutdown"],
        HOME, timeout=600, mode="scope", tag="config-compare-shutdown").term)
    make_writable_and_remove(ws)
    make_writable_and_remove(os.path.join(root, hashlib.md5(ws.encode()).hexdigest()))
    os.makedirs(ws)
    subprocess.run(["rsync", "-a", "--delete", PROBE_DIR + "/", ws + "/"], check=True)
    os.makedirs(out_dir, exist_ok=True)
    for (cid, _desc, args, files) in cases:
        saved = {}
        for rel, content in files.items():
            path = os.path.join(ws, rel)
            saved[rel] = open(path, "rb").read() if os.path.exists(path) else None
            if content is None:
                if os.path.exists(path):
                    os.remove(path)
            else:
                with open(path, "w") as f:
                    f.write(content)
        cmd = case_argv(binary, root, args)
        print("[config-compare] %s %s" % (side, cid), flush=True)
        r = cc.run(cmd, ws, timeout=TIMEOUT, mode="scope", tag="config-compare",
                   stdout_path=os.path.join(out_dir, cid + ".stdout"),
                   stderr_path=os.path.join(out_dir, cid + ".stderr"))
        for rel, content in saved.items():
            path = os.path.join(ws, rel)
            if content is None:
                if os.path.exists(path):
                    os.remove(path)
            else:
                with open(path, "wb") as f:
                    f.write(content)
        with open(os.path.join(out_dir, cid + ".json"), "w") as f:
            json.dump({"argv": cmd, "duration_s": r.duration,
                       "termination": r.term.to_dict()}, f, indent=1)
        print("[config-compare]   %s in %.1fs" % (r.term, r.duration), flush=True)
    report.add_aux("%s shutdown" % side, cc.run(
        [binary, "--output_user_root=" + root, "--nohome_rc", "--nosystem_rc", "shutdown"],
        ws, timeout=600, mode="scope", tag="config-compare-shutdown").term)


def load_case(out_dir, cid):
    try:
        with open(os.path.join(out_dir, cid + ".json")) as f:
            rec = json.load(f)
        with open(os.path.join(out_dir, cid + ".stdout"), "rb") as f:
            rec["stdout"] = f.read()
        with open(os.path.join(out_dir, cid + ".stderr"), "rb") as f:
            rec["stderr"] = f.read()
    except (OSError, ValueError):
        return None
    return rec


def judge(norm, cid, o, b):
    differing, gaps = [], []
    for stream in ("stdout", "stderr"):
        eq, g = norm.compare(o[stream], b[stream], stream, path_pairs("oracle"),
                             path_pairs("blaze"))
        if not eq:
            differing.append(stream)
        gaps += g
    return cc.judge(cc.Termination.from_dict(o.get("termination")),
                    cc.Termination.from_dict(b.get("termination")), differing,
                    declared_exit=DECLARED_EXIT.get(cid),
                    blaze_unported=cc.unported_message(b["stderr"]), gaps=sorted(set(gaps)))


def main(argv):
    if not argv or argv[0] in ("help", "--help", "-h"):
        print(USAGE)
        return 0
    if argv[0] == "selftest":
        return selftest()
    if argv[0] == "list":
        for (cid, desc, args, files) in CASES:
            print("%-22s %s\n%22s   %s%s" % (cid, desc, "", " ".join(args),
                                              "  files: " + ", ".join(files) if files else ""))
        return 0
    binary = None
    oracle = ORACLE
    only = []
    label = "default"
    skip_oracle = False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--binary":
            binary = os.path.abspath(argv[i + 1]); i += 2
        elif a == "--oracle":
            oracle = os.path.abspath(argv[i + 1]); i += 2
        elif a == "--case":
            only.append(argv[i + 1]); i += 2
        elif a == "--label":
            label = argv[i + 1]; i += 2
        elif a == "--skip-oracle":
            skip_oracle = True; i += 1
        else:
            print("unknown argument: " + a, file=sys.stderr)
            return 2
    if binary is None:
        print("--binary is required", file=sys.stderr)
        return 2
    cases = [c for c in CASES if not only or c[0] in only]
    if not cases:
        return cc.empty_selection_error("config/compare")
    try:
        oracle, oracle_sha = cc.require_oracle(oracle)
        blaze = cc.blaze_identity(binary)
    except cc.Refusal as e:
        return cc.refuse("config/compare", e)
    base = os.path.join(CACHE, "config-compare", label)
    report = cc.Report("config/compare", blaze=blaze,
                       oracle={"path": oracle, "sha256": oracle_sha},
                       selection="label %s, %d cases%s%s" % (
                           label, len(cases), " (--case %s)" % ",".join(only) if only else "",
                           ", oracle outputs reused" if skip_oracle else ""),
                       tool_files=[os.path.abspath(__file__)],
                       compared="termination, the whole stdout and the whole stderr after the "
                                "exclusion rules listed at the end")
    norm = cc.Normaliser(RULES)
    report.add_normaliser(norm)
    report.print_header()
    odir, bdir = os.path.join(base, "oracle"), os.path.join(base, "blaze")
    key_path = os.path.join(odir, "oracle.key")
    if skip_oracle:
        try:
            cc.require_fresh(key_path, oracle_key(cases))
        except cc.Refusal as e:
            return cc.refuse("config/compare", e)
    else:
        cc.invalidate_key(key_path)
        run_side("oracle", oracle, cases, odir, report)
        cc.write_key(key_path, oracle_key(cases), case_files(odir, cases))
    run_side("blaze", blaze["path"], cases, bdir, report)
    cc.write_capture(os.path.join(bdir, "capture.json"), blaze, case_files(bdir, cases))
    for (cid, _d, _a, _f) in cases:
        o, b = load_case(odir, cid), load_case(bdir, cid)
        if o is None or b is None:
            report.add(cid, cc.SKIPPED, "no %s output" % ("oracle" if o is None else "blaze"))
            continue
        cls, detail = judge(norm, cid, o, b)
        report.add(cid, cls, detail)
    report.write_json(os.path.join(base, "results.json"))
    print()
    report.print_rows()
    report.print_footer()
    return report.exit_code()


def selftest():
    def argv(blaze, label):
        return ["--binary", blaze, "--case", CASES[0][0], "--label", label]

    return cc.selftest_tool(
        "config/compare", os.path.abspath(__file__), argv,
        empty=lambda b, l: ["--binary", b, "--case", "no-such-case", "--label", l],
        reuse=lambda b, l: argv(b, l) + ["--skip-oracle"],
        oracle_outputs=lambda home, l: [os.path.join(home, ".cache", "blaze", "config-compare",
                                                     l, "oracle", CASES[0][0] + ".stdout")])


