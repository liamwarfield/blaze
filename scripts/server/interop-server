class Env:
    def __init__(self, probe, bazel, scratch):
        self.probe = probe
        self.bazel = bazel
        self.scratch = scratch
        self.javabase = os.path.join(scratch, "javabase")
        self.workspace = os.path.join(scratch, "ws")
        self.clients = []  # Popen objects of clients started in the background

    def root(self, case):
        return os.path.join(self.scratch, "roots", case)

    def argv(self, case, *command, startup=()):
        return [
            self.bazel,
            "--output_user_root=" + self.root(case),
            "--nohome_rc",
            "--nosystem_rc",
            "--server_javabase=" + self.javabase,
            *startup,
            *command,
        ]


def show_cmd(argv):
    return " ".join(a if a and " " not in a else repr(a) for a in argv)


def run_client(env, case, *command, startup=(), timeout=120, merge=False):
    argv = env.argv(case, *command, startup=startup)
    print("  $ (cd %s && %s)%s" % (env.workspace, show_cmd(argv), " 2>&1" if merge else ""))
    p = subprocess.run(
        argv,
        cwd=env.workspace,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT if merge else subprocess.PIPE,
        timeout=timeout,
    )
    out = p.stdout
    err = b"" if merge else p.stderr
    print("    exit %d" % p.returncode)
    show_output("stdout" if not merge else "stdout+stderr", out)
    if not merge:
        show_output("stderr", err)
    return p.returncode, out, err


def show_output(name, data, limit=1200):
    if not data:
        print("    %s: (empty)" % name)
        return
    text = data if len(data) <= limit else data[:limit] + b"...[%d bytes in all]" % len(data)
    print("    %s: %r" % (name, text))


def server_pid(env, case):
    pids = []
    for f in glob.glob(os.path.join(env.root(case), "*", "server", "server.pid.txt")):
        try:
            with open(f) as fh:
                pids.append(int(fh.read()))
        except (OSError, ValueError):
            pass
    return pids[0] if pids else None


def alive(pid):
    if pid is None:
        return False
    try:
        with open("/proc/%d/stat" % pid) as fh:
            state = fh.read().rsplit(")", 1)[1].split()[0]
        return state != "Z"
    except OSError:
        return False


def is_probe(pid):
    try:
        exe = os.readlink("/proc/%d/exe" % pid)
    except OSError:
        return False
    return os.path.basename(exe.replace(" (deleted)", "")) in ("probe", "command_server_probe")


def wait_for(predicate, timeout, step=0.1):
    deadline = time.time() + timeout
    while time.time() < deadline:
        if predicate():
            return True
        time.sleep(step)
    return predicate()


def output_base(env, case):
    bases = glob.glob(os.path.join(env.root(case), "*", "server"))
    return os.path.dirname(bases[0]) if bases else None


class Failure(Exception):
    pass


def check(cond, what):
    print("    check: %s: %s" % (what, "ok" if cond else "FAILED"))
    if not cond:
        raise Failure(what)


# ---------------------------------------------------------------------------------------------
# Cases. Each takes the Env and raises Failure on a failed check.


def case_connect(env):
    """First command starts the server; the client connects (Ping with the cookies)."""
    code, out, err = run_client(env, "connect", "echo", "hello")
    check(code == 0, "exit code 0")
    check(STARTING in err, "client started a server ('Starting local Bazel server')")
    check(out == b"out:hello\n", "stdout is the echo")
    base = output_base(env, "connect")
    server = os.path.join(base, "server")
    files = sorted(os.listdir(server))
    print("    server dir: %s" % files)
    for f in ("server_info.rawproto", "command_port", "request_cookie", "response_cookie"):
        check(f in files, "server/%s written" % f)
    with open(os.path.join(server, "command_port")) as fh:
        port = fh.read()
    print("    command_port: %r" % port)
    check(port.startswith("[::1]:") or port.startswith("127.0.0.1:"), "loopback address")
    with open(os.path.join(server, "request_cookie")) as fh:
        cookie = fh.read()
    check(len(cookie) > 16 and all(c in "0123456789abcdef" for c in cookie), "hex cookie")
    pid = server_pid(env, "connect")
    check(alive(pid) and is_probe(pid), "server pid %s is the probe and alive" % pid)
    with open(os.path.join(server, "jvm.out"), "rb") as fh:
        show_output("server/jvm.out", fh.read())
    # The connect log of the client: --client_debug prints its Ping attempts.
    code, out, err = run_client(env, "connect", "echo", "ping", startup=("--client_debug",))
    lines = [l for l in err.splitlines() if b"connect" in l.lower() or b"ping" in l.lower()]
    for l in lines[:6]:
        print("    client_debug: %r" % l)
    check(code == 0 and out == b"out:ping\n", "second command over the same server")
    check(any(b"Connected (server pid=%d)" % pid in l for l in lines), "client logged 'Connected (server pid=%d)'" % pid)


def case_order(env):
    """stdout and stderr forwarded in order and byte-exact (non-UTF-8 bytes included)."""
    raw = [b"a", "b\u00e9".encode("latin-1"), "c\u00e9".encode("utf-8"), b"\xff\xfe\x80", b"d"]
    full = [os.fsencode(a) for a in env.argv("order", "echo")] + raw
    shown = [a.decode("latin-1") for a in full]
    print("  $ (cd %s && %s) 2>&1   # args as bytes: %r" % (env.workspace, show_cmd(shown), raw))
    p = subprocess.run(full, cwd=env.workspace, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=120)
    print("    exit %d" % p.returncode)
    lines = [l for l in p.stdout.split(b"\n") if l.startswith(b"out:") or l.startswith(b"err:")]
    show_output("stdout+stderr (echo lines)", b"\n".join(lines) + b"\n")
    expected = []
    for r in raw:
        expected += [b"out:" + r, b"err:" + r]
    check(p.returncode == 0, "exit code 0")
    check(lines == expected, "out/err interleaved per argument, exact bytes")
    q = subprocess.run(full, cwd=env.workspace, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=120)
    check(q.stdout == b"".join(b"out:" + r + b"\n" for r in raw), "stdout alone byte-exact")
    errs = [l for l in q.stderr.split(b"\n") if l.startswith(b"err:")]
    check(errs == [b"err:" + r for r in raw], "stderr alone byte-exact")


def case_exit_codes(env):
    """The client exits with the command's exit code."""
    for n in (0, 1, 2, 3, 4, 8, 36):
        code, out, err = run_client(env, "exit", "exit", str(n))
        check(code == n, "exit %d" % n)


def case_big(env):
    """5 MB of output arrive complete (8192-byte chunks, flow control)."""
    n = 5 * 1000 * 1000
    argv = env.argv("big", "big", str(n))
    print("  $ (cd %s && %s) | sha256sum" % (env.workspace, show_cmd(argv)))
    p = subprocess.run(argv, cwd=env.workspace, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=300)
    expected = bytes(i % 251 for i in range(n))
    print("    exit %d, %d bytes, sha256 %s (expected %s)" % (
        p.returncode, len(p.stdout), hashlib.sha256(p.stdout).hexdigest()[:16],
        hashlib.sha256(expected).hexdigest()[:16]))
    show_output("stderr", p.stderr)
    check(p.returncode == 0, "exit code 0")
    check(p.stdout == expected, "all %d bytes, in order" % n)
    # A slow reader: the client blocks on its stdout pipe, the server on flow control.
    print("  $ (cd %s && %s) | (sleep 3; cat) | wc -c" % (env.workspace, show_cmd(argv)))
    slow = subprocess.Popen(argv, cwd=env.workspace, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    time.sleep(3)
    data = slow.stdout.read()
    slow.wait(timeout=300)
    print("    exit %d, %d bytes" % (slow.returncode, len(data)))
    check(slow.returncode == 0 and data == expected, "slow reader gets all bytes")


def case_reuse(env):
    """A second client invocation reuses the server (no 'Starting local Bazel server')."""
    code, out, err = run_client(env, "reuse", "echo", "first")
    check(code == 0 and STARTING in err, "first invocation starts the server")
    pid1 = server_pid(env, "reuse")
    code, out, err = run_client(env, "reuse", "echo", "second")
    pid2 = server_pid(env, "reuse")
    check(code == 0 and out == b"out:second\n", "second invocation works")
    check(STARTING not in err, "second invocation did not start a server")
    check(pid1 == pid2 and alive(pid2), "same server pid %s" % pid2)


def start_background(env, case, *command):
    argv = env.argv(case, *command)
    print("  $ (cd %s && %s) &" % (env.workspace, show_cmd(argv)))
    p = subprocess.Popen(argv, cwd=env.workspace, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    env.clients.append(p)
    return p


def read_stderr_until(p, marker, timeout):
    """Reads the client's stderr until `marker` appears; returns what was read."""
    os.set_blocking(p.stderr.fileno(), False)
    data = b""
    deadline = time.time() + timeout
    while time.time() < deadline and marker not in data:
        try:
            chunk = p.stderr.read()
        except BlockingIOError:
            chunk = None
        if chunk:
            data += chunk
        elif p.poll() is not None:
            break
        else:
            time.sleep(0.05)
    os.set_blocking(p.stderr.fileno(), True)
    return data


def case_cancel(env):
    """SIGINT to the client during `sleep 60` sends Cancel; the command ends (exit 8)."""
    code, out, err = run_client(env, "cancel", "echo", "warm")
    pid = server_pid(env, "cancel")
    p = start_background(env, "cancel", "sleep", "60")
    before = read_stderr_until(p, b"sleeping 60s", 60)
    check(b"sleeping 60s" in before, "command started on the server")
    print("  $ kill -INT %d   # the client" % p.pid)
    t0 = time.time()
    p.send_signal(signal.SIGINT)
    out, err = p.communicate(timeout=60)
    elapsed = time.time() - t0
    err = before + err
    print("    exit %d after %.1fs" % (p.returncode, elapsed))
    show_output("stdout", out)
    show_output("stderr", err)
    check(b"Bazel caught interrupt signal; cancelling pending invocation." in err, "client sent Cancel")
    check(b"sleep interrupted" in err, "server command was interrupted")
    check(p.returncode == 8, "exit code 8 (INTERRUPTED)")
    check(elapsed < 10, "ended well before the 60 s sleep")
    check(alive(pid) and server_pid(env, "cancel") == pid, "server still running (pid %s)" % pid)


def case_exec(env):
    """The client executes the ExecRequest (/bin/echo exec-ok)."""
    code, out, err = run_client(env, "exec", "exec")
    check(code == 0 and out == b"exec-ok\n", "client exec'd /bin/echo exec-ok")


def case_shutdown(env):
    """`shutdown` returns; the server process is gone and its files deleted."""
    code, out, err = run_client(env, "shutdown", "echo", "up")
    pid = server_pid(env, "shutdown")
    base = output_base(env, "shutdown")
    check(alive(pid), "server %s running" % pid)
    t0 = time.time()
    code, out, err = run_client(env, "shutdown", "shutdown")
    elapsed = time.time() - t0
    print("    client returned after %.1fs" % elapsed)
    check(code == 0, "exit code 0")
    check(not alive(pid), "server process %d is gone when the client returns" % pid)
    left = sorted(os.listdir(os.path.join(base, "server")))
    print("    server dir after shutdown: %s" % left)
    for f in ("server_info.rawproto", "command_port", "request_cookie", "response_cookie", "server.pid.txt"):
        check(f not in left, "server/%s deleted by the shutdown hooks" % f)
    with open(os.path.join(base, "server", "jvm.out"), "rb") as fh:
        show_output("server/jvm.out", fh.read())


def case_sigkill(env):
    """SIGKILL of the server during a command: 'Server terminated abruptly'."""
    code, out, err = run_client(env, "sigkill", "echo", "up")
    pid = server_pid(env, "sigkill")
    p = start_background(env, "sigkill", "sleep", "60")
    before = read_stderr_until(p, b"sleeping 60s", 60)
    check(b"sleeping 60s" in before, "command started on the server")
    print("  $ kill -KILL %d   # the server" % pid)
    os.kill(pid, signal.SIGKILL)
    out, err = p.communicate(timeout=60)
    err = before + err
    print("    exit %d" % p.returncode)
    show_output("stderr", err)
    check(b"Server terminated abruptly" in err, "client printed 'Server terminated abruptly'")
    check(p.returncode == 37, "exit code 37")


def case_idle(env):
    """--max_idle_secs=5: the server exits by itself."""
    code, out, err = run_client(env, "idle", "echo", "up", startup=("--max_idle_secs=5",))
    pid = server_pid(env, "idle")
    check(code == 0 and alive(pid), "server %s running" % pid)
    t0 = time.time()
    gone = wait_for(lambda: not alive(pid), 30)
    print("    server gone after %.1fs" % (time.time() - t0))
    check(gone, "server exited by itself")
    check(time.time() - t0 >= 3, "not before the idle time")


def case_crash(env):
    """A panic on the command thread halts the server (37); the client reports it."""
    code, out, err = run_client(env, "crash", "echo", "up")
    pid = server_pid(env, "crash")
    code, out, err = run_client(env, "crash", "crash")
    check(code == 37, "exit code 37")
    check(b"Server terminated abruptly" in err or b"without an explicit exit code" in err,
          "client reported the dead server")
    check(wait_for(lambda: not alive(pid), 10), "server process is gone")


CASES = [
    ("connect", case_connect),
    ("order", case_order),
    ("exit-codes", case_exit_codes),
    ("big", case_big),
    ("reuse", case_reuse),
    ("cancel", case_cancel),
    ("exec", case_exec),
    ("shutdown", case_shutdown),
    ("sigkill", case_sigkill),
    ("idle", case_idle),
    ("crash", case_crash),
]


def cleanup(env):
    """Shuts down, and failing that kills, every server under the scratch roots."""
    for p in env.clients:
        if p.poll() is None:
            p.kill()
            p.wait()
    for pidfile in glob.glob(os.path.join(env.scratch, "roots", "*", "*", "server", "server.pid.txt")):
        try:
            with open(pidfile) as fh:
                pid = int(fh.read())
        except (OSError, ValueError):
            continue
        if not alive(pid):
            continue
        case = pidfile.split(os.sep)[-4]
        try:
            subprocess.run(env.argv(case, "shutdown"), cwd=env.workspace, timeout=30,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            pass
        if alive(pid) and is_probe(pid):
            os.kill(pid, signal.SIGKILL)
            wait_for(lambda: not alive(pid), 5)
        print("cleanup: server %d of %s %s" % (pid, case, "gone" if not alive(pid) else "STILL ALIVE"))


# ---------------------------------------------------------------------------------------------
# --server-binary: the real Bazel client with a real server binary, compared with the real
# client and its real server.

REAL_WORK = os.path.join(C.SERVER_WORK, "s3", "real")
REAL_OOM = None  # C.OomWatch, made inside the unit
# Step title -> the oracle side's designed termination (audit 4r2, SV-2): equal on both sides is
# IDENTICAL, the oracle ending otherwise ORACLE-UNEXPECTED; any other equal failure BOTH-FAILED.
REAL_DECLARED = {
    "build //:fail": "exit 1",
    "build //:sleep, SIGINT to the client after 10s": "exit 8",
}


class RealSide:
    """One side of the --server-binary comparison: the oracle client, on its own output user
    root; with `javabase`, the server is whatever <javabase>/bin/java is."""

    def __init__(self, name, client, javabase):
        self.name = name
        self.client = client
        self.javabase = javabase
        self.ur = os.path.join(REAL_WORK, "ur-" + name)
        self.ws = os.path.join(REAL_WORK, "ws")
        self.env = {"HOME": C.HOME, "PATH": "/usr/bin:/bin"}
        self.env.update(C.tripwire_env())
        paths = [(javabase, "<SERVER_JAVABASE>")] if javabase else []
        self.norm = C.Norm(self.ur, paths)
        self.steps = []  # (title, text, failed, compare_common Termination or None for a fact)
        self.timed_out = False

    def startup(self, extra=()):
        argv = [self.client, "--output_user_root=" + self.ur, "--nohome_rc", "--nosystem_rc"]
        if self.javabase:
            argv.append("--server_javabase=" + self.javabase)
        return argv + list(extra)

    def argv(self, command, args, startup=()):
        argv = self.startup(startup) + [command]
        if command in ("build", "query", "info", "test"):
            argv += ["--repository_cache=" + C.REPO_CACHE, "--color=no", "--curses=no"]
        return argv + list(args)

    def spawn(self, command, args=(), startup=()):
        return subprocess.Popen(self.argv(command, args, startup), cwd=self.ws, env=self.env,
                                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE)

    def finish(self, title, p, timeout=600):
        timed_out = False
        try:
            out, err = p.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            p.kill()
            out, err = p.communicate()
            timed_out = True
        status = C.Status(p.returncode, timed_out)
        self.timed_out |= timed_out
        oom = REAL_OOM.delta() if REAL_OOM else 0
        term = C.termination(status, oom)
        self.steps.append((title, "%s\n--- stdout\n%s--- stderr\n%s" % (
            C.status_line(status, oom), self.norm.text(out or b""), self.norm.stderr(err or b"")),
            not term.ok, term))
        return out or b""

    def run(self, title, command, args=(), startup=(), timeout=600):
        return self.finish(title, self.spawn(command, args, startup), timeout)

    def fact(self, title, value):
        self.steps.append((title, "%s\n" % value, False, None))

    def pid(self):
        return C.server_pid(self.ur)

    def is_server(self, pid):
        return C.owned_by_root(pid, self.ur)

    def cleanup(self):
        def shutdown(out_base):
            subprocess.run(self.startup() + ["--output_base=" + out_base, "shutdown"],
                           cwd=REAL_WORK, env=self.env, stdin=subprocess.DEVNULL,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=90)
        left = C.kill_root_servers(self.ur, shutdown)
        if left:
            raise RuntimeError("servers %s of %s survived SIGKILL" % (left, self.ur))


def real_sequence(s):
    """The steps of --server-binary mode, run once per side on one fresh root and workspace."""
    s.cleanup()
    for d in (s.ur, s.ws):
        if os.path.lexists(d):
            C.safe_rmtree(d, REAL_WORK)
    C.write_template(s.ws)
    s.run("version", "version")
    pid = s.pid()
    s.fact("a server is running", s.is_server(pid))
    s.run("info release workspace server_pid", "info", ["release", "workspace", "server_pid"])
    s.run("build //:ok", "build", ["//:ok"])
    s.run("build //:ok (again)", "build", ["//:ok"])
    s.run("query //...", "query", ["//..."])
    s.run("build //:fail", "build", ["//:fail"])
    s.fact("same server for every command so far", pid is not None and s.pid() == pid
           and s.is_server(pid))
    p = s.spawn("build", ["//:sleep"])
    time.sleep(10)
    p.send_signal(signal.SIGINT)
    s.finish("build //:sleep, SIGINT to the client after 10s", p)
    s.fact("server still up after the cancel", s.is_server(pid) and s.pid() == pid)
    s.run("info release (after the cancel)", "info", ["release"])
    s.run("shutdown", "shutdown")
    s.fact("server gone after shutdown", pid is not None and C.wait_gone(pid, 10))
    s.run("--max_idle_secs=5 info release (new server)", "info", ["release"],
          startup=["--max_idle_secs=5"])
    pid2 = s.pid()
    s.fact("new server", pid2 not in (None, pid))
    s.fact("idle server gone within 30s", pid2 is not None and C.wait_gone(pid2, 30))


def real_main(opts, args):
    tool = "interop-server"
    control = "--control" in args
    no_unit = "--no-unit" in args
    extra = [a for a in args if a not in ("--control", "--no-unit")]
    if extra:
        sys.exit("--server-binary mode takes no case names (%s); see help" % " ".join(extra))
    oracle = C.verified_oracle(tool, opts["bazel"])
    server = os.path.abspath(opts["server_binary"])
    if not control and not os.access(server, os.X_OK):
        sys.exit("not an executable: %s" % server)
    if not control:
        C.refuse_oracle_as_blaze(tool, server)
    if not no_unit:
        rc = C.in_unit(tool, [os.path.abspath(__file__), "run", "--server-binary", server,
                              "--bazel", oracle] + args + ["--no-unit"],
                       os.path.join(REAL_WORK, "unit"))
        if rc is not None:
            return rc
    global REAL_OOM
    REAL_OOM = C.OomWatch()
    os.makedirs(REAL_WORK, exist_ok=True)
    staged = None
    javabase = os.path.join(REAL_WORK, "javabase")
    if os.path.lexists(javabase):
        C.safe_rmtree(javabase, REAL_WORK)
    if control:
        bins = [("client, both sides (pinned oracle)", oracle, C.ORACLE_SHA256),
                ("server B (--control: the oracle's own server, no --server_javabase)", oracle,
                 C.ORACLE_SHA256)]
        b_javabase = None
    else:
        staged, sha = C.stage_binary(tool, server)
        os.makedirs(os.path.join(javabase, "bin"))
        os.symlink(staged, os.path.join(javabase, "bin", "java"))
        bins = [("client, both sides (pinned oracle)", oracle, C.ORACLE_SHA256),
                ("server B (%s as <server_javabase>/bin/java, run from %s)" % (server, staged),
                 server, sha)]
        b_javabase = javabase
    for line in C.header(tool, bins, blaze=None if control else server):
        print(line)
    print("%s: A = oracle client and its real server; B = oracle client with %s" % (
        tool, "--server_javabase=<SERVER_JAVABASE> (bin/java -> the server binary)"
        if b_javabase else "its real server again (--control)"))
    sys.stdout.flush()

    def on_signal(signum, _frame):
        raise KeyboardInterrupt("signal %d" % signum)
    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGHUP, on_signal)

    sides = {"A": RealSide("A", oracle, None), "B": RealSide("B", oracle, b_javabase)}
    errors = []
    tdir = os.path.join(REAL_WORK, "transcripts-control" if control else "transcripts")
    os.makedirs(tdir, exist_ok=True)
    try:
        for n in ("A", "B"):
            try:
                real_sequence(sides[n])
            except KeyboardInterrupt:
                raise
            except Exception as e:  # noqa: BLE001 - recorded as an ERROR
                errors.append("side %s: %s: %s" % (n, type(e).__name__, e))
            finally:
                sides[n].cleanup()
                if os.path.lexists(sides[n].ur):
                    C.safe_rmtree(sides[n].ur, REAL_WORK)
            with open(os.path.join(tdir, "%s.txt" % n), "w", encoding="latin-1") as fh:
                for title, text, _, _ in sides[n].steps:
                    fh.write("=== %s\n%s" % (title, text))
            if errors:
                break
    finally:
        for s in sides.values():
            try:
                s.cleanup()
            except Exception as e:  # noqa: BLE001
                print("cleanup of side %s: %s" % (s.name, e))
        for d in (javabase, os.path.join(REAL_WORK, "ws")):
            if os.path.lexists(d):
                C.safe_rmtree(d, REAL_WORK)
        if staged:
            C.unstage_binary(staged)
    report = cc.Report(tool, blaze={"path": oracle if control else server,
                                    "sha256": C.sha256_file(oracle if control else server),
                                    "role": "server B"},
                       oracle={"path": oracle, "sha256": C.sha256_file(oracle)},
                       selection="--server-binary sequence%s" % (" (--control)" if control
                                                                  else ""),
                       tool_files=[os.path.abspath(__file__), os.path.join(HERE, "common.py")],
                       compared="per step: the client's termination (an OOM kill in the unit "
                                "during the step included) and the normalised transcript "
                                "(stdout, every stderr line in order after Norm.RULES)")
    a, b = sides["A"].steps, sides["B"].steps
    for k in range(max(len(a), len(b))):
        ta = a[k] if k < len(a) else None
        tb = b[k] if k < len(b) else None
        title = (ta or tb)[0]
        if ta and tb and ta[0] != tb[0]:
            cls, detail = cc.DIFFERENT, "different steps (%r, %r)" % (ta[0], tb[0])
        else:
            cls, detail = C.judge_step(ta, tb, REAL_DECLARED.get(title))
        report.add(title, cls, detail)
        print("  %-17s %s%s" % (cls, title, " (%s)" % detail if detail else ""))
        if cls != cc.IDENTICAL and ta and tb:
            sys.stdout.writelines("    " + l + "\n" for l in difflib.unified_diff(
                ta[1].splitlines(), tb[1].splitlines(), "A (real server)", "B (server binary)",
                lineterm=""))
    for e in errors:
        report.problem("ERROR %s" % e)
    timed = [n for n in sides if sides[n].timed_out]
    if timed:
        report.problem("a step timed out on side %s" % ",".join(timed))
    report.note("steps: A %d, B %d; transcripts in %s" % (len(a), len(b), tdir))
    report.print_footer()
    return report.exit_code()


def parse(argv):
    opts = {"probe": DEFAULT_PROBE, "bazel": DEFAULT_BAZEL, "scratch": DEFAULT_SCRATCH,
            "server_binary": None}
    rest = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--probe", "--bazel", "--scratch", "--server-binary"):
            if i + 1 >= len(argv):
                sys.exit("%s needs a value" % a)
            opts[a[2:].replace("-", "_")] = os.path.abspath(os.path.expanduser(argv[i + 1]))
            i += 2
        else:
            rest.append(a)
            i += 1
    if os.path.realpath(opts["scratch"]).startswith(ORACLE_ROOT):
        sys.exit("refusing to use the oracle's output_user_root")
    return opts, rest


def selftest():
    """--server-binary mode's real command line against fake binaries: the fake client switches
    on --server_javabase, so side B's behaviour is the fake server's."""
    st = cc.Selftest("interop-server")
    fh = cc.FakeHome("server-interop-server")
    me = os.path.abspath(__file__)
    n = [0]

    def fakes(a, b):
        """The fake client: behaviour `a` without --server_javabase, `b` with it."""
        n[0] += 1
        ca = cc.fake_script(token=fh.token, tripfile=fh.tripfile, role="client A", **a)
        cb = cc.fake_script(token=fh.token, tripfile=fh.tripfile, role="client B", **b)
        body_a = "\n".join(l for l in ca.split("\n")[2:] if not l.startswith('case "$cmd" in info)'))
        body_b = "\n".join(l for l in cb.split("\n")[2:] if not l.startswith('case "$cmd" in info)'))
        with open(fh.oracle, "w") as f:
            f.write("#!/bin/bash\ncase \" $* \" in *--server_javabase=*)\n%s\n;;\nesac\n%s\n"
                    % (body_b, body_a))
        os.chmod(fh.oracle, 0o755)
        server = os.path.join(fh.home, "bin", "server-%d" % n[0])
        with open(server, "w") as f:
            f.write("#!/bin/bash\nexit 0\n# %d\n" % n[0])
        os.chmod(server, 0o755)
        return server

    def run(server, extra=(), pin=None):
        return fh.run_tool(me, ["run", "--server-binary", server] + list(extra), pin=pin)

    def classes(rep):
        return [r["class"] for r in (rep or {}).get("cases", [])]

    def show(rc, rep):
        return "exit %s, %s" % (rc, sorted(set(classes(rep))))
    fail = [("//:fail", 1), ("//:sleep", 8)]
    try:
        srv = fakes(dict(out=b"x"), dict(out=b"x"))
        subprocess.run([fh.oracle, "build"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        st.check("tripwire trips on a direct launch", fh.tripped())
        if fh.tripped():
            os.remove(fh.tripfile)
        same = dict(out=b"x\n", err=b"INFO: x\n", when=fail)
        srv = fakes(same, same)
        rc, rep, log = run(srv)
        st.check("equal, declared failures: exit 0", rc == 0 and set(classes(rep)) ==
                 {cc.IDENTICAL}, show(rc, rep))
        srv = fakes(same, dict(same, err=b"INFO: x\nINFO: extra\n"))
        rc, rep, log = run(srv)
        st.check("an extra stderr line: DIFFERENT", rc == 1 and cc.DIFFERENT in classes(rep),
                 show(rc, rep))
        srv = fakes(dict(out=b"x\n", code=1), dict(out=b"x\n", code=1))
        rc, rep, log = run(srv)
        st.check("equal undeclared failures: BOTH-FAILED, exit 1",
                 rc == 1 and cc.BOTH_FAILED in classes(rep), show(rc, rep))
        old = os.environ.get("COMPARE_COMMON_SELFTEST_MEMORY")
        os.environ["COMPARE_COMMON_SELFTEST_MEMORY"] = "400M"
        try:
            srv = fakes(same, dict(same, alloc_mb=700))
            rc, rep, log = run(srv)
        finally:
            if old is None:
                os.environ.pop("COMPARE_COMMON_SELFTEST_MEMORY", None)
            else:
                os.environ["COMPARE_COMMON_SELFTEST_MEMORY"] = old
        oom = [r for r in (rep or {}).get("cases", []) if "oom-kill" in r["detail"]]
        st.check("an OOM kill during a step: never IDENTICAL",
                 rc == 1 and oom and all(r["class"] == cc.DIFFERENT for r in oom),
                 "%s; %d rows name oom-kill" % (show(rc, rep), len(oom)))
        rc, rep, log = run(fh.oracle)
        st.check("the oracle as the server under test refused (exit 2)", rc == 2, "exit %s" % rc)
        rc, rep, log = run(srv, pin="0" * 64)
        st.check("wrong oracle hash refused (exit 2)", rc == 2, "exit %s" % rc)
        st.check("no process started outside the tool's unit", not fh.tripped(),
                 open(fh.tripfile).read()[:200] if fh.tripped() else "")
    except Exception as e:  # noqa: BLE001 - a crash of the selftest is a failure
        import traceback
        traceback.print_exc()
        st.check("selftest ran to the end", False, "%s: %s" % (type(e).__name__, e))
    finally:
        if st.failures:
            print("  (fake HOME kept for inspection: %s)" % fh.root)
        else:
            fh.remove()
    return st.finish()


def main(argv):
    if not argv or argv[0] in ("help", "--help", "-h"):
        print(__doc__)
        return 0
    if argv[0] == "selftest":
        return selftest()
    action, args = argv[0], argv[1:]
    opts, names = parse(args)
    if action == "list":
        for name, fn in CASES:
            print("%-11s %s" % (name, fn.__doc__))
        return 0
    if action == "run" and opts["server_binary"]:
        return real_main(opts, names)
    if action == "run" and "--control" in names:
        sys.exit("--control needs --server-binary mode (see help)")
    env = Env(opts["probe"], opts["bazel"], opts["scratch"])
    if action == "clean":
        cleanup(env)
        return 0
    if action != "run":
        print(__doc__)
        return 2
    selected = [c for c in CASES if not names or c[0] in names]
    unknown = set(names) - {c[0] for c in CASES}
    if unknown:
        sys.exit("unknown cases: %s" % sorted(unknown))
    if not selected:
        sys.exit("empty selection")
    C.verified_oracle("interop-server", env.bazel)
    if os.path.isdir(env.scratch):
        cleanup(env)
        C.safe_rmtree(env.scratch, os.path.dirname(env.scratch))
    os.makedirs(os.path.join(env.javabase, "bin"))
    os.makedirs(env.workspace)
    open(os.path.join(env.workspace, "MODULE.bazel"), "w").close()
    probe_copy = os.path.join(env.scratch, "probe")
    shutil.copy2(env.probe, probe_copy)
    os.symlink(probe_copy, os.path.join(env.javabase, "bin", "java"))
    for line in C.header("interop-server", [
            ("client (pinned oracle)", env.bazel, C.ORACLE_SHA256),
            ("server (probe %s, copied to %s)" % (env.probe, probe_copy), env.probe,
             C.sha256_file(probe_copy))], blaze=env.probe):
        print(line)
    print("interop-server: probe mode: %d cases selected (%s); checks, not a comparison"
          % (len(selected), ", ".join(n for n, _ in selected)))
    results = []
    try:
        for name, fn in selected:
            print("\n== %s: %s" % (name, fn.__doc__))
            try:
                fn(env)
                results.append((name, "PASS", ""))
            except Failure as e:
                results.append((name, "FAIL", str(e)))
            except Exception as e:  # noqa: BLE001 - report and continue
                results.append((name, "FAIL", "%s: %s" % (type(e).__name__, e)))
            print("== %s: %s" % (name, results[-1][1]))
    finally:
        print()
        cleanup(env)
    print("\nSummary:")
    for name, status, why in results:
        print("  %-11s %s%s" % (name, status, ("  (" + why + ")") if why else ""))
    passed = sum(1 for r in results if r[1] == "PASS")
    print("%d of %d cases passed" % (passed, len(results)))
    return 0 if passed == len(results) else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
