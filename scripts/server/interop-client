# --------------------------------------------------------------------------------------------
# The probe (scripts/w4/probe), imported for its scenario data and aquery summary; not edited.

def load_probe():
    path = os.path.join(ROOT, "scripts/w4/probe")
    loader = importlib.machinery.SourceFileLoader("w4_probe", path)
    spec = importlib.util.spec_from_loader("w4_probe", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


PROBE = load_probe()
PROGRESS = PROBE.PROGRESS
UUID = re.compile(r"\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\b")
DUR = re.compile(r"\b\d+(\.\d+)?m?s\b")
PIDS = [
    (re.compile(r"pid=\d+"), "pid=<PID>"),
    (re.compile(r"server \(\d+\)"), "server (<PID>)"),
    (re.compile(r"JVM process \d+"), "JVM process <PID>"),
]
SANDBOX = re.compile(r"/sandbox/([a-z-]+)/\d+/")
LOG_TIME = re.compile(r"^\[([A-Z]+) \d\d:\d\d:\d\d\.\d{3} ", re.M)
COMMON_COMMANDS = {"build", "query", "cquery", "aquery", "run", "test", "info"}


def die(msg):
    sys.stderr.write("interop-client: %s\n" % msg)
    sys.exit(2)


