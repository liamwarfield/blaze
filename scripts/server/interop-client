# The shared install base copy (--mode jvm).

def blaze_install_key(blaze):
    """Blaze's install key: extract Blaze's own install base once and read it."""
    probe_root = os.path.join(WORK, "keyprobe")
    rmtree(probe_root)
    os.makedirs(probe_root)
    ib = os.path.join(probe_root, "ib")
    env = {"HOME": HOME, "PATH": "/usr/bin:/bin", "BLAZE_SERVER_MODE": "inprocess"}
    p = subprocess.run([blaze, "--output_user_root=" + os.path.join(probe_root, "ur"),
                        "--install_base=" + ib, "--nohome_rc", "--nosystem_rc", "--batch",
                        "version"], cwd=probe_root, env=env, stdout=subprocess.PIPE,
                       stderr=subprocess.PIPE, timeout=600)
    key_file = os.path.join(ib, "install_base_key")
    if not os.path.exists(key_file):
        die("could not extract Blaze's install base (%s):\n%s"
            % (C.Status(p.returncode), p.stderr.decode("latin-1")))
    with open(key_file) as f:
        key = f.read()
    rmtree(probe_root)
    return key


def prepare_install_base(blaze):
    """Copies the oracle's install base to INSTALL once (cp -a keeps the far-future mtimes)."""
    if not os.path.exists(os.path.join(INSTALL, "A-server.jar")):
        rmtree(INSTALL)
        subprocess.run(["cp", "-a", C.ORACLE_INSTALL_BASE, INSTALL], check=True)
    with open(os.path.join(C.ORACLE_INSTALL_BASE, "install_base_key")) as f:
        oracle_key = f.read()
    return {"A": oracle_key, "B": oracle_key if CONTROL else blaze_install_key(blaze)}


def set_install_key(key):
    path = os.path.join(INSTALL, "install_base_key")
    st = os.stat(os.path.join(INSTALL, "daemonize"))
    os.chmod(path, 0o755)
    with open(path, "w") as f:
        f.write(key)
    os.utime(path, (st.st_atime, st.st_mtime))


# --------------------------------------------------------------------------------------------
# One side of a case.

CONTROL = False
MODE = "jvm"
BINARIES = {}  # "A"/"B" -> the client binary that runs


class Side:
    def __init__(self, name):
        self.name = name
        self.binary = BINARIES[name]
        self.ur = os.path.join(WORK, "ur-" + name)
        self.env = {"HOME": HOME, "PATH": "/usr/bin:/bin", "BLAZE_SERVER_MODE": MODE}
        self.steps = []  # (title, text, failed)
        paths = [(INSTALL, "<INSTALL_BASE>")] if MODE == "jvm" else []
        self.norm = C.Norm(self.ur, paths)
        self.timed_out = False

    # Setup and teardown.

    def fresh(self, ws_source=None):
        self.cleanup()
        rmtree(self.ur)
        rmtree(WS)
        if ws_source is None:
            write_template(WS)
        else:
            shutil.copytree(ws_source, WS, symlinks=True)

    def server_pid(self):
        return C.server_pid(self.ur)

    def is_server(self, pid):
        return C.owned_by_root(pid, self.ur)

    def startup_base(self):
        base = [self.binary, "--output_user_root=" + self.ur]
        if MODE == "jvm":
            base.append("--install_base=" + INSTALL)
        return base + ["--nohome_rc", "--nosystem_rc"]

    def cleanup(self):
        """Shuts down the servers of this side's output user root with this side's client (in
        jvm mode the install base must carry this side's key: another client would replace it);
        kills what is left."""
        def shutdown(out_base):
            subprocess.run(self.startup_base() + ["--output_base=" + out_base, "shutdown"],
                           cwd=WORK, env=self.env, stdin=subprocess.DEVNULL,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=90)
        left = C.kill_root_servers(self.ur, shutdown)
        if left:
            raise RuntimeError("servers %s of %s survived SIGKILL" % (left, self.ur))

    # Commands.

    def argv(self, startup, command, args):
        argv = self.startup_base() + list(startup)
        if command is not None:
            argv.append(command)
            if command in COMMON_COMMANDS:
                argv += ["--repository_cache=" + REPO_CACHE, "--color=no", "--curses=no"]
        return argv + list(args)

    def spawn(self, startup=(), command=None, args=(), stdout=subprocess.PIPE):
        return subprocess.Popen(self.argv(startup, command, args), cwd=WS, env=self.env,
                                stdin=subprocess.DEVNULL, stdout=stdout, stderr=subprocess.PIPE)

    def finish(self, title, p, timeout=900):
        timed_out = False
        try:
            out, err = p.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            p.kill()
            out, err = p.communicate()
            timed_out = True
        self.record_run(title, C.Status(p.returncode, timed_out), out or b"", err or b"")
        return out or b"", err or b""

    def run(self, title, startup=(), command=None, args=(), timeout=900):
        return self.finish(title, self.spawn(startup, command, args), timeout)

    def record_run(self, title, status, out, err):
        if status.timed_out:
            self.timed_out = True
        self.steps.append((title, "%s\n--- stdout\n%s--- stderr\n%s"
                           % (status, self.norm.text(out), self.norm.stderr(err)),
                           not status.ok))

    def record_big(self, title, status, out, err):
        """Like record_run for large outputs: size and sha256 of the normalised bytes, then the
        first and last 40 lines (the diff shows where they differ)."""
        def summary(text):
            lines = text.splitlines(True)
            h = hashlib.sha256(text.encode("latin-1")).hexdigest()
            head = "".join(lines[:40])
            tail = "".join(lines[-40:]) if len(lines) > 80 else "".join(lines[40:])
            return "%d lines, %d bytes, sha256 %s\n%s%s" % (
                len(lines), len(text), h, head, ("[...]\n" + tail) if tail else "")
        if status.timed_out:
            self.timed_out = True
        self.steps.append((title, "%s\n--- stdout\n%s--- stderr\n%s"
                           % (status, summary(self.norm.text(out)), summary(self.norm.stderr(err))),
                           not status.ok))

    def fact(self, title, value, failed=False):
        self.steps.append((title, "%s\n" % value, failed))


