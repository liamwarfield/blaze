def compare(name, a, b, report):
    """One row per step (compare_common classes through C.judge_step); prints the diff of each
    step that is not IDENTICAL. Returns the case verdict."""
    titles = [t[0] for t in a.steps]
    if titles != [t[0] for t in b.steps]:
        print("  DIFFERENT step lists")
        for l in difflib.unified_diff(titles, [t[0] for t in b.steps], "oracle", "blaze",
                                      lineterm=""):
            print("  " + l)
        report.add("%s: (step list)" % name, cc.DIFFERENT, "the two sides ran different steps")
        return "DIFFERENT"
    if not a.steps:
        report.add("%s: (no step)" % name, cc.SKIPPED, "the case recorded no step")
        return "EMPTY"
    verdict = "IDENTICAL"
    for sa, sb in zip(a.steps, b.steps):
        title = sa[0]
        dev = None if CONTROL else EXPECTED_DEVIATIONS.get((name, MODE, title))
        cls, detail = C.judge_step(sa, sb, DECLARED.get((name, title)))
        if dev and cls != cc.IDENTICAL:
            if dev[1](sa[1]) and dev[2](sb[1]):
                cls, detail = cc.DECLARED_GAP, "named deviation: %s" % dev[0]
            else:
                detail += "; not the named deviation (%s)" % dev[0]
        report.add("%s: %s" % (name, title), cls, detail, group=name)
        print("  %-17s %s%s" % (cls, title, " (%s)" % detail if detail else ""))
        if cls not in (cc.IDENTICAL,):
            sys.stdout.writelines("    " + l + "\n" for l in difflib.unified_diff(
                sa[1].splitlines(), sb[1].splitlines(), "oracle", "blaze", lineterm=""))
        if cls not in cc.PASSING:
            verdict = "DIFFERENT" if cls == cc.DIFFERENT or verdict == "DIFFERENT" else "NOT-IDENTICAL"
    return verdict


def parse(args):
    global CONTROL, MODE, REFERENCE
    only = None
    names, no_unit = [], False
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--control":
            CONTROL = True
        elif a == "--no-unit":
            no_unit = True
        elif a in ("--mode", "--scenarios", "--reference"):
            if i + 1 >= len(args):
                die("%s needs a value" % a)
            if a == "--mode":
                MODE = args[i + 1]
                if MODE not in ("jvm", "daemon"):
                    die("--mode must be jvm or daemon")
            elif a == "--reference":
                REFERENCE = args[i + 1]
                if REFERENCE not in ("cold", "default"):
                    die("--reference must be cold or default")
            else:
                only = set(x for x in args[i + 1].split(",") if x)
            i += 1
        elif a.startswith("--mode="):
            MODE = a.split("=", 1)[1]
            if MODE not in ("jvm", "daemon"):
                die("--mode must be jvm or daemon")
        elif a.startswith("--reference="):
            REFERENCE = a.split("=", 1)[1]
            if REFERENCE not in ("cold", "default"):
                die("--reference must be cold or default")
        elif a.startswith("-"):
            die("unknown option %r" % a)
        else:
            names.append(a)
        i += 1
    return names, only, no_unit


def selftest():
    """The real command line (`run plain`, `run startup-crash`, --mode daemon) against fake
    binaries under a fake HOME; the fakes trip when started outside the tool's unit."""
    st = cc.Selftest(TOOL)
    fh = cc.FakeHome("server-interop-client")
    me = os.path.abspath(__file__)
    fails = [("//:fail", 1), ("nosuchcommand", 2), ("--bogus_startup_option", 2)]
    n = [0]

    def fakes(ospec, bspec):
        n[0] += 1
        C.fake(fh.oracle, fh, "oracle", **ospec)
        b = C.fake(os.path.join(fh.home, "bin", "blaze-%d" % n[0]), fh, "blaze-%d" % n[0],
                   **bspec)
        return b

    def run(b, cases=("plain",), memory=None):
        old = os.environ.get("BLAZE"), os.environ.get("COMPARE_COMMON_SELFTEST_MEMORY")
        os.environ["BLAZE"] = b
        if memory:
            os.environ["COMPARE_COMMON_SELFTEST_MEMORY"] = memory
        try:
            return fh.run_tool(me, ["run"] + list(cases) + ["--mode", "daemon"])
        finally:
            for k, v in zip(("BLAZE", "COMPARE_COMMON_SELFTEST_MEMORY"), old):
                if v is None:
                    os.environ.pop(k, None)
                else:
                    os.environ[k] = v

    def classes(rep):
        return [r["class"] for r in (rep or {}).get("cases", [])]

    def show(rc, rep):
        return "exit %s, %s" % (rc, sorted(set(classes(rep))))
    try:
        b = fakes(dict(out=b"x"), dict(out=b"x"))
        subprocess.run([b, "build"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        st.check("tripwire trips on a direct launch", fh.tripped())
        if fh.tripped():
            os.remove(fh.tripfile)
        same = dict(out=b"same\n", err=b"INFO: x\n", when=fails)
        b = fakes(same, same)
        rc, rep, log = run(b)
        st.check("equal, declared failures: exit 0", rc == 0 and set(classes(rep)) ==
                 {cc.IDENTICAL}, show(rc, rep))
        b = fakes(same, dict(same, out=b"other\n"))
        rc, rep, log = run(b)
        st.check("stdout differs: DIFFERENT, exit 1", rc == 1 and cc.DIFFERENT in classes(rep),
                 show(rc, rep))
        b = fakes(same, dict(same, err=b"INFO: x\nINFO: extra\n"))
        rc, rep, log = run(b)
        st.check("an extra stderr line: DIFFERENT, exit 1",
                 rc == 1 and cc.DIFFERENT in classes(rep), show(rc, rep))
        b = fakes(dict(same, err=b"INFO: x\nINFO: y\n"), dict(same, err=b"INFO: y\nINFO: x\n"))
        rc, rep, log = run(b)
        st.check("stderr in another order: DIFFERENT (no multiset)",
                 rc == 1 and cc.DIFFERENT in classes(rep), show(rc, rep))
        b = fakes(dict(out=b"x\n", code=1), dict(out=b"x\n", code=1))
        rc, rep, log = run(b)
        st.check("equal undeclared failures: BOTH-FAILED, exit 1",
                 rc == 1 and cc.BOTH_FAILED in classes(rep), show(rc, rep))
        b = fakes(same, dict(same, sig="PIPE"))
        rc, rep, log = run(b)
        st.check("Blaze killed by SIGPIPE: DIFFERENT", rc == 1 and cc.DIFFERENT in classes(rep),
                 show(rc, rep))
        b = fakes(same, dict(same, alloc_mb=700))
        rc, rep, log = run(b, memory="400M")
        oom = [r for r in (rep or {}).get("cases", []) if "oom-kill" in r["detail"]]
        st.check("an OOM kill in the unit during a step: never IDENTICAL",
                 rc == 1 and oom and all(r["class"] == cc.DIFFERENT for r in oom),
                 "%s; %d rows name oom-kill" % (show(rc, rep), len(oom)))
        b = fakes(dict(err=b"Server crashed during startup.\nUnrecognized option: -Xbogus\n",
                       code=37),
                  dict(out=b"release 9.3.2\n", err=b"Extracting Bazel installation...\nStarting "
                       b"local Bazel server (9.3.2) and connecting to it...\n"))
        rc, rep, log = run(b, cases=("startup-crash",))
        # Exit 1 all the same: a run whose only row is a declared gap compared nothing.
        st.check("the named deviation with its texts: DECLARED-GAP",
                 rc == 1 and classes(rep) == [cc.DECLARED_GAP], show(rc, rep))
        b = fakes(dict(err=b"Server crashed during startup.\nUnrecognized option: -Xbogus\n",
                       code=37), dict(out=b"release 9.3.2\n", err=b"something else\n"))
        rc, rep, log = run(b, cases=("startup-crash",))
        st.check("another difference of the same step stays DIFFERENT",
                 rc == 1 and classes(rep) == [cc.DIFFERENT], show(rc, rep))
        b = fakes(same, same)
        rc, rep, log = run(fh.oracle)
        st.check("the oracle as the binary under test refused (exit 2)", rc == 2, "exit %s" % rc)
        rc, rep, log = fh.run_tool(me, ["run", "plain", "--mode", "daemon"], pin="0" * 64)
        st.check("wrong oracle hash refused (exit 2)", rc == 2, "exit %s" % rc)
        st.check("no process started outside the tool's unit", not fh.tripped(),
                 open(fh.tripfile).read()[:200] if fh.tripped() else "")
    except Exception as e:  # noqa: BLE001 - a crash of the selftest is a failure
        import traceback
        traceback.print_exc()
        st.check("selftest ran to the end", False, "%s: %s" % (type(e).__name__, e))
    finally:
        if st.failures:
            print("  (fake HOME kept for inspection: %s)" % fh.root)
        else:
            fh.remove()
    return st.finish()


def main(argv):
    if len(argv) >= 2 and argv[1] == "selftest":
        return selftest()
    if len(argv) < 2 or argv[1] in ("help", "--help", "-h"):
        sys.stdout.write(USAGE)
        for name, f in CASES:
            print("  %-16s %s" % (name, " ".join(f.__doc__.split())))
        return 0
    if argv[1] == "list":
        for name, f in CASES:
            print("%-16s %s" % (name, " ".join(f.__doc__.split())))
        return 0
    if argv[1] != "run":
        die("unknown command %r; see `interop-client help`" % argv[1])
    names, only, no_unit = parse(argv[2:])
    unknown = set(names) - {c[0] for c in CASES}
    if unknown:
        die("unknown case(s): %s" % ", ".join(sorted(unknown)))
    selected = [c for c in CASES if not names or c[0] in names]
    if only is not None:
        if not any(c[0] == "scenarios" for c in selected):
            die("--scenarios given but the scenarios case is not selected")
        if not only or not scenario_names(only):
            die("--scenarios %s matches no scenario" % ",".join(sorted(only)))
        missing = only - set(scenario_names(only))
        if missing:
            die("unknown scenario(s): %s" % ", ".join(sorted(missing)))
    if not selected:
        die("empty selection")
    oracle = C.verified_oracle(TOOL)
    blaze_src = C.blaze_binary()
    if not CONTROL and not os.path.exists(blaze_src):
        die("no Blaze binary at %s (set BLAZE)" % blaze_src)
    if not CONTROL:
        C.refuse_oracle_as_blaze(TOOL, blaze_src)

    if not no_unit:
        rc = C.in_unit(TOOL, [os.path.abspath(__file__)] + argv[1:] + ["--no-unit"],
                       os.path.join(WORK, "unit"))
        if rc is not None:
            return rc

    global OOM
    OOM = C.OomWatch()
    os.makedirs(WORK, exist_ok=True)
    lock = open(os.path.join(WORK, "run.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        die("another interop-client run holds %s" % os.path.join(WORK, "run.lock"))
    staged = None
    report = cc.Report(TOOL, blaze={"path": oracle if CONTROL else blaze_src,
                                    "sha256": C.sha256_file(oracle if CONTROL else blaze_src),
                                    "role": "B"},
                       oracle={"path": oracle, "sha256": C.sha256_file(oracle)},
                       selection=" ".join(argv[1:]),
                       tool_files=[os.path.abspath(__file__), os.path.join(HERE, "common.py")],
                       compared="per step: the client's termination (an OOM kill in the unit "
                                "during the step included) and the normalised transcript "
                                "(stdout, every stderr line in order after Norm.RULES)")
    if CONTROL:
        BINARIES.update(A=oracle, B=oracle)
        print("\n".join(C.header(TOOL, [("A (oracle, pinned)", oracle, C.ORACLE_SHA256),
                                       ("B (--control: the oracle again)", oracle,
                                        C.ORACLE_SHA256)])))
    else:
        staged, bsha = C.stage_binary(TOOL, blaze_src)
        BINARIES.update(A=oracle, B=staged)
        print("\n".join(C.header(TOOL, [("A (oracle, pinned)", oracle, C.ORACLE_SHA256),
                                       ("B (blaze %s, run from %s)" % (blaze_src, staged),
                                        blaze_src, bsha)], blaze=blaze_src)))
    print("%s: mode %s, reference %s%s; cases selected: %s%s" % (
        TOOL, MODE, REFERENCE,
        " (--control: B runs the oracle client and server)" if CONTROL else "",
        ", ".join(n for n, _ in selected),
        ("; scenarios: " + ", ".join(scenario_names(only))) if only else ""))
    sys.stdout.flush()

    def on_signal(signum, _frame):
        raise KeyboardInterrupt("signal %d" % signum)
    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGHUP, on_signal)

    keys = prepare_install_base(staged) if MODE == "jvm" else None
    results = []
    sides = {}
    tdir = os.path.join(WORK, "transcripts-%s%s%s" % (
        MODE, "-cold" if REFERENCE == "cold" else "", "-control" if CONTROL else ""))
    os.makedirs(tdir, exist_ok=True)
    try:
        for name, f in selected:
            run, error = {}, None
            for n in SIDES:
                side = Side(n)
                sides[n] = side
                run[n] = side
                if keys:
                    set_install_key(keys[n])
                try:
                    if name == "scenarios":
                        f(side, only)
                    else:
                        f(side)
                except KeyboardInterrupt:
                    raise
                except Exception as e:  # noqa: BLE001 - the case is an ERROR, the run goes on
                    error = "side %s: %s: %s" % (n, type(e).__name__, e)
                finally:
                    side.cleanup()
                    rmtree(side.ur)
                if error:
                    break
            for n in run:
                with open(os.path.join(tdir, "%s-%s.txt" % (name, n)), "w", encoding="latin-1") as fh:
                    for title, text, _, _ in run[n].steps:
                        fh.write("=== %s\n%s" % (title, text))
            print("case %s:" % name)
            if error:
                print("  ERROR %s (transcripts kept in %s)" % (error, tdir))
                report.add("%s: (case)" % name, cc.SKIPPED, "tool error: %s" % error, group=name)
                report.problem("case %s: tool error: %s" % (name, error))
                results.append((name, "ERROR"))
            else:
                verdict = compare(name, run["A"], run["B"], report)
                timed = [n for n in SIDES if run[n].timed_out]
                if timed:
                    verdict += " (a step timed out on side %s)" % ",".join(timed)
                results.append((name, verdict))
                print("case %s: %s" % (name, verdict))
            sys.stdout.flush()
    finally:
        for n, side in sides.items():
            if keys:
                set_install_key(keys[n])
            try:
                side.cleanup()
            except Exception as e:  # noqa: BLE001
                print("cleanup of side %s: %s" % (n, e))
        if keys:
            set_install_key(keys["A"])
        if os.path.lexists(WS):
            rmtree(WS)
        if staged:
            C.unstage_binary(staged)
    report.note("cases: %d selected, %d run; every step IDENTICAL or declared: %s; with a step "
                "DIFFERENT: %s; with another non-passing step: %s; errors: %s"
                % (len(selected), len(results),
                   ", ".join(n for n, v in results if v == "IDENTICAL") or "none",
                   ", ".join(n for n, v in results if v.startswith("DIFFERENT")) or "none",
                   ", ".join(n for n, v in results if v.startswith("NOT-IDENTICAL")
                             or v.startswith("EMPTY")) or "none",
                   ", ".join(n for n, v in results if v == "ERROR") or "none"))
    if len(results) != len(selected):
        report.problem("%d of %d selected cases did not run" % (len(selected) - len(results),
                                                                len(selected)))
    timed = [n for n, v in results if "timed out" in v]
    if timed:
        report.problem("a step timed out in: %s" % ", ".join(timed))
    report.print_footer()
    return report.exit_code()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
