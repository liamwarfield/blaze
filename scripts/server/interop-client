    out, err = p.communicate(timeout=600)
    s.record_big("aquery --output=jsonproto //...", C.Status(p.returncode), out, err)


def info_map(text):
    out = {}
    for line in text.decode("latin-1").splitlines():
        if ": " in line:
            k, v = line.split(": ", 1)
            out[k] = v
    return out


def case_command_log(s):
    """command.log (Bazel 9 writes it only with --write_command_log): absent after a default
    build; the bytes of the file `info command_log` names (normalised) after a build and after a
    failing build with --write_command_log; deleted again by the next default command; `info
    server_pid` against the pid file; `info server_log` existence."""
    s.fresh()
    out, _ = s.run("info command_log server_log server_pid", command="info",
                   args=["command_log", "server_log", "server_pid"])
    info = info_map(out)
    pid = s.server_pid()
    s.fact("info server_pid is the pid file's server",
           info.get("server_pid") is not None and info.get("server_pid") == str(pid))
    log = info.get("server_log")
    s.fact("info server_log exists", bool(log) and os.path.exists(log))
    command_log = info.get("command_log")

    def read_log(title):
        try:
            with open(command_log, "rb") as f:
                s.fact(title, "present\n" + s.norm.stderr(f.read()))
        except FileNotFoundError:
            s.fact(title, "absent")
        except (OSError, TypeError) as e:
            s.fact(title, "cannot read: %s" % type(e).__name__, failed=True)
    s.run("build //:ok", command="build", args=["//:ok"])
    read_log("command.log after build //:ok")
    s.run("build --write_command_log //:ok", command="build", args=["--write_command_log", "//:ok"])
    read_log("command.log after build --write_command_log //:ok")
    s.run("build --write_command_log //:fail", command="build",
          args=["--write_command_log", "//:fail"])
    read_log("command.log after build --write_command_log //:fail")
    s.run("info command_log server_log server_pid (again)", command="info",
          args=["command_log", "server_log", "server_pid"])
    read_log("command.log after info")


def case_scenarios(s, only=None):
    """The command sequences of scripts/w4/scenarios/* (COMMANDS: run, aquery, cat, stat), one
    server per scenario, then shutdown."""
    names = scenario_names(only)
    for name in names:
        sdir = os.path.join(PROBE.SCENARIOS, name)
        s.fresh(os.path.join(sdir, "ws"))
        n = 0
        with open(os.path.join(sdir, "COMMANDS")) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                n += 1
                title = "%s %d: %s" % (name, n, line)
                parts = shlex.split(line)
                kind, args = parts[0], parts[1:]
                if kind in ("run", "aquery"):
                    if kind == "run":
                        p = s.spawn(command=args[0], args=args[1:])
                    else:
                        p = s.spawn(command="aquery", args=[
                            "--output=jsonproto", "--include_param_files",
                            "--include_file_write_contents"] + args)
                    timed_out = False
                    try:
                        out, err = p.communicate(timeout=1800)
                    except subprocess.TimeoutExpired:
                        p.kill()
                        out, err = p.communicate()
                        timed_out = True
                    out = PROBE.Run.raw_aquery(out.decode("latin-1")).encode("latin-1")
                    s.record_run(title, C.Status(p.returncode, timed_out), out, err)
                elif kind == "cat":
                    try:
                        with open(os.path.join(WS, args[0]), "rb") as fh:
                            s.fact(title, s.norm.text(fh.read()))
                    except OSError as e:
                        s.fact(title, "cannot read: %s" % type(e).__name__)
                elif kind == "stat":
                    path = os.path.join(WS, args[0])
                    try:
                        st = os.stat(path)
                        s.fact(title, "%s %o" % ("dir" if os.path.isdir(path) else "file",
                                                 st.st_mode & 0o7777))
                    except OSError as e:
                        s.fact(title, "cannot stat: %s" % type(e).__name__)
                else:
                    raise RuntimeError("unknown step kind %r in %s" % (kind, name))
        s.run("%s: shutdown" % name, command="shutdown")


def scenario_names(only):
    global PROBE
    if PROBE is None:
        PROBE = load_probe()
    names = sorted(n for n in os.listdir(PROBE.SCENARIOS)
                   if os.path.isfile(os.path.join(PROBE.SCENARIOS, n, "COMMANDS")))
    if only:
        names = [n for n in names if n in only]
    return names


def case_shutdown(s):
    """shutdown without a server, with one, and a command after it starts a new server."""
    s.fresh()
    s.run("shutdown (no server)", command="shutdown")
    s.run("info release (starts a server)", command="info", args=["release"])
    pid = s.server_pid()
    s.run("shutdown", command="shutdown")
    s.fact("server gone after shutdown", pid is not None and C.wait_gone(pid, 5))
    s.run("shutdown (server gone)", command="shutdown")
    s.run("info release (starts a new server)", command="info", args=["release"])
    s.fact("new server", s.server_pid() not in (None, pid))


def case_startup_options(s):
    """A changed startup option restarts the server (warning text, Only in old/new server
    lines); a changed volatile option (--max_idle_secs) does not."""
    s.fresh()
    s.run("info release", command="info", args=["release"])
    s.run("--host_jvm_args=-Dfoo=1 info release", startup=["--host_jvm_args=-Dfoo=1"],
          command="info", args=["release"])
    s.run("--host_jvm_args=-Dfoo=1 --host_jvm_args=-Dbar=2 --io_nice_level=3 info release",
          startup=["--host_jvm_args=-Dfoo=1", "--host_jvm_args=-Dbar=2", "--io_nice_level=3"],
          command="info", args=["release"])
    s.run("info release (back to the defaults)", command="info", args=["release"])
    pid = s.server_pid()
    s.run("--max_idle_secs=1000 info release", startup=["--max_idle_secs=1000"],
          command="info", args=["release"])
    s.fact("server kept for a volatile option", pid is not None and s.server_pid() == pid
           and s.is_server(pid))


def kill_server(s, pid):
    for kill in (lambda: os.killpg(pid, signal.SIGKILL), lambda: os.kill(pid, signal.SIGKILL)):
        try:
            if s.is_server(pid):
                kill()
        except OSError:
            pass
    C.wait_gone(pid, 10)


def case_sigkill(s):
    """Server killed with SIGKILL between two commands, and while a command runs."""
    s.fresh()
    s.run("info release", command="info", args=["release"])
    pid = s.server_pid()
    kill_server(s, pid)
    s.fact("server killed", not C.alive(pid))
    s.run("info release (after SIGKILL)", command="info", args=["release"])
    pid = s.server_pid()
    p = s.spawn(command="build", args=["//:sleep"])
    time.sleep(10)
    kill_server(s, pid)
    s.finish("build //:sleep, server killed after 10s", p)
    s.run("info release (after the abrupt end)", command="info", args=["release"])


def case_sigint(s):
    """SIGINT to the client during a build: cancel, exit 8, server stays up; three SIGINTs kill
    the server."""
    s.fresh()
    s.run("info release", command="info", args=["release"])
    pid = s.server_pid()
    p = s.spawn(command="build", args=["//:sleep"])
    time.sleep(10)
    p.send_signal(signal.SIGINT)
    s.finish("build //:sleep, one SIGINT after 10s", p)
    s.fact("server still up", s.is_server(pid) and s.server_pid() == pid)
    s.run("info release (same server)", command="info", args=["release"])
    p = s.spawn(command="build", args=["//:sleep"])
    time.sleep(10)
    # 5 ms apart: the third arrives before the server can have answered the first cancel.
    for _ in range(3):
        p.send_signal(signal.SIGINT)
        time.sleep(0.005)
    s.finish("build //:sleep, three SIGINTs 5ms apart after 10s", p)
    s.fact("server killed by the third SIGINT", C.wait_gone(pid, 15))
    s.run("info release (new server)", command="info", args=["release"])


def case_two_clients(s):
    """Two clients on one output base: --noblock_for_lock exits 9; the default waits."""
    s.fresh()
    s.run("info release", command="info", args=["release"])
    p = s.spawn(command="build", args=["//:sleep20"])
    time.sleep(6)
    s.run("--noblock_for_lock info release (while a build runs)", startup=["--noblock_for_lock"],
          command="info", args=["release"])
    s.run("info release (waits for the build)", command="info", args=["release"])
    s.finish("build //:sleep20 (first client)", p)


def case_run(s):
    """`run` of an executable target with arguments; the program exits 3 (the client execs the
    ExecRequest): stdout, stderr and the exit code; `run` of a target whose build fails (1)."""
    s.fresh()
    s.run("run //:hello_bin -- a b", command="run", args=["//:hello_bin", "--", "a", "b"])
    s.run("run //:hello_bin -- 'with space' \"q\"", command="run",
          args=["//:hello_bin", "--", "with space", "\"q\""])
    s.run("run //:fail (build fails)", command="run", args=["//:fail"])


def case_broken_pipe(s):
    """stdout closed after the first line (`... | head -1`)."""
    s.fresh()
    s.run("info release", command="info", args=["release"])
    for title, args in (("help | head -1", []), ("help completion | head -1", ["completion"])):
        p = s.spawn(command="help", args=args)
        first = p.stdout.readline()
        p.stdout.close()
        timed_out = False
        try:
            err = p.stderr.read()
            p.wait(timeout=300)
        except subprocess.TimeoutExpired:
            p.kill()
            p.wait()
            err = b""
            timed_out = True
        s.record_run(title, C.Status(p.returncode, timed_out), first, err)


def case_startup_crash(s):
    """A server that dies during startup (bad JVM flag): Server crashed during startup, 37."""
    s.fresh()
    s.run("--host_jvm_args=-Xbogus info release", startup=["--host_jvm_args=-Xbogus"],
          command="info", args=["release"])


def case_cwd_deleted(s):
    """The workspace (the server's cwd) deleted and re-created between two commands."""
    s.fresh()
    s.run("info release", command="info", args=["release"])
    pid = s.server_pid()
    rmtree(WS)
    write_template(WS)
    s.run("info release (workspace re-created)", command="info", args=["release"])
    s.fact("server restarted", s.server_pid() not in (None, pid) and C.wait_gone(pid, 5))


def case_idle(s):
    """--max_idle_secs=5: the server exits when idle; the next command starts a new one."""
    s.fresh()
    s.run("--max_idle_secs=5 info release", startup=["--max_idle_secs=5"], command="info",
          args=["release"])
    pid = s.server_pid()
    s.fact("server gone after 20s idle", pid is not None and C.wait_gone(pid, 20))
    s.run("--max_idle_secs=5 info release (new server)", startup=["--max_idle_secs=5"],
          command="info", args=["release"])


CASES = [
    ("plain", case_plain),
