def compare(name, a, b):
    """Prints MATCH/DIFF per step; returns (steps, identical steps)."""
    titles = [t for t, _ in a.steps]
    if titles != [t for t, _ in b.steps]:
        print("%s: DIFF (different step lists)" % name)
        for l in difflib.unified_diff(titles, [t for t, _ in b.steps], "oracle", "blaze", lineterm=""):
            print(l)
        return len(a.steps), 0
    same = 0
    for (title, ta), (_, tb) in zip(a.steps, b.steps):
        if ta == tb:
            same += 1
            print("  MATCH  %s" % title)
        else:
            print("  DIFF   %s" % title)
            sys.stdout.writelines(l + "\n" for l in difflib.unified_diff(
                ta.splitlines(), tb.splitlines(), "oracle", "blaze", lineterm=""))
    return len(a.steps), same


def main(argv):
    if len(argv) < 2 or argv[1] in ("help", "--help", "-h"):
        sys.stdout.write(USAGE)
        for name, f in CASES:
            print("  %-16s %s" % (name, " ".join(f.__doc__.split())))
        return 0
    if argv[1] == "list":
        for name, f in CASES:
            print("%-16s %s" % (name, " ".join(f.__doc__.split())))
        return 0
    if argv[1] != "run":
        die("unknown command %r; see `interop-client help`" % argv[1])
    args = argv[2:]
    global CONTROL
    if "--control" in args:
        CONTROL = True
        args.remove("--control")
    only = None
    if "--scenarios" in args:
        i = args.index("--scenarios")
        only = set(args[i + 1].split(","))
        del args[i:i + 2]
    selected = [c for c in CASES if not args or c[0] in args]
    unknown = set(args) - {c[0] for c in CASES}
    if unknown:
        die("unknown case(s): %s" % ", ".join(sorted(unknown)))
    if not os.path.exists(blaze_binary()):
        die("no Blaze binary at %s (set BLAZE)" % blaze_binary())

    os.makedirs(WORK, exist_ok=True)
    sides = {n: Side(n) for n in SIDES}

    def on_signal(signum, _frame):
        raise KeyboardInterrupt("signal %d" % signum)
    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGHUP, on_signal)

    keys = prepare_install_base()
    if CONTROL:
        keys["B"] = keys["A"]
    print("interop-client: oracle %s; blaze %s%s"
          % (ORACLE, blaze_binary(), " (--control: B runs the oracle too)" if CONTROL else ""))
    results = []
    try:
        for name, f in selected:
            run = {}
            for n in SIDES:
                side = Side(n)
                sides[n] = side
                set_install_key(keys[n])
                try:
                    if name == "scenarios":
                        f(side, only)
                    else:
                        f(side)
                finally:
                    side.cleanup()
                run[n] = side
            tdir = os.path.join(WORK, "transcripts-control" if CONTROL else "transcripts")
            os.makedirs(tdir, exist_ok=True)
            for n in SIDES:
                with open(os.path.join(tdir, "%s-%s.txt" % (name, n)), "w", encoding="latin-1") as fh:
                    for title, text in run[n].steps:
                        fh.write("=== %s\n%s" % (title, text))
            print("case %s:" % name)
            steps, same = compare(name, run["A"], run["B"])
            results.append((name, steps, same))
            print("case %s: %s (%d of %d steps identical)"
                  % (name, "IDENTICAL" if steps == same else "DIFFERENT", same, steps))
            sys.stdout.flush()
    finally:
        for n, side in sides.items():
            set_install_key(keys[n])
            side.cleanup()
        set_install_key(keys["A"])
    print("interop-client: %d cases; identical: %s; different: %s"
          % (len(results), ", ".join(n for n, t, s in results if t == s) or "none",
             ", ".join(n for n, t, s in results if t != s) or "none"))
    return 0 if all(t == s for _, t, s in results) else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
