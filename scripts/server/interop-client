def case_large_output(s):
    """Large outputs streamed by the server: `help everything-as-html` (stdout), a genrule that
    writes 3000 lines to stdout and to stderr (action output on the client's stderr),
    `aquery --output=jsonproto //...` (stdout)."""
    s.fresh()
