def case_plain(s):
    """Plain commands on one server: version, info, help, build, query, a failing build (1), a
    bad command (2), a bad startup option (2); only the first starts a server."""
    s.fresh()
    s.run("version", command="version")
    pid = s.server_pid()
    s.run("info release workspace", command="info", args=["release", "workspace"])
    s.run("help", command="help")
    s.run("build //:ok", command="build", args=["//:ok"])
    s.run("query //...", command="query", args=["//..."])
    s.run("build //:fail", command="build", args=["//:fail"])
    s.run("nosuchcommand", command="nosuchcommand")
    s.run("--bogus_startup_option info", startup=["--bogus_startup_option"], command="info")
    s.fact("one server for all commands", pid is not None and s.server_pid() == pid
           and s.is_server(pid))


