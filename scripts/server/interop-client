DECLARED = {
    ("plain", "build //:fail"): "exit 1",
    ("plain", "nosuchcommand"): "exit 2",
    ("plain", "--bogus_startup_option info"): "exit 2",
    ("exit-codes", "build //:fail (1)"): "exit 1",
