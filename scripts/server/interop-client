    ("exit-codes", "test //:ok (4: no test targets)"): "exit 4",
    ("exit-codes", "query //nosuchpkg:x (7)"): "exit 7",
    ("exit-codes", "run //:hello_bin -- x (3 from the program)"): "exit 3",
    ("command-log", "build --write_command_log //:fail"): "exit 1",
    ("sigkill", "build //:sleep, server killed after 10s"): "exit 37",
    ("sigint", "build //:sleep, one SIGINT after 10s"): "exit 8",
    ("sigint", "build //:sleep, three SIGINTs 5ms apart after 10s"): "exit 1",
    ("two-clients", "--noblock_for_lock info release (while a build runs)"): "exit 9",
    ("run", "run //:hello_bin -- a b"): "exit 3",
    ("run", "run //:hello_bin -- 'with space' \"q\""): "exit 3",
    ("run", "run //:fail (build fails)"): "exit 2",
