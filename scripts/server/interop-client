def compare(a, b, counts):
    """Prints the class of each step; returns True when no step is DIFFERENT."""
    titles = [t for t, _, _ in a.steps]
    if titles != [t for t, _, _ in b.steps]:
        print("  DIFFERENT step lists")
        for l in difflib.unified_diff(titles, [t for t, _, _ in b.steps], "oracle", "blaze",
                                      lineterm=""):
            print("  " + l)
        counts[C.DIFFERENT] += max(len(a.steps), len(b.steps))
        return False
    ok = True
    for (title, ta, fa), (_, tb, fb) in zip(a.steps, b.steps):
        cls = C.classify(ta, tb, fa, fb)
        counts[cls] += 1
        print("  %-12s %s" % (cls, title))
        if cls == C.DIFFERENT:
            ok = False
            sys.stdout.writelines("    " + l + "\n" for l in difflib.unified_diff(
                ta.splitlines(), tb.splitlines(), "oracle", "blaze", lineterm=""))
    return ok


def parse(args):
    global CONTROL, MODE
    only = None
    names, no_unit = [], False
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--control":
            CONTROL = True
        elif a == "--no-unit":
            no_unit = True
        elif a in ("--mode", "--scenarios"):
            if i + 1 >= len(args):
                die("%s needs a value" % a)
            if a == "--mode":
                MODE = args[i + 1]
                if MODE not in ("jvm", "daemon"):
                    die("--mode must be jvm or daemon")
            else:
                only = set(x for x in args[i + 1].split(",") if x)
            i += 1
        elif a.startswith("--mode="):
            MODE = a.split("=", 1)[1]
            if MODE not in ("jvm", "daemon"):
                die("--mode must be jvm or daemon")
        elif a.startswith("-"):
            die("unknown option %r" % a)
        else:
            names.append(a)
        i += 1
    return names, only, no_unit


def main(argv):
    if len(argv) < 2 or argv[1] in ("help", "--help", "-h"):
        sys.stdout.write(USAGE)
        for name, f in CASES:
            print("  %-16s %s" % (name, " ".join(f.__doc__.split())))
        return 0
    if argv[1] == "list":
        for name, f in CASES:
            print("%-16s %s" % (name, " ".join(f.__doc__.split())))
        return 0
    if argv[1] != "run":
        die("unknown command %r; see `interop-client help`" % argv[1])
    names, only, no_unit = parse(argv[2:])
    unknown = set(names) - {c[0] for c in CASES}
    if unknown:
        die("unknown case(s): %s" % ", ".join(sorted(unknown)))
    selected = [c for c in CASES if not names or c[0] in names]
    if only is not None:
        if not any(c[0] == "scenarios" for c in selected):
            die("--scenarios given but the scenarios case is not selected")
        if not only or not scenario_names(only):
            die("--scenarios %s matches no scenario" % ",".join(sorted(only)))
        missing = only - set(scenario_names(only))
        if missing:
            die("unknown scenario(s): %s" % ", ".join(sorted(missing)))
    if not selected:
        die("empty selection")
    oracle = C.verified_oracle(TOOL)
    blaze_src = C.blaze_binary()
    if not CONTROL and not os.path.exists(blaze_src):
        die("no Blaze binary at %s (set BLAZE)" % blaze_src)

    if not no_unit:
        rc = C.in_unit(TOOL, [os.path.abspath(__file__)] + argv[1:] + ["--no-unit"],
                       os.path.join(WORK, "unit"))
        if rc is not None:
            return rc

    os.makedirs(WORK, exist_ok=True)
    lock = open(os.path.join(WORK, "run.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        die("another interop-client run holds %s" % os.path.join(WORK, "run.lock"))
    staged = None
    if CONTROL:
        BINARIES.update(A=oracle, B=oracle)
        print("\n".join(C.header(TOOL, [("A (oracle, pinned)", oracle, C.ORACLE_SHA256),
                                       ("B (--control: the oracle again)", oracle,
                                        C.ORACLE_SHA256)])))
    else:
        staged, bsha = C.stage_binary(TOOL, blaze_src)
        BINARIES.update(A=oracle, B=staged)
        print("\n".join(C.header(TOOL, [("A (oracle, pinned)", oracle, C.ORACLE_SHA256),
                                       ("B (blaze %s, run from %s)" % (blaze_src, staged),
                                        blaze_src, bsha)], blaze=blaze_src)))
    print("%s: mode %s%s; cases selected: %s%s" % (
        TOOL, MODE, " (--control: B runs the oracle client and server)" if CONTROL else "",
        ", ".join(n for n, _ in selected),
        ("; scenarios: " + ", ".join(scenario_names(only))) if only else ""))
    sys.stdout.flush()

    def on_signal(signum, _frame):
        raise KeyboardInterrupt("signal %d" % signum)
    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGHUP, on_signal)

    keys = prepare_install_base(staged) if MODE == "jvm" else None
    results = []
    counts = {C.IDENTICAL: 0, C.SAME_FAILURE: 0, C.DIFFERENT: 0, C.NOT_RUN: 0}
    sides = {}
    tdir = os.path.join(WORK, "transcripts-%s%s" % (MODE, "-control" if CONTROL else ""))
    os.makedirs(tdir, exist_ok=True)
    try:
        for name, f in selected:
            run, error = {}, None
            for n in SIDES:
                side = Side(n)
                sides[n] = side
                run[n] = side
                if keys:
                    set_install_key(keys[n])
                try:
                    if name == "scenarios":
                        f(side, only)
                    else:
                        f(side)
                except KeyboardInterrupt:
                    raise
                except Exception as e:  # noqa: BLE001 - the case is an ERROR, the run goes on
                    error = "side %s: %s: %s" % (n, type(e).__name__, e)
                finally:
                    side.cleanup()
                    rmtree(side.ur)
                if error:
                    break
            for n in run:
                with open(os.path.join(tdir, "%s-%s.txt" % (name, n)), "w", encoding="latin-1") as fh:
                    for title, text, _ in run[n].steps:
                        fh.write("=== %s\n%s" % (title, text))
            print("case %s:" % name)
            if error:
                print("  ERROR %s (transcripts kept in %s)" % (error, tdir))
                results.append((name, "ERROR"))
            else:
                ok = compare(run["A"], run["B"], counts)
                timed = [n for n in SIDES if run[n].timed_out]
                verdict = "IDENTICAL" if ok else "DIFFERENT"
                if timed:
                    verdict += " (a step timed out on side %s)" % ",".join(timed)
                results.append((name, verdict))
                print("case %s: %s" % (name, verdict))
            sys.stdout.flush()
    finally:
        for n, side in sides.items():
            if keys:
                set_install_key(keys[n])
            try:
                side.cleanup()
            except Exception as e:  # noqa: BLE001
                print("cleanup of side %s: %s" % (n, e))
        if keys:
            set_install_key(keys["A"])
        if os.path.lexists(WS):
            rmtree(WS)
        if staged:
            C.unstage_binary(staged)
    print("%s: denominator: %d cases selected, %d run; identical: %s; different: %s; errors: %s"
          % (TOOL, len(selected), len(results),
             ", ".join(n for n, v in results if v == "IDENTICAL") or "none",
             ", ".join(n for n, v in results if v.startswith("DIFFERENT")) or "none",
             ", ".join(n for n, v in results if v == "ERROR") or "none"))
    print("%s: steps: %d identical, %d same-failure (identical non-zero exits; not matches), "
          "%d different, %d not run" % (TOOL, counts[C.IDENTICAL], counts[C.SAME_FAILURE],
                                        counts[C.DIFFERENT], counts[C.NOT_RUN]))
    bad = [n for n, v in results if v != "IDENTICAL"]
    return 0 if not bad and len(results) == len(selected) else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
