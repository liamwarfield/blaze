def die(msg):
    C.die(TOOL, msg)


def load_record():
    """scripts/oracle/record, imported (not edited) for prepare_workspace and walk_outputs."""
    path = os.path.join(C.REPO, "scripts/oracle/record")
    loader = importlib.machinery.SourceFileLoader("oracle_record", path)
    spec = importlib.util.spec_from_loader("oracle_record", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def projects():
    with open(os.path.join(C.REPO, "corpus/projects.json")) as f:
        return json.load(f)["projects"]


def resolve(project, steps):
    """The sequence with the project's command lines filled in."""
    spec = projects()[project]
    command = spec["commands"][0]
    expr = " + ".join(command[1:])
    out = []
    for name, actions, argv in SEQUENCE:
        if name not in steps:
            continue
        nokeep = argv[:1] == ["NOKEEP"]
        if nokeep:
            argv = argv[1:]
        if argv == ["CMD"]:
            argv = list(command)
        argv = [expr if a == "EXPR" else a for a in argv]
        acts = []
        for act in actions:
            act = list(act)
            act[1] = EDIT_FILES[project][act[1]]
            acts.append(act)
        out.append({"name": name, "actions": acts, "argv": argv, "nokeep": nokeep})
    return out


def command_line(step, reference, out_dir):
    """Command and options of a step after the startup options."""
    verb = step["argv"][0]
    argv = [verb, "--repository_cache=" + C.REPO_CACHE] + COMMON if verb != "shutdown" else [verb]
    if verb == "clean":
        argv = [verb]
    if verb in BUILD_LIKE and reference == "cold":
        argv += ["--nokeep_state_after_build"] if step.get("nokeep") else REF_FLAGS
    if verb in ("build", "test"):
        argv += ["--execution_log_json_file=" + os.path.join(out_dir, step["name"] + ".execlog.json"),
                 "--execution_log_sort",
                 "--build_event_json_file=" + os.path.join(out_dir, step["name"] + ".bep.json")]
    return argv + step["argv"][1:]


