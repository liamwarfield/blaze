# The side runner (inside the unit).

def side_main(spec_path):
    spec = json.load(open(spec_path))
    record = load_record()
    ws, ur, out = spec["ws"], spec["ur"], spec["out"]
    binary = spec["binary"]
    env = dict(spec["env"])
    if spec.get("tripwire") and os.environ.get(C.UNIT_ENV) == "1":
        env["COMPARE_COMMON_TRIPWIRE"] = spec["tripwire"]
    startup = [binary, "--output_user_root=" + ur, "--nohome_rc", "--nosystem_rc"]
    output_base = os.path.join(ur, hashlib.md5(os.path.realpath(ws).encode()).hexdigest())
    paths = {"execroot": os.path.join(output_base, "execroot", "_main"),
             "output_base": output_base, "install_base": None, "output_user_root": ur,
             "workspace": os.path.realpath(ws), "record_dir": out, "binary": binary,
             "binary_dir": os.path.dirname(binary), "home": C.HOME}
    user = os.environ.get("USER") or os.path.basename(C.HOME)
    host = socket.gethostname().split(".")[0]
    saved = {}
    log = open(os.path.join(out, "steps.jsonl"), "a")
    servers = []  # distinct server pids in order of appearance

    def server_label():
        pid = C.server_pid(ur)
        if pid is None or not C.alive(pid):
            return "none", None
        if pid not in servers:
            servers.append(pid)
        return "S%d" % (servers.index(pid) + 1), pid

    def on_signal(signum, _frame):
        raise KeyboardInterrupt("signal %d" % signum)
    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGHUP, on_signal)

    try:
        for step in spec["steps"]:
            name = step["name"]
            for act in step["actions"]:
                path = os.path.join(ws, act[1])
                if act[0] == "touch":
                    os.utime(path, None)
                elif act[0] == "append":
                    with open(path, "a") as f:
                        f.write(act[2])
                elif act[0] == "save":
                    saved[act[1]] = open(path, "rb").read()
                elif act[0] == "restore":
                    with open(path, "wb") as f:
                        f.write(saved[act[1]])
                else:
                    raise RuntimeError("unknown action %r" % (act,))
            argv = startup + command_line(step, spec["reference"], out)
            before, before_pid = server_label()
            oom0 = C.oom_kills()
            t0 = time.monotonic()
            timeout = STEP_TIMEOUT.get(step["argv"][0], DEFAULT_TIMEOUT)
            with open(os.path.join(out, name + ".stdout"), "wb") as so, \
                    open(os.path.join(out, name + ".stderr"), "wb") as se:
                p = subprocess.Popen(argv, cwd=ws, env=env, stdin=subprocess.DEVNULL,
                                     stdout=so, stderr=se)
                timed_out = False
                try:
                    p.wait(timeout=timeout)
                except subprocess.TimeoutExpired:
                    p.kill()
                    p.wait()
                    timed_out = True
            dur = round(time.monotonic() - t0, 2)
            after, after_pid = server_label()
            if paths["install_base"] is None:
                paths["install_base"] = record.find_install_base(ur)
            rec = {"name": name, "argv": argv, "returncode": p.returncode, "timed_out": timed_out,
                   "status": str(C.Status(p.returncode, timed_out)), "duration_s": dur,
                   "oom_kill_before": oom0, "oom_kill_after": C.oom_kills(),
                   "server_before": before, "server_after": after,
                   "server_pid_before": before_pid, "server_pid_after": after_pid}
            if step["argv"][0] in ("build", "test"):
                ctx = onorm_context(paths, user, host)
                rec["outputs"] = record.walk_outputs(ctx, ws)
                rec["spawns"] = extract_spawns(ctx, os.path.join(out, name + ".execlog.json"))
                rec["metrics"] = extract_metrics(os.path.join(out, name + ".bep.json"))
                if not spec.get("keep_raw"):
                    for suffix in (".execlog.json", ".bep.json"):
                        if os.path.exists(os.path.join(out, name + suffix)):
                            os.remove(os.path.join(out, name + suffix))
            log.write(json.dumps(rec, sort_keys=True) + "\n")
            log.flush()
            print("[seq %s] %s: %s in %.1fs, server %s -> %s" % (
                spec["side"], name, rec["status"], dur, before, after), flush=True)
    finally:
        with open(os.path.join(out, "context.json"), "w") as f:
            json.dump({"paths": paths, "user": user, "host": host}, f, indent=1, sort_keys=True)

        def shutdown(out_base):
            subprocess.run(startup + ["--output_base=" + out_base, "shutdown"], cwd=ws, env=env,
                           stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=120)
        left = C.kill_root_servers(ur, shutdown,
                                   log=lambda m: print("[seq %s] cleanup: %s" % (spec["side"], m)))
        with open(os.path.join(out, "done.json"), "w") as f:
            json.dump({"servers_left": left, "servers_seen": servers}, f)
    return 0


def onorm_context(paths, user, host):
    return C.onorm.Context(paths, user, host)


def extract_spawns(ctx, path):
    if not os.path.exists(path):
        return None
    out = []
    for s in C.osurf._concat_json(open(path, encoding="utf-8", errors="replace").read()):
        item = {"mnemonic": s.get("mnemonic"), "targetLabel": s.get("targetLabel"),
                "outputs": [ctx.text(o) for o in s.get("listedOutputs") or []],
                "runner": s.get("runner"), "cacheHit": s.get("cacheHit", False),
                "exitCode": s.get("exitCode", 0), "status": s.get("status", "")}
        out.append(C.oc.canonical(item))
    return sorted(out)


def drop_timing(obj):
    if isinstance(obj, dict):
        return {k: drop_timing(v) for k, v in obj.items()
                if not C.osurf.BEP_TIMING_KEY_RE.search(k)}
    if isinstance(obj, list):
        return [drop_timing(x) for x in obj]
    return obj


# Dropped from buildMetrics, as scripts/oracle/allow.json "build-metrics-volatile-counters" does
# for the referee: they differ between two oracle runs of the same command (seq --control).
VOLATILE_GRAPH = ("evaluatedValues", "builtValues", "changedValues", "cleanedValues",
                  "dirtiedValues", "postInvocationSkyframeNodeCount")


def extract_metrics(path):
    if not os.path.exists(path):
        return None
    for line in open(path, encoding="utf-8", errors="replace"):
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if "buildMetrics" in e:
            m = e["buildMetrics"]
            m = drop_timing({k: m[k] for k in ("actionSummary", "packageMetrics",
                                               "targetMetrics", "buildGraphMetrics") if k in m})
            for k in VOLATILE_GRAPH:
                m.get("buildGraphMetrics", {}).pop(k, None)
            m.get("actionSummary", {}).get("actionCacheStatistics", {}).pop("sizeInBytes", None)
            return m
    return {"buildMetrics": "absent"}


