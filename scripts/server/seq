SEQUENCE = [
    ("cold", [], ["CMD"]),
    ("again", [], ["CMD"]),
    ("query", [], ["query", "EXPR", "--output=label_kind", "--keep_going"]),
    ("cquery", [], ["cquery", "EXPR", "--output=label_kind"]),
