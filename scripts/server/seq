# The outer driver.

def run_side(side, binary, ws, ur, out, steps, reference, keep_raw):
    """Runs one side in its own unit; returns the unit status line."""
    os.makedirs(out, exist_ok=True)
    spec = {"side": side, "binary": binary, "ws": ws, "ur": ur, "out": out, "steps": steps,
            "reference": reference, "keep_raw": keep_raw,
            "env": {"HOME": C.HOME, "PATH": "/usr/bin:/bin", "BLAZE_SERVER_MODE": "daemon"}}
    spec_path = os.path.join(out, "spec.json")
    with open(spec_path, "w") as f:
        json.dump(spec, f, indent=1)
    status = os.path.join(out, "unit-status")
    if os.path.lexists(status):
        os.remove(status)
    cmd = ["systemd-run", "--user", "--collect", "--wait", "--pipe", "--quiet", "--same-dir",
           "-p", "MemoryMax=12G", "-p", "MemorySwapMax=0",
           "/usr/bin/python3", "-I", C.SUPERVISOR, status,
           "env", "-i", "HOME=" + C.HOME, "PATH=/usr/bin:/bin",
           "/usr/bin/python3", "-I", os.path.abspath(__file__), "_side", spec_path]
    print("%s: side %s: %s in a unit (12G), output %s" % (TOOL, side, binary, out), flush=True)
    rc = subprocess.call(cmd, stdin=subprocess.DEVNULL, cwd=ws)
    try:
        line = open(status).read().strip()
    except OSError:
        line = "no status recorded inside the unit (systemd-run returned %d)" % rc
    with open(os.path.join(out, "unit-status.txt"), "w") as f:
        f.write(line + "\n")
    return line


def workspace_digest(ws):
    h = hashlib.sha256()
    for dirpath, dirnames, filenames in os.walk(ws):
        dirnames.sort()
        for n in sorted(filenames):
            p = os.path.join(dirpath, n)
            rel = os.path.relpath(p, ws)
            if os.path.islink(p):
                h.update(b"L" + rel.encode() + b"\0" + os.readlink(p).encode() + b"\n")
            elif os.path.isfile(p):
                h.update(b"F" + rel.encode() + b"\0" + C.oc.sha256_file(p).encode()
                         + (b" x" if os.access(p, os.X_OK) else b"") + b"\n")
    return h.hexdigest()


def load_side(out):
    steps = {}
    path = os.path.join(out, "steps.jsonl")
    if os.path.exists(path):
        for line in open(path):
            if line.strip():
                r = json.loads(line)
                steps[r["name"]] = r
    ctx_path = os.path.join(out, "context.json")
    ctx = C.onorm.Context.from_dict(json.load(open(ctx_path))) if os.path.exists(ctx_path) else None
    return steps, ctx


EXTRA_STDERR = ("Starting local ", "Extracting Bazel installation", "Server ", "Another command ",
                "Waiting for ", "Killed non-responsive")


def views(rec, out, ctx):
    """The compared fields of one step (see help)."""
    v = {"status": rec["status"]}
    err = open(os.path.join(out, rec["name"] + ".stderr"), "rb").read().decode("utf-8", "replace")
    summary = C.onorm.stderr_summary(ctx, err)
    for raw in err.splitlines():
        line = raw.split("\r")[-1].rstrip()
        if line.startswith(EXTRA_STDERR):
            line = C.Norm("\0no-root\0").text(ctx.text(line)).rstrip("\n")
            summary[line] = summary.get(line, 0) + 1
    v["stderr"] = "".join("%s%s\n" % (k, "" if n == 1 else "  [x%d]" % n)
                          for k, n in sorted(summary.items()))
    verb = rec["argv"][rec["argv"].index("--nosystem_rc") + 1]
    if verb in ("query", "cquery", "aquery", "info"):
        text = open(os.path.join(out, rec["name"] + ".stdout"), "rb").read().decode("utf-8", "replace")
        v["stdout"] = C.Norm("\0no-root\0").text(ctx.text(text))
    if verb in ("build", "test"):
        v["spawns"] = "".join(s + "\n" for s in rec["spawns"]) if rec.get("spawns") is not None \
            else "no execution log\n"
        v["metrics"] = json.dumps(rec.get("metrics"), indent=1, sort_keys=True) + "\n"
        # record.walk_outputs also walks bazel-testlogs; those files carry test times, so they
        # are compared by path and type only (as surfaces.py TESTLOGS_RE does for the referee).
        v["outputs"] = "".join(
            C.oc.canonical({k: x for k, x in e.items() if k in ("path", "type")}
                           if e["path"].startswith("testlogs/") else e) + "\n"
            for e in rec["outputs"]["entries"]) if rec.get("outputs") else "no outputs walk\n"
    v["server"] = "%s -> %s\n" % (rec["server_before"], rec["server_after"])
    return v


def compare(steps, a_out, b_out, report):
    a_steps, a_ctx = load_side(a_out)
    b_steps, b_ctx = load_side(b_out)
    counts = {C.IDENTICAL: 0, C.SAME_FAILURE: 0, C.DIFFERENT: 0, C.NOT_RUN: 0}
    rows = []
    for step in steps:
        name = step["name"]
        a, b = a_steps.get(name), b_steps.get(name)
        if a is None or b is None:
            counts[C.NOT_RUN] += 1
            rows.append((name, C.NOT_RUN, "side %s has no record" % ("A" if a is None else "B"), []))
            continue
        va, vb = views(a, a_out, a_ctx), views(b, b_out, b_ctx)
        diffs = []
        for field in va:
            if va[field] != vb.get(field):
                d = list(difflib.unified_diff(va[field].splitlines(), vb.get(field, "").splitlines(),
                                              "A " + field, "B " + field, lineterm="", n=1))
                diffs.append((field, d))
        failed_a = a["returncode"] != 0 or a["timed_out"]
        failed_b = b["returncode"] != 0 or b["timed_out"]
        if diffs:
            cls = C.DIFFERENT
        else:
            cls = C.SAME_FAILURE if (failed_a or failed_b) else C.IDENTICAL
        counts[cls] += 1
        note = "A %s %.0fs, B %s %.0fs; server %s" % (a["status"], a["duration_s"], b["status"],
                                                      b["duration_s"], va["server"].strip())
        if a.get("oom_kill_after") != a.get("oom_kill_before") or \
                b.get("oom_kill_after") != b.get("oom_kill_before"):
            note += "; OOM KILL in the unit"
        rows.append((name, cls, note, diffs))
    for name, cls, note, diffs in rows:
        report("  %-13s %-19s %s" % (cls, name, note))
        for field, d in diffs:
            report("      field %s differs (%d diff lines)" % (field, len(d)))
            for l in d[:60]:
                report("        " + l)
            if len(d) > 60:
                report("        [... %d more diff lines in the transcripts]" % (len(d) - 60))
    return counts


def side_ok(out, status_line):
    done = os.path.join(out, "done.json")
    problems = []
    if status_line != "exit 0":
        problems.append("side runner ended with: %s" % status_line)
    if not os.path.exists(done):
        problems.append("side runner did not finish its cleanup")
    else:
        left = json.load(open(done)).get("servers_left")
        if left:
            problems.append("servers left alive after cleanup: %s" % left)
    return problems


def cmd_run(args):
    project, control, reference = None, False, "cold"
    steps_sel, fresh_ref, keep_raw = None, False, False
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("--project", "--reference", "--steps"):
            if i + 1 >= len(args):
                die("%s needs a value" % a)
            val = args[i + 1]
            i += 1
            if a == "--project":
                project = val
            elif a == "--reference":
                reference = val
            else:
                steps_sel = [s for s in val.split(",") if s]
        elif a == "--control":
            control = True
        elif a == "--fresh-reference":
            fresh_ref = True
        elif a == "--keep-raw":
            keep_raw = True
        else:
            die("unknown argument %r (see `seq help`)" % a)
        i += 1
    if project not in PROJECTS:
        die("--project must be one of %s" % ", ".join(PROJECTS))
    if reference not in ("cold", "default"):
        die("--reference must be cold or default")
    if steps_sel is not None:
        unknown = [s for s in steps_sel if s not in STEP_NAMES]
        if unknown:
            die("unknown step(s): %s" % ", ".join(unknown))
        if not steps_sel:
            die("--steps selects no step")
    selected = steps_sel or STEP_NAMES
    steps = resolve(project, selected)
    if not steps:
        die("empty selection")
    oracle = C.verified_oracle(TOOL)
    free = os.statvfs(C.HOME)
    if free.f_bavail * free.f_frsize < 120 * 1024 ** 3:
        die("less than 120 GB free on /home: not running")

    spec = projects()[project]
    record = load_record()
    pdir = os.path.join(WORK, project)
    os.makedirs(pdir, exist_ok=True)
    stamp = datetime.datetime.now().strftime("%Y%m%dT%H%M%S")
    mode = "control" if control else "daemon"
    run_dir = os.path.join(WORK, "runs", "%s-%s-%s-%s" % (stamp, project, mode, reference))
    os.makedirs(run_dir)
    report_lines = []

    def report(line):
        print(line, flush=True)
        report_lines.append(line)

    staged = None
    blaze_src = C.blaze_binary()
    if control:
        b_binary, b_sha, b_role = oracle, C.ORACLE_SHA256, "B (--control: the oracle again)"
    else:
        if not os.path.exists(blaze_src):
            die("no Blaze binary at %s (set BLAZE)" % blaze_src)
        staged, b_sha = C.stage_binary(TOOL, blaze_src)
        b_binary, b_role = staged, "B (blaze %s, run from a private copy)" % blaze_src
    for l in C.header(TOOL, [("A (oracle, pinned)", oracle, C.ORACLE_SHA256),
                             (b_role, blaze_src if not control else oracle, b_sha)],
                      blaze=None if control else blaze_src):
        report(l)
    report("%s: project %s (commit %s, command %s); reference %s (side A%s); side B %s" % (
        TOOL, project, spec.get("commit"), " ".join(spec["commands"][0]), reference,
        " with " + " ".join(REF_FLAGS) if reference == "cold" else " without extra flags",
        "the oracle with A's flags" if control else "Blaze, BLAZE_SERVER_MODE=daemon, A's flags"))
    report("%s: steps selected: %d of %d (%s)" % (TOOL, len(steps), len(SEQUENCE),
                                                  ", ".join(s["name"] for s in steps)))
    status = {}
    ws = os.path.join(pdir, "ws")
    ur = os.path.join(pdir, "ur")
    checkout = C.oc.expand(spec["checkout"])
    lock = open(os.path.join(pdir, "lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        die("another seq run holds %s" % os.path.join(pdir, "lock"))

    def fresh_side():
        """Both sides run at the same paths (ws, ur), one after the other: nothing in the
        outputs differs by path. The workspace is re-prepared from the checkout for each."""
        C.kill_root_servers(ur)
        if os.path.lexists(ur):
            C.safe_rmtree(ur, C.TOOLS_WORK)
        return record.prepare_workspace(checkout, ws)

    try:
        fixed = fresh_side()
        ws_digest = workspace_digest(ws)
        key_obj = {"oracle_sha256": C.ORACLE_SHA256, "project": project,
                   "commit": spec.get("commit"), "command": spec["commands"][0],
                   "workspace": os.path.realpath(ws), "workspace_digest": ws_digest,
                   "workspace_fixups": fixed, "steps": steps, "reference": reference,
                   "ref_flags": REF_FLAGS, "common": COMMON,
                   "tools_sha256": C.tools_sha256(["seq", "common.py"])}
        key = hashlib.sha256(C.oc.canonical(key_obj).encode()).hexdigest()
        ref_dir = os.path.join(WORK, "refcache", key)
        report("%s: reference key %s (workspace digest %s)" % (TOOL, key, ws_digest))
        a_out = ref_dir
        cached = (not fresh_ref and os.path.exists(os.path.join(ref_dir, "complete.json")))
        if cached:
            meta = json.load(open(os.path.join(ref_dir, "complete.json")))
            report("%s: side A from the cache %s (recorded %s, status %s)" % (
                TOOL, ref_dir, meta.get("recorded"), meta.get("unit_status")))
            status["A"] = meta.get("unit_status")
        else:
            if os.path.lexists(ref_dir):
                C.safe_rmtree(ref_dir, C.TOOLS_WORK)
            os.makedirs(ref_dir)
            with open(os.path.join(ref_dir, "key.json"), "w") as f:
                json.dump(key_obj, f, indent=1, sort_keys=True)
            status["A"] = run_side("A", oracle, os.path.realpath(ws), ur, ref_dir, steps,
                                   reference, keep_raw)
            if not side_ok(ref_dir, status["A"]) and len(load_side(ref_dir)[0]) == len(steps):
                with open(os.path.join(ref_dir, "complete.json"), "w") as f:
                    json.dump({"recorded": stamp, "unit_status": status["A"]}, f)
            fresh_side()
        b_out = os.path.join(run_dir, "B")
        status["B"] = run_side("B", b_binary, os.path.realpath(ws), ur, b_out, steps,
                               reference, keep_raw)
        report("%s: side A unit: %s; side B unit: %s" % (TOOL, status["A"], status["B"]))
        problems = ["A: " + p for p in (side_ok(a_out, status["A"]) if not cached else [])]
        problems += ["B: " + p for p in side_ok(b_out, status["B"])]
        for p in problems:
            report("%s: PROBLEM %s" % (TOOL, p))
        report("%s: per step (A = %s, B = %s):" % (TOOL, a_out, b_out))
        counts = compare(steps, a_out, b_out, report)
        report("%s: denominator: %d steps selected (%d in the sequence); %d identical, "
               "%d same-failure (equal, a side failed; not matches), %d different, %d not run"
               % (TOOL, len(steps), len(SEQUENCE), counts[C.IDENTICAL], counts[C.SAME_FAILURE],
                  counts[C.DIFFERENT], counts[C.NOT_RUN]))
        rc = 0 if not problems and counts[C.DIFFERENT] == 0 and counts[C.NOT_RUN] == 0 else 1
    finally:
        left = C.kill_root_servers(ur)
        if left:
            report("%s: PROBLEM servers %s of %s still alive" % (TOOL, left, ur))
        for d in (ws, ur):
            if os.path.lexists(d):
                C.safe_rmtree(d, C.TOOLS_WORK)
        lock.close()
        if staged:
            C.unstage_binary(staged)
        with open(os.path.join(run_dir, "report.txt"), "w") as f:
            f.write("\n".join(report_lines) + "\n")
    report("%s: report %s" % (TOOL, os.path.join(run_dir, "report.txt")))
    return rc


def cmd_recompare(args):
    """Compares two recorded sides again (after a change of the comparison, not of the
    recording): --a DIR --b DIR (a refcache/<key> and a runs/<...>/B directory)."""
    if len(args) != 4 or args[0] != "--a" or args[2] != "--b":
        die("usage: seq recompare --a DIR --b DIR")
    a_out, b_out = os.path.abspath(args[1]), os.path.abspath(args[3])
    for d in (a_out, b_out):
        if not os.path.exists(os.path.join(d, "spec.json")):
            die("%s holds no recorded side (spec.json)" % d)
    sa, sb = json.load(open(os.path.join(a_out, "spec.json"))), json.load(open(os.path.join(b_out, "spec.json")))
    if [s["name"] for s in sa["steps"]] != [s["name"] for s in sb["steps"]]:
        die("the two sides ran different step lists")
    lines = []

    def report(line):
        print(line, flush=True)
        lines.append(line)
    for role, spec in (("A", sa), ("B", sb)):
        report("%s: recompare: side %s binary %s sha256 %s, reference %s, unit %s" % (
            TOOL, role, spec["binary"], C.sha256_file(spec["binary"]) if os.path.exists(
                spec["binary"]) else "(binary no longer present)", spec["reference"],
            open(os.path.join(a_out if role == "A" else b_out, "unit-status")).read().strip()
            if os.path.exists(os.path.join(a_out if role == "A" else b_out, "unit-status"))
            else "?"))
    report("%s: tool sha256 %s" % (TOOL, C.tools_sha256(["seq", "common.py"])))
    counts = compare(sa["steps"], a_out, b_out, report)
    report("%s: denominator: %d steps; %d identical, %d same-failure (equal, a side failed; not "
           "matches), %d different, %d not run" % (TOOL, len(sa["steps"]), counts[C.IDENTICAL],
                                                   counts[C.SAME_FAILURE], counts[C.DIFFERENT],
                                                   counts[C.NOT_RUN]))
    # Equal failures are listed, never a pass (audit round 4, rule (d)): exit 0 only when every
    # step is IDENTICAL.
    return 0 if counts[C.DIFFERENT] == 0 and counts[C.NOT_RUN] == 0 and \
        counts[C.SAME_FAILURE] == 0 and counts[C.IDENTICAL] > 0 else 1


def cmd_clean(args):
    pdirs = [os.path.join(WORK, p) for p in PROJECTS]
    for p in pdirs:
        ur = os.path.join(p, "ur")
        C.kill_root_servers(ur, log=print)
        for d in (os.path.join(p, "ws"), ur):
            if os.path.lexists(d):
                print("removing %s" % d)
                C.safe_rmtree(d, C.TOOLS_WORK)
    bindir = os.path.join(C.TOOLS_WORK, "bin")
    if os.path.isdir(bindir):
        for n in sorted(os.listdir(bindir)):
            pid = n.rsplit("-", 1)[-1]
            if pid.isdigit() and not C.alive(int(pid)):
                print("removing %s" % os.path.join(bindir, n))
                C.safe_rmtree(os.path.join(bindir, n), C.TOOLS_WORK)
    for flag, sub in (("--runs", "runs"), ("--refcache", "refcache")):
        if flag in args and os.path.isdir(os.path.join(WORK, sub)):
            print("removing %s" % os.path.join(WORK, sub))
            C.safe_rmtree(os.path.join(WORK, sub), C.TOOLS_WORK)
    return 0


def main(argv):
    if len(argv) < 2 or argv[1] in ("help", "--help", "-h"):
        sys.stdout.write(USAGE)
        for name, actions, cmd in SEQUENCE:
            print("  %-19s %s%s" % (name, "".join("%s %s; " % (a[0], a[1]) for a in actions),
                                    " ".join(cmd)))
        print("  (source: %s; build: BUILD.bazel)" % ", ".join(
            "%s %s" % (p, EDIT_FILES[p]["source"]) for p in PROJECTS))
        return 0
    if argv[1] == "_side":
        return side_main(argv[2])
    if argv[1] == "list":
        project = argv[argv.index("--project") + 1] if "--project" in argv else "brotli"
        if project not in PROJECTS:
            die("--project must be one of %s" % ", ".join(PROJECTS))
        for s in resolve(project, STEP_NAMES):
            print("%-19s %s%s" % (s["name"], "".join("%s %s; " % tuple(a[:2]) for a in s["actions"]),
                                  " ".join(command_line(s, "cold", "<out>"))))
        return 0
    if argv[1] == "run":
        return cmd_run(argv[2:])
    if argv[1] == "clean":
        return cmd_clean(argv[2:])
    if argv[1] == "recompare":
        return cmd_recompare(argv[2:])
    die("unknown command %r; see `seq help`" % argv[1])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
