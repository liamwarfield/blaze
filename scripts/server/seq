def run_side(side, binary, ws, ur, out, steps, reference, keep_raw):
    """Runs one side in its own unit; returns the unit status line."""
    os.makedirs(out, exist_ok=True)
    spec = {"side": side, "binary": binary, "ws": ws, "ur": ur, "out": out, "steps": steps,
            "reference": reference, "keep_raw": keep_raw,
            "env": {"HOME": C.HOME, "PATH": "/usr/bin:/bin", "BLAZE_SERVER_MODE": "daemon"},
            "tripwire": C.tripwire_env_token()}
    spec_path = os.path.join(out, "spec.json")
    with open(spec_path, "w") as f:
        json.dump(spec, f, indent=1)
    status = os.path.join(out, "unit-status")
    if os.path.lexists(status):
        os.remove(status)
    cmd = ["systemd-run", "--user", "--collect", "--wait", "--pipe", "--quiet", "--same-dir",
           "-p", "MemoryMax=" + C.selftest_memory("12G"), "-p", "MemorySwapMax=0",
           "-p", "OOMPolicy=continue",
           "/usr/bin/python3", "-I", C.SUPERVISOR, status,
           "env", "-i", "HOME=" + C.HOME, "PATH=/usr/bin:/bin", C.UNIT_ENV + "=1",
           "/usr/bin/python3", "-I", os.path.abspath(__file__), "_side", spec_path]
    print("%s: side %s: %s in a unit (12G), output %s" % (TOOL, side, binary, out), flush=True)
    rc = subprocess.call(cmd, stdin=subprocess.DEVNULL, cwd=ws)
    try:
        line = open(status).read().strip()
    except OSError:
        line = "no status recorded inside the unit (systemd-run returned %d)" % rc
    with open(os.path.join(out, "unit-status.txt"), "w") as f:
        f.write(line + "\n")
    return line


def workspace_digest(ws):
    h = hashlib.sha256()
    for dirpath, dirnames, filenames in os.walk(ws):
        dirnames.sort()
        for n in sorted(filenames):
            p = os.path.join(dirpath, n)
            rel = os.path.relpath(p, ws)
            if os.path.islink(p):
                h.update(b"L" + rel.encode() + b"\0" + os.readlink(p).encode() + b"\n")
            elif os.path.isfile(p):
                h.update(b"F" + rel.encode() + b"\0" + C.oc.sha256_file(p).encode()
                         + (b" x" if os.access(p, os.X_OK) else b"") + b"\n")
    return h.hexdigest()


def load_side(out):
    steps = {}
    path = os.path.join(out, "steps.jsonl")
    if os.path.exists(path):
        for line in open(path):
            if line.strip():
                r = json.loads(line)
                steps[r["name"]] = r
    ctx_path = os.path.join(out, "context.json")
    ctx = C.onorm.Context.from_dict(json.load(open(ctx_path))) if os.path.exists(ctx_path) else None
    return steps, ctx


# The whole stderr is compared, every line in order (audit 4r2, SV-1), after the record's path
# placeholders (scripts/oracle/normalise.py Context), the interop tools' pid, duration, UUID,
# sandbox and log-time rules (common.Norm) and these named exclusion rules, each counted per
# side in the report.
SEQ_RULES = cc.VOLATILE_RULES + [
    cc.Rule("connect_retry", r"^\.\.\. still trying to connect to local ",
            "printed by the client while it waits for a server under load (differs between two "
            "oracle runs: interop-client --control)"),
]
NORM = cc.Normaliser(SEQ_RULES, path_reason="each side's workspace copy, output base, execroot, "
                     "output user root, install base (scripts/oracle/normalise.py Context), "
                     "then process ids, durations, UUIDs, sandbox numbers (common.Norm)")
# (reference, step) -> the oracle side's designed termination: equal on both sides is IDENTICAL,
# the oracle ending otherwise ORACLE-UNEXPECTED (audit 4r2, SV-2). Every other equal failure is
# BOTH-FAILED (never a match).
DECLARED = {
    ("cold", "compile-error"): "exit 1",
    ("default", "compile-error"): "exit 1",
    # PostAnalysisQueryProcessor.java:93-101: "Queries based on analysis results are not
    # allowed if incrementality state is not being kept", exit 2.
    ("cold", "cquery"): "exit 2",
    ("cold", "aquery"): "exit 2",
}


def step_termination(rec):
    """The compare_common Termination of a recorded step; an OOM kill in the side's unit during
    the step makes it `oom-kill` (audit 4r2, SV-3)."""
    before, after = rec.get("oom_kill_before"), rec.get("oom_kill_after")
    oom = (after - before) if (before is not None and after is not None) else 0
    return C.termination(C.Status(rec["returncode"], rec["timed_out"]), max(0, oom))


def views(rec, out, ctx, side):
    """The compared fields of one step (see help); the termination is judged on its own."""
    v = {}
    err = open(os.path.join(out, rec["name"] + ".stderr"), "rb").read().decode("utf-8", "replace")
    lines = "\n".join(raw.split("\r")[-1].rstrip() for raw in err.split("\n"))
    v["stderr"] = NORM.apply(C.Norm("\0no-root\0").text(ctx.text(lines)), side, "stderr").text
    verb = rec["argv"][rec["argv"].index("--nosystem_rc") + 1]
    if verb in ("query", "cquery", "aquery", "info"):
        text = open(os.path.join(out, rec["name"] + ".stdout"), "rb").read().decode("utf-8", "replace")
        v["stdout"] = C.Norm("\0no-root\0").text(ctx.text(text))
    if verb in ("build", "test"):
        v["spawns"] = "".join(s + "\n" for s in rec["spawns"]) if rec.get("spawns") is not None \
            else "no execution log\n"
        v["metrics"] = json.dumps(rec.get("metrics"), indent=1, sort_keys=True) + "\n"
        # record.walk_outputs also walks bazel-testlogs; those files carry test times, so they
        # are compared by path and type only (as surfaces.py TESTLOGS_RE does for the referee).
        v["outputs"] = "".join(
            C.oc.canonical({k: x for k, x in e.items() if k in ("path", "type")}
                           if e["path"].startswith("testlogs/") else e) + "\n"
            for e in rec["outputs"]["entries"]) if rec.get("outputs") else "no outputs walk\n"
    v["server"] = "%s -> %s\n" % (rec["server_before"], rec["server_after"])
    return v


def compare(steps, a_out, b_out, report, rep, reference):
    """One row per step in `rep` (a compare_common.Report); prints the diffs."""
    a_steps, a_ctx = load_side(a_out)
    b_steps, b_ctx = load_side(b_out)
    rep.add_normaliser(NORM)
    for step in steps:
        name = step["name"]
        a, b = a_steps.get(name), b_steps.get(name)
        if a is None or b is None:
            rep.add(name, cc.SKIPPED, "side %s has no record (its runner died before the step)"
                    % ("A" if a is None else "B"))
            report("  %-17s %-19s side %s has no record" % (cc.SKIPPED, name,
                                                             "A" if a is None else "B"))
            continue
        va, vb = views(a, a_out, a_ctx, "oracle"), views(b, b_out, b_ctx, "blaze")
        diffs = []
        for field in va:
            if va[field] != vb.get(field):
                d = list(difflib.unified_diff(va[field].splitlines(), vb.get(field, "").splitlines(),
                                              "A " + field, "B " + field, lineterm="", n=1))
                diffs.append((field, d))
        ta, tb = step_termination(a), step_termination(b)
        decl = DECLARED.get((reference, name))
        differing = [f for f, _ in diffs]
        if decl is not None and C.term_text(ta) != decl:
            cls, detail = cc.ORACLE_UNEXPECTED, "declared %s, oracle %s" % (decl, ta)
        else:
            cls, detail = cc.judge(ta, tb, differing, declared_exit=(
                ta.code if decl is not None and ta.kind == "exit" else None))
        note = "A %s %.0fs, B %s %.0fs; server %s" % (ta, a["duration_s"], tb, b["duration_s"],
                                                      va["server"].strip())
        rep.add(name, cls, "%s%s%s" % (detail, "; " if detail else "", note))
        report("  %-17s %-19s %s%s" % (cls, name, note, (" (%s)" % detail) if detail else ""))
        for field, d in diffs:
            report("      field %s differs (%d diff lines)" % (field, len(d)))
            for l in d[:60]:
                report("        " + l)
            if len(d) > 60:
                report("        [... %d more diff lines in the transcripts]" % (len(d) - 60))


def side_ok(out, status_line):
    done = os.path.join(out, "done.json")
    problems = []
    if status_line != "exit 0":
        problems.append("side runner ended with: %s" % status_line)
    if not os.path.exists(done):
        problems.append("side runner did not finish its cleanup")
    else:
        left = json.load(open(done)).get("servers_left")
        if left:
            problems.append("servers left alive after cleanup: %s" % left)
    return problems


def cmd_run(args):
    project, control, reference = None, False, "cold"
    steps_sel, fresh_ref, keep_raw = None, False, False
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("--project", "--reference", "--steps"):
            if i + 1 >= len(args):
                die("%s needs a value" % a)
            val = args[i + 1]
            i += 1
            if a == "--project":
                project = val
            elif a == "--reference":
                reference = val
            else:
                steps_sel = [s for s in val.split(",") if s]
        elif a == "--control":
            control = True
        elif a == "--fresh-reference":
            fresh_ref = True
        elif a == "--keep-raw":
            keep_raw = True
        else:
            die("unknown argument %r (see `seq help`)" % a)
        i += 1
    if project not in PROJECTS:
        die("--project must be one of %s" % ", ".join(PROJECTS))
    if reference not in ("cold", "default"):
        die("--reference must be cold or default")
    if steps_sel is not None:
        unknown = [s for s in steps_sel if s not in STEP_NAMES]
        if unknown:
            die("unknown step(s): %s" % ", ".join(unknown))
        if not steps_sel:
            die("--steps selects no step")
    selected = steps_sel or STEP_NAMES
    steps = resolve(project, selected)
    if not steps:
        die("empty selection")
    oracle = C.verified_oracle(TOOL)
    free = os.statvfs(C.HOME)
    if free.f_bavail * free.f_frsize < 120 * 1024 ** 3:
        die("less than 120 GB free on /home: not running")

    spec = projects()[project]
    record = load_record()
    pdir = os.path.join(WORK, project)
    os.makedirs(pdir, exist_ok=True)
    stamp = datetime.datetime.now().strftime("%Y%m%dT%H%M%S")
    mode = "control" if control else "daemon"
    run_dir = os.path.join(WORK, "runs", "%s-%s-%s-%s-%d" % (stamp, project, mode, reference,
                                                           os.getpid()))
    os.makedirs(run_dir)
    report_lines = []

    def report(line):
        print(line, flush=True)
        report_lines.append(line)

    staged = None
    blaze_src = C.blaze_binary()
    if control:
        b_binary, b_sha, b_role = oracle, C.ORACLE_SHA256, "B (--control: the oracle again)"
    else:
        if not os.path.exists(blaze_src):
            die("no Blaze binary at %s (set BLAZE)" % blaze_src)
        C.refuse_oracle_as_blaze(TOOL, blaze_src)
        staged, b_sha = C.stage_binary(TOOL, blaze_src)
        b_binary, b_role = staged, "B (blaze %s, run from a private copy)" % blaze_src
    for l in C.header(TOOL, [("A (oracle, pinned)", oracle, C.oracle_sha256()),
                             (b_role, blaze_src if not control else oracle, b_sha)],
                      blaze=None if control else blaze_src):
        report(l)
    rep = cc.Report(TOOL, blaze={"path": blaze_src if not control else oracle, "sha256": b_sha},
                    oracle={"path": oracle, "sha256": C.oracle_sha256()},
                    selection="%s %s, steps %s" % (project, reference, ",".join(selected)),
                    tool_files=[os.path.abspath(__file__), os.path.join(HERE, "common.py")],
                    compared="per step: termination (an OOM kill in the side's unit during the "
                             "step included), the whole stderr in order after the exclusion "
                             "rules listed at the end, query/info stdout, spawns, metrics, "
                             "outputs, the server relation")
    report("%s: project %s (commit %s, command %s); reference %s (side A%s); side B %s" % (
        TOOL, project, spec.get("commit"), " ".join(spec["commands"][0]), reference,
        " with " + " ".join(REF_FLAGS) if reference == "cold" else " without extra flags",
        "the oracle with A's flags" if control else "Blaze, BLAZE_SERVER_MODE=daemon, A's flags"))
    report("%s: steps selected: %d of %d (%s)" % (TOOL, len(steps), len(SEQUENCE),
                                                  ", ".join(s["name"] for s in steps)))
    status = {}
    ws = os.path.join(pdir, "ws")
    ur = os.path.join(pdir, "ur")
    checkout = C.oc.expand(spec["checkout"])
    lock = open(os.path.join(pdir, "lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        die("another seq run holds %s" % os.path.join(pdir, "lock"))

    def fresh_side():
        """Both sides run at the same paths (ws, ur), one after the other: nothing in the
        outputs differs by path. The workspace is re-prepared from the checkout for each."""
        C.kill_root_servers(ur)
        if os.path.lexists(ur):
            C.safe_rmtree(ur, C.TOOLS_WORK)
        return record.prepare_workspace(checkout, ws)

    try:
        fixed = fresh_side()
        ws_digest = workspace_digest(ws)
        key_obj = {"oracle_sha256": C.oracle_sha256(), "project": project,
                   "commit": spec.get("commit"), "command": spec["commands"][0],
                   "workspace": os.path.realpath(ws), "workspace_digest": ws_digest,
                   "workspace_fixups": fixed, "steps": steps, "reference": reference,
                   "ref_flags": REF_FLAGS, "common": COMMON,
                   "tools_sha256": C.tools_sha256(["seq", "common.py"])}
        key = hashlib.sha256(C.oc.canonical(key_obj).encode()).hexdigest()
        ref_dir = os.path.join(WORK, "refcache", key)
        report("%s: reference key %s (workspace digest %s)" % (TOOL, key, ws_digest))
        a_out = ref_dir
        complete = os.path.join(ref_dir, "complete.json")
        cached = False
        if not fresh_ref and os.path.exists(complete):
            # The completeness marker is a compare_common key: it holds the digest of every
            # file of the cached side, so a changed or missing file is seen (audit 4r2, SV-4).
            why = cc.check_key(complete, key_obj)
            if why is None:
                cached = True
            else:
                report("%s: cached side A not used: %s; side A runs again" % (TOOL, why))
        if cached:
            meta = json.load(open(os.path.join(ref_dir, "meta.json")))
            report("%s: side A from the cache %s (recorded %s, status %s)" % (
                TOOL, ref_dir, meta.get("recorded"), meta.get("unit_status")))
            status["A"] = meta.get("unit_status")
        else:
            if os.path.lexists(ref_dir):
                C.safe_rmtree(ref_dir, C.TOOLS_WORK)
            os.makedirs(ref_dir)
            with open(os.path.join(ref_dir, "key.json"), "w") as f:
                json.dump(key_obj, f, indent=1, sort_keys=True)
            status["A"] = run_side("A", oracle, os.path.realpath(ws), ur, ref_dir, steps,
                                   reference, keep_raw)
            if not side_ok(ref_dir, status["A"]) and len(load_side(ref_dir)[0]) == len(steps):
                with open(os.path.join(ref_dir, "meta.json"), "w") as f:
                    json.dump({"recorded": stamp, "unit_status": status["A"]}, f)
                files = [os.path.join(dp, n) for dp, _, fs in os.walk(ref_dir) for n in fs
                         if n != "complete.json"]
                cc.write_key(complete, key_obj, files)
            fresh_side()
        b_out = os.path.join(run_dir, "B")
        status["B"] = run_side("B", b_binary, os.path.realpath(ws), ur, b_out, steps,
                               reference, keep_raw)
        report("%s: side A unit: %s; side B unit: %s" % (TOOL, status["A"], status["B"]))
        problems = ["A: " + p for p in (side_ok(a_out, status["A"]) if not cached else [])]
        problems += ["B: " + p for p in side_ok(b_out, status["B"])]
        for p in problems:
            report("%s: PROBLEM %s" % (TOOL, p))
            rep.problem(p)
        report("%s: per step (A = %s, B = %s):" % (TOOL, a_out, b_out))
        compare(steps, a_out, b_out, report, rep, reference)
        rep.note("%d steps selected of %d in the sequence" % (len(steps), len(SEQUENCE)))
    finally:
        left = C.kill_root_servers(ur)
        if left:
            report("%s: PROBLEM servers %s of %s still alive" % (TOOL, left, ur))
            rep.problem("servers %s of %s still alive" % (left, ur))
        for line in rep.footer_lines():
            report(line)
        rep.print_footer(file=open(os.devnull, "w"))
        rc = rep.exit_code()
        for d in (ws, ur):
            if os.path.lexists(d):
                C.safe_rmtree(d, C.TOOLS_WORK)
        lock.close()
        if staged:
            C.unstage_binary(staged)
        with open(os.path.join(run_dir, "report.txt"), "w") as f:
            f.write("\n".join(report_lines) + "\n")
    report("%s: report %s" % (TOOL, os.path.join(run_dir, "report.txt")))
    return rc


def cmd_recompare(args):
    """Compares two recorded sides again (after a change of the comparison, not of the
    recording): --a DIR --b DIR (a refcache/<key> and a runs/<...>/B directory)."""
    if len(args) != 4 or args[0] != "--a" or args[2] != "--b":
        die("usage: seq recompare --a DIR --b DIR")
    a_out, b_out = os.path.abspath(args[1]), os.path.abspath(args[3])
    for d in (a_out, b_out):
        if not os.path.exists(os.path.join(d, "spec.json")):
            die("%s holds no recorded side (spec.json)" % d)
    sa, sb = json.load(open(os.path.join(a_out, "spec.json"))), json.load(open(os.path.join(b_out, "spec.json")))
    if [s["name"] for s in sa["steps"]] != [s["name"] for s in sb["steps"]]:
        die("the two sides ran different step lists")
    lines = []

    def report(line):
        print(line, flush=True)
        lines.append(line)
    for role, spec in (("A", sa), ("B", sb)):
        report("%s: recompare: side %s binary %s sha256 %s, reference %s, unit %s" % (
            TOOL, role, spec["binary"], C.sha256_file(spec["binary"]) if os.path.exists(
                spec["binary"]) else "(binary no longer present)", spec["reference"],
            open(os.path.join(a_out if role == "A" else b_out, "unit-status")).read().strip()
            if os.path.exists(os.path.join(a_out if role == "A" else b_out, "unit-status"))
            else "?"))
    report("%s: tool sha256 %s" % (TOOL, C.tools_sha256(["seq", "common.py"])))
    rep = cc.Report(TOOL, blaze={"path": sb["binary"]}, oracle={"path": sa["binary"]},
                    selection="recompare %s %s" % (a_out, b_out),
                    tool_files=[os.path.abspath(__file__), os.path.join(HERE, "common.py")],
                    compared="as `run`, from the recorded sides")
    # A re-classification of stored outputs never passes (compare_common rule).
    rep.reclassify_only = True
    compare(sa["steps"], a_out, b_out, report, rep, sa["reference"])
    rep.print_footer()
    return rep.exit_code()


def cmd_clean(args):
    pdirs = [os.path.join(WORK, p) for p in PROJECTS]
    for p in pdirs:
        ur = os.path.join(p, "ur")
        C.kill_root_servers(ur, log=print)
        for d in (os.path.join(p, "ws"), ur):
            if os.path.lexists(d):
                print("removing %s" % d)
                C.safe_rmtree(d, C.TOOLS_WORK)
    bindir = os.path.join(C.TOOLS_WORK, "bin")
    if os.path.isdir(bindir):
        for n in sorted(os.listdir(bindir)):
            pid = n.rsplit("-", 1)[-1]
            if pid.isdigit() and not C.alive(int(pid)):
                print("removing %s" % os.path.join(bindir, n))
                C.safe_rmtree(os.path.join(bindir, n), C.TOOLS_WORK)
    for flag, sub in (("--runs", "runs"), ("--refcache", "refcache")):
        if flag in args and os.path.isdir(os.path.join(WORK, sub)):
            print("removing %s" % os.path.join(WORK, sub))
            C.safe_rmtree(os.path.join(WORK, sub), C.TOOLS_WORK)
    return 0


def selftest():
    """`run --project re2` against fake binaries (fake HOME); the fakes trip when started
    outside the side runner's unit."""
    st = cc.Selftest(TOOL)
    fh = cc.FakeHome("server-seq")
    me = os.path.abspath(__file__)
    n = [0]

    def fakes(ospec, bspec):
        n[0] += 1
        C.fake(fh.oracle, fh, "oracle", **ospec)
        return C.fake(os.path.join(fh.home, "bin", "blaze-%d" % n[0]), fh, "blaze-%d" % n[0],
                      **bspec)

    def run(b, steps="cold,query", extra=(), memory=None, pin=None):
        old = os.environ.get("BLAZE"), os.environ.get("COMPARE_COMMON_SELFTEST_MEMORY")
        os.environ["BLAZE"] = b
        if memory:
            os.environ["COMPARE_COMMON_SELFTEST_MEMORY"] = memory
        try:
            return fh.run_tool(me, ["run", "--project", "re2", "--steps", steps] + list(extra),
                               pin=pin)
        finally:
            for k, v in zip(("BLAZE", "COMPARE_COMMON_SELFTEST_MEMORY"), old):
                if v is None:
                    os.environ.pop(k, None)
                else:
                    os.environ[k] = v

    def classes(rep):
        return [r["class"] for r in (rep or {}).get("cases", [])]

    def show(rc, rep):
        return "exit %s, %s" % (rc, classes(rep))
    try:
        b = fakes(dict(out=b"x"), dict(out=b"x"))
        subprocess.run([b, "build"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        st.check("tripwire trips on a direct launch", fh.tripped())
        if fh.tripped():
            os.remove(fh.tripfile)
        same = dict(out=b"//:a\n", err=b"INFO: Analyzed 1 target.\nINFO: Elapsed time: 1.5s\n")
        b = fakes(same, same)
        rc, rep, log = run(b)
        st.check("equal: exit 0, every step IDENTICAL", rc == 0 and classes(rep) ==
                 [cc.IDENTICAL, cc.IDENTICAL], show(rc, rep))
        rc, rep, log = run(b)
        notes = open(log).read()
        st.check("side A reused from the anchored cache", rc == 0 and "from the cache" in notes,
                 show(rc, rep))
        cache = os.path.join(fh.cache, "work", "server", "tools", "seq", "refcache")
        target = next(os.path.join(dp, f) for dp, _, fs in os.walk(cache) for f in fs
                      if f.endswith(".stderr"))
        with open(target, "ab") as f:
            f.write(b"tampered\n")
        rc, rep, log = run(b)
        text = open(log).read()
        st.check("a changed cached file is seen: side A runs again",
                 rc == 0 and "cached side A not used" in text, show(rc, rep))
        b = fakes(same, dict(same, err=b"INFO: Analyzed 1 target.\nINFO: Elapsed time: 1.5s\n"
                             b"WARNING: one more line\n"))
        rc, rep, log = run(b)
        st.check("an extra stderr line of any kind: DIFFERENT", rc == 1 and cc.DIFFERENT in
                 classes(rep), show(rc, rep))
        b = fakes(dict(same, err=b"INFO: a\nINFO: b\n"), dict(same, err=b"INFO: b\nINFO: a\n"))
        rc, rep, log = run(b)
        st.check("stderr lines in another order: DIFFERENT (no multiset)",
                 rc == 1 and cc.DIFFERENT in classes(rep), show(rc, rep))
        b = fakes(dict(same, code=1), dict(same, code=1))
        rc, rep, log = run(b)
        st.check("equal undeclared failures: BOTH-FAILED, exit 1",
                 rc == 1 and set(classes(rep)) == {cc.BOTH_FAILED}, show(rc, rep))
        b = fakes(dict(same, when=[("cquery", 2)]), dict(same, when=[("cquery", 2)]))
        rc, rep, log = run(b, steps="cquery")
        st.check("the declared cold-reference cquery failure: IDENTICAL",
                 rc == 0 and classes(rep) == [cc.IDENTICAL], show(rc, rep))
        b = fakes(same, dict(same, sig="PIPE"))
        rc, rep, log = run(b)
        st.check("Blaze killed by SIGPIPE: DIFFERENT", rc == 1 and cc.DIFFERENT in classes(rep),
                 show(rc, rep))
        b = fakes(same, dict(same, alloc_mb=700))
        rc, rep, log = run(b, memory="400M", extra=["--fresh-reference"])
        oom = [r for r in (rep or {}).get("cases", []) if "oom-kill" in r["detail"]]
        st.check("an OOM kill in the side's unit: never IDENTICAL",
                 rc == 1 and oom and all(r["class"] == cc.DIFFERENT for r in oom),
                 "%s; %d rows name oom-kill" % (show(rc, rep), len(oom)))
        rc, rep, log = run(fh.oracle)
        st.check("the oracle as the binary under test refused (exit 2)", rc == 2, "exit %s" % rc)
        rc, rep, log = run(b, pin="0" * 64)
        st.check("wrong oracle hash refused (exit 2)", rc == 2, "exit %s" % rc)
        st.check("no process started outside the side runners' units", not fh.tripped(),
                 open(fh.tripfile).read()[:200] if fh.tripped() else "")
    except Exception as e:  # noqa: BLE001 - a crash of the selftest is a failure
        import traceback
        traceback.print_exc()
        st.check("selftest ran to the end", False, "%s: %s" % (type(e).__name__, e))
    finally:
        if st.failures:
            print("  (fake HOME kept for inspection: %s)" % fh.root)
        else:
            fh.remove()
    return st.finish()


def main(argv):
    if len(argv) >= 2 and argv[1] == "selftest":
        return selftest()
    if len(argv) < 2 or argv[1] in ("help", "--help", "-h"):
        sys.stdout.write(USAGE)
        for name, actions, cmd in SEQUENCE:
            print("  %-19s %s%s" % (name, "".join("%s %s; " % (a[0], a[1]) for a in actions),
                                    " ".join(cmd)))
        print("  (source: %s; build: BUILD.bazel)" % ", ".join(
            "%s %s" % (p, EDIT_FILES[p]["source"]) for p in PROJECTS))
        return 0
    if argv[1] == "_side":
        return side_main(argv[2])
    if argv[1] == "list":
        project = argv[argv.index("--project") + 1] if "--project" in argv else "brotli"
        if project not in PROJECTS:
            die("--project must be one of %s" % ", ".join(PROJECTS))
        for s in resolve(project, STEP_NAMES):
            print("%-19s %s%s" % (s["name"], "".join("%s %s; " % tuple(a[:2]) for a in s["actions"]),
                                  " ".join(command_line(s, "cold", "<out>"))))
        return 0
    if argv[1] == "run":
        return cmd_run(argv[2:])
    if argv[1] == "clean":
        return cmd_clean(argv[2:])
    if argv[1] == "recompare":
        return cmd_recompare(argv[2:])
    die("unknown command %r; see `seq help`" % argv[1])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
