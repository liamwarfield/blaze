#!/usr/bin/env python3
"""Group classify's per-function causes into families and rank them. See `families help`."""
import json, os, re, sys
from collections import defaultdict

USAGE = """\
usage: scripts/ut-analysis/families <label>
       scripts/ut-analysis/families help

Reads ~/.cache/blaze/upstream-test-results/<label>/causes.json (written by `classify`) and groups
the causes into families: `unported:<Class.method>` by the table U, the rest by the regexes in
RULES (over "<name> <cause> <detail>", first match wins). The rules were written by reading
the logs of blaze-v0.1.0; on another label, check the `unclassified` list it prints. Writes
<label>/families.json and prints the ranked families with three examples each.
"""
if len(sys.argv) != 2 or sys.argv[1] in ("help", "--help", "-h"):
    print(USAGE)
    sys.exit(0)
R = os.path.expanduser(os.path.join("~/.cache/blaze/upstream-test-results", sys.argv[1]))
d = json.load(open(os.path.join(R, "causes.json")))
F = d["functions"]

# (family, java/behaviour, missing-features item or None=NEW)
U = {
