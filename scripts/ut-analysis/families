 (r"bazel_lockfile_test", "lockfile"),
 (r"mod_command_test", "mod-cycle"),
 (r"configured_query_test#test_config_function", "cquery-config-function"),
 (r"bazel_rules_cc_test", "rules-cc-self"),
 (r"bazel_repository_cache_test#test_contents_cache_not_allowed", "exit-code"),
 (r"external_integration_test#test_integrity_correct", "convenience-symlink-in-repo"),
 (r"cc_integration_test#test_save_feature_state", "cc-feature-state"),
 (r"build_without_the_bytes_test#test_remote_cache_eviction", "rewinding"),
 (r"remote_execution_test#test_create_tree_artifact_outputs", "remote-worker-start"),
 (r"sandboxing_test#test_sandbox_reuse", "sandbox-reuse"),
 (r"starlark_repository_test#test_starlark_repository_which", "repo-which-execute"),
 (r"bazel_external_repository_test#.*Sparse", "sparse-tar"),
 (r"bazel_sandboxed_worker_with_cgroups_test|bazel_json_worker_test|bazel_worker_test", "repo-contents-cache-race"),
]

fam = defaultdict(list)
unknown = []
for k, v in F.items():
    c = v["cause"]
    f = None
    if c.startswith("unported:"):
        key = c[len("unported:"):]
        f = U.get(key, (None,))[0]
    if f is None:
        s = k + " " + c + " " + v.get("detail", "")
        for rx, fam_name in RULES:
            if re.search(rx, s):
                f = fam_name
                break
    if f is None:
        unknown.append((k, c))
        f = "unclassified"
    fam[f].append(k)

ranked = sorted(fam.items(), key=lambda kv: -len(kv[1]))
json.dump({f: sorted(ks) for f, ks in ranked}, open(os.path.join(R, "families.json"), "w"), indent=1)
for i, (f, ks) in enumerate(ranked):
    ts = sorted({k.split("#")[0].split(":")[1] for k in ks})
    ex = sorted(ks)
    ex3 = [ex[0], ex[len(ex) // 2], ex[-1]] if len(ex) >= 3 else ex
    print("%2d %4d %-28s targets=%d | %s" % (i + 1, len(ks), f, len(ts), " ; ".join(e.replace("//src/test/", "") for e in ex3)))
print("unclassified:", len(unknown))
for k, c in unknown:
    print("  ", k, c[:120])
