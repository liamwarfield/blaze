 "BuildEventServiceModule.createBesTransport": ("bes",),
 "RuleConfiguredTargetFactory.create": ("genquery",),
 "DumpCommand.exec": ("dump",),
 "StrippingPathMapper.tryCreate": ("path-mapping",),
