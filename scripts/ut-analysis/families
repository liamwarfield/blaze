 "BuildConfigurationValue.modifiedExecutionInfo": ("modify-execution-info",),
 "BlazeQueryEnvironment": ("query-graph",), "OutputFormatter": ("query-xml",),
 "BlazeCommandUtils.getUsage": ("help",), "BlazeCommandUtils.expandHelpTopic": ("help",),
 "BuildTool.runExclusiveTests": ("exclusive-tests",),
 "CommandLogModule.getOutputListener": ("command-log",),
 "FakeLoadTarget.<init>": ("fake-load-target",),
 "StarlarkActionFactory.registerStarlarkAction": ("shadowed-action",),
 "CanonicalizeCommand.exec": ("canonicalize",), "ConfigCommand.exec": ("config",),
 "LicenseCommand.exec": ("license",),
 "CppCompileAction.discoverInputs": ("include-scanning",),
