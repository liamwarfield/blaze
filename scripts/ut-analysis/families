 "ImplicitOutputsFunction.StarlarkImplicitOutputsFunctionWithCallback.calculateOutputs": ("implicit-outputs-callback",),
 "Scrubber.parse": ("scrubbing",), "StarlarkBaseExternalContext.loadWasm": ("wasm",),
