# Non-unported causes: (regex over "<target>#<fn> <cause>") -> family; first match wins.
RULES = [
 (r"absent:not_run", "help-completion"),
 (r" aborted:suite stopped", "collateral-xml-overflow"),
 (r"bazel_lockfile_test", "lockfile"),
 (r"undeclared inclusion", "undeclared-inclusion-after-discard"),
 (r"ui_test#test_interleaved_errors_and_progress", "progress-messages"),
 (r"Not an input-discovering action", "unused-inputs-list"),
 (r"UnsupportedCertVersion", "tls-v1-cert"),
 (r"sibling|execroot_test#test_cc_smoke_with_new_layouts|execroot_test#test_external_directory_globs|"
  r"cc_integration_test#test_include_external_genrule_header", "sibling-layout"),
 (r"_trash|No such file or directory\)|cannot load '_': no such file|BUILD file not found in directory '_' of external|error globbing", "repo-contents-cache-race"),
 (r"Variable `|Key `|has no field or method|got select for|Multiple entries with same key|ERROR: Traceback", "starlark-error-text"),
 (r"sparse", "sparse-tar"),
 (r"fetching is disabled|nofetch|test_no_fetch_then_fetch", "nofetch"),
 (r"client_test#test_(nobatch|server_not_restarted|client_debug_change|multiple_requests|no_server_restart|batch|server_restart|local_startup|multiple_commands|server_process_name|noblock)|"
  r"bazel_server_mode_test|discard_analysis_cache_test#test_aspect_and|startup_options_test|check_external_files_test|"
  r"external_correctness_test|bazel_spawnstats|build_without_the_bytes_test#test_downloads_toplevel|"
  r"remote_execution_test#test_remote_default_exec|my_rule is being analyzed|nonincremental_builds_test|"
  r"execution_phase_tests#test_cache_computed|starlark_repository_test#test_unrelated_env|"
  r"external_integration_test#test_cache_hit_reported", "no-server"),
 (r"discard_graph_edges_test|client_test#test_sigquit|server_logging_test|bazel_java_test#test_server_javabase|"
  r"command_profiler_test|dump_test", "jvm-only"),
 (r"profile_test|watchfs_test|loading_phase_tests#test_starlark_cpu_profile|command.profile.gz", "profile"),
 (r"ui_test#test_(line_wrapping|terminal_title|basic_progress)|rc_options_test", "progress-bar"),
 (r"ui_test#test_loading_progress|progress_reporting_test|^timeout|sandboxing_test#test_succeed", "progress-messages"),
 (r"repo_contents_cache_test#RepoContentsCacheTest.testGc", "repo-contents-cache-gc"),
