#!/usr/bin/env python3
"""Compare two per-name test results (from scripts/gate/run-tests) with the acceptance rule.

Usage: scripts/gate/compare-tests <base> <new> [--name-map map.tsv] [--list N]
       scripts/gate/compare-tests help

<base> and <new> are run-tests results or baselines, plain JSON or .json.gz. The accepted
baseline is docs/state/tests-baseline.json.gz.

Rule: every name that passed in <base> must pass in <new>.
  LOST    passed in base, fails or is ignored in new
  ABSENT  passed in base, not in new at all (deleted, renamed, its crate did not build, not run)
Both are regressions; new passes never compensate for them.
  --name-map  TSV of `old_name<TAB>new_name<TAB>reason` for tests that were renamed or moved
  --list N    print at most N names per kind (default 50)

Exit status: 0 when no name was lost or absent, 1 otherwise, 2 on usage errors.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import gate_lib  # noqa: E402


def describe(doc):
    c = doc.get("counts", {})
    return "commit %s%s; pass %s, fail %s, ignored %s" % (
        doc.get("commit"), " (DIRTY tree)" if doc.get("tree_dirty") else "", c.get("pass"), c.get("fail"),
        c.get("ignored"))


def main(argv):
    if argv[:1] and argv[0] in ("help", "-h", "--help"):
        print(__doc__)
        return 0
    paths, mapping, limit = [], {}, 50
    i = 0
    try:
        while i < len(argv):
            if argv[i] == "--name-map":
                mapping = gate_lib.read_name_map(argv[i + 1])
                i += 2
            elif argv[i] == "--list":
                limit = int(argv[i + 1])
                i += 2
            elif argv[i].startswith("--"):
                raise ValueError("unknown option %s" % argv[i])
            else:
                paths.append(argv[i])
                i += 1
        if len(paths) != 2:
            raise ValueError("expected <base> and <new>")
        base, new = gate_lib.load_results(paths[0]), gate_lib.load_results(paths[1])
    except (ValueError, IndexError, OSError) as e:
        print("error: %s\n\n%s" % (e, __doc__), file=sys.stderr)
        return 2
    print("base: %s" % describe(base))
    print("new:  %s" % describe(new))
    for p in new.get("problems") or []:
        print("PROBLEM in new: %s" % p)
    cmp = gate_lib.compare_tests(base["results"], new["results"], mapping)
    print("retained %d  recovered %d  new-pass %d  lost %d  absent %d" % (
        cmp["retained"], len(cmp["recovered"]), len(cmp["added"]), len(cmp["lost"]), len(cmp["absent"])))
    for name, status in cmp["lost"][:limit]:
        print("  LOST   %s -> %s" % (name, status))
    for name in cmp["absent"][:limit]:
        print("  ABSENT %s" % name)
    hidden = max(0, len(cmp["lost"]) - limit) + max(0, len(cmp["absent"]) - limit)
    if hidden:
        print("  ... %d more (raise --list)" % hidden)
    bad = gate_lib.regressions(cmp)
    print("result: %s" % ("PASS (no name lost)" if not bad else "FAIL (%d names that passed no longer pass)" % bad))
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
