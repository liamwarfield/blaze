#!/usr/bin/env python3
"""Accept a per-name test result as the baseline: docs/state/tests-baseline.json.gz.

Usage: scripts/gate/baseline <result.json> [--allow-dirty] [--allow-loss "REASON"]
                             [--name-map map.tsv] [--out PATH]
       scripts/gate/baseline show [PATH]
       scripts/gate/baseline help

<result.json> comes from scripts/gate/run-tests. The baseline is its commit, counts, test
executables and per-name results, as JSON with sorted keys, gzipped without a name or timestamp
(as `gzip -n`): the same result always gives the same bytes. Next to it the tool writes
tests-baseline.json.gz.sha256 (`sha256sum -c` format).

The tool refuses:
  * a result from a dirty tree (a baseline names a commit), unless --allow-dirty;
  * a result with `problems` (a test executable crashed or could not be attributed);
  * a result with no passing test;
  * a result in which a name that passes in the current baseline no longer passes (the rule of
    scripts/gate/compare-tests), unless --allow-loss "REASON" is given. The lost and absent names
    and the reason are then stored in the new baseline under `accepted_losses`.
--name-map is passed to the comparison (renamed or moved tests).

`show` prints the commit and counts of the baseline (default: the committed one) and checks it
against its .sha256 file.

docs/state/ is a protected path (scripts/gate/protected-paths.txt): committing a new baseline
needs BLAZE_PROTECTED_OK. Exit status: 0 written (or shown and intact), 1 refused, 2 usage error.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import gate_lib  # noqa: E402


def show(path):
    sha_path = path + ".sha256"
    if not os.path.isfile(path):
        print("no baseline at %s" % path)
        return 1
    with open(path, "rb") as f:
        data = f.read()
    doc = gate_lib.load_results(path)
    c = doc.get("counts", {})
    print("baseline %s" % path)
    print("  commit %s%s" % (doc.get("commit"), " (DIRTY tree, diff %s)" % doc.get("dirty_diff_sha256")
                             if doc.get("tree_dirty") else " (clean tree)"))
    print("  pass %s, fail %s, ignored %s; %d names; %d test executables" % (
        c.get("pass"), c.get("fail"), c.get("ignored"), len(doc["results"]), len(doc.get("binaries", {}))))
    for loss in doc.get("accepted_losses", []):
        print("  accepted loss: %s (was pass, now %s): %s" % (loss["name"], loss["now"], loss["reason"]))
    digest = gate_lib.sha256(data)
    want = None
    if os.path.isfile(sha_path):
        with open(sha_path) as f:
            want = f.read().split()[0]
    print("  sha256 %s (%s)" % (digest, "matches %s" % os.path.basename(sha_path) if want == digest
                               else "DOES NOT MATCH %s" % sha_path))
    return 0 if want == digest else 1


def main(argv):
    if not argv or argv[0] in ("help", "-h", "--help"):
        print(__doc__)
        return 0 if argv else 2
    if argv[0] == "show":
        return show(argv[1] if len(argv) > 1 else gate_lib.BASELINE)
    src, out, allow_dirty, loss_reason, mapping = None, gate_lib.BASELINE, False, None, {}
    i = 0
    try:
        while i < len(argv):
            a = argv[i]
            if a == "--allow-dirty":
                allow_dirty = True
                i += 1
            elif a in ("--allow-loss", "--out", "--name-map"):
                value = argv[i + 1]
                if a == "--allow-loss":
                    if not value.strip():
                        raise ValueError("--allow-loss needs a reason")
                    loss_reason = value
                elif a == "--out":
                    out = value
                else:
                    mapping = gate_lib.read_name_map(value)
                i += 2
            elif a.startswith("--"):
                raise ValueError("unknown option %s" % a)
            elif src is None:
                src = a
                i += 1
            else:
                raise ValueError("unexpected argument %s" % a)
        if src is None:
            raise ValueError("expected a run-tests result")
        doc = gate_lib.load_results(src)
    except (ValueError, IndexError, OSError) as e:
        print("error: %s (see `scripts/gate/baseline help`)" % e, file=sys.stderr)
        return 2

    refusals = []
    if not doc.get("commit"):
        refusals.append("the result names no commit")
    if doc.get("tree_dirty") and not allow_dirty:
        refusals.append("the result comes from a dirty tree (commit %s, diff %s); run the tests on a clean "
                        "checkout of the commit, or pass --allow-dirty" % (doc.get("commit"), doc.get("dirty_diff_sha256")))
    for p in doc.get("problems") or []:
        refusals.append("problem in the result: %s" % p)
    if not any(v == "pass" for v in doc["results"].values()):
        refusals.append("the result has no passing test")
    new = {k: doc.get(k) for k in gate_lib.BASELINE_KEYS}
    new["accepted_losses"] = []
    if os.path.isfile(out):
        old = gate_lib.load_results(out)
        cmp = gate_lib.compare_tests(old["results"], doc["results"], mapping)
        print("against the current baseline (commit %s): retained %d  recovered %d  new-pass %d  lost %d  absent %d" % (
            old.get("commit"), cmp["retained"], len(cmp["recovered"]), len(cmp["added"]), len(cmp["lost"]),
            len(cmp["absent"])))
        losses = [{"name": n, "now": st} for n, st in cmp["lost"]] + [{"name": n, "now": "absent"} for n in cmp["absent"]]
        if losses and loss_reason is None:
            for loss in losses[:50]:
                print("  %-6s %s" % ("ABSENT" if loss["now"] == "absent" else "LOST", loss["name"]))
            refusals.append("%d names that pass in the current baseline no longer pass; fix them, map renames "
                            "with --name-map, or accept the loss with --allow-loss \"REASON\"" % len(losses))
        new["accepted_losses"] = [dict(loss, reason=loss_reason, since_commit=old.get("commit")) for loss in losses]
    if refusals:
        for r in refusals:
            print("refused: %s" % r, file=sys.stderr)
        return 1
    data = gate_lib.gzip_bytes(gate_lib.canonical_json(new))
    os.makedirs(os.path.dirname(os.path.abspath(out)), exist_ok=True)
    for path, payload in ((out, data), (out + ".sha256", ("%s  %s\n" % (gate_lib.sha256(data), os.path.basename(out))).encode())):
        tmp = path + ".tmp"
        with open(tmp, "wb") as f:
            f.write(payload)
        os.replace(tmp, path)
    c = new["counts"] or {}
    print("wrote %s: commit %s%s; pass %s, fail %s, ignored %s; sha256 %s" % (
        out, new["commit"], " (DIRTY)" if new["tree_dirty"] else "", c.get("pass"), c.get("fail"),
        c.get("ignored"), gate_lib.sha256(data)))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
