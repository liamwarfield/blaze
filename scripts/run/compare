#!/usr/bin/env python3
"""Compare `run` between the oracle (Bazel 9.3.2) and Blaze. See `compare help`."""

import hashlib
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time

USAGE = """\
usage: scripts/run/compare --binary <blaze> [--oracle <bazel>] [--project brotli|re2|all]
                           [--case ID]... [--label NAME] [--skip-oracle]
       scripts/run/compare list
       scripts/run/compare selftest
       scripts/run/compare help

Runs a fixed list of `run` invocations (see `list`) with the oracle and with Blaze, each on its
own work copy of a corpus project (~/.cache/blaze/work/run-compare/<side>/<project>: rsync of
the read-only checkout minus bazel-* and .git, restored to the checkout's git HEAD, plus the
probe package scripts/run/probe as //blaze_run_probe) and its own output user root
(~/.cache/blaze/oracle-out/run-compare-<side>), with a clean environment (HOME, PATH=/usr/bin:/bin
plus the case's variables), --nohome_rc --nosystem_rc, the shared repository cache, --color=no
--curses=no, under systemd-run --user --scope -p MemoryMax=12G -p MemorySwapMax=0 with the
supervisor of scripts/lib/compare_common.py, which records how each command really ended (`exit
N`, `signal NAME`, `oom-kill`, `timeout` after 3600 s). Both sides run the same cases in the
same order from a fresh output root. --oracle must be the pinned oracle (sha256 in
UPSTREAM.json); another binary is refused.

Compared per case, in full, after the exclusion rules (scripts/lib/compare_common.py
VOLATILE_RULES: progress lines, times, UUIDs, test timings, install md5, temp names; rule
`paths`: each side's workspace, output user root and output base; B1_GAP_RULES: lines that
depend on the oracle's warm server against Blaze's cold process, audit round 3 B1):
  termination  exit code, or signal, OOM kill, timeout
  stdout       the run program's standard output
  stderr       the whole of stderr
  script       (--script_path cases) the written script, then the termination, stdout and
               stderr of running it
The report lists every rule with its reason and the lines it changed or removed on each side.

Classes (scripts/lib/compare_common.py): IDENTICAL (all of it equal after the volatile rules;
the oracle exited 0 or the case declares its exit code in DECLARED_EXIT), KNOWN-GAP (equal
except in B1 lines), DIFFERENT, BOTH-FAILED (equal failures not declared), NOT-PORTED,
ORACLE-UNEXPECTED, SKIPPED. The terminations of the `shutdown` commands are listed; one that
died abnormally fails the run.

Output: a header (repository HEAD and dirty flag, tool and module sha256, both binaries' paths
and sha256, what is compared), one row per case, the exclusions, the denominator; raw outputs
under ~/.cache/blaze/run-compare/<label>/<side>/<project>/<case>.{stdout,stderr,json} and
results.json (the same report). Exit 0 only when at least one case was compared and every
selected case is IDENTICAL; 1 otherwise (an empty selection included); 2 on a usage error or a
refusal (also when this tool or compare_common.py changed on disk during the run).
--skip-oracle reuses the oracle outputs of an earlier run with the same --label only when
<label>/oracle/<project>/oracle.key, written after those outputs were complete, holds this run's
key (oracle sha256, every case's argv and environment, the digests of the corpus checkout and of
the probe package, the case sequence) and every output it anchors is unchanged; otherwise it
refuses. The outputs are raw (normalised when compared), so this tool's sha256 is not in it.
selftest drives this command line with fake binaries (compare_common.selftest_tool).
"""

HOME = os.path.expanduser("~")
REPO_ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(REPO_ROOT, "scripts", "lib"))
import compare_common as cc  # noqa: E402
CACHE = os.path.join(HOME, ".cache", "blaze")
ORACLE = os.path.join(CACHE, "oracle", "bazel-9.3.2-linux-x86_64")
REPO_CACHE = os.path.join(CACHE, "repo-cache")
PROBE_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "probe")
CORPUS = os.path.join(CACHE, "corpus")
TIMEOUT = 3600

P = "//blaze_run_probe"

# (id, project, description, cwd relative to the workspace, startup options, command args,
#  extra environment, script file written by the case or None)
CASES = [
    ("args", "brotli", "cc_binary with arguments after --", "", [],
     ["//:brotli", "--", "--version"], {}, None),
    ("exit-code", "brotli", "program exits non-zero", "", [], [P + ":exit3"], {}, None),
    ("env", "brotli", "BUILD_* variables, cleared runfiles variables, --run_env, args attr",
     "", [], ["--run_env=RUN_ENV_PROBE=val", P + ":printenv", "--", "a", "b c"],
     {"RUNFILES_DIR": "/bogus", "TEST_SRCDIR": "/bogus", "JAVA_RUNFILES": "/bogus"}, None),
    ("subdir", "brotli", "run from a package directory (BUILD_WORKING_DIRECTORY, pretty path)",
     "blaze_run_probe", [], [":printenv"], {}, None),
    ("run-in-cwd", "brotli", "--run_in_cwd", "blaze_run_probe", [],
     ["--run_in_cwd", ":printenv"], {}, None),
    ("show-args", "brotli", "--noomit_run_args (residue in the INFO line)", "", [],
     ["--noomit_run_args", P + ":exit3", "--", "x", "y z"], {}, None),
    ("run-under-cmd", "brotli", "--run_under=<command>", "", [],
     ["--run_under=echo prefix", P + ":exit3", "--", "x"], {}, None),
    ("run-under-label", "brotli", "--run_under=<label>", "", [],
     ["--run_under=" + P + ":wrapper", P + ":printenv", "--", "x"], {}, None),
    ("script-path", "brotli", "--script_path (script contents, then running it)", "", [],
     ["--script_path=run_probe.sh", P + ":printenv", "--", "s1"], {}, "run_probe.sh"),
    ("run-false", "brotli", "--run=false", "", [], ["--run=false", P + ":exit3"], {}, None),
    ("subcommands", "brotli", "--subcommands (full command description)", "", [],
     ["--subcommands", P + ":exit3"], {}, None),
    ("test-target", "brotli", "a cc_test run through `run` (test environment)", "", [],
     [P + ":envtest", "--", "t1"], {}, None),
    ("build-fails", "brotli", "target that fails to build", "", [], [P + ":broken"], {}, None),
    ("not-executable", "brotli", "non-executable target", "", [], [P + ":notexec"], {}, None),
    ("two-targets", "brotli", "pattern expanding to several targets", "", [],
     [P + ":all"], {}, None),
    ("no-target", "brotli", "no target given", "", [], [], {}, None),
    ("batch", "brotli", "--batch (the server runs the program as a child)", "", ["--batch"],
     [P + ":exit3", "--", "b"], {}, None),
    ("re2-test", "re2", "a googletest cc_test through `run`", "", [],
     ["//:charclass_test"], {}, None),
    ("re2-test-args", "re2", "test with arguments after --", "", [],
     ["//:charclass_test", "--", "--gtest_list_tests"], {}, None),
    ("re2-runs-per-test", "re2", "--runs_per_test=2 (more than one test action)", "", [],
     ["--runs_per_test=2", "//:charclass_test"], {}, None),
]

# Cases whose non-zero exit is the behaviour under test, with the oracle's exit code (run-2,
# 2026-11-19). Equal failures of a case not listed here are BOTH-FAILED.
DECLARED_EXIT = {
    "exit-code": 3,       # the program's exit code is propagated
    "show-args": 3,       # :exit3
    "subcommands": 3,     # :exit3
    "batch": 3,           # :exit3
    "build-fails": 1,
    "not-executable": 2,
    "two-targets": 2,
    "no-target": 2,
}

RULES = cc.VOLATILE_RULES + cc.B1_GAP_RULES


def clean_env(extra):
    env = {"HOME": HOME, "PATH": "/usr/bin:/bin"}
    env.update(extra)
    return env


def make_writable_and_remove(path):
    if not os.path.lexists(path):
        return
    subprocess.run(["chmod", "-R", "u+w", path], stderr=subprocess.DEVNULL)
    shutil.rmtree(path, ignore_errors=True)
    if os.path.lexists(path):
        subprocess.run(["rm", "-rf", path])


def kill_servers(root):
    if not os.path.isdir(root):
        return
    for name in os.listdir(root):
        pidfile = os.path.join(root, name, "server", "server.pid.txt")
        try:
            pid = int(open(pidfile).read().strip())
        except (OSError, ValueError):
            continue
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            continue
        for _ in range(100):
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                break
            time.sleep(0.1)


def prepare_workspace(checkout, ws):
    """Copy the checkout to ws, restore it to the checkout's git HEAD, add the probe package."""
    os.makedirs(ws, exist_ok=True)
    subprocess.run(
        ["rsync", "-a", "--delete", "--delete-excluded", "--exclude=/bazel-*", "--exclude=/.git",
         checkout.rstrip("/") + "/", ws + "/"], check=True)
    st = subprocess.run(
        ["git", "--no-optional-locks", "-C", checkout, "status", "--porcelain=v1", "-z",
         "--ignored", "--untracked-files=all"], check=True, stdout=subprocess.PIPE).stdout.decode()
    for entry in st.split("\0"):
        if len(entry) < 4:
            continue
        code, path = entry[:2], entry[3:]
        if path.startswith("bazel-") and "/" not in path.rstrip("/"):
            continue
        dest = os.path.join(ws, path)
        if code in ("??", "!!"):
            if os.path.isdir(dest) and not os.path.islink(dest):
                shutil.rmtree(dest)
            elif os.path.lexists(dest):
                os.remove(dest)
        else:
            blob = subprocess.run(["git", "-C", checkout, "show", "HEAD:" + path],
                                  stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            if blob.returncode == 0:
                os.makedirs(os.path.dirname(dest), exist_ok=True)
                with open(dest, "wb") as f:
                    f.write(blob.stdout)
    probe = os.path.join(ws, "blaze_run_probe")
    shutil.copytree(PROBE_DIR, probe)


def side_paths(side, project):
    ws = os.path.join(CACHE, "work", "run-compare", side, project)
    root = os.path.join(CACHE, "oracle-out", "run-compare-" + side)
    return ws, root


def prepare_side(side, project):
    """Fresh work copy and output base of one side."""
    ws, root = side_paths(side, project)
    kill_servers(root)
    make_writable_and_remove(ws)
    make_writable_and_remove(os.path.join(root, hashlib.md5(ws.encode()).hexdigest()))
    prepare_workspace(os.path.join(CORPUS, project), ws)


def path_pairs(side, project):
    """The replacements of one side's own paths (rule `paths`)."""
    ws, root = side_paths(side, project)
    ob = os.path.join(root, hashlib.md5(ws.encode()).hexdigest())
    return [(ob, "<OUTPUT_BASE>"), (root, "<OUTPUT_USER_ROOT>"), (ws, "<WORKSPACE>")]


def inputs_digest(project):
    return {"corpus": cc.tree_digest(os.path.join(CORPUS, project)),
            "probe": cc.tree_digest(PROBE_DIR)}


def case_argv(binary, root, startup, args):
    cmd = [binary, "--output_user_root=" + root, "--nohome_rc", "--nosystem_rc"] + startup
    return cmd + ["run", "--repository_cache=" + REPO_CACHE, "--color=no", "--curses=no"] + args


def oracle_key(project, cases):
    """Key of the oracle outputs of one project's case sequence (raw outputs: no tool sha)."""
    _, root = side_paths("oracle", project)
    return cc.cache_key(
        None, cc.pinned_sha256(),
        [case_argv(cc.PINNED_ORACLE, root, c[4], c[5]) for c in cases],
        [cc.clean_env(c[6]) for c in cases], inputs_digest(project),
        extra={"project": project, "cases": [list(c[:4]) + [c[7]] for c in cases]})


def case_files(out_dir, cases):
    return [os.path.join(out_dir, c[0] + ext) for c in cases
            for ext in (".stdout", ".stderr", ".json")]


def run_side(side, binary, project, cases, out_dir, report):
    """Runs the cases; writes <cid>.stdout, .stderr (raw) and .json (termination, script)."""
    prepare_side(side, project)
    ws, root = side_paths(side, project)
    os.makedirs(out_dir, exist_ok=True)
    for (cid, _proj, _desc, cwd, startup, args, extra_env, script) in cases:
        cmd = case_argv(binary, root, startup, args)
        print("[run-compare] %s %s/%s" % (side, project, cid), flush=True)
        r = cc.run(cmd, os.path.join(ws, cwd), env=extra_env, timeout=TIMEOUT, mode="scope",
                   tag="run-compare", stdout_path=os.path.join(out_dir, cid + ".stdout"),
                   stderr_path=os.path.join(out_dir, cid + ".stderr"))
        rec = {"argv": cmd, "cwd": cwd, "env": extra_env, "duration_s": r.duration,
               "termination": r.term.to_dict()}
        if script is not None:
            path = os.path.join(ws, cwd, script)
            if os.path.isfile(path):
                rec["script"] = open(path, "rb").read().decode("latin-1")
                q = cc.run([path, "extra arg"], os.path.join(ws, cwd), timeout=TIMEOUT,
                           mode="scope", tag="run-compare-script")
                rec["script_run"] = {"termination": q.term.to_dict(),
                                     "stdout": q.out.decode("latin-1"),
                                     "stderr": q.err.decode("latin-1")}
                os.remove(path)
            else:
                rec["script"] = None
        with open(os.path.join(out_dir, cid + ".json"), "w") as f:
            json.dump(rec, f, indent=1)
        print("[run-compare]   %s in %.1fs" % (r.term, r.duration), flush=True)
    # Shut the side's server down (the oracle's; Blaze has none) and keep the output root.
    t = cc.run([binary, "--output_user_root=" + root, "--nohome_rc", "--nosystem_rc",
                "shutdown"], ws, mode="scope", timeout=600, tag="run-compare-shutdown").term
    report.add_aux("%s %s shutdown" % (side, project), t)


def load_case(out_dir, cid):
    try:
        with open(os.path.join(out_dir, cid + ".json")) as f:
            rec = json.load(f)
        with open(os.path.join(out_dir, cid + ".stdout"), "rb") as f:
            rec["stdout"] = f.read()
        with open(os.path.join(out_dir, cid + ".stderr"), "rb") as f:
            rec["stderr"] = f.read()
    except (OSError, ValueError):
        return None
    return rec


def judge_case(norm, project, cid, o, b):
    """(class, detail) of one case: every field in full after the rules."""
    op, bp = path_pairs("oracle", project), path_pairs("blaze", project)
    differing, gaps = [], []
    for stream in ("stdout", "stderr"):
        eq, g = norm.compare(o[stream], b[stream], stream, op, bp)
        if not eq:
            differing.append(stream)
        gaps += g
    if "script" in o or "script" in b:
        eq, g = norm.compare(o.get("script") or "", b.get("script") or "", "stdout", op, bp)
        if not eq or (o.get("script") is None) != (b.get("script") is None):
            differing.append("script")
        osr, bsr = o.get("script_run") or {}, b.get("script_run") or {}
        if (osr.get("termination") or {}).get("text") != (bsr.get("termination") or {}).get("text"):
            differing.append("script termination")
        for stream in ("stdout", "stderr"):
            eq, g = norm.compare(osr.get(stream, ""), bsr.get(stream, ""), stream, op, bp)
            if not eq:
                differing.append("script " + stream)
            gaps += g
    return cc.judge(cc.Termination.from_dict(o.get("termination")),
                    cc.Termination.from_dict(b.get("termination")), differing,
                    declared_exit=DECLARED_EXIT.get(cid),
                    blaze_unported=cc.unported_message(b["stderr"]), gaps=sorted(set(gaps)))


COMPARED = ("termination, stdout and the whole stderr (and for --script_path the script, its "
            "termination and output), in full after the exclusion rules listed at the end")


def main(argv):
    if not argv or argv[0] in ("help", "--help", "-h"):
        print(USAGE)
        return 0
    if argv[0] == "list":
        for c in CASES:
            print("%-18s %-7s %s" % (c[0], c[1], c[2]))
        return 0
    if argv[0] == "selftest":
        return selftest()
    binary, oracle, project, label, only, skip_oracle = None, ORACLE, "all", "run-1", [], False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--binary":
            binary = os.path.abspath(argv[i + 1]); i += 2
        elif a == "--oracle":
            oracle = os.path.abspath(argv[i + 1]); i += 2
        elif a == "--project":
            project = argv[i + 1]; i += 2
        elif a == "--label":
            label = argv[i + 1]; i += 2
        elif a == "--case":
            only.append(argv[i + 1]); i += 2
        elif a == "--skip-oracle":
            skip_oracle = True; i += 1
        else:
            print("unknown argument: %s\n\n%s" % (a, USAGE), file=sys.stderr)
            return 2
    if binary is None:
        print(USAGE, file=sys.stderr)
        return 2
    projects = ["brotli", "re2"] if project == "all" else [project]
    selected = {proj: [c for c in CASES if c[1] == proj and (not only or c[0] in only)]
                for proj in projects}
    if not any(selected.values()):
        return cc.empty_selection_error("run/compare")
    try:
        oracle, oracle_sha = cc.require_oracle(oracle)
        blaze = cc.blaze_identity(binary)
    except cc.Refusal as e:
        return cc.refuse("run/compare", e)
    base = os.path.join(CACHE, "run-compare", label)
    report = cc.Report("run/compare", blaze=blaze, oracle={"path": oracle, "sha256": oracle_sha},
                       selection="label %s, projects %s, %d cases%s%s" % (
                           label, ",".join(projects), sum(len(v) for v in selected.values()),
                           " (--case %s)" % ",".join(only) if only else "",
                           ", oracle outputs reused" if skip_oracle else ""),
                       tool_files=[os.path.abspath(__file__)], compared=COMPARED)
    norm = cc.Normaliser(RULES)
    report.add_normaliser(norm)
    report.print_header()
    for proj in projects:
        cases = selected[proj]
        if not cases:
            continue
        odir = os.path.join(base, "oracle", proj)
        bdir = os.path.join(base, "blaze", proj)
        key_path = os.path.join(odir, "oracle.key")
        if skip_oracle:
            try:
                cc.require_fresh(key_path, oracle_key(proj, cases))
            except cc.Refusal as e:
                return cc.refuse("run/compare", e)
        else:
            cc.invalidate_key(key_path)
            run_side("oracle", oracle, proj, cases, odir, report)
            cc.write_key(key_path, oracle_key(proj, cases), case_files(odir, cases))
        run_side("blaze", blaze["path"], proj, cases, bdir, report)
        cc.write_capture(os.path.join(bdir, "capture.json"), blaze, case_files(bdir, cases))
        for c in cases:
            o, b = load_case(odir, c[0]), load_case(bdir, c[0])
            if o is None or b is None:
                report.add("%s/%s" % (proj, c[0]), cc.SKIPPED, "no %s output" % (
                    "oracle" if o is None else "blaze"))
                continue
            cls, detail = judge_case(norm, proj, c[0], o, b)
            report.add("%s/%s" % (proj, c[0]), cls, detail,
                       oracle=str(cc.Termination.from_dict(o["termination"])),
                       blaze=str(cc.Termination.from_dict(b["termination"])))
    os.makedirs(base, exist_ok=True)
    report.write_json(os.path.join(base, "results.json"))
    print()
    report.print_rows()
    report.print_footer()
    print("results: %s" % os.path.join(base, "results.json"))
    return report.exit_code()


def selftest():
    def argv(blaze, label):
        return ["--binary", blaze, "--project", "brotli", "--case", "args", "--label", label]

    return cc.selftest_tool(
        "run/compare", os.path.abspath(__file__), argv,
        empty=lambda b, l: ["--binary", b, "--case", "no-such-case", "--label", l],
        reuse=lambda b, l: argv(b, l) + ["--skip-oracle"],
        oracle_outputs=lambda home, l: [os.path.join(home, ".cache", "blaze", "run-compare", l,
                                                     "oracle", "brotli", "args.stdout")])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
