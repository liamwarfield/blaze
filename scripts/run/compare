# Cases whose non-zero exit is the behaviour under test, with the oracle's exit code (run-2,
# 2026-11-19). Equal failures of a case not listed here are BOTH-FAILED.
DECLARED_EXIT = {
    "exit-code": 3,       # the program's exit code is propagated
    "show-args": 3,       # :exit3
    "subcommands": 3,     # :exit3
    "batch": 3,           # :exit3
    "build-fails": 1,
    "not-executable": 2,
    "two-targets": 2,
    "no-target": 2,
}

SUMMARY_RE = re.compile(
    r"^(ERROR:|WARNING:|FAIL|INFO: Running command line|INFO: Runnable command line"
    r"|INFO: Build completed|INFO: Build did NOT)")
UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")


def summary_lines(stderr):
    """The summary lines of stderr, with the --subcommands command description (the lines after
    "INFO: Running command line:" up to the one closing its subshell)."""
    lines = stderr.splitlines()
    out = []
    i = 0
    while i < len(lines):
        line = lines[i]
        if SUMMARY_RE.match(line):
            out.append(line)
            if line in ("INFO: Running command line:", "INFO: Runnable command line:"):
                while i + 1 < len(lines):
                    i += 1
                    out.append(lines[i])
                    if lines[i].endswith(")"):
                        break
        i += 1
    return out


def clean_env(extra):
    env = {"HOME": HOME, "PATH": "/usr/bin:/bin"}
    env.update(extra)
    return env


def make_writable_and_remove(path):
    if not os.path.lexists(path):
        return
    subprocess.run(["chmod", "-R", "u+w", path], stderr=subprocess.DEVNULL)
    shutil.rmtree(path, ignore_errors=True)
    if os.path.lexists(path):
        subprocess.run(["rm", "-rf", path])


def kill_servers(root):
    if not os.path.isdir(root):
        return
    for name in os.listdir(root):
        pidfile = os.path.join(root, name, "server", "server.pid.txt")
        try:
            pid = int(open(pidfile).read().strip())
        except (OSError, ValueError):
            continue
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            continue
        for _ in range(100):
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                break
            time.sleep(0.1)


def prepare_workspace(checkout, ws):
    """Copy the checkout to ws, restore it to the checkout's git HEAD, add the probe package."""
    os.makedirs(ws, exist_ok=True)
    subprocess.run(
        ["rsync", "-a", "--delete", "--delete-excluded", "--exclude=/bazel-*", "--exclude=/.git",
         checkout.rstrip("/") + "/", ws + "/"], check=True)
    st = subprocess.run(
        ["git", "--no-optional-locks", "-C", checkout, "status", "--porcelain=v1", "-z",
         "--ignored", "--untracked-files=all"], check=True, stdout=subprocess.PIPE).stdout.decode()
    for entry in st.split("\0"):
        if len(entry) < 4:
            continue
        code, path = entry[:2], entry[3:]
        if path.startswith("bazel-") and "/" not in path.rstrip("/"):
            continue
        dest = os.path.join(ws, path)
        if code in ("??", "!!"):
            if os.path.isdir(dest) and not os.path.islink(dest):
                shutil.rmtree(dest)
            elif os.path.lexists(dest):
                os.remove(dest)
        else:
            blob = subprocess.run(["git", "-C", checkout, "show", "HEAD:" + path],
                                  stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            if blob.returncode == 0:
                os.makedirs(os.path.dirname(dest), exist_ok=True)
                with open(dest, "wb") as f:
                    f.write(blob.stdout)
    probe = os.path.join(ws, "blaze_run_probe")
    shutil.copytree(PROBE_DIR, probe)


def normaliser(ws, root):
    output_base_hash = hashlib.md5(ws.encode()).hexdigest()

    def norm(text):
        text = text.replace(os.path.join(root, output_base_hash), "<OUTPUT_BASE>")
        text = text.replace(root, "<OUTPUT_USER_ROOT>")
        text = text.replace(ws, "<WORKSPACE>")
        text = re.sub(r"<OUTPUT_USER_ROOT>/install/[0-9a-f]{32}", "<INSTALL_BASE>", text)
        text = UUID_RE.sub("<UUID>", text)
        # googletest's timings.
        text = re.sub(r"\((\d+) ms( total)?\)", lambda m: "(<N> ms%s)" % (m.group(2) or ""), text)
        return text
    return norm


def side_paths(side, project):
    ws = os.path.join(CACHE, "work", "run-compare", side, project)
    root = os.path.join(CACHE, "oracle-out", "run-compare-" + side)
    return ws, root


def prepare_side(side, project):
    """Fresh work copy and output base of one side; returns the work copy's tree digest."""
    ws, root = side_paths(side, project)
    kill_servers(root)
    make_writable_and_remove(ws)
    make_writable_and_remove(os.path.join(root, hashlib.md5(ws.encode()).hexdigest()))
    prepare_workspace(os.path.join(CORPUS, project), ws)
    return cc.tree_digest(ws)


def case_argv(binary, root, startup, args):
    cmd = [binary, "--output_user_root=" + root, "--nohome_rc", "--nosystem_rc"] + startup
    return cmd + ["run", "--repository_cache=" + REPO_CACHE, "--color=no", "--curses=no"] + args


def oracle_key(project, cases, inputs):
    """Key of the oracle outputs of one project's case sequence (compare_common.cache_key)."""
    _, root = side_paths("oracle", project)
    oracle = cc.PINNED_ORACLE
    return cc.cache_key(
        cc.tool_sha256(os.path.abspath(__file__)), cc.pinned_sha256(),
        [case_argv(oracle, root, c[4], c[5]) for c in cases],
        [cc.clean_env(c[6]) for c in cases], inputs,
        extra={"project": project, "cases": [list(c[:4]) + [c[7]] for c in cases]})


def run_side(side, binary, project, cases, out_dir):
    ws, root = side_paths(side, project)
    norm = normaliser(ws, root)
    os.makedirs(out_dir, exist_ok=True)
    results = {}
    for (cid, _proj, _desc, cwd, startup, args, extra_env, script) in cases:
        cmd = case_argv(binary, root, startup, args)
        print("[run-compare] %s %s/%s" % (side, project, cid), flush=True)
        r = cc.run(cmd, os.path.join(ws, cwd), env=extra_env, timeout=TIMEOUT, mode="scope",
                   tag="run-compare")
        out, err, dur = r.out, r.err, r.duration
        with open(os.path.join(out_dir, cid + ".stdout"), "wb") as f:
            f.write(out)
        with open(os.path.join(out_dir, cid + ".stderr"), "wb") as f:
            f.write(err)
        out_s = norm(out.decode("latin-1"))
        err_s = norm(err.decode("latin-1"))
        rec = {
            "argv": cmd, "cwd": cwd, "env": extra_env, "duration_s": dur,
            "exit": r.rc,
            "termination": r.term.to_dict(),
            "stdout": out_s,
            "summary": summary_lines(err_s),
            "unported": cc.unported_message(err),
        }
        if script is not None:
            path = os.path.join(ws, cwd, script)
            if os.path.isfile(path):
                rec["script"] = norm(open(path, "rb").read().decode("latin-1"))
                q = cc.run([path, "extra arg"], os.path.join(ws, cwd), timeout=TIMEOUT,
                           mode="scope", tag="run-compare-script")
                rec["script_run"] = {"exit": str(q.term),
                                     "output": norm((q.out + q.err).decode("latin-1"))}
                os.remove(path)
            else:
                rec["script"] = None
        results[cid] = rec
        with open(os.path.join(out_dir, cid + ".norm.json"), "w") as f:
            json.dump(rec, f, indent=1)
        print("[run-compare]   %s in %.1fs" % (r.term, dur), flush=True)
    # Shut the side's server down (the oracle's; Blaze has none) and keep the output root.
    t = cc.run([binary, "--output_user_root=" + root, "--nohome_rc", "--nosystem_rc",
                "shutdown"], ws, mode="scope", timeout=600, tag="run-compare-shutdown").term
    if not t.ok:
        print("[run-compare] %s shutdown: %s" % (side, t), flush=True)
    return results


def compare(oracle, blaze):
    """MATCH/DIFF per field; `exit` compares the terminations."""
    fields = ["exit", "stdout", "summary", "script", "script_run"]
    out = {}
    for f in fields:
        if f == "exit":
            ot = cc.Termination.from_dict(oracle.get("termination"))
            bt = cc.Termination.from_dict(blaze.get("termination"))
            out[f] = "MATCH" if ot is not None and ot == bt else "DIFF"
            continue
        if f not in oracle and f not in blaze:
            continue
        out[f] = "MATCH" if oracle.get(f) == blaze.get(f) else "DIFF"
    return out


def judge(cid, orec, brec, cmp_):
    """compare_common class of one case."""
    ot = cc.Termination.from_dict(orec.get("termination"))
    bt = cc.Termination.from_dict(brec.get("termination"))
    differing = [f for f, v in cmp_.items() if v == "DIFF" and f != "exit"]
    unported = brec.get("unported")
    return cc.judge(ot, bt, differing, declared_exit=DECLARED_EXIT.get(cid),
                    blaze_unported=unported)


def main(argv):
    if not argv or argv[0] in ("help", "--help", "-h"):
        print(USAGE)
        return 0
    if argv[0] == "list":
        for c in CASES:
            print("%-18s %-7s %s" % (c[0], c[1], c[2]))
        return 0
    if argv[0] == "selftest":
        return selftest()
    binary, oracle, project, label, only, skip_oracle = None, ORACLE, "all", "run-1", [], False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--binary":
            binary = os.path.abspath(argv[i + 1]); i += 2
        elif a == "--oracle":
            oracle = os.path.abspath(argv[i + 1]); i += 2
        elif a == "--project":
            project = argv[i + 1]; i += 2
        elif a == "--label":
            label = argv[i + 1]; i += 2
        elif a == "--case":
            only.append(argv[i + 1]); i += 2
        elif a == "--skip-oracle":
            skip_oracle = True; i += 1
        else:
            print("unknown argument: %s\n\n%s" % (a, USAGE), file=sys.stderr)
            return 2
    if binary is None:
        print(USAGE, file=sys.stderr)
        return 2
    projects = ["brotli", "re2"] if project == "all" else [project]
    selected = {proj: [c for c in CASES if c[1] == proj and (not only or c[0] in only)]
                for proj in projects}
    if not any(selected.values()):
        return cc.empty_selection_error("run/compare")
    try:
        oracle, oracle_sha = cc.require_oracle(oracle)
        blaze = cc.blaze_identity(binary)
    except cc.Refusal as e:
        return cc.refuse("run/compare", e)
    base = os.path.join(CACHE, "run-compare", label)
    report = cc.Report("run/compare", blaze=blaze, oracle={"path": oracle, "sha256": oracle_sha},
                       selection="label %s, projects %s, %d cases%s" % (
                           label, ",".join(projects), sum(len(v) for v in selected.values()),
                           " (--case %s)" % ",".join(only) if only else ""),
                       tool_files=[os.path.abspath(__file__)])
    report.print_header()
    table = []
    all_results = {}
    for proj in projects:
        cases = selected[proj]
        if not cases:
            continue
        odir = os.path.join(base, "oracle", proj)
        bdigest = prepare_side("blaze", proj)
        if skip_oracle:
            try:
                cc.require_fresh(os.path.join(odir, "oracle.key"),
                                 oracle_key(proj, cases, bdigest))
            except cc.Refusal as e:
                return cc.refuse("run/compare", e)
            ores = {c[0]: json.load(open(os.path.join(odir, c[0] + ".norm.json"))) for c in cases}
        else:
            odigest = prepare_side("oracle", proj)
            ores = run_side("oracle", oracle, proj, cases, odir)
            cc.write_key(os.path.join(odir, "oracle.key"), oracle_key(proj, cases, odigest))
        bres = run_side("blaze", blaze["path"], proj, cases, os.path.join(base, "blaze", proj))
        for c in cases:
            cmp_ = compare(ores[c[0]], bres[c[0]])
            cls, detail = judge(c[0], ores[c[0]], bres[c[0]], cmp_)
            report.add("%s/%s" % (proj, c[0]), cls, detail)
            table.append((proj, c[0], ores[c[0]], bres[c[0]], cmp_, cls))
            all_results["%s/%s" % (proj, c[0])] = {
                "oracle": ores[c[0]], "blaze": bres[c[0]], "compare": cmp_, "class": cls,
                "detail": detail}
    report.write_json(os.path.join(base, "results.json"), extra={"results": all_results})
    print()
    print("| project | case | oracle | blaze | exit | stdout | summary | script | class |")
    print("| --- | --- | --- | --- | --- | --- | --- | --- | --- |")
    for proj, cid, orec, brec, cmp_, cls in table:
        script = "/".join(cmp_[k] for k in ("script", "script_run") if k in cmp_) or "-"
        print("| %s | %s | %s | %s | %s | %s | %s | %s | %s |" % (
            proj, cid, cc.Termination.from_dict(orec["termination"]),
            cc.Termination.from_dict(brec["termination"]), cmp_["exit"], cmp_["stdout"],
            cmp_["summary"], script, cls))
    print()
    report.print_rows()
    report.print_footer()
    print("results: %s" % os.path.join(base, "results.json"))
    return report.exit_code()


def selftest():
    def run_pair(ofake, bfake, wd):
        cc.require_oracle(ofake)
        recs = {}
        for side, fake in (("oracle", ofake), ("blaze", bfake)):
            r = cc.run([fake, "run"], wd, mode="scope", tag="selftest")
            norm = normaliser(wd, os.path.join(wd, "ur"))
            recs[side] = {"exit": r.rc, "termination": r.term.to_dict(),
                          "stdout": norm(r.out.decode("latin-1")),
                          "summary": summary_lines(norm(r.err.decode("latin-1"))),
                          "unported": cc.unported_message(r.err)}
        cmp_ = compare(recs["oracle"], recs["blaze"])
        return judge("selftest", recs["oracle"], recs["blaze"], cmp_)

    def empty_selection():
        with open(os.devnull, "w") as null:
            old = sys.stderr
            sys.stderr = null
            try:
                return main(["--binary", "/bin/true", "--case", "no-such-case"])
            finally:
                sys.stderr = old

    def extra(st):
        ot = cc.Termination("exit", 2).to_dict()
        rec = {"termination": ot, "stdout": "", "summary": ["ERROR: x"]}
        st.check("declared failure (two-targets, exit 2) is IDENTICAL",
                 judge("two-targets", rec, dict(rec), compare(rec, dict(rec)))[0] == cc.IDENTICAL)
        st.check("undeclared equal failure is BOTH-FAILED",
                 judge("args", rec, dict(rec), compare(rec, dict(rec)))[0] == cc.BOTH_FAILED)
        legacy = {"exit": 0, "stdout": "", "summary": []}
        st.check("a legacy record without termination never matches",
                 compare(legacy, dict(legacy))["exit"] == "DIFF")
        key = oracle_key("brotli", CASES[:2], "digest-a")
        kp = os.path.join(st.dir, "oracle.key")
        cc.write_key(kp, key)
        st.check("--skip-oracle refuses another workspace digest",
                 cc.check_key(kp, oracle_key("brotli", CASES[:2], "digest-b")) is not None)
        st.check("--skip-oracle refuses another case sequence",
                 cc.check_key(kp, oracle_key("brotli", CASES[:3], "digest-a")) is not None)

    return cc.selftest("run/compare", run_pair=run_pair, empty_selection=empty_selection,
                       extra=extra, mode="scope")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
