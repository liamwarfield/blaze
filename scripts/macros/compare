#!/usr/bin/env python3
"""Compare symbolic macros, subrules and lazy macro expansion between the oracle and Blaze."""

import json
import os
import re
import shutil
import subprocess
import sys

USAGE = """\
usage: scripts/macros/compare --binary <blaze> [--oracle <bazel>] [--case ID]... [--label NAME]
                              [--skip-oracle] [--skip-blaze] [--show]
       scripts/macros/compare list
       scripts/macros/compare selftest
       scripts/macros/compare help

Runs a fixed list of commands (see `list`) on a work copy of the brotli checkout plus the probe
packages of scripts/macros/probe (macro_probe/... as //macro_probe/..., and probe_ext as the
local module @probe_ext, added to MODULE.bazel with local_path_override), once with the oracle
(Bazel 9.3.2) and once with Blaze. Each side has its own work copy
(~/.cache/blaze/work/macros-compare/<side>) and output user root
(~/.cache/blaze/oracle-out/macros-compare-<side>); commands run with a clean environment
(HOME, PATH=/usr/bin:/bin), --nohome_rc --nosystem_rc, the shared repository cache,
--color=no --curses=no, under systemd-run --user --scope -p MemoryMax=12G -p MemorySwapMax=0,
in the order listed.

Compared per case: the termination, the whole stdout and the whole stderr, after the exclusion
rules of scripts/lib/compare_common.py (VOLATILE_RULES; `paths`: each side's work copy and
output user root; `output_base_hash`: the output base's directory name), listed in the report
with the lines each changed or removed on each side. Both sides start every case on a fresh
server (the oracle's is shut down before each case), so no server-state rule applies.

Output: a header (repository HEAD and dirty flag, tool and module sha256, both binaries' paths
and sha256), one row per case, the exclusions, the denominator; raw outputs under
~/.cache/blaze/macros-compare/<label>/<side>/<case>.{stdout,stderr,term} and results.json.
--skip-oracle reuses the oracle outputs of an earlier run with the same --label; --skip-blaze
only records the oracle (it judges nothing and so exits 1 at best). --show prints the diffs of
differing cases.

Guards (scripts/lib/compare_common.py): every command runs under a supervisor in the scope that
records how it really ended (`exit N`, `signal NAME`, `oom-kill`, `timeout`), written to
<case>.term and compared (a recording without <case>.term never matches); the terminations of
the `shutdown` commands are listed (an abnormal one fails the run). --oracle must be the pinned
oracle (UPSTREAM.json). --skip-oracle refuses unless <label>/oracle/oracle.key, written after the
oracle's files were complete, holds this run's key (oracle sha256, every argv and the
environment, the digests of the brotli checkout and of the probe, the case sequence) and every
file it anchors is unchanged; the files are raw, so this tool's sha256 is not in the key. An
empty selection is an error. Classes: IDENTICAL (all of it equal after the rules; the oracle
exited 0, or DECLARED_EXIT names the case with that exit code), DIFFERENT, BOTH-FAILED (equal
failures not declared), NOT-PORTED, ORACLE-UNEXPECTED, SKIPPED. Exit 0 only when at least one
case was compared and every selected case is IDENTICAL; 1 otherwise; 2 on a usage error or a
refusal.
selftest drives this command line with fake binaries (compare_common.selftest_tool).
"""

HOME = os.path.expanduser("~")
CACHE = os.path.join(HOME, ".cache", "blaze")
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
import compare_common as cc  # noqa: E402

# Cases whose non-zero exit is the behaviour under test: {case id: the oracle's exit code}.
# Equal failures of a case not listed here are BOTH-FAILED. Left to the case list's owner.
DECLARED_EXIT = {}
ORACLE = os.path.join(CACHE, "oracle", "bazel-9.3.2-linux-x86_64")
REPO_CACHE = os.path.join(CACHE, "repo-cache")
PROBE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "probe")
CHECKOUT = os.path.join(CACHE, "corpus", "brotli")

P = "//macro_probe"
LAZY = "--experimental_lazy_macro_expansion_packages=" + P + "/lazy," + P + "/ok"

ERR_PKGS = [
    "err_unknown_attr", "err_implicit", "err_missing_name", "err_mandatory", "err_return",
    "err_recursion", "err_fail", "err_naming", "err_conflict", "err_finalizer_in_macro",
    "err_existing_rules", "err_glob", "err_bad_type", "err_unexported", "err_kwargs",
    "err_attr_name", "err_computed_default", "err_macro_in_build", "err_inherit_none",
]

# (id, description, command args)
CASES = [
    ("q-ok-label-kind", "query label_kind of the macro package",
     ["query", P + "/ok:all", "--output=label_kind"]),
    ("q-all-label-kind", "query label_kind of every probe package that loads",
     ["query", P + "/ok/... + " + P + "/defs/... + " + P + "/vis/... + " + P + "/sub/... + "
      + P + "/lazy/...", "--output=label_kind"]),
    ("q-ok-build", "query --output=build (generator attributes)",
     ["query", P + "/ok:all", "--output=build"]),
    ("q-lazy-build", "query --output=build of a package with finalizers",
     ["query", P + "/lazy:all", "--output=build"]),
    ("q-ok-jsonproto", "query --output=streamed_jsonproto",
     ["query", P + "/ok:all", "--output=streamed_jsonproto"]),
    ("q-ok-xml", "query --output=xml", ["query", P + "/ok:all", "--output=xml"]),
    ("q-deps", "query deps through macro-declared targets",
     ["query", "deps(" + P + "/vis:consumer)", "--output=label"]),
    ("q-buildfiles", "query buildfiles (macro .bzl files)",
     ["query", "buildfiles(" + P + "/ok:all)", "--output=label"]),
    ("q-ext-repo", "query a package using a macro from another repository",
     ["query", "attr(generator_function, ext_macro, " + P + "/ok:all)", "--output=label_kind"]),
    ("q-violator", "query a target violating macro naming rules",
     ["query", P + "/err_naming:all", "--output=label_kind"]),
    ("q-violator-dep", "query deps on a violating target",
     ["query", "deps(" + P + "/err_naming:uses_violator)", "--output=label"]),
    ("cquery-ok", "cquery of the macro package",
     ["cquery", P + "/ok:all + " + P + "/vis:consumer"]),
    ("cquery-opt", "cquery with a select() branch chosen",
     ["cquery", "-c", "opt", "deps(" + P + "/ok:c2)"]),
    ("aquery-ok", "aquery of macro-declared targets",
     ["aquery", "mnemonic(FileWrite, " + P + "/ok:s1 + " + P + "/ok:c1)",
      "--output=text"]),
    ("build-ok", "build the macro package and the consumer",
     ["build", P + "/ok:all", P + "/vis:consumer"]),
    ("build-vis-bad", "visibility error on a private macro-declared target",
     ["build", "--nobuild", P + "/vis:bad_consumer"]),
    ("build-vis-bad2", "visibility error on an undeclared-visibility macro target",
     ["build", "--nobuild", P + "/vis:bad_consumer2"]),
    ("build-vis-bad3", "dependency on a nested macro's private target",
     ["build", "--nobuild", P + "/err_vis_dep:x"]),
    ("build-violator", "build a target depending on a naming violator",
     ["build", "--nobuild", P + "/err_naming:uses_violator"]),
    ("build-sub", "build a rule with subrules", ["build", P + "/sub:w"]),
    ("aquery-sub", "aquery a rule with subrules",
     ["aquery", P + "/sub:w", "--output=text"]),
    ("build-sub-bad", "a rule calling an undeclared subrule",
     ["build", "--nobuild", P + "/sub:bad"]),
] + [
    ("q-" + pkg, "error case " + pkg, ["query", P + "/" + pkg + ":all", "--output=label_kind"])
    for pkg in ERR_PKGS
] + [
    ("lazy-q-label-kind", "lazy expansion: query label_kind",
     ["query", P + "/lazy:all + " + P + "/ok:all", "--output=label_kind", LAZY]),
    ("lazy-q-build", "lazy expansion: query --output=build",
     ["query", P + "/lazy:all", "--output=build", LAZY]),
    ("lazy-q-target", "lazy expansion: query one macro-declared target",
     ["query", P + "/ok:o1_b_inner_priv", "--output=label_kind", LAZY]),
    ("lazy-q-deps", "lazy expansion: deps through macro targets",
     ["query", "deps(" + P + "/vis:consumer)", "--output=label", LAZY]),
    ("lazy-build", "lazy expansion: build", ["build", P + "/lazy:all", P + "/ok:all", LAZY]),
    ("lazy-cquery", "lazy expansion: cquery", ["cquery", P + "/lazy:all", LAZY]),
    ("dormant-q-deps", "dormant deps: query deps",
     ["query", "deps(" + P + "/dormant:r)", "--output=label", "--experimental_dormant_deps"]),
    ("dormant-q-build", "dormant deps and a materializer: query --output=build",
     ["query", P + "/dormant:all", "--output=build", "--experimental_dormant_deps"]),
    ("dormant-q-noflag", "dormant deps without the flag",
     ["query", P + "/dormant:all", "--output=label_kind"]),
    ("lazy-only-q", "lazy expansion of one package: query label_kind",
     ["query", P + "/lazy:all", "--output=label_kind",
      "--experimental_lazy_macro_expansion_packages=" + P + "/lazy"]),
    ("lazy-only-target", "lazy expansion of one package: one macro-declared target",
     ["query", P + "/lazy:ls_helper", "--output=label_kind",
      "--experimental_lazy_macro_expansion_packages=" + P + "/lazy"]),
]

RULES = cc.VOLATILE_RULES + [
    cc.Rule("output_base_hash", r"<UR>/[0-9a-f]{32}", "the output base is named by the md5 of "
            "the work copy's path, which differs between the sides", repl="<UR>/<HASH>",
            streams=("stdout", "stderr"))]


def side_dirs(side):
    return (os.path.join(CACHE, "work", "macros-compare", side),
            os.path.join(CACHE, "oracle-out", "macros-compare-" + side))


def path_pairs(side):
    ws, ur = side_dirs(side)
    return [(ws, "<WS>"), (ur, "<UR>")]


def prepare(side):
    ws = os.path.join(CACHE, "work", "macros-compare", side)
    if os.path.isdir(ws):
        shutil.rmtree(ws)
    os.makedirs(ws)
    subprocess.run(["rsync", "-a", "--exclude", "/bazel-*", "--exclude", "/.git",
                    CHECKOUT + "/", ws + "/"], check=True)
    # Restore files the checkout may have modified (the lockfile) to git HEAD.
    for f in subprocess.run(["git", "-C", CHECKOUT, "diff", "--name-only"], check=True,
                            capture_output=True, text=True).stdout.split():
        blob = subprocess.run(["git", "-C", CHECKOUT, "show", "HEAD:" + f], check=True,
                              capture_output=True).stdout
        with open(os.path.join(ws, f), "wb") as fh:
            fh.write(blob)
    shutil.copytree(os.path.join(PROBE, "macro_probe"), os.path.join(ws, "macro_probe"))
    shutil.copytree(os.path.join(PROBE, "probe_ext"), os.path.join(ws, "probe_ext"))
    with open(os.path.join(ws, "MODULE.bazel"), "a") as fh:
        fh.write('\nbazel_dep(name = "probe_ext", version = "0")\n'
                 'local_path_override(module_name = "probe_ext", path = "probe_ext")\n')
    return ws


def case_argv(binary, ur, args):
    return [binary, "--output_user_root=" + ur, "--nohome_rc", "--nosystem_rc", args[0],
            "--repository_cache=" + REPO_CACHE, "--color=no", "--curses=no"] + args[1:]


def oracle_key(cases):
    ur = os.path.join(CACHE, "oracle-out", "macros-compare-oracle")
    # Raw outputs (normalised when compared): this tool's sha256 is not part of the key.
    return cc.cache_key(None, cc.pinned_sha256(),
                        [case_argv(cc.PINNED_ORACLE, ur, a) for _c, _d, a in cases],
                        cc.clean_env(), {"brotli": cc.tree_digest(CHECKOUT),
                                         "probe": cc.tree_digest(PROBE)},
                        extra={"cases": [c[0] for c in cases]})


def case_files(outdir, cases):
    return [os.path.join(outdir, c[0] + ext) for c in cases
            for ext in (".stdout", ".stderr", ".term")]


def run_side(side, binary, cases, outdir, report):
    ws = prepare(side)
    _, ur = side_dirs(side)
    if os.path.isdir(ur):
        subprocess.run(["chmod", "-R", "u+w", ur])
        shutil.rmtree(ur, ignore_errors=True)
    os.makedirs(outdir, exist_ok=True)
    for cid, _desc, args in cases:
        # A fresh server per case: Bazel replays a package's events (print() output) only when
        # it loads the package, and Blaze has no persistent server.
        report.add_aux("%s shutdown before %s" % (side, cid), cc.run(
            [binary, "--output_user_root=" + ur, "--nohome_rc", "--nosystem_rc", "shutdown"],
            ws, timeout=600, mode="scope", tag="macros-shutdown").term)
        r = cc.run(case_argv(binary, ur, args), ws, timeout=1800, mode="scope",
                   tag="macros-compare", stdout_path=os.path.join(outdir, cid + ".stdout"),
                   stderr_path=os.path.join(outdir, cid + ".stderr"))
        with open(os.path.join(outdir, cid + ".term"), "w") as fh:
            json.dump(r.term.to_dict(), fh)
        print(f"  {side} {cid}: {r.term}", file=sys.stderr)
    report.add_aux("%s shutdown" % side, cc.run(
        [binary, "--output_user_root=" + ur, "--nohome_rc", "--nosystem_rc", "shutdown"],
        ws, timeout=600, mode="scope", tag="macros-shutdown").term)


def load_case(outdir, cid):
    try:
        with open(os.path.join(outdir, cid + ".term")) as fh:
            term = cc.Termination.from_dict(json.load(fh))
        with open(os.path.join(outdir, cid + ".stdout"), "rb") as fh:
            out = fh.read()
        with open(os.path.join(outdir, cid + ".stderr"), "rb") as fh:
            err = fh.read()
    except (OSError, ValueError):
        return None  # recorded before 2026-11-19 (no .term), or missing
    return {"term": term, "stdout": out, "stderr": err}


def main(argv):
    if not argv or argv[0] in ("help", "--help", "-h"):
        print(USAGE)
        return 0
    if argv[0] == "selftest":
        return selftest()
    if argv[0] == "list":
        for cid, desc, args in CASES:
            print(f"{cid:28} {desc}\n{'':28} {' '.join(args)}")
        return 0
    binary = None
    oracle = ORACLE
    only = []
    label = "default"
    skip_oracle = skip_blaze = show = False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--binary":
            binary = os.path.abspath(argv[i + 1]); i += 2
        elif a == "--oracle":
            oracle = argv[i + 1]; i += 2
        elif a == "--case":
            only.append(argv[i + 1]); i += 2
        elif a == "--label":
            label = argv[i + 1]; i += 2
        elif a == "--skip-oracle":
            skip_oracle = True; i += 1
        elif a == "--skip-blaze":
            skip_blaze = True; i += 1
        elif a == "--show":
            show = True; i += 1
        else:
            print("unknown argument " + a + "\n" + USAGE, file=sys.stderr)
            return 2
    if binary is None and not skip_blaze:
        print("--binary is required\n" + USAGE, file=sys.stderr)
        return 2
    cases = [c for c in CASES if not only or c[0] in only]
    if not cases:
        return cc.empty_selection_error("macros/compare")
    try:
        oracle, oracle_sha = cc.require_oracle(oracle)
        blaze = None if skip_blaze else cc.blaze_identity(binary)
    except cc.Refusal as e:
        return cc.refuse("macros/compare", e)
    base = os.path.join(CACHE, "macros-compare", label)
    odir = os.path.join(base, "oracle")
    bdir = os.path.join(base, "blaze")
    report = cc.Report("macros/compare", blaze=blaze,
                       oracle={"path": oracle, "sha256": oracle_sha},
                       selection="label %s, %d cases%s%s%s" % (
                           label, len(cases), " (--case %s)" % ",".join(only) if only else "",
                           ", oracle outputs reused" if skip_oracle else "",
                           ", oracle only (--skip-blaze)" if skip_blaze else ""),
                       tool_files=[os.path.abspath(__file__)],
                       compared="termination, the whole stdout and the whole stderr after the "
                                "exclusion rules listed at the end")
    norm = cc.Normaliser(RULES, path_reason="each side's work copy and output user root")
    report.add_normaliser(norm)
    report.print_header()
    key_path = os.path.join(odir, "oracle.key")
    if skip_oracle:
        try:
            cc.require_fresh(key_path, oracle_key(cases))
        except cc.Refusal as e:
            return cc.refuse("macros/compare", e)
    else:
        cc.invalidate_key(key_path)
        run_side("oracle", oracle, cases, odir, report)
        cc.write_key(key_path, oracle_key(cases), case_files(odir, cases))
    if skip_blaze:
        for cid, _d, _a in cases:
            o = load_case(odir, cid)
            report.add(cid, cc.SKIPPED, "oracle recorded only (%s)" % (o["term"] if o else
                                                                       "no output"))
        report.print_footer()
        return report.exit_code()
    run_side("blaze", blaze["path"], cases, bdir, report)
    cc.write_capture(os.path.join(bdir, "capture.json"), blaze, case_files(bdir, cases))
    for cid, desc, _a in cases:
        o, b = load_case(odir, cid), load_case(bdir, cid)
        if o is None or b is None:
            report.add(cid, cc.SKIPPED, "no %s output with a termination" % (
                "oracle" if o is None else "blaze"))
            continue
        cls, detail = judge(norm, cid, o, b)
        report.add(cid, cls, detail)
        print(f"{cls:17} {cid:28} {o['term']}/{b['term']} {detail}")
        if show and cls != cc.IDENTICAL:
            import difflib
            for f in ("stdout", "stderr"):
                ol = norm.apply(o[f], "oracle", f, path_pairs("oracle")).text.splitlines()
                bl = norm.apply(b[f], "blaze", f, path_pairs("blaze")).text.splitlines()
                for l in difflib.unified_diff(ol, bl, "oracle." + f, "blaze." + f, lineterm="",
                                              n=1):
                    print("    " + l)
    report.write_json(os.path.join(base, "results.json"))
    print()
    report.print_rows()
    report.print_footer()
    return report.exit_code()


def judge(norm, cid, o, b):
    differing = []
    for f in ("stdout", "stderr"):
        eq, _ = norm.compare(o[f], b[f], f, path_pairs("oracle"), path_pairs("blaze"))
        if not eq:
            differing.append(f)
    return cc.judge(o["term"], b["term"], differing, declared_exit=DECLARED_EXIT.get(cid),
                    blaze_unported=cc.unported_message(b["stderr"]))


def selftest():
    def argv(blaze, label):
        return ["--binary", blaze, "--case", CASES[0][0], "--label", label]

    def extra(st, fh, run):
        o, b = fh.fakes(dict(out=b"same\n"), dict(out=b"same\n"))
        rc, rep, log = run(["--case", CASES[0][0], "--label", "selftest-skip-blaze",
                            "--skip-blaze"])
        st.check("--skip-blaze (nothing judged) never exits 0", rc == 1, "exit %s" % rc)

    return cc.selftest_tool(
        "macros/compare", os.path.abspath(__file__), argv,
        empty=lambda b, l: ["--binary", b, "--case", "no-such-case", "--label", l],
        reuse=lambda b, l: argv(b, l) + ["--skip-oracle"],
        oracle_outputs=lambda home, l: [os.path.join(home, ".cache", "blaze", "macros-compare",
                                                     l, "oracle", CASES[0][0] + ".stdout")],
        extra=extra)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
