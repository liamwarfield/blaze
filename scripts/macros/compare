KEEP_RE = re.compile(r"^(ERROR:|WARNING:|DEBUG:|FAIL)")
DROP_RE = re.compile(r"^(INFO: Elapsed time|INFO: \d+ processes|INFO: Build completed"
                     r"|INFO: Found|INFO: Analyzed)")


def norm(text, ws, ur):
    text = text.replace(ws, "<WS>").replace(ur, "<UR>")
    text = re.sub(r"<UR>/[0-9a-f]{32}", "<UR>/<HASH>", text)
    return text


def stderr_lines(stderr):
    out = []
    keep = False
    for line in stderr.splitlines():
        if KEEP_RE.match(line):
            keep = True
            out.append(line)
        elif keep and (line.startswith("\t") or line.startswith("  ") or line.startswith("Traceback")
                       or line.startswith("Error")):
            out.append(line)
        else:
            keep = False
    return out


def prepare(side):
    ws = os.path.join(CACHE, "work", "macros-compare", side)
    if os.path.isdir(ws):
        shutil.rmtree(ws)
    os.makedirs(ws)
    subprocess.run(["rsync", "-a", "--exclude", "/bazel-*", "--exclude", "/.git",
                    CHECKOUT + "/", ws + "/"], check=True)
    # Restore files the checkout may have modified (the lockfile) to git HEAD.
    for f in subprocess.run(["git", "-C", CHECKOUT, "diff", "--name-only"], check=True,
                            capture_output=True, text=True).stdout.split():
        blob = subprocess.run(["git", "-C", CHECKOUT, "show", "HEAD:" + f], check=True,
                              capture_output=True).stdout
        with open(os.path.join(ws, f), "wb") as fh:
            fh.write(blob)
    shutil.copytree(os.path.join(PROBE, "macro_probe"), os.path.join(ws, "macro_probe"))
    shutil.copytree(os.path.join(PROBE, "probe_ext"), os.path.join(ws, "probe_ext"))
    with open(os.path.join(ws, "MODULE.bazel"), "a") as fh:
        fh.write('\nbazel_dep(name = "probe_ext", version = "0")\n'
                 'local_path_override(module_name = "probe_ext", path = "probe_ext")\n')
    return ws


def case_argv(binary, ur, args):
    return [binary, "--output_user_root=" + ur, "--nohome_rc", "--nosystem_rc", args[0],
            "--repository_cache=" + REPO_CACHE, "--color=no", "--curses=no"] + args[1:]


def oracle_key(cases, ws_digest):
    ur = os.path.join(CACHE, "oracle-out", "macros-compare-oracle")
    # Raw outputs (normalised when loaded): this tool's sha256 is not part of the key.
    return cc.cache_key(None, cc.pinned_sha256(),
                        [case_argv(cc.PINNED_ORACLE, ur, a) for _c, _d, a in cases],
                        cc.clean_env(), ws_digest, extra={"cases": [c[0] for c in cases]})


def run_side(side, binary, cases, outdir):
    ws = prepare(side)
    digest = cc.tree_digest(ws)
    ur = os.path.join(CACHE, "oracle-out", "macros-compare-" + side)
    if os.path.isdir(ur):
        subprocess.run(["chmod", "-R", "u+w", ur])
        shutil.rmtree(ur, ignore_errors=True)
    os.makedirs(outdir, exist_ok=True)
    results = {}
    for cid, _desc, args in cases:
        # A fresh server per case: Bazel replays a package's events (print() output) only when
        # it loads the package, and Blaze has no persistent server.
        cc.run([binary, "--output_user_root=" + ur, "--nohome_rc", "--nosystem_rc", "shutdown"],
               ws, timeout=600, mode="scope", tag="macros-shutdown")
        r = cc.run(case_argv(binary, ur, args), ws, timeout=1800, mode="scope",
                   tag="macros-compare")
        code, out, err = r.rc, r.out, r.err
        with open(os.path.join(outdir, cid + ".term"), "w") as fh:
            json.dump(r.term.to_dict(), fh)
        out = out.decode("latin-1")
        err = err.decode("latin-1")
        with open(os.path.join(outdir, cid + ".stdout"), "w", encoding="latin-1") as fh:
            fh.write(out)
        with open(os.path.join(outdir, cid + ".stderr"), "w", encoding="latin-1") as fh:
            fh.write(err)
        with open(os.path.join(outdir, cid + ".exit"), "w") as fh:
            fh.write(str(code))
        results[cid] = normalize(outdir, cid, side)
        print(f"  {side} {cid}: {r.term}", file=sys.stderr)
    cc.run([binary, "--output_user_root=" + ur, "--nohome_rc", "--nosystem_rc", "shutdown"],
           ws, timeout=600, mode="scope", tag="macros-shutdown")
    if side == "oracle":
        cc.write_key(os.path.join(outdir, "oracle.key"), oracle_key(cases, digest))
    return results


def normalize(outdir, cid, side):
    ws = os.path.join(CACHE, "work", "macros-compare", side)
    ur = os.path.join(CACHE, "oracle-out", "macros-compare-" + side)
    with open(os.path.join(outdir, cid + ".exit")) as fh:
        code = fh.read().strip()
    code = int(code) if code.lstrip("-").isdigit() else code
    try:
        with open(os.path.join(outdir, cid + ".term")) as fh:
            term = json.load(fh)
    except (OSError, ValueError):
        term = None  # recorded before 2026-11-19: never matches
    with open(os.path.join(outdir, cid + ".stdout"), encoding="latin-1") as fh:
        out = fh.read()
    with open(os.path.join(outdir, cid + ".stderr"), encoding="latin-1") as fh:
        err = fh.read()
    n = {
        "exit": term,
        "rc": code,
        "unported": cc.unported_message(err),
        "stdout": norm(out, ws, ur).splitlines(),
        "stderr": [l for l in stderr_lines(norm(err, ws, ur)) if not DROP_RE.match(l)],
    }
    with open(os.path.join(outdir, cid + ".norm.json"), "w") as fh:
        json.dump(n, fh, indent=1)
    return n


def load_side(outdir, cases, side):
    return {cid: normalize(outdir, cid, side) for cid, _d, _a in cases}


def main(argv):
    if not argv or argv[0] in ("help", "--help", "-h"):
        print(USAGE)
        return 0
    if argv[0] == "selftest":
        return selftest()
    if argv[0] == "list":
        for cid, desc, args in CASES:
            print(f"{cid:28} {desc}\n{'':28} {' '.join(args)}")
        return 0
    binary = None
    oracle = ORACLE
    only = []
    label = "default"
    skip_oracle = skip_blaze = show = False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--binary":
            binary = os.path.abspath(argv[i + 1]); i += 2
        elif a == "--oracle":
            oracle = argv[i + 1]; i += 2
        elif a == "--case":
            only.append(argv[i + 1]); i += 2
        elif a == "--label":
            label = argv[i + 1]; i += 2
        elif a == "--skip-oracle":
            skip_oracle = True; i += 1
        elif a == "--skip-blaze":
            skip_blaze = True; i += 1
        elif a == "--show":
            show = True; i += 1
        else:
            print("unknown argument " + a + "\n" + USAGE, file=sys.stderr)
            return 2
    if binary is None and not skip_blaze:
        print("--binary is required\n" + USAGE, file=sys.stderr)
        return 2
    cases = [c for c in CASES if not only or c[0] in only]
    if not cases:
        return cc.empty_selection_error("macros/compare")
    try:
        oracle, oracle_sha = cc.require_oracle(oracle)
        blaze = None if skip_blaze else cc.blaze_identity(binary)
    except cc.Refusal as e:
        return cc.refuse("macros/compare", e)
    base = os.path.join(CACHE, "macros-compare", label)
    odir = os.path.join(base, "oracle")
    bdir = os.path.join(base, "blaze")
    report = cc.Report("macros/compare", blaze=blaze,
                       oracle={"path": oracle, "sha256": oracle_sha},
                       selection="label %s, %d cases%s" % (
                           label, len(cases), " (--case %s)" % ",".join(only) if only else ""),
                       tool_files=[os.path.abspath(__file__)])
    report.print_header()
    if skip_oracle:
        try:
            cc.require_fresh(os.path.join(odir, "oracle.key"),
                             oracle_key(cases, cc.tree_digest(prepare("blaze"))))
        except cc.Refusal as e:
            return cc.refuse("macros/compare", e)
        oracle_res = load_side(odir, cases, "oracle")
    else:
        oracle_res = run_side("oracle", oracle, cases, odir)
    if skip_blaze:
        unrecorded = [c for c, r in oracle_res.items()
                      if not r["exit"] or r["exit"]["kind"] in ("unrecorded", "not-run")]
        print("recorded the oracle only; nothing compared%s" % (
            "; no termination recorded for: " + ", ".join(unrecorded) if unrecorded else ""))
        return 1 if unrecorded else 0
    blaze_res = run_side("blaze", blaze["path"], cases, bdir)
    rows = []
    for cid, desc, _a in cases:
        o, b = oracle_res[cid], blaze_res[cid]
        cls, detail, fields = judge(cid, o, b)
        report.add(cid, cls, detail)
        ok = all(fields.values())
        rows.append({"case": cid, "match": ok, "class": cls, "fields": fields,
                     "oracle_exit": o["exit"], "blaze_exit": b["exit"]})
        mark = "MATCH" if ok else "DIFF "
        diffs = ",".join(f for f, v in fields.items() if not v)
        print(f"{mark} {cid:28} {cc.Termination.from_dict(o['exit'])}/"
              f"{cc.Termination.from_dict(b['exit'])} {diffs}  {cls}")
        if show and not ok:
            for f in ("stdout", "stderr"):
                if not fields[f]:
                    import difflib
                    for l in difflib.unified_diff(o[f], b[f], "oracle", "blaze", lineterm="", n=1):
                        print("    " + l)
    report.write_json(os.path.join(base, "results.json"), extra={"rows": rows})
    print()
    report.print_rows()
    report.print_footer()
    return report.exit_code()


def judge(cid, o, b):
    """(class, detail, {field: equal}) of one case; `exit` compares the terminations."""
    ot, bt = cc.Termination.from_dict(o["exit"]), cc.Termination.from_dict(b["exit"])
    fields = {"exit": ot is not None and ot == bt,
              "stdout": o["stdout"] == b["stdout"], "stderr": o["stderr"] == b["stderr"]}
    cls, detail = cc.judge(ot, bt, [f for f in ("stdout", "stderr") if not fields[f]],
                           declared_exit=DECLARED_EXIT.get(cid), blaze_unported=b.get("unported"))
    return cls, detail, fields


def selftest():
    def run_pair(ofake, bfake, wd):
        cc.require_oracle(ofake)
        res = {}
        for side, fake in (("oracle", ofake), ("blaze", bfake)):
            r = cc.run([fake, "query"], wd, mode="scope", tag="selftest")
            out, err = r.out.decode("latin-1"), r.err.decode("latin-1")
            res[side] = {"exit": r.term.to_dict(), "unported": cc.unported_message(err),
                         "stdout": norm(out, wd, wd).splitlines(),
                         "stderr": [l for l in stderr_lines(norm(err, wd, wd))
                                    if not DROP_RE.match(l)]}
        cls, detail, _ = judge("selftest", res["oracle"], res["blaze"])
        return cls, detail

    def empty_selection():
        with open(os.devnull, "w") as null:
            old = sys.stderr
            sys.stderr = null
            try:
                return main(["--binary", "/bin/true", "--case", "no-such-case"])
            finally:
                sys.stderr = old

    def extra(st):
        legacy = {"exit": None, "stdout": [], "stderr": []}
        st.check("a legacy record without .term never matches",
                 judge("x", legacy, dict(legacy))[0] != cc.IDENTICAL)

    return cc.selftest("macros/compare", run_pair=run_pair, empty_selection=empty_selection,
                       extra=extra, mode="scope")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
