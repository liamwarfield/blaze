def query_exprs(p):
    if p == "brotli":
        a, b, lib, top = "//:brotli", "//:brotlicommon", "//:brotlienc", "//..."
        return [top, "deps(%s)" % a, "deps(%s, 2)" % a, "rdeps(%s, %s)" % (top, b),
                "rdeps(%s, %s, 1)" % (top, b), "allrdeps(%s)" % b,
                "somepath(%s, %s)" % (a, b), "allpaths(%s, %s)" % (a, b),
                'kind("cc_library", %s)' % top, 'attr("linkopts", "-lm", %s)' % top,
                'filter("enc", %s)' % top, "labels(srcs, %s)" % lib, "tests(%s)" % top,
                "buildfiles(%s)" % a, "loadfiles(%s)" % a, "siblings(%s)" % lib,
                "visible(%s, %s)" % (a, top), "same_pkg_direct_rdeps(%s)" % b,
                "(%s - deps(%s)) ^ kind(rule, %s)" % (top, lib, top),
                "let x = deps(%s) in $x except %s" % (lib, b), "some(%s)" % top]
    if p == "re2":
        a, b, top = "//:re2_test", "//:re2", "//:all + //python:all"
        return ["//:all", "deps(%s)" % b, "deps(%s, 2)" % a, "rdeps(%s, %s)" % (top, b),
                "rdeps(%s, %s, 1)" % (top, b), "somepath(%s, %s)" % (a, b),
                "allpaths(%s, %s)" % (a, b), 'kind(".*_test", //:all)',
                'attr("size", "large", //:all)', 'filter("exhaustive", //:all)',
                "labels(deps, %s)" % a, "tests(//:all)", "tests(//:small_tests)",
                "buildfiles(%s)" % b, "loadfiles(%s)" % b, "siblings(//python:re2)",
                "visible(%s, //:all)" % a, "//:all - tests(//:all)",
                "let t = tests(//:all) in $t intersect kind(cc_test, $t)"]
    if p == "probe":
        return ["//pkg:all", "deps(//pkg:m)", "deps(//pkg:all)", "rdeps(//..., //pkg:a)",
                "somepath(//pkg:m, //pkg:a)", "allpaths(//pkg:m, //pkg:a)",
                "tests(//pkg:suite)", "buildfiles(//pkg:m)", "loadfiles(//pkg:m)",
                "visible(//other:o, //pkg:all)", "//...", "deps(//pkg:ca)"]
    return []


def query_cells(p):
    cells = []
    exprs = query_exprs(p)
    for e in exprs:
        for f in QUERY_FORMATS:
            cells.append(("query", e, f, []))
    if not exprs:
        return cells
    d = exprs[1]  # a deps(...) expression
    flagsets = [
        ("label", ["--order_output=full"]), ("label", ["--order_output=deps"]),
        ("label", ["--order_output=no"]), ("label_kind", ["--noincompatible_lexicographical_output"]),
        ("graph", ["--order_output=full"]), ("graph", ["--order_output=full", "--nograph:factored"]),
        ("graph", ["--order_output=full", "--graph:node_limit=40"]),
        ("graph", ["--order_output=full", "--graph:conditional_edges_limit=1"]),
        ("graph", ["--order_output=full", "--graph:conditional_edges_limit=0"]),
        ("minrank", ["--order_output=full"]), ("maxrank", ["--order_output=full"]),
        ("label", ["--noimplicit_deps"]), ("label", ["--notool_deps"]),
        ("label", ["--nonodep_deps"]), ("label", ["--experimental_graphless_query=yes"]),
        ("label", ["--experimental_graphless_query=no"]), ("label", ["--consistent_labels"]),
        ("label", ["--line_terminator_null"]), ("location", ["--relative_locations"]),
        ("xml", ["--relative_locations"]), ("xml", ["--noxml:line_numbers"]),
        ("xml", ["--xml:default_values"]), ("xml", ["--order_output=full"]),
        ("build", ["--order_output=full"]), ("proto", ["--noproto:default_values"]),
        ("proto", ["--proto:locations=false"]), ("proto", ["--relative_locations"]),
        ("proto", ["--noproto:flatten_selects"]), ("proto", ["--proto:output_rule_attrs=srcs,deps"]),
        ("proto", ["--noproto:rule_inputs_and_outputs"]),
        ("proto", ["--proto:include_synthetic_attribute_hash"]),
        ("proto", ["--proto:instantiation_stack"]), ("proto", ["--proto:definition_stack"]),
        ("proto", ["--proto:rule_classes"]), ("proto", ["--proto:include_attribute_source_aspects"]),
        ("streamed_jsonproto", ["--proto:instantiation_stack", "--proto:definition_stack"]),
        ("label", ["--aspect_deps=off"]), ("label", ["--aspect_deps=precise"]),
        ("xml", ["--aspect_deps=precise"]), ("proto", ["--aspect_deps=precise"]),
    ]
    for f, flags in flagsets:
        cells.append(("query", d, f, flags))
    cells.append(("query", "", "label", ["--query_file=q.txt"]) if p == "probe" else
                 ("query", "", "label", ["--query_file=/nonexistent/q.txt"]))
    cells.append(("query", exprs[0], "label", ["--query_file=/nonexistent/q.txt"]))
    cells.append(("query", "tests(%s)" % ("//pkg:suite" if p == "probe" else exprs[0]),
                  "label", ["--strict_test_suite"]))
    cells.append(("query", d, "nosuchformat", []))
    cells.append(("query", "buildfiles(%s)" % d, "location", []))
    return cells


def cquery_cells(p):
