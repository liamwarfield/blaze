def cells_for(project, commands):
    if project == "workerd":
        return [c for c in WORKERD_CELLS if c[0] in commands]
    cells = []
    if "query" in commands:
        cells += query_cells(project)
    if "cquery" in commands:
        cells += cquery_cells(project)
    if "aquery" in commands:
        cells += aquery_cells(project)
    return cells


def cell_id(project, cell):
    cmd, expr, fmt, flags = cell
    h = hashlib.sha256(json.dumps([project, cmd, expr, fmt, flags]).encode()).hexdigest()[:10]
    slug = re.sub(r"[^A-Za-z0-9]+", "_", "%s_%s_%s" % (cmd, fmt, " ".join(flags)))[:60]
    return "%s-%s-%s" % (project, slug.strip("_"), h)


def cell_argv(cell):
    cmd, expr, fmt, flags = cell
    argv = [cmd] + COMMON + ["--output=" + fmt] + flags
    if expr:
        argv.append(expr)
    return argv


def sync_workspace(project, side):
    dst = os.path.join(WORK, side, project)
    os.makedirs(dst, exist_ok=True)
    if project == "probe":
        shutil.rmtree(dst)
        for rel, text in PROBE_FILES.items():
            path = os.path.join(dst, rel)
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w", encoding="latin-1") as f:
                f.write(text)
        return dst
    src = os.path.join(CACHE, "corpus", project)
    subprocess.run(["rsync", "-a", "--delete", "--exclude", "bazel-*", "--exclude", ".git",
                    src + "/", dst + "/"], check=True)
    # Restore the checkout's committed MODULE.bazel.lock (rsync already copied it).
    return dst


RULES = cc.VOLATILE_RULES + cc.B1_GAP_RULES


def startup(side, project, binary):
    """(binary argv prefix, cwd, memory cap) of one side, as the command runs."""
    exe = ORACLE if side == "o" else binary
    if project == "workerd":
        # What scripts/workerd/run does, through compare_common's launcher.
        ws = os.path.join(CACHE, "work", "workerd" if side == "o" else "workerd-blaze")
        ur = os.path.join(CACHE, "oracle-out", "ur-workerd" if side == "o" else
                          "ur-workerd-blaze")
        return [exe, "--output_user_root=" + ur, "--nohome_rc", "--nosystem_rc"], ws, "20G"
    return ([exe, "--output_user_root=" + USER_ROOT[side], "--nohome_rc", "--nosystem_rc"],
            os.path.join(WORK, side, project), "12G")


def run(side, project, binary, argv, timeout=1800):
    pre, cwd, mem = startup(side, project, binary)
    if project == "workerd" and not os.path.isdir(cwd):
        os.makedirs(cwd)
        subprocess.run(["rsync", "-a", "--delete", "--exclude", "/bazel-*", "--exclude", "/.git",
                        os.path.join(CACHE, "corpus", "workerd") + "/", cwd + "/"], check=True)
    r = cc.run(pre + argv, cwd, timeout=timeout, mode="scope", memory_max=mem,
               tag="query-compare")
    return r.term, r.out, r.err


_input_digests = {}


def input_digest(project):
    if project not in _input_digests:
        if project == "probe":
            _input_digests[project] = cc.sha256_bytes(json.dumps(PROBE_FILES, sort_keys=True)
                                                      .encode())
        elif project == "workerd":
            src = os.path.join(CACHE, "corpus", "workerd")
            head = subprocess.run(["git", "-C", src, "rev-parse", "HEAD"], capture_output=True,
                                  text=True).stdout.strip()
            st = subprocess.run(["git", "-C", src, "status", "--porcelain"],
                                capture_output=True).stdout
            _input_digests[project] = "git %s status %s" % (head, cc.sha256_bytes(st))
        else:
            _input_digests[project] = cc.tree_digest(os.path.join(CACHE, "corpus", project))
    return _input_digests[project]


def oracle_key(project, cell, side_pass):
    """Key of a saved oracle output (raw bytes: no tool sha256)."""
    pre, cwd, mem = startup("o", project, None)
    return cc.cache_key(None, cc.pinned_sha256(), pre + cell_argv(cell), cc.clean_env(),
                        input_digest(project),
                        extra={"project": project, "pass": side_pass, "cwd": cwd,
                               "memory": mem})


def side_files(d, name):
    return [os.path.join(d, name + ext) for ext in (".stdout", ".stderr", ".term")]


def info_paths(side, project, binary, report):
    """(workspace, output_base, install_base) of one side."""
    paths = []
    for key in ("workspace", "output_base", "install_base"):
        term, out, _ = run(side, project, binary, ["info"] + COMMON + [key], timeout=600)
        report.add_aux("%s %s info %s" % (side, project, key), term)
        paths.append(out.decode("latin-1").strip() if term.ok else None)
    return paths


def _normalise_node_label(m):
    items = m.group(1).split("\\n")
    t = re.match(r"\.\.\.and (\d+) more items$", items[-1])
    if t:
        # A truncated factored node: which items are shown depends on the class's (identity
        # hash) order, so only the number of items is compared.
        return '"<%d items>"' % (len(items) - 1 + int(t.group(1)))
    return '"' + "\\n".join(sorted(items)) + '"'


def normalise_unordered(data):
    """Order-insensitive form: sorted lines; items of a factored graph node sorted too."""
    text = data.decode("latin-1")
    lines = []
    for line in text.split("\n"):
        line = re.sub(r'"([^"]*)"', _normalise_node_label, line)
        lines.append(line)
    return sorted(lines)


def order_is_identity_hashed(cell):
    """Cells whose output order Java takes from identity hash codes (a Digraph's node map, a
    HashSet<Node>): it differs from one Bazel server to the next, so only the multiset of lines
    is defined. query --output=graph|minrank|maxrank without --order_output=full (factored
    classes, roots, rank ties), and --order_output=deps|no (topological order from the node map;
    the graphless deps set)."""
    cmd, _, fmt, flags = cell
    if cmd != "query":
        return False
    if "--order_output=deps" in flags or "--order_output=no" in flags:
        return True
    return fmt in ("graph", "minrank", "maxrank") and "--order_output=full" not in flags


def classify(cell, oa, ob, b):
    (orc_a, oout_a, _), (orc_b, oout_b, _), (brc, bout, berr) = oa, ob, b
    if b"not ported yet" in berr or b"panicked at" in berr:
        return "loud"
    if (brc == orc_a and bout == oout_a) or (brc == orc_b and bout == oout_b):
        return "identical"
    if ((orc_a, oout_a) != (orc_b, oout_b) or order_is_identity_hashed(cell)) and \
            brc == orc_a and normalise_unordered(bout) == normalise_unordered(oout_a):
        return "identical-unordered"
    if (orc_a, oout_a) != (orc_b, oout_b) and brc in (orc_a, orc_b):
        return "oracle-varies"
    return "different"


def save(d, name, res):
    term, out, err = res
    with open(os.path.join(d, name + ".stdout"), "wb") as f:
        f.write(out)
    with open(os.path.join(d, name + ".stderr"), "wb") as f:
        f.write(err)
    with open(os.path.join(d, name + ".rc"), "w") as f:
        f.write(str(term.exit_code_like()))
    with open(os.path.join(d, name + ".term"), "w") as f:
        json.dump(term.to_dict(), f)


def load(d, name):
    """(Termination or None, stdout, stderr); None when saved without a termination."""
    with open(os.path.join(d, name + ".stdout"), "rb") as f:
        out = f.read()
    with open(os.path.join(d, name + ".stderr"), "rb") as f:
        err = f.read()
    try:
        with open(os.path.join(d, name + ".term")) as f:
            term = cc.Termination.from_dict(json.load(f))
    except (OSError, ValueError):
        term = None
    return term, out, err


def stderr_check(norm, meta, project, oa, ob, b):
    """(equal to A or B, gap rules that differ) of Blaze's stderr after the rules."""
    paths = meta.get("paths", {}).get(project, {})
    tags = ("<WORKSPACE>", "<OUTPUT_BASE>", "<INSTALL_BASE>")
    op = [(p, t) for p, t in zip(paths.get("o") or [], tags) if p]
    bp = [(p, t) for p, t in zip(paths.get("b") or [], tags) if p]
    best = None
    for o in (oa, ob):
        eq, gaps = norm.compare(o[2], b[2], "stderr", op, bp)
        if eq and not gaps:
            return True, []
        if eq and best is None:
            best = gaps
    return (True, best) if best is not None else (False, [])


def common_class(cell, cid, verdict, oa, b, stderr_eq=True, gaps=()):
    """compare_common class of a cell from its verdict and the stderr check."""
    oterm, bterm, berr = oa[0], b[0], b[2]
    if verdict == "loud":
        msg = cc.unported_message(berr)
        return (cc.NOT_PORTED, msg) if msg else (cc.DIFFERENT, "Blaze panicked")
    if verdict in ("identical", "identical-unordered"):
        reduced = None
        if verdict == "identical-unordered":
            reduced = "stdout compared as a multiset of lines (identical-unordered)"
        cls, detail = cc.judge(oterm, bterm, [] if stderr_eq else ["stderr"],
                               declared_exit=DECLARED_EXIT.get(cid), gaps=list(gaps),
                               reduced=reduced)
        return cls, (verdict + ("; " + detail if detail else ""))
    if verdict == "oracle-varies":
        return cc.DIFFERENT, "the oracle varies; Blaze matches neither run"
    cls, detail = cc.judge(oterm, bterm, ["stdout"] + ([] if stderr_eq else ["stderr"]),
                           declared_exit=DECLARED_EXIT.get(cid))
    return (cls if cls != cc.IDENTICAL else cc.DIFFERENT), detail


def substitute(data, pairs):
    for frm, to in pairs:
        if frm and to and frm != to:
            data = data.replace(frm.encode("latin-1"), to.encode("latin-1"))
    return data


def main(argv):
    if len(argv) < 2 or argv[1] in ("help", "-h", "--help"):
        print(__doc__.strip())
        return 0
    if argv[1] == "selftest":
        return selftest()
    list_only = argv[1] == "cells"
    args = {"--project": "brotli,re2,probe", "--command": "query,cquery,aquery", "--cells": None,
            "--binary": None, "--label": None, "--details": "0"}
    flags = set()
    i = 2 if list_only else 1
    while i < len(argv):
        if argv[i] == "--no-run":
            flags.add(argv[i])
            i += 1
        elif argv[i] in args:
            args[argv[i]] = argv[i + 1]
            i += 2
        else:
            print("unknown argument: " + argv[i], file=sys.stderr)
            return 2
    projects = args["--project"].split(",")
    commands = args["--command"].split(",")
    sel = re.compile(args["--cells"]) if args["--cells"] else None
    plan = []
    for p in projects:
        for c in cells_for(p, commands):
            cid = cell_id(p, c)
            if sel and not sel.search(cid) and not sel.search(" ".join(cell_argv(c))):
                continue
            plan.append((p, c, cid))
    if list_only:
        for p, c, cid in plan:
            print("%s\t%s" % (cid, " ".join(cell_argv(c))))
        print("%d cells" % len(plan))
        return 0
    if not args["--label"] or (not args["--binary"] and "--no-run" not in flags):
        print("--label and --binary are required (see help)", file=sys.stderr)
        return 2
    if not plan:
        return cc.empty_selection_error("query/compare", "cells")
    no_run = "--no-run" in flags
    try:
        oracle_path, oracle_sha = cc.require_oracle(ORACLE)
        blaze = cc.blaze_identity(args["--binary"]) if args["--binary"] else None
    except cc.Refusal as e:
        return cc.refuse("query/compare", e)
    label_dir = os.path.join(OUT, args["--label"])
    os.makedirs(os.path.join(label_dir, "cells"), exist_ok=True)
    binary = blaze["path"] if blaze else None
    meta_path = os.path.join(label_dir, "meta.json")
    meta = json.load(open(meta_path)) if os.path.exists(meta_path) else {"paths": {}}
    report = cc.Report("query/compare", blaze=blaze,
                       oracle={"path": oracle_path, "sha256": oracle_sha},
                       selection="label %s, %d cells (projects %s, commands %s%s)%s" % (
                           args["--label"], len(plan), args["--project"], args["--command"],
                           ", cells %r" % args["--cells"] if args["--cells"] else "",
                           ", --no-run" if no_run else ""),
                       tool_files=[os.path.abspath(__file__)],
                       compared="termination, stdout (bytes, or as a multiset of lines where "
                                "the class says so), the whole stderr after the exclusion "
                                "rules listed at the end")
    norm = cc.Normaliser(RULES, path_reason="each side's workspace, output base and install "
                         "base (from `info`)")
    report.add_normaliser(norm)
    report.reclassify_only = no_run
    report.print_header()
    if not no_run:
        if "/target/" in binary:
            print("warning: the binary lies in a target/ directory; copy it out first",
                  file=sys.stderr)
        meta["binary"] = binary
        meta["binary_sha256"] = blaze["sha256"]
        meta["date"] = time.strftime("%Y-%m-%d %H:%M:%S")
        meta["blaze_head"] = subprocess.run(["git", "-C", ROOT, "rev-parse", "HEAD"],
                                            capture_output=True, text=True).stdout.strip()
        for p in sorted(set(x[0] for x in plan)):
            if p != "workerd":
                sync_workspace(p, "o")
                sync_workspace(p, "b")
            meta["paths"][p] = {"o": info_paths("o", p, binary, report),
                                "b": info_paths("b", p, binary, report)}
            p_cells = [x for x in plan if x[0] == p]
            for side_pass in ("A", "B"):
                if p != "workerd":
                    report.add_aux("oracle %s shutdown before pass %s" % (p, side_pass),
                                   run("o", p, binary, ["shutdown"], timeout=300)[0])
                for _, c, cid in p_cells:
                    d = os.path.join(label_dir, "cells", cid)
                    os.makedirs(d, exist_ok=True)
                    kp = os.path.join(d, "oracle%s.key" % side_pass)
                    cc.invalidate_key(kp)
                    save(d, "oracle" + side_pass, run("o", p, binary, cell_argv(c)))
                    cc.write_key(kp, oracle_key(p, c, side_pass),
                                 side_files(d, "oracle" + side_pass))
                    if side_pass == "A":
                        t0 = time.time()
                        cap = os.path.join(d, "blaze.capture.json")
                        cc.invalidate_key(cap)
                        res = run("b", p, binary, cell_argv(c))
                        save(d, "blaze", res)
                        cc.write_capture(cap, blaze, side_files(d, "blaze"),
                                         extra={"argv": cell_argv(c)})
                        with open(os.path.join(d, "argv.json"), "w") as f:
                            json.dump({"project": p, "argv": cell_argv(c),
                                       "blaze_s": round(time.time() - t0, 2)}, f)
            if p != "workerd":
                report.add_aux("oracle %s shutdown" % p,
                               run("o", p, binary, ["shutdown"], timeout=300)[0])
        json.dump(meta, open(meta_path, "w"), indent=1)
    results = []
    for p, c, cid in plan:
        d = os.path.join(label_dir, "cells", cid)
        if not os.path.exists(os.path.join(d, "blaze.stdout")):
            report.add(cid, cc.SKIPPED, "no saved Blaze result")
            results.append({"id": cid, "project": p, "command": c[0], "expr": c[1],
                            "output": c[2], "flags": c[3], "verdict": None,
                            "class": cc.SKIPPED})
            continue
        why = [cc.check_key(os.path.join(d, "oracle%s.key" % sp), oracle_key(p, c, sp))
               for sp in ("A", "B")]
        why = ["stale oracle output: " + r for r in why if r]
        capture = cc.check_capture(os.path.join(d, "blaze.capture.json"), blaze)
        if capture:
            why.append("Blaze output: " + capture)
        if p not in meta.get("paths", {}):
            why.append("no recorded paths for project %s" % p)
        b = load(d, "blaze")
        oa, ob = load(d, "oracleA"), load(d, "oracleB")
        if not why and None in (b[0], oa[0], ob[0]):
            why.append("saved without a recorded termination")
        if why:
            report.add(cid, cc.SKIPPED, why[0])
            results.append({"id": cid, "project": p, "command": c[0], "expr": c[1],
                            "output": c[2], "flags": c[3], "verdict": None,
                            "class": cc.SKIPPED})
            continue
        po, pb = meta["paths"][p]["o"], meta["paths"][p]["b"]
        pairs = sorted(zip(pb, po), key=lambda x: -len(x[0] or ""))
        b = (b[0], substitute(b[1], pairs), b[2])
        verdict = classify(c, oa, ob, b)
        eq, gaps = stderr_check(norm, meta, p, oa, ob, b)
        cls, detail = common_class(c, cid, verdict, oa, b, eq, gaps)
        report.add(cid, cls, detail)
        with open(os.path.join(d, "blaze.normalised.stdout"), "wb") as f:
            f.write(b[1])
        results.append({"id": cid, "project": p, "command": c[0], "expr": c[1], "output": c[2],
                        "flags": c[3], "verdict": verdict, "class": cls,
                        "oracle_rc": oa[0].exit_code_like(), "blaze_rc": b[0].exit_code_like(),
                        "oracle_termination": str(oa[0]), "blaze_termination": str(b[0]),
                        "oracle_deterministic": (oa[0], oa[1]) == (ob[0], ob[1])})
    report.write_json(os.path.join(label_dir, "results.json"), extra={"results": results})
    write_matrix(label_dir, results, meta)
    counts = {}
    for r in results:
        counts[r["class"]] = counts.get(r["class"], 0) + 1
    print("cells: %d  %s" % (len(results), "  ".join("%s %d" % kv for kv in sorted(counts.items()))))
    n = int(args["--details"])
    for r in [r for r in results if r["class"] in (cc.DIFFERENT, cc.NOT_PORTED)][:n]:
        print("%s  %s  %s" % (r["class"], r["id"], " ".join(
            [r["command"], "--output=" + r["output"]] + r["flags"] + [r["expr"]])))
    for row in report.rows:
        if row["class"] not in (cc.IDENTICAL,):
            print("  %-17s %s %s" % (row["class"], row["case"], row["detail"]))
    report.print_footer()
    print("matrix: " + os.path.join(label_dir, "matrix.md"))
    return report.exit_code()


def selftest():
    def cell_of(blaze, label):
        cells = cells_for("probe", ["query"])
        return cell_id("probe", cells[0])

    def argv(blaze, label):
        return ["--binary", blaze, "--label", label, "--project", "probe", "--command", "query",
                "--cells", "^" + re.escape(cell_of(blaze, label)) + "$"]

    def extra(st, fh, run):
        o, b = fh.fakes(dict(out=b"same\n"), dict(out=b"same\n"))
        rc, rep, log = run(argv(b, "selftest-no-run"))
        rc2, rep2, log2 = run(argv(b, "selftest-no-run") + ["--no-run"])
        st.check("--no-run with the binary that made the outputs never exits 0",
                 rc == 0 and rc2 == 1, "fresh run exit %s, --no-run exit %s" % (rc, rc2))
        # M7: the workerd branch through the launcher (empty work copies made here, so nothing
        # is copied from the corpus; the fakes ignore the workspace).
        for d in ("workerd", "workerd-blaze"):
            os.makedirs(os.path.join(fh.cache, "work", d), exist_ok=True)
        wcell = cell_id("workerd", cells_for("workerd", ["query"])[0])
        rc3, rep3, log3 = run(["--binary", b, "--label", "selftest-workerd", "--project",
                               "workerd", "--command", "query", "--cells",
                               "^" + re.escape(wcell) + "$"])
        cl = [r["class"] for r in (rep3 or {}).get("cases", [])]
        st.check("M7: a workerd cell runs through the launcher", rc3 == 0
                 and cl == [cc.IDENTICAL], "exit %s, %s" % (rc3, cl))

    return cc.selftest_tool(
        "query/compare", os.path.abspath(__file__), argv,
        empty=lambda b, l: ["--binary", b, "--label", l, "--cells", "^no cell has this id$"],
        stored=lambda b, l: ["--binary", b, "--label", l, "--project", "probe", "--command",
                             "query", "--no-run", "--cells",
                             "^" + re.escape(cell_of(b, l)) + "$"],
        extra=extra)


def write_matrix(label_dir, results, meta):
    lines = ["# query/cquery/aquery comparison: oracle 9.3.2 against Blaze", "",
             "Binary: `%s` (sha256 %s), Blaze HEAD %s, %s." % (
                 meta.get("binary"), meta.get("binary_sha256", "")[:12], meta.get("blaze_head"),
                 meta.get("date")), "",
             "Classes (scripts/lib/compare_common.py): IDENTICAL (I), IDENTICAL-REDUCED (U: "
             "stdout as a multiset of lines), KNOWN-GAP (G), BOTH-FAILED (F), NOT-PORTED (L), "
             "DIFFERENT (D), SKIPPED (S).", ""]
    for p in sorted(set(r["project"] for r in results)):
        for cmd in ("query", "cquery", "aquery"):
            rs = [r for r in results if r["project"] == p and r["command"] == cmd]
            if not rs:
                continue
            plain = [r for r in rs if not r["flags"]]
            fmts = []
            for r in plain:
                if r["output"] not in fmts:
                    fmts.append(r["output"])
            exprs = []
            for r in plain:
                if r["expr"] not in exprs:
                    exprs.append(r["expr"])
            lines.append("## %s %s" % (p, cmd))
            lines.append("")
            if plain:
                lines.append("| expression | " + " | ".join(fmts) + " |")
                lines.append("|---|" + "---|" * len(fmts))
                short = {cc.IDENTICAL: "I", cc.REDUCED: "U", cc.KNOWN_GAP: "G",
                         cc.BOTH_FAILED: "F", cc.NOT_PORTED: "L", cc.DIFFERENT: "D",
                         cc.SKIPPED: "S", cc.ORACLE_UNEXPECTED: "O"}
                for e in exprs:
                    row = []
                    for f in fmts:
                        v = [r["class"] for r in plain if r["expr"] == e and r["output"] == f]
                        row.append(short.get(v[0], "?") if v else "")
                    lines.append("| `%s` | %s |" % (e.replace("|", "\\|"), " | ".join(row)))
                lines.append("")
            flagged = [r for r in rs if r["flags"]]
            if flagged:
                lines.append("| expression | output | flags | class |")
                lines.append("|---|---|---|---|")
                for r in flagged:
                    lines.append("| `%s` | %s | `%s` | %s |" % (
                        r["expr"].replace("|", "\\|"), r["output"], " ".join(r["flags"]), r["class"]))
                lines.append("")
    with open(os.path.join(label_dir, "matrix.md"), "w") as f:
        f.write("\n".join(lines) + "\n")


if __name__ == "__main__":
    sys.exit(main(sys.argv))
