                 "config(//:brotlienc, target)"]
    elif p == "re2":
        exprs = ["deps(//:re2)", "//:re2_test", "//python:_re2"]
    elif p == "probe":
        exprs = ["deps(//pkg:m)", "//pkg:fg", "deps(//pkg:t)"]
    else:
        return []
    cells = []
    for e in exprs:
        for f in CQUERY_FORMATS:
            flags = []
            if f == "starlark":
                flags = ["--starlark:expr=str(target.label) + ' ' + str(providers(target).keys())"]
            if f.startswith("transitions="):
                flags, f = ["--transitions=" + f.split("=")[1]], "transitions"
            cells.append(("cquery", e, f, flags))
    d = exprs[0]
    for f, flags in [("label", ["--show_config_fragments=direct"]),
                     ("label", ["--show_config_fragments=transitive"]),
                     ("label", ["--show_config_fragments=direct_host_only"]),
                     ("label", ["--noimplicit_deps"]), ("label", ["--notool_deps"]),
                     ("label_kind", ["--include_aspects"]),
