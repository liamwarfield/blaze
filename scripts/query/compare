def cells_for(project, commands):
    if project == "workerd":
        return [c for c in WORKERD_CELLS if c[0] in commands]
    cells = []
    if "query" in commands:
        cells += query_cells(project)
    if "cquery" in commands:
        cells += cquery_cells(project)
    if "aquery" in commands:
        cells += aquery_cells(project)
    return cells


def cell_id(project, cell):
    cmd, expr, fmt, flags = cell
    h = hashlib.sha256(json.dumps([project, cmd, expr, fmt, flags]).encode()).hexdigest()[:10]
    slug = re.sub(r"[^A-Za-z0-9]+", "_", "%s_%s_%s" % (cmd, fmt, " ".join(flags)))[:60]
    return "%s-%s-%s" % (project, slug.strip("_"), h)


def cell_argv(cell):
    cmd, expr, fmt, flags = cell
    argv = [cmd] + COMMON + ["--output=" + fmt] + flags
    if expr:
        argv.append(expr)
    return argv


def sync_workspace(project, side):
    dst = os.path.join(WORK, side, project)
    os.makedirs(dst, exist_ok=True)
    if project == "probe":
        shutil.rmtree(dst)
        for rel, text in PROBE_FILES.items():
            path = os.path.join(dst, rel)
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w", encoding="latin-1") as f:
                f.write(text)
        return dst
    src = os.path.join(CACHE, "corpus", project)
    subprocess.run(["rsync", "-a", "--delete", "--exclude", "bazel-*", "--exclude", ".git",
                    src + "/", dst + "/"], check=True)
    # Restore the checkout's committed MODULE.bazel.lock (rsync already copied it).
    return dst


def run(side, project, binary, argv, timeout=1800):
    if project == "workerd":
        env = dict(os.environ)
        cmd = [os.path.join(ROOT, "scripts/workerd/run"), "oracle" if side == "o" else "blaze"]
        if side == "b":
            env["BLAZE"] = binary
        p = subprocess.run(cmd + argv, capture_output=True, timeout=timeout, env=env)
        return p.returncode, p.stdout, p.stderr
    exe = ORACLE if side == "o" else binary
    startup = [exe, "--output_user_root=" + USER_ROOT[side], "--nohome_rc", "--nosystem_rc"]
    p = subprocess.run(startup + argv, cwd=os.path.join(WORK, side, project),
                       capture_output=True, timeout=timeout)
    return p.returncode, p.stdout, p.stderr


def info_paths(side, project, binary):
    """(workspace, output_base, install_base) of one side."""
    paths = []
    for key in ("workspace", "output_base", "install_base"):
        rc, out, _ = run(side, project, binary, ["info"] + COMMON + [key], timeout=600)
        paths.append(out.decode("latin-1").strip() if rc == 0 else None)
    return paths


def normalise_unordered(data):
    """Order-insensitive form: sorted lines; items of a factored graph node sorted too."""
    text = data.decode("latin-1")
    lines = []
    for line in text.split("\n"):
        line = re.sub(r'"([^"]*)"',
                      lambda m: '"' + "\\n".join(sorted(m.group(1).split("\\n"))) + '"', line)
        lines.append(line)
    return sorted(lines)


def order_is_identity_hashed(cell):
    """Cells whose output order Java takes from identity hash codes (a Digraph's node map, a
    HashSet<Node>): it differs from one Bazel server to the next, so only the multiset of lines
    is defined. query --output=graph|minrank|maxrank without --order_output=full (factored
    classes, roots, rank ties), and --order_output=deps|no (topological order from the node map;
    the graphless deps set)."""
    cmd, _, fmt, flags = cell
    if cmd != "query":
        return False
    if "--order_output=deps" in flags or "--order_output=no" in flags:
        return True
    return fmt in ("graph", "minrank", "maxrank") and "--order_output=full" not in flags


def classify(cell, oa, ob, b):
    (orc_a, oout_a, _), (orc_b, oout_b, _), (brc, bout, berr) = oa, ob, b
    if b"not ported yet" in berr or b"panicked at" in berr:
        return "loud"
    if (brc == orc_a and bout == oout_a) or (brc == orc_b and bout == oout_b):
        return "identical"
    if ((orc_a, oout_a) != (orc_b, oout_b) or order_is_identity_hashed(cell)) and \
            brc == orc_a and normalise_unordered(bout) == normalise_unordered(oout_a):
        return "identical-unordered"
    return "different"


def save(d, name, res):
    rc, out, err = res
    with open(os.path.join(d, name + ".stdout"), "wb") as f:
        f.write(out)
    with open(os.path.join(d, name + ".stderr"), "wb") as f:
        f.write(err)
    with open(os.path.join(d, name + ".rc"), "w") as f:
        f.write(str(rc))


def load(d, name):
    with open(os.path.join(d, name + ".stdout"), "rb") as f:
        out = f.read()
    with open(os.path.join(d, name + ".stderr"), "rb") as f:
        err = f.read()
    with open(os.path.join(d, name + ".rc")) as f:
        rc = int(f.read())
    return rc, out, err


def substitute(data, pairs):
    for frm, to in pairs:
        if frm and to and frm != to:
            data = data.replace(frm.encode("latin-1"), to.encode("latin-1"))
    return data


def main(argv):
    if len(argv) < 2 or argv[1] in ("help", "-h", "--help"):
        print(__doc__.strip())
        return 0
    list_only = argv[1] == "cells"
    args = {"--project": "brotli,re2,probe", "--command": "query,cquery,aquery", "--cells": None,
            "--binary": None, "--label": None, "--details": "0"}
    flags = set()
    i = 2 if list_only else 1
    while i < len(argv):
        if argv[i] == "--no-run":
            flags.add(argv[i])
            i += 1
        elif argv[i] in args:
            args[argv[i]] = argv[i + 1]
            i += 2
        else:
            print("unknown argument: " + argv[i], file=sys.stderr)
            return 2
    projects = args["--project"].split(",")
    commands = args["--command"].split(",")
    sel = re.compile(args["--cells"]) if args["--cells"] else None
    plan = []
    for p in projects:
        for c in cells_for(p, commands):
            cid = cell_id(p, c)
            if sel and not sel.search(cid) and not sel.search(" ".join(cell_argv(c))):
                continue
            plan.append((p, c, cid))
    if list_only:
        for p, c, cid in plan:
            print("%s\t%s" % (cid, " ".join(cell_argv(c))))
        print("%d cells" % len(plan))
        return 0
    if not args["--label"] or (not args["--binary"] and "--no-run" not in flags):
        print("--label and --binary are required (see help)", file=sys.stderr)
        return 2
    label_dir = os.path.join(OUT, args["--label"])
    os.makedirs(os.path.join(label_dir, "cells"), exist_ok=True)
    binary = os.path.abspath(args["--binary"]) if args["--binary"] else None
    meta_path = os.path.join(label_dir, "meta.json")
    meta = json.load(open(meta_path)) if os.path.exists(meta_path) else {"paths": {}}
    if "--no-run" not in flags:
        if "/target/" in binary:
            print("warning: the binary lies in a target/ directory; copy it out first",
                  file=sys.stderr)
        meta["binary"] = binary
        meta["binary_sha256"] = hashlib.sha256(open(binary, "rb").read()).hexdigest()
        meta["date"] = time.strftime("%Y-%m-%d %H:%M:%S")
        meta["blaze_head"] = subprocess.run(["git", "-C", ROOT, "rev-parse", "HEAD"],
                                            capture_output=True, text=True).stdout.strip()
        for p in sorted(set(x[0] for x in plan)):
            if p != "workerd":
                sync_workspace(p, "o")
                sync_workspace(p, "b")
            meta["paths"][p] = {"o": info_paths("o", p, binary), "b": info_paths("b", p, binary)}
            p_cells = [x for x in plan if x[0] == p]
            for side_pass in ("A", "B"):
                if p != "workerd":
                    run("o", p, binary, ["shutdown"], timeout=300)
                for _, c, cid in p_cells:
                    d = os.path.join(label_dir, "cells", cid)
                    os.makedirs(d, exist_ok=True)
                    save(d, "oracle" + side_pass, run("o", p, binary, cell_argv(c)))
                    if side_pass == "A":
                        t0 = time.time()
                        res = run("b", p, binary, cell_argv(c))
                        save(d, "blaze", res)
                        with open(os.path.join(d, "argv.json"), "w") as f:
                            json.dump({"project": p, "argv": cell_argv(c),
                                       "blaze_s": round(time.time() - t0, 2)}, f)
            if p != "workerd":
                run("o", p, binary, ["shutdown"], timeout=300)
        json.dump(meta, open(meta_path, "w"), indent=1)
    results = []
    for p, c, cid in plan:
        d = os.path.join(label_dir, "cells", cid)
        if not os.path.exists(os.path.join(d, "blaze.rc")):
            continue
        po, pb = meta["paths"][p]["o"], meta["paths"][p]["b"]
        pairs = sorted(zip(pb, po), key=lambda x: -len(x[0] or ""))
        b = load(d, "blaze")
        b = (b[0], substitute(b[1], pairs), b[2])
        verdict = classify(c, load(d, "oracleA"), load(d, "oracleB"), b)
        with open(os.path.join(d, "blaze.normalised.stdout"), "wb") as f:
            f.write(b[1])
        results.append({"id": cid, "project": p, "command": c[0], "expr": c[1], "output": c[2],
                        "flags": c[3], "verdict": verdict,
                        "oracle_rc": load(d, "oracleA")[0], "blaze_rc": b[0],
                        "oracle_deterministic": load(d, "oracleA")[:2] == load(d, "oracleB")[:2]})
    json.dump(results, open(os.path.join(label_dir, "results.json"), "w"), indent=1)
    write_matrix(label_dir, results, meta)
    counts = {}
    for r in results:
        counts[r["verdict"]] = counts.get(r["verdict"], 0) + 1
    print("cells: %d  %s  (of the identical: %d where both exit non-zero)" % (
        len(results), "  ".join("%s %d" % kv for kv in sorted(counts.items())),
        len([r for r in results if r["verdict"] == "identical" and r["oracle_rc"] != 0])))
    n = int(args["--details"])
    for r in [r for r in results if r["verdict"] in ("different", "loud")][:n]:
        print("%s  %s  %s" % (r["verdict"], r["id"], " ".join([r["command"], "--output=" + r["output"]] + r["flags"] + [r["expr"]])))
    print("matrix: " + os.path.join(label_dir, "matrix.md"))
    return 0


def write_matrix(label_dir, results, meta):
    lines = ["# query/cquery/aquery comparison: oracle 9.3.2 against Blaze", "",
             "Binary: `%s` (sha256 %s), Blaze HEAD %s, %s." % (
                 meta.get("binary"), meta.get("binary_sha256", "")[:12], meta.get("blaze_head"),
                 meta.get("date")), "",
             "Verdicts: identical (I), identical-unordered (U: the oracle varies between two "
             "servers; same lines as a multiset), loud (L), different (D).", ""]
    for p in sorted(set(r["project"] for r in results)):
        for cmd in ("query", "cquery", "aquery"):
            rs = [r for r in results if r["project"] == p and r["command"] == cmd]
            if not rs:
                continue
            plain = [r for r in rs if not r["flags"]]
            fmts = []
            for r in plain:
                if r["output"] not in fmts:
                    fmts.append(r["output"])
            exprs = []
            for r in plain:
                if r["expr"] not in exprs:
                    exprs.append(r["expr"])
            lines.append("## %s %s" % (p, cmd))
            lines.append("")
            if plain:
                lines.append("| expression | " + " | ".join(fmts) + " |")
                lines.append("|---|" + "---|" * len(fmts))
                short = {"identical": "I", "identical-unordered": "U", "loud": "L", "different": "D"}
                for e in exprs:
                    row = []
                    for f in fmts:
                        v = [r["verdict"] for r in plain if r["expr"] == e and r["output"] == f]
                        row.append(short.get(v[0], "?") if v else "")
                    lines.append("| `%s` | %s |" % (e.replace("|", "\\|"), " | ".join(row)))
                lines.append("")
            flagged = [r for r in rs if r["flags"]]
            if flagged:
                lines.append("| expression | output | flags | verdict |")
                lines.append("|---|---|---|---|")
                for r in flagged:
                    lines.append("| `%s` | %s | `%s` | %s |" % (
                        r["expr"].replace("|", "\\|"), r["output"], " ".join(r["flags"]), r["verdict"]))
                lines.append("")
    with open(os.path.join(label_dir, "matrix.md"), "w") as f:
        f.write("\n".join(lines) + "\n")


