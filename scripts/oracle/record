#!/usr/bin/env python3
"""Record a Bazel-compatible binary's outputs on the corpus projects. See `record help`."""

import argparse
import datetime
import hashlib
import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import oracle_common as oc  # noqa: E402
from normalise import Context  # noqa: E402

USAGE = """\
usage: scripts/oracle/record --binary <path> --label <name> --project <name|all>
                             [--surfaces mod,build,query,cquery,aquery] [--force]
                             [--blaze-server inprocess|daemon] [--max-idle-secs N]
                             [--renormalise] [--no-scope] [--summary|--no-summary]
       scripts/oracle/record help

Runs <binary> (real Bazel or Blaze) on corpus projects (corpus/projects.json) and records
structured outputs, normalised, under ~/.cache/blaze/oracle-records/<label>/<project>/:

  manifest.json        sha256 of every file; the binary's path and sha256; the date; the Blaze
                       repository's commit (`git rev-parse HEAD` of this checkout), whether its
                       tree was dirty and, if so, a sha256 of the uncommitted state; whether the
                       binary can come from that commit (`binary_origin.commit_verified`: the
                       binary lies in this checkout's target/ and is not older than its HEAD
                       commit; a warning is printed when not); what --force overrode; command
                       lines, exit codes, durations
  raw/                 unnormalised outputs exactly as the binary wrote them
  norm/                normalised outputs (what humans read and diff)
  items/<surface>.json the comparable items of each surface (what `compare` reads)

Each run copies the read-only checkout into ~/.cache/blaze/work/<label>/<project> (rsync, minus
bazel-* and .git, then restored to the checkout's git HEAD), wipes the per-label output user root
~/.cache/blaze/oracle-out/rec-<label>, and runs, in this order:

  mod     mod graph --output=json; snapshot of MODULE.bazel.lock
  build   the project's command with --execution_log_json_file, --execution_log_sort and
          --build_event_json_file; then a hash manifest of bazel-bin and bazel-testlogs
  query   query <patterns> and deps(<patterns>), --output=label_kind and streamed_jsonproto,
          with --keep_going (exit 3 with a partial result counts as recorded; see README)
  cquery  cquery deps(<patterns>) --output=label_kind; cquery <patterns> --output=jsonproto
  aquery  aquery deps(<patterns>) --output=jsonproto --include_param_files
          --include_file_write_contents
  then `info` (paths for the normaliser) and `shutdown`.

All commands of a project use the same startup options, so a binary with a persistent server
(Bazel; Blaze with --blaze-server daemon) runs them on one server: `mod graph` starts it, the
others find it warm. Blaze's default is one process per command (no server). The manifest says,
per command, whether it ran on a cold or a warm server (`server`: the pid in
<output base>/server/server.pid.txt before and after, whether the client printed its
server-start line, and `state`), and, per recording, the mode, which servers were stopped before
the run, the exit code of the final `shutdown` and any server still alive after it (stopped then).

A command that fails does not stop the run: its surfaces are recorded as FAILED with the stderr
tail, and the exit code is itself compared (surface exit_codes).

A label is never reused. `record` refuses a label that already has a directory for the project
(even an unfinished one), and refuses to add a project to a label whose other projects were
recorded with a different binary: a label names one binary, and a score names a label. Use a new
label (for Blaze: blaze-<commit, 12 hex digits>, plus -dirty-<first 8 of the diff sha256> for an
uncommitted tree) or pass --force, which the new manifest then says (`replaced`, `forced`), and
which compare and scoreboard print.

Options:
  --binary PATH     the bazel-compatible client binary
  --label NAME      record label, e.g. oracle-9.3.2 (the reference) or blaze-<rev>
  --project NAME    a project from corpus/projects.json, or `all`
  --surfaces LIST   comma-separated steps (default: all five)
  --force           record over an existing label/project, or with another binary than the
                    label's other projects
  --renormalise     do not run anything; rebuild norm/ and items/ from raw/ (after a normaliser
                    change). The new directories replace the old ones only when the rebuild
                    is complete; the manifest keeps a `renormalised` history.
  --blaze-server MODE
                    run the binary with BLAZE_SERVER_MODE=MODE: `daemon` is Blaze's persistent
                    server (one server per project for the whole sequence, as Bazel); `inprocess`
                    is Blaze's default, one process per command. Not given: the variable is
                    unset (Bazel ignores it). Stored in the manifest (`server.blaze_server_mode`).
  --max-idle-secs N startup option --max_idle_secs=N on every command (AGENTS.md "Memory").
                    Default: 60 with --blaze-server daemon, not passed otherwise.
  --no-scope        do not wrap the run in `systemd-run --user --scope -p MemoryMax=12G
                    -p MemorySwapMax=0` (the default wraps it; Bazel servers live in that scope)
  --summary         write corpus/oracle/<project>.json (default only for label oracle-9.3.2)
  --no-summary      do not write it
"""

MEMORY_MAX = "12G"
COMMAND_TIMEOUT = 3 * 3600
# --max_idle_secs of a daemon-mode recording (AGENTS.md "Memory": 60 on every probe server).
DAEMON_MAX_IDLE_SECS = 60


def clean_env(blaze_server_mode=None):
    env = {"HOME": oc.HOME, "PATH": "/usr/bin:/bin"}
    if blaze_server_mode:
        env["BLAZE_SERVER_MODE"] = blaze_server_mode
    return env


def maybe_reexec_in_scope(args):
    if args.no_scope or os.environ.get("BLAZE_ORACLE_SCOPE") == "1":
        return
    if shutil.which("systemd-run") is None:
        print("warning: systemd-run not found; running without memory limits", file=sys.stderr)
        return
    argv = [
        "systemd-run", "--user", "--scope", "--collect", "--quiet",
        "-p", "MemoryMax=" + MEMORY_MAX, "-p", "MemorySwapMax=0",
        "--", "env", "BLAZE_ORACLE_SCOPE=1", sys.executable, "-I", os.path.abspath(__file__),
    ] + sys.argv[1:]
    os.execvp(argv[0], argv)


def run(cmd, cwd, stdout_path, stderr_path, timeout=COMMAND_TIMEOUT, env=None):
    t0 = time.monotonic()
    with open(stdout_path, "wb") as out, open(stderr_path, "wb") as err:
        try:
            p = subprocess.run(cmd, cwd=cwd, env=env or clean_env(), stdout=out, stderr=err,
                               stdin=subprocess.DEVNULL, timeout=timeout)
            rc = p.returncode
        except subprocess.TimeoutExpired:
            rc = -9
            err.write(b"\n[record] command timed out\n")
        except OSError as e:
            rc = -1
            err.write(("\n[record] could not run: %s\n" % e).encode())
    return rc, round(time.monotonic() - t0, 2)


def make_writable_and_remove(path):
    if not os.path.lexists(path):
        return
    subprocess.run(["chmod", "-R", "u+w", path], stderr=subprocess.DEVNULL)
    shutil.rmtree(path, ignore_errors=True)
    if os.path.lexists(path):
        subprocess.run(["rm", "-rf", path])


def live_servers(root):
    """{output base name: pid} of the servers under the output user root `root`: the pid in
    <output base>/server/server.pid.txt of a live process whose command line names `root` (a
    stale pid file whose number was reused by another process does not count)."""
    out = {}
    if not os.path.isdir(root):
        return out
    for name in sorted(os.listdir(root)):
        pidfile = os.path.join(root, name, "server", "server.pid.txt")
        try:
            with open(pidfile) as f:
                pid = int(f.read().strip())
            with open("/proc/%d/cmdline" % pid, "rb") as f:
                cmdline = f.read()
        except (OSError, ValueError):
            continue
        if root.encode() in cmdline:
            out[name] = pid
    return out


def server_pid(root):
    """The pid of the one live server under `root`, or None (several: the lowest output base)."""
    live = live_servers(root)
    return live[sorted(live)[0]] if live else None


def kill_servers(root):
    """Stop every server under `root` (SIGTERM, SIGKILL after 10 s). Returns what it stopped."""
    stopped = []
    for name, pid in live_servers(root).items():
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            continue
        stopped.append({"output_base": name, "pid": pid})
        for _ in range(100):
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                break
            time.sleep(0.1)
        else:
            try:
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
    return stopped


def prepare_workspace(checkout, ws):
    """Copy the checkout to ws and restore it to the checkout's git HEAD."""
    os.makedirs(ws, exist_ok=True)
    subprocess.run(
        ["rsync", "-a", "--delete", "--delete-excluded", "--exclude=/bazel-*", "--exclude=/.git",
         checkout.rstrip("/") + "/", ws + "/"],
        check=True,
    )
    if not os.path.isdir(os.path.join(checkout, ".git")):
        return []
    st = subprocess.run(
        ["git", "--no-optional-locks", "-C", checkout, "status", "--porcelain=v1", "-z",
         "--ignored", "--untracked-files=all"],
        check=True, stdout=subprocess.PIPE,
    ).stdout.decode()
    fixed = []
    for entry in st.split("\0"):
        if len(entry) < 4:
            continue
        code, path = entry[:2], entry[3:]
        if path.startswith("bazel-") and "/" not in path.rstrip("/"):
            continue
        dest = os.path.join(ws, path)
        if code in ("??", "!!"):
            if os.path.isdir(dest) and not os.path.islink(dest):
                shutil.rmtree(dest)
            elif os.path.lexists(dest):
                os.remove(dest)
            fixed.append("removed " + path)
        else:
            blob = subprocess.run(["git", "-C", checkout, "show", "HEAD:" + path],
                                  stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            if blob.returncode == 0:
                os.makedirs(os.path.dirname(dest), exist_ok=True)
                with open(dest, "wb") as f:
                    f.write(blob.stdout)
                fixed.append("restored " + path)
    return fixed


def walk_outputs(ctx, ws):
    """Hash every entry under bazel-bin and bazel-testlogs (contents path-normalised)."""
    entries, roots = [], []
    for root_name, link in (("bin", "bazel-bin"), ("testlogs", "bazel-testlogs")):
        top = os.path.join(ws, link)
        if not os.path.exists(top):
            continue
        roots.append(root_name)
        top = os.path.realpath(top)
        for dirpath, dirnames, filenames in os.walk(top, followlinks=False):
            for name in sorted(dirnames + filenames):
                full = os.path.join(dirpath, name)
                rel = root_name + "/" + os.path.relpath(full, top)
                if os.path.islink(full):
                    entries.append({"path": rel, "type": "symlink", "target": ctx.text(os.readlink(full))})
                elif os.path.isfile(full):
                    with open(full, "rb") as f:
                        data = f.read()
                    norm, changed = ctx.bytes(data)
                    entries.append({
                        "path": rel, "type": "file", "size": len(data),
                        "sha256": hashlib.sha256(norm).hexdigest(),
                        "raw_sha256": hashlib.sha256(data).hexdigest() if changed else None,
                        "path_normalised": changed,
                        "executable": os.access(full, os.X_OK),
                    })
                elif os.path.isdir(full):
                    if not os.listdir(full):
                        entries.append({"path": rel, "type": "empty_dir"})
    entries.sort(key=lambda e: e["path"])
    return {"roots": roots, "entries": entries}


def copy_test_xml(ws, dest):
    top = os.path.join(ws, "bazel-testlogs")
    if not os.path.isdir(top):
        return
    top = os.path.realpath(top)
    for dirpath, _, filenames in os.walk(top):
        if "test.xml" in filenames:
            out = os.path.join(dest, os.path.relpath(dirpath, top))
            os.makedirs(out, exist_ok=True)
            shutil.copyfile(os.path.join(dirpath, "test.xml"), os.path.join(out, "test.xml"))


def find_install_base(root):
    d = os.path.join(root, "install")
    if os.path.isdir(d):
        subs = sorted(x for x in os.listdir(d) if os.path.isdir(os.path.join(d, x)))
        if len(subs) == 1:
            return os.path.join(d, subs[0])
    return None


def parse_info(text):
    out = {}
    for line in text.splitlines():
        if ": " in line:
            k, v = line.split(": ", 1)
            out[k.strip()] = v.strip()
    return out


def existing_recording(label, project):
    """What is already recorded for label/project: None, or a short description of it."""
    rd = oc.record_dir(label, project)
    if not os.path.lexists(rd):
        return None
    m = oc.load_manifest(label, project)
    if m is None:
        return "%s exists without a manifest (an interrupted or running recording)" % rd
    return "%s was recorded %s with binary sha256 %s" % (rd, m.get("created"), m.get("binary_sha256"))


def label_conflicts(label, names, binary_sha256):
    """Reasons why recording projects `names` under `label` with this binary would reuse the label."""
    out = []
    for n in names:
        have = existing_recording(label, n)
        if have:
            out.append(have)
    for other in oc.projects_in(label):
        if other in names:
            continue
        m = oc.load_manifest(label, other)
        if m.get("binary_sha256") != binary_sha256:
            out.append("label %s already holds %s recorded with another binary (sha256 %s, this one %s)" % (
                label, other, m.get("binary_sha256"), binary_sha256))
    return out


def validate_exceptions(manifest):
    """The manifest's declared exceptions (see README "Declared exceptions"), checked."""
    excs = manifest.get("exceptions", [])
    if not isinstance(excs, list):
        oc.die("manifest field `exceptions` must be a list")
    for e in excs:
        ok = (isinstance(e, dict) and isinstance(e.get("id"), str) and e["id"]
              and isinstance(e.get("kind"), str) and e["kind"]
              and isinstance(e.get("explanation"), str) and e["explanation"].strip()
              and isinstance(e.get("surfaces"), list) and e["surfaces"]
              and all(s in oc.SURFACES for s in e["surfaces"]))
        if not ok:
            oc.die("malformed manifest exception %r: it needs id, kind, explanation and a non-empty "
                   "list `surfaces` of known surfaces" % (e,))
    return excs


def record_project(args, project, spec, steps):
    label = args.label
    rd = oc.record_dir(label, project)
    raw = os.path.join(rd, "raw")
    binary = os.path.abspath(oc.expand(args.binary))
    checkout = oc.expand(spec["checkout"])
    ws = os.path.join(oc.WORK, label, project)
    root = os.path.join(oc.OUTPUT_ROOTS, "rec-" + label)
    command = spec["commands"][0]
    verb, patterns = command[0], command[1:]
    expr = " + ".join(patterns)

    print("[record] %s/%s: preparing" % (label, project), flush=True)
    replaced = None
    if os.path.lexists(rd):
        # Only reachable with --force (main refuses otherwise). The new manifest says so.
        old = oc.load_manifest(label, project) or {}
        replaced = {"created": old.get("created"), "binary_sha256": old.get("binary_sha256"),
                    "blaze_repo": old.get("blaze_repo")}
    make_writable_and_remove(rd)
    os.makedirs(raw)
    # Any server of an earlier run in this output user root goes first (a rebuilt Blaze would
    # replace it by itself, binary identity; Bazel only for another install base).
    stopped_before = kill_servers(root)
    make_writable_and_remove(root)
    os.makedirs(root)
    fixed = prepare_workspace(checkout, ws)
    ws = os.path.realpath(ws)
    output_base = os.path.join(root, hashlib.md5(ws.encode()).hexdigest())

    paths = {
        "execroot": os.path.join(output_base, "execroot", "_main"),
        "output_base": output_base,
        "install_base": None,
        "output_user_root": root,
        "workspace": ws,
        "record_dir": rd,
        "binary": binary,
        "binary_dir": os.path.dirname(binary),
        "home": oc.HOME,
    }
    user = os.environ.get("USER") or os.path.basename(oc.HOME)
    host = socket.gethostname().split(".")[0]

    startup = [binary, "--output_user_root=" + root, "--nohome_rc", "--nosystem_rc"]
    if args.max_idle_secs is not None:
        startup.append("--max_idle_secs=%d" % args.max_idle_secs)
    env = clean_env(args.blaze_server)
    common = ["--repository_cache=" + oc.REPO_CACHE, "--color=no", "--curses=no"]
    cmds = []
    if "mod" in steps:
        cmds.append(("mod_graph", ["mod", "graph", "--output=json"]))
    if "build" in steps:
        cmds.append(("build", [verb] + patterns + [
            "--execution_log_json_file=" + os.path.join(raw, "execlog.json"),
            "--execution_log_sort",
            "--build_event_json_file=" + os.path.join(raw, "bep.json"),
        ]))
    if "query" in steps:
        cmds += [
            ("query_label_kind", ["query", expr, "--output=label_kind", "--keep_going"]),
            ("query_deps_label_kind", ["query", "deps(%s)" % expr, "--output=label_kind", "--keep_going"]),
            ("query_jsonproto", ["query", expr, "--output=streamed_jsonproto", "--keep_going"]),
            ("query_deps_jsonproto", ["query", "deps(%s)" % expr, "--output=streamed_jsonproto", "--keep_going"]),
        ]
    if "cquery" in steps:
        cmds += [
            ("cquery_deps_label_kind", ["cquery", "deps(%s)" % expr, "--output=label_kind"]),
            ("cquery_jsonproto", ["cquery", expr, "--output=jsonproto"]),
        ]
    if "aquery" in steps:
        cmds.append(("aquery_deps_jsonproto", [
            "aquery", "deps(%s)" % expr, "--output=jsonproto", "--include_param_files",
            "--include_file_write_contents"]))
    cmds.append(("info", ["info", "output_base", "execution_root", "install_base"]))

    commands = []
    t_start = time.monotonic()
    for name, argv in cmds:
        verb_i = argv[0]
        full = startup + [verb_i] + common + argv[1:]
        print("[record] %s/%s: %s" % (label, project, name), flush=True)
        pid_before = server_pid(root)
        rc, dur = run(full, ws, os.path.join(raw, name + ".stdout"), os.path.join(raw, name + ".stderr"), env=env)
        pid_after = server_pid(root)
        with open(os.path.join(raw, name + ".stderr"), errors="replace") as f:
            start_line = oc.client_started_server(f.read())
        state = oc.server_state(pid_before, pid_after, start_line)
        print("[record]   exit %d in %.1fs (%s server)" % (rc, dur, state), flush=True)
        commands.append({"name": name, "argv": full, "exit_code": rc, "duration_s": dur,
                         "server": {"pid_before": pid_before, "pid_after": pid_after,
                                    "start_line": start_line, "state": state}})
        if name == "mod_graph":
            lock = os.path.join(ws, "MODULE.bazel.lock")
            if os.path.isfile(lock):
                shutil.copyfile(lock, os.path.join(raw, "MODULE.bazel.lock"))
        if paths["install_base"] is None:
            paths["install_base"] = find_install_base(root)
        if name == "build":
            ctx = Context(paths, user, host)
            t0 = time.monotonic()
            oc.write_json(os.path.join(raw, "outputs.walk.json"), walk_outputs(ctx, ws), indent=0)
            copy_test_xml(ws, os.path.join(raw, "testxml"))
            commands[-1]["outputs_walk_s"] = round(time.monotonic() - t0, 2)
        if name == "info" and rc == 0:
            info = parse_info(open(os.path.join(raw, "info.stdout")).read())
            for key, pkey in (("output_base", "output_base"), ("execution_root", "execroot"),
                              ("install_base", "install_base")):
                if info.get(key) and info[key] != paths[pkey]:
                    print("[record]   note: info %s=%s (computed %s)" % (key, info[key], paths[pkey]))
                    paths[pkey] = info[key]
    shutdown_rc, _ = run(startup + ["shutdown"], ws, os.devnull, os.devnull, timeout=120, env=env)
    # Audit 3, B1 item 4: the shutdown's exit code, and no server of the label alive after it
    # (10 s for a server that is still exiting).
    deadline = time.monotonic() + 10
    while live_servers(root) and time.monotonic() < deadline:
        time.sleep(0.2)
    alive_after = kill_servers(root)
    if alive_after:
        print("[record]   WARNING: a server was alive after shutdown (stopped now): %s" % alive_after, file=sys.stderr)
    total = round(time.monotonic() - t_start, 2)

    if os.path.isfile(os.path.join(ws, "MODULE.bazel.lock")):
        shutil.copyfile(os.path.join(ws, "MODULE.bazel.lock"), os.path.join(raw, "MODULE.bazel.lock.final"))

    manifest = {
        "label": label,
        "project": project,
        "created": now(),
        "binary": binary,
        "binary_sha256": oc.sha256_file(binary),
        # The Blaze repository this recorder ran from, read before the first command.
        "blaze_repo": args.repo_state,
        # Whether the binary can come from that checkout (audit R2A-2): inside its target dir and
        # not older than its HEAD commit. commit_verified false: the commit is the recorder's only.
        "binary_origin": args.binary_origin,
        "checkout": checkout,
        "checkout_commit": spec.get("commit"),
        "workspace_fixups": fixed,
        "project_command": command,
        "steps": [s for s in oc.STEP_ORDER if s in steps],
        "context": Context(paths, user, host).to_dict(),
        "commands": commands,
        "total_duration_s": total,
        "server": {"blaze_server_mode": args.blaze_server, "max_idle_secs": args.max_idle_secs,
                   "stopped_before": stopped_before, "shutdown_exit_code": shutdown_rc,
                   "alive_after_shutdown": alive_after},
    }
    if replaced is not None:
        manifest["replaced"] = replaced
    if args.forced:
        # What --force overrode (audit R2A-5); compare and scoreboard print it.
        manifest["forced"] = list(args.forced)
    oc.write_json(os.path.join(rd, "manifest.json"), manifest)
    finish(rd)


def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")


def remove_stage(stage):
    """Delete a staging directory without touching raw/, which it only links to."""
    link = os.path.join(stage, "raw")
    if os.path.islink(link):
        os.unlink(link)
    make_writable_and_remove(stage)


def finish(rd, renormalise=False):
    """(Re)build norm/ and items/ from raw/ and refresh the manifest's file hashes.

    The new norm/ and items/ are built in rd/.stage and renamed into place when complete, so a
    reader of the recording (a comparison, a test that reads the reference) never sees a
    half-built directory, and a rebuild that fails leaves the old ones as they were.
    """
    import surfaces

    manifest = oc.read_json(os.path.join(rd, "manifest.json"))
    validate_exceptions(manifest)
    ctx = Context.from_dict(manifest["context"])
    stage = os.path.join(rd, ".stage")
    remove_stage(stage)
    for sub in ("norm", "items"):
        os.makedirs(os.path.join(stage, sub))
    os.symlink(os.path.join(rd, "raw"), os.path.join(stage, "raw"))
    results = surfaces.extract_all(stage, manifest, ctx)
    manifest["surfaces"] = {
        s: {"status": r["status"], "items": len(r.get("items", {}))} for s, r in results.items()
    }
    manifest["extractor_sha256"] = oc.extractor_sha256()
    if renormalise:
        manifest.setdefault("renormalised", []).append(
            {"date": now(), "extractor_sha256": manifest["extractor_sha256"]})
    files = {}
    for base in (os.path.join(rd, "raw"), os.path.join(stage, "norm"), os.path.join(stage, "items")):
        for dirpath, _, filenames in os.walk(base):
            for fn in filenames:
                full = os.path.join(dirpath, fn)
                files[os.path.join(os.path.basename(base), os.path.relpath(full, base))] = oc.sha256_file(full)
    manifest["files"] = dict(sorted(files.items()))
    for sub in ("norm", "items"):
        live, old = os.path.join(rd, sub), os.path.join(stage, sub + ".old")
        if os.path.lexists(live):
            os.rename(live, old)
        os.rename(os.path.join(stage, sub), live)
    oc.write_json(os.path.join(rd, "manifest.json"), manifest)
    remove_stage(stage)
    for s, r in results.items():
        extra = ""
        if r["status"] != "OK":
            extra = " (%s)" % (r.get("error") or "").splitlines()[0][:100] if r.get("error") else ""
        print("[record]   %-18s %-7s %6d items%s" % (s, r["status"], len(r.get("items", {})), extra))
    return manifest


def write_summary(label, project):
    rd = oc.record_dir(label, project)
    m = oc.read_json(os.path.join(rd, "manifest.json"))
    summary = {
        "label": label,
        "project": project,
        "created": m["created"],
        "binary_sha256": m["binary_sha256"],
        "blaze_repo": m.get("blaze_repo"),
        "extractor_sha256": m.get("extractor_sha256"),
        "exceptions": m.get("exceptions", []),
        "checkout_commit": m.get("checkout_commit"),
        "project_command": m["project_command"],
        "surfaces": m.get("surfaces", {}),
        "timings_s": {c["name"]: c["duration_s"] for c in m["commands"]},
        "exit_codes": {c["name"]: c["exit_code"] for c in m["commands"]},
        "total_duration_s": m.get("total_duration_s"),
        "files_sha256": {k: v for k, v in m["files"].items() if not k.startswith("raw/")},
    }
    os.makedirs(oc.CORPUS_SUMMARIES, exist_ok=True)
    oc.write_json(os.path.join(oc.CORPUS_SUMMARIES, project + ".json"), summary)


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("help", "-h", "--help"):
        print(USAGE)
        return 0
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--binary")
    ap.add_argument("--label", required=True)
    ap.add_argument("--project", required=True)
    ap.add_argument("--surfaces", default=",".join(oc.STEP_ORDER))
    ap.add_argument("--renormalise", action="store_true")
    ap.add_argument("--force", action="store_true")
    ap.add_argument("--no-scope", action="store_true")
    ap.add_argument("--blaze-server", choices=["inprocess", "daemon"])
    ap.add_argument("--max-idle-secs", type=int)
    ap.add_argument("--summary", dest="summary", action="store_true", default=None)
    ap.add_argument("--no-summary", dest="summary", action="store_false")
    args = ap.parse_args()

    projects = oc.load_projects()
    names = sorted(projects) if args.project == "all" else [args.project]
    for n in names:
        if n not in projects:
            oc.die("unknown project %r (have: %s)" % (n, ", ".join(sorted(projects))))
    steps = [s.strip() for s in args.surfaces.split(",") if s.strip()]
    for s in steps:
        if s not in oc.STEPS:
            oc.die("unknown step %r (have: %s)" % (s, ", ".join(oc.STEP_ORDER)))
    summary = args.summary if args.summary is not None else args.label == oc.REFERENCE_LABEL
    if args.max_idle_secs is None and args.blaze_server == "daemon":
        args.max_idle_secs = DAEMON_MAX_IDLE_SECS
    if args.max_idle_secs is not None and args.max_idle_secs < 0:
        oc.die("--max-idle-secs must not be negative")

    if args.renormalise:
        for n in names:
            rd = oc.record_dir(args.label, n)
            if not os.path.isfile(os.path.join(rd, "manifest.json")):
                oc.die("no record at " + rd)
            print("[record] %s/%s: renormalising" % (args.label, n))
            finish(rd, renormalise=True)
            if summary:
                write_summary(args.label, n)
        return 0

    if not args.binary:
        oc.die("--binary is required")
    if not os.access(oc.expand(args.binary), os.X_OK):
        oc.die("binary not executable: " + args.binary)
    conflicts = label_conflicts(args.label, names, oc.sha256_file(os.path.abspath(oc.expand(args.binary))))
    if conflicts and not args.force:
        oc.die("label %r is already in use, and labels are never reused:\n  %s\n"
               "Record under a new label (for Blaze: blaze-<commit>, see `record help`), or pass --force "
               "to replace it." % (args.label, "\n  ".join(conflicts)))
    maybe_reexec_in_scope(args)
    args.repo_state = oc.repo_state()
    args.binary_origin = oc.binary_origin(oc.expand(args.binary))
    args.forced = conflicts if args.force else []
    if not args.binary_origin["commit_verified"]:
        print("[record] WARNING: commit_verified false: the recorded commit %s may not be the binary's origin: %s"
              % (args.repo_state.get("commit"), "; ".join(args.binary_origin["reasons"])), file=sys.stderr)
    for c in args.forced:
        print("[record] WARNING: --force: %s" % c, file=sys.stderr)
    for n in names:
        record_project(args, n, projects[n], steps)
        if summary:
            write_summary(args.label, n)
    return 0


if __name__ == "__main__":
    sys.exit(main())
