#!/usr/bin/env python3
"""Compare the Java rules between the oracle (Bazel 9.3.2) and Blaze. See `compare help`."""

import glob
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys

USAGE = """\
usage: scripts/java/compare --binary <blaze> [--oracle <bazel>] [--label NAME] [--skip-oracle]
                            [--step ID]... [--keep-going]
       scripts/java/compare list
       scripts/java/compare selftest
       scripts/java/compare help

Runs a fixed list of steps (see `list`) on the probe workspace scripts/java/probe with the oracle
and with Blaze. Each side has its own work copy (~/.cache/blaze/work/java-compare/<label>/<side>,
rsync of the probe) and its own output user root (~/.cache/blaze/oracle-out/java-compare-<side>),
a clean environment (HOME, PATH=/usr/bin:/bin), --nohome_rc --nosystem_rc, the shared repository
cache, --color=no --curses=no, and runs under systemd-run --user --scope -p MemoryMax=12G
-p MemorySwapMax=0. Both sides start from a fresh output user root and run the same steps in the
same order; the server is shut down at the end.

Compared per step: the termination, the whole stderr and stdout. stderr is compared in full
after the exclusion rules of scripts/lib/compare_common.py (VOLATILE_RULES; `paths`: the
workspace copy, output base, execroot, output user root, install base and $HOME of each side;
B1_GAP_RULES: lines that depend on the oracle's warm server, audit round 3 B1), listed in the
report with the lines each changed or removed. stdout per kind:
  cquery     `cquery --output=label_kind //:all`: stdout in full (paths replaced,
             scripts/oracle/normalise.py)
  aquery     `aquery --output=jsonproto 'deps(//:all)'`: every action (mnemonic, argv, inputs,
             outputs, environment, execution info, action key, owner, configuration) and the
             order of every list, as the referee's extractor (scripts/oracle/surfaces.py
             aquery_summary/aquery_order) resolves them; a runfiles manifest action whose only
             difference is its action key (allowed in scripts/oracle/allow.json) makes the step
             IDENTICAL-REDUCED, never IDENTICAL
  build      `build //:all //:hello_deploy.jar //:app_deploy.jar` with
             --spawn_strategy=linux-sandbox (Blaze has no persistent workers; the oracle would
             run Javac in a worker otherwise): stdout in full
  outputs    sha256 of every *.jar and of the launcher scripts under bazel-bin after build
  aquery-X, build-X
             the same for deps(//:app) / //:app under one flag: lang17
             (--java_language_version=17), tool21 (--tool_java_runtime_version=remotejdk_21),
             noturbine (--nojava_header_compilation), toolchain (the custom java_toolchain of
             //toolchain, --extra_toolchains); and turbineapt
             (--experimental_turbine_annotation_processing) on deps(//:uses_api) / //:uses_api
  aquery-proto
             `aquery 'deps(//proto:uses_proto)'` (java_proto_library; protoc is not built)
  test       `test //:greeter_test`, run, run-app (`run //:hello -- probe`, `run //:app`):
             stdout in full; test and run start from a fresh server on both sides (Blaze's
             server does not keep the graph between commands yet, docs/decisions.md D2)

Guards (scripts/lib/compare_common.py): every command runs under a supervisor in the scope that
records how it really ended (`exit N`, `signal NAME`, `oom-kill`, `timeout`); the terminations of
`shutdown` and `info` are listed too (an abnormal one fails the run). --oracle must be the pinned
oracle (UPSTREAM.json). Each step (and `outputs`) is one case: IDENTICAL (termination, stdout and
stderr equal; the oracle exited 0, or DECLARED_EXIT names the step with that exit code),
KNOWN-GAP (equal except in B1 lines), IDENTICAL-REDUCED (see aquery), DIFFERENT, BOTH-FAILED
(equal failures not declared), NOT-PORTED, ORACLE-UNEXPECTED, SKIPPED (a selected step missing
on one side). An empty selection is an error.

Output: a header (repository HEAD and dirty flag, both binaries' paths and sha256), a table, the
per-step classes and the denominator; raw outputs under ~/.cache/blaze/java-compare/<label>/<side>/
and results.json there (with provenance and denominator). Exit 0 only when at least one step was
compared and every selected step is IDENTICAL; 1 otherwise; 2 on a usage error or a refusal.
--skip-oracle reuses the oracle outputs of an earlier run with the same --label only when
<label>/oracle/oracle.key, written after those outputs were complete, holds this run's key
(oracle sha256, every argv and the environment, the digest of the probe, the selected steps) and
every output it anchors is unchanged; otherwise it refuses. The outputs are raw (normalised
when compared), so this tool's sha256 is not in the key.
selftest drives this command line with fake binaries (compare_common.selftest_tool).
--step limits the run to the named steps (the build step is implied by outputs).
"""

HOME = os.path.expanduser("~")
REPO_ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(REPO_ROOT, "scripts", "oracle"))
import normalise  # noqa: E402
import surfaces  # noqa: E402
sys.path.insert(0, os.path.join(REPO_ROOT, "scripts", "lib"))
import compare_common as cc  # noqa: E402

# Steps whose non-zero exit is the behaviour under test: {step id: the oracle's exit code}.
# Equal failures of a step not listed here are BOTH-FAILED. Left to the step list's owner.
DECLARED_EXIT = {}

CACHE = os.path.join(HOME, ".cache", "blaze")
ORACLE = os.path.join(CACHE, "oracle", "bazel-9.3.2-linux-x86_64")
REPO_CACHE = os.path.join(CACHE, "repo-cache")
PROBE_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "probe")
TIMEOUT = 3600

SB = "--spawn_strategy=linux-sandbox"
JP = "--output=jsonproto"
LANG17 = "--java_language_version=17"
TOOL21 = "--tool_java_runtime_version=remotejdk_21"
NOTURBINE = "--nojava_header_compilation"
TURBINE_APT = "--experimental_turbine_annotation_processing"
TOOLCHAIN = "--extra_toolchains=//toolchain:custom_definition"
# (id, args). The kind of a step is its id up to the first "-" (cquery, aquery, build, test,
# run); steps of one kind are compared alike.
STEPS = [
    ("cquery", ["cquery", "--output=label_kind", "//:all"]),
    ("aquery", ["aquery", JP, "deps(//:all)"]),
    ("build", ["build", SB, "//:all", "//:hello_deploy.jar", "//:app_deploy.jar"]),
    ("aquery-lang17", ["aquery", JP, LANG17, "deps(//:app)"]),
    ("build-lang17", ["build", SB, LANG17, "//:app"]),
    ("aquery-tool21", ["aquery", JP, TOOL21, "deps(//:app)"]),
    ("build-tool21", ["build", SB, TOOL21, "//:app"]),
    ("aquery-noturbine", ["aquery", JP, NOTURBINE, "deps(//:app)"]),
    ("build-noturbine", ["build", SB, NOTURBINE, "//:app"]),
    ("aquery-toolchain", ["aquery", JP, TOOLCHAIN, "deps(//:app)"]),
    ("build-toolchain", ["build", SB, TOOLCHAIN, "//:app"]),
    ("aquery-turbineapt", ["aquery", JP, TURBINE_APT, "deps(//:uses_api)"]),
    ("build-turbineapt", ["build", SB, TURBINE_APT, "//:uses_api"]),
    ("aquery-proto", ["aquery", JP, "deps(//proto:uses_proto)"]),
    ("test", ["test", SB, "//:greeter_test"]),
    ("run", ["run", SB, "//:hello", "--", "probe"]),
    ("run-app", ["run", SB, "//:app"]),
]
LAUNCHERS = ("hello", "greeter_test", "app", "hello_imported")
RUNFILES_MANIFEST_RE = re.compile(r"\.runfiles(_manifest|/MANIFEST)$")
RULES = cc.VOLATILE_RULES + cc.B1_GAP_RULES


def make_writable_and_remove(path):
    if not os.path.lexists(path):
        return
    subprocess.run(["chmod", "-R", "u+w", path], stderr=subprocess.DEVNULL)
    shutil.rmtree(path, ignore_errors=True)
    if os.path.lexists(path):
        subprocess.run(["rm", "-rf", path])


def step_argv(binary, our, args):
    return [binary, "--output_user_root=" + our, "--nohome_rc",
            "--nosystem_rc"] + args[:1] + ["--repository_cache=" + REPO_CACHE, "--color=no",
                                           "--curses=no"] + args[1:]


def run_cmd(binary, ws, our, args):
    """(compare_common.Termination, stdout, stderr) of one command in a --scope unit."""
    r = cc.run(step_argv(binary, our, args), ws, timeout=TIMEOUT, mode="scope",
               tag="java-compare")
    return r.term, r.out, r.err


def info(binary, ws, our, key, report=None, side=""):
    term, out, _ = run_cmd(binary, ws, our, ["info", key])
    if report is not None:
        report.add_aux("%s info %s" % (side, key), term)
    return out.decode("latin-1").strip() if term.ok else ""


def selected_steps(steps):
    return [(sid, args) for sid, args in STEPS
            if not steps or sid in steps or (sid == "build" and "outputs" in steps)]


def oracle_key(label, steps):
    ws = os.path.join(CACHE, "work", "java-compare", label, "oracle")
    our = os.path.join(CACHE, "oracle-out", "java-compare-oracle")
    # Raw outputs (normalised at comparison): this tool's sha256 is not part of the key.
    return cc.cache_key(None, cc.pinned_sha256(),
                        [step_argv(cc.PINNED_ORACLE, our, a) for _s, a in selected_steps(steps)],
                        cc.clean_env(), cc.tree_digest(PROBE_DIR),
                        extra={"workspace": ws, "steps": sorted(steps)})


def side_run(side, binary, label, steps, report):
    ws = os.path.join(CACHE, "work", "java-compare", label, side)
    our = os.path.join(CACHE, "oracle-out", "java-compare-" + side)
    outdir = os.path.join(CACHE, "java-compare", label, side)
    if side == "oracle":
        cc.invalidate_key(os.path.join(outdir, "oracle.key"))
    make_writable_and_remove(ws)
    make_writable_and_remove(our)
    make_writable_and_remove(outdir)
    os.makedirs(ws)
    os.makedirs(outdir)
    subprocess.run(["rsync", "-a", "--delete", PROBE_DIR + "/", ws + "/"], check=True)
    results = {"steps": {}}
    for sid, args in STEPS:
        if steps and sid not in steps and not (sid == "build" and "outputs" in steps):
            continue
        if sid.split("-")[0] in ("test", "run"):
            # Both sides start these from a fresh server with the on-disk action cache: Blaze's
            # server does not keep the graph between commands yet (decisions D2), Bazel's does.
            report.add_aux("%s shutdown before %s" % (side, sid),
                           run_cmd(binary, ws, our, ["shutdown"])[0])
        term, out, err = run_cmd(binary, ws, our, args)
        open(os.path.join(outdir, sid + ".stdout"), "wb").write(out)
        open(os.path.join(outdir, sid + ".stderr"), "wb").write(err)
        results["steps"][sid] = {"exit": term.exit_code_like(), "termination": term.to_dict(),
                                 "unported": cc.unported_message(err)}
        if sid == "build":
            hashes = {}
            bin_dir = os.path.join(ws, "bazel-bin")
            for path in sorted(glob.glob(os.path.join(bin_dir, "**", "*"), recursive=True)):
                rel = os.path.relpath(path, bin_dir)
                if ".runfiles" in rel or os.path.isdir(path):
                    continue
                if rel.endswith(".jar") or rel in LAUNCHERS:
                    with open(path, "rb") as f:
                        hashes[rel] = hashlib.sha256(f.read()).hexdigest()
            results["outputs"] = hashes
    paths = {
        "workspace": ws,
        "output_user_root": our,
        "output_base": info(binary, ws, our, "output_base", report, side),
        "execroot": info(binary, ws, our, "execution_root", report, side),
        "install_base": info(binary, ws, our, "install_base", report, side),
        "home": HOME,
    }
    results["paths"] = paths
    report.add_aux("%s shutdown" % side, run_cmd(binary, ws, our, ["shutdown"])[0])
    with open(os.path.join(outdir, "results.json"), "w") as f:
        json.dump(results, f, indent=1, sort_keys=True)
    files = [os.path.join(outdir, n) for n in sorted(os.listdir(outdir)) if n != "oracle.key"]
    if side == "oracle":
        cc.write_key(os.path.join(outdir, "oracle.key"), oracle_key(label, steps), files)
    else:
        cc.write_capture(os.path.join(outdir, "capture.json"),
                         {"path": binary, "sha256": cc.sha256_file(binary)}, files)
    return results


def load(side, label):
    outdir = os.path.join(CACHE, "java-compare", label, side)
    with open(os.path.join(outdir, "results.json")) as f:
        return json.load(f), outdir


def read(outdir, name):
    p = os.path.join(outdir, name)
    return open(p, "rb").read().decode("latin-1") if os.path.exists(p) else ""


def aquery_items(ctx, text):
    try:
        doc = ctx.deep(json.loads(text))
    except ValueError:
        return None
    summary = surfaces.aquery_summary(doc)
    return {**summary, **surfaces.aquery_order(doc, list(summary))}


def compare(label, steps, report, norm):
    o, odir = load("oracle", label)
    b, bdir = load("blaze", label)
    octx = normalise.Context(o["paths"])
    bctx = normalise.Context(b["paths"])
    rows = []
    step_of_row = {}
    reduced = {}
    gaps = {}

    def row(name, ok, detail=""):
        rows.append((name, "MATCH" if ok else "DIFF", detail))
        step_of_row[len(rows) - 1] = cur[0]

    cur = [None]
    for sid, _ in selected_steps(steps):
        cur[0] = sid
        if sid not in o["steps"] or sid not in b["steps"]:
            if report is not None:
                report.add(sid, cc.SKIPPED, "not run on the %s side" % (
                    "oracle" if sid not in o["steps"] else "blaze"))
            continue
        ot = cc.Termination.from_dict(o["steps"][sid].get("termination"))
        bt = cc.Termination.from_dict(b["steps"][sid].get("termination"))
        row(sid + " exit", ot is not None and ot == bt, "oracle %s, blaze %s" % (ot, bt))
        eq, g = norm.compare(read(odir, sid + ".stderr"), read(bdir, sid + ".stderr"), "stderr",
                             octx._pairs, bctx._pairs)
        row(sid + " stderr", eq, "whole stderr after the exclusion rules")
        if g:
            gaps[sid] = g
        kind = sid.split("-")[0]
        if kind == "cquery":
            ol = octx.text(read(odir, sid + ".stdout")).splitlines()
            bl = bctx.text(read(bdir, sid + ".stdout")).splitlines()
            row(sid + " stdout", ol == bl, "%d vs %d lines" % (len(ol), len(bl)))
        elif kind == "aquery":
            oi = aquery_items(octx, read(odir, sid + ".stdout"))
            bi = aquery_items(bctx, read(bdir, sid + ".stdout"))
            if oi is None or bi is None:
                row(sid, False, "no jsonproto on %s" % ("oracle" if oi is None else "blaze"))
                continue
            same = diff = missing = extra = allowed = 0
            diffs = []
            for k, v in oi.items():
                if k not in bi:
                    missing += 1
                    diffs.append("missing " + k)
                elif bi[k] == v:
                    same += 1
                else:
                    fields = sorted(f for f in set(v) | set(bi[k]) if v.get(f) != bi[k].get(f)) \
                        if isinstance(v, dict) and isinstance(bi[k], dict) else ["value"]
                    if RUNFILES_MANIFEST_RE.search(k) and fields == ["actionKey"]:
                        allowed += 1
                    else:
                        diff += 1
                        diffs.append("diff %s: %s" % (k, ",".join(fields)))
            for k in bi:
                if k not in oi:
                    extra += 1
                    diffs.append("extra " + k)
            with open(os.path.join(bdir, sid + ".diffs.txt"), "w") as f:
                f.write("\n".join(diffs) + "\n")
            row(sid + " items", diff == missing == extra == 0,
                "%d items: %d same, %d allowed, %d diff, %d missing, %d extra" % (
                    len(oi), same, allowed, diff, missing, extra))
            if allowed:
                reduced[sid] = "aquery: %d runfiles-manifest action keys allowed to differ" % (
                    allowed)
        else:
            eq, g = norm.compare(read(odir, sid + ".stdout"), read(bdir, sid + ".stdout"),
                                 "stdout", octx._pairs, bctx._pairs)
            row(sid + " stdout", eq, "whole stdout after the exclusion rules")
            if g:
                gaps.setdefault(sid, []).extend(g)
    cur[0] = "outputs"
    if "outputs" in o and "outputs" in b and not o["outputs"] and not b["outputs"]:
        # Audit 4r2, T3: the row is never absent; with no jar on either side it says why.
        report.add("outputs", cc.SKIPPED, "neither build wrote a jar or launcher (build: oracle "
                   "%s, blaze %s)" % (cc.Termination.from_dict(o["steps"]["build"]["termination"]),
                                      cc.Termination.from_dict(b["steps"]["build"]["termination"])))
    elif "outputs" in o and "outputs" in b:
        oh, bh = o["outputs"], b["outputs"]
        for k in sorted(set(oh) | set(bh)):
            row("sha256 " + k, oh.get(k) == bh.get(k),
                "" if oh.get(k) == bh.get(k) else "oracle %s, blaze %s" % (
                    (oh.get(k) or "-")[:12], (bh.get(k) or "-")[:12]))
    elif not steps or "outputs" in steps or "build" in steps:
        report.add("outputs", cc.SKIPPED, "no build outputs recorded on the %s side" % (
            "oracle" if "outputs" not in o else "blaze"))
    w = max(len(r[0]) for r in rows) if rows else 10
    for name, status, detail in rows:
        print("%-*s  %-5s  %s" % (w, name, status, detail))
    judge_steps(o, b, rows, step_of_row, report, gaps, reduced)
    report.write_json(os.path.join(CACHE, "java-compare", label, "results.json"),
                      extra={"rows": rows})
    return rows


def judge_steps(o, b, rows, step_of_row, report, gaps, reduced):
    """One compare_common class per step (and `outputs`) from the aspect rows."""
    order = []
    for i in range(len(rows)):
        if step_of_row[i] not in order:
            order.append(step_of_row[i])
    for sid in order:
        mine = [rows[i] for i in range(len(rows)) if step_of_row[i] == sid]
        differing = [name for name, status, _ in mine
                     if status == "DIFF" and not name.endswith(" exit")]
        if sid == "outputs":
            ot = bt = cc.Termination("exit", 0)  # the build step carries the termination
            unported = None
        else:
            ot = cc.Termination.from_dict(o["steps"][sid].get("termination"))
            bt = cc.Termination.from_dict(b["steps"][sid].get("termination"))
            unported = b["steps"][sid].get("unported")
        cls, detail = cc.judge(ot, bt, differing, declared_exit=DECLARED_EXIT.get(sid),
                               blaze_unported=unported, gaps=sorted(set(gaps.get(sid, []))),
                               reduced=reduced.get(sid))
        report.add(sid, cls, detail)


def main(argv):
    if not argv or argv[0] in ("help", "--help", "-h"):
        print(USAGE, end="")
        return 0
    if argv[0] == "selftest":
        return selftest()
    if argv[0] == "list":
        for sid, args in STEPS:
            print("%-8s %s" % (sid, " ".join(args)))
        print("%-8s %s" % ("outputs", "sha256 of bazel-bin/**/*.jar and launcher scripts after build"))
        return 0
    binary, oracle, label, skip_oracle, steps = None, ORACLE, "java-compare", False, []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--binary":
            binary = argv[i + 1]; i += 2
        elif a == "--oracle":
            oracle = argv[i + 1]; i += 2
        elif a == "--label":
            label = argv[i + 1]; i += 2
        elif a == "--step":
            steps.append(argv[i + 1]); i += 2
        elif a == "--skip-oracle":
            skip_oracle = True; i += 1
        else:
            print("unknown argument %s\n%s" % (a, USAGE), file=sys.stderr)
            return 2
    if not binary:
        print(USAGE, file=sys.stderr)
        return 2
    binary = os.path.abspath(binary)
    known = {sid for sid, _ in STEPS} | {"outputs"}
    if [s for s in steps if s not in known] or (steps and not selected_steps(steps)):
        return cc.empty_selection_error("java/compare", "steps (unknown: %s)" % ", ".join(
            s for s in steps if s not in known))
    try:
        oracle, oracle_sha = cc.require_oracle(oracle)
        blaze = cc.blaze_identity(binary)
    except cc.Refusal as e:
        return cc.refuse("java/compare", e)
    report = cc.Report("java/compare", blaze=blaze, oracle={"path": oracle, "sha256": oracle_sha},
                       selection="label %s, steps %s%s" % (
                           label, ",".join(steps) or "all",
                           ", oracle outputs reused" if skip_oracle else ""),
                       tool_files=[os.path.abspath(__file__)],
                       compared="per step: termination, the whole stderr after the exclusion "
                                "rules, stdout (in full; aquery through the referee's "
                                "extractor); jar and launcher sha256 after build")
    norm = cc.Normaliser(RULES)
    report.add_normaliser(norm)
    report.print_header()
    if skip_oracle:
        try:
            cc.require_fresh(os.path.join(CACHE, "java-compare", label, "oracle", "oracle.key"),
                             oracle_key(label, steps))
        except cc.Refusal as e:
            return cc.refuse("java/compare", e)
    else:
        side_run("oracle", oracle, label, steps, report)
    side_run("blaze", blaze["path"], label, steps, report)
    compare(label, steps, report, norm)
    print()
    report.print_rows()
    report.print_footer()
    return report.exit_code()


def selftest():
    def argv(blaze, label):
        return ["--binary", blaze, "--step", "cquery", "--label", label]

    def extra(st, fh, run):
        # M7: the build step and the outputs row through the real command line; T3: with no jar
        # on either side the outputs row is SKIPPED, not absent.
        o, b = fh.fakes(dict(out=b""), dict(out=b""))
        rc, rep, log = run(["--binary", b, "--step", "outputs", "--label", "selftest-build"])
        rows = {r["case"]: r for r in (rep or {}).get("cases", [])}
        st.check("T3/M7: build runs; outputs row SKIPPED without jars",
                 rc == 1 and rows.get("build", {}).get("class") == cc.IDENTICAL
                 and rows.get("outputs", {}).get("class") == cc.SKIPPED,
                 "exit %s, %s" % (rc, {k: v["class"] for k, v in rows.items()}))

    return cc.selftest_tool(
        "java/compare", os.path.abspath(__file__), argv, extra=extra,
        empty=lambda b, l: ["--binary", b, "--step", "no-such-step", "--label", l],
        reuse=lambda b, l: argv(b, l) + ["--skip-oracle"],
        oracle_outputs=lambda home, l: [os.path.join(home, ".cache", "blaze", "java-compare", l,
                                                     "oracle", "cquery.stdout")])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
