#!/usr/bin/env bash
# Records the JDK's replacing UTF-8 decoder (`new String(bytes, UTF_8)`), which
# StringEncoding.internalToUnicode uses, as test vectors for blaze_util::string_encoding.
set -euo pipefail

usage() {
  cat <<'USAGE'
usage: scripts/string-encoding/run
       scripts/string-encoding/run help

Compiles scripts/string-encoding/Utf8DecodeVectors.java with the host javac (--release 11) and
runs it on the oracle's embedded JDK
(~/.cache/blaze/oracle-out/ur/install/<key>/embedded_tools/jdk/bin/java). Writes
crates/blaze_util/tests/data/java_utf8_decode_vectors.txt, which
crates/blaze_util/tests/string_encoding_test.rs reads.
USAGE
}

if [[ "${1:-}" == "help" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi
if [[ $# -ne 0 ]]; then
  usage
  exit 2
fi

here="$(cd "$(dirname "$0")" && pwd)"
repo="$(cd "$here/../.." && pwd)"
java="$HOME/.cache/blaze/oracle-out/ur/install/58cf1ecbff441bac762b0050d6da21e9/embedded_tools/jdk/bin/java"
work="$(mktemp -d "${TMPDIR:-/tmp}/string-encoding.XXXXXX")"
trap 'rm -rf "$work"' EXIT

javac --release 11 -d "$work" "$here/Utf8DecodeVectors.java"
mkdir -p "$repo/crates/blaze_util/tests/data"
"$java" -cp "$work" Utf8DecodeVectors > "$repo/crates/blaze_util/tests/data/java_utf8_decode_vectors.txt"
echo "wrote crates/blaze_util/tests/data/java_utf8_decode_vectors.txt"
