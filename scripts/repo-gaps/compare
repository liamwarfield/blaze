def norm(text, ws, aux, root):
    text = text.replace(ws, "<WS>").replace(aux, "<AUX>").replace(root, "<ROOT>")
    text = re.sub(r"<ROOT>/[0-9a-f]{32}", "<ROOT>/<OB>", text)
    return text


def compared(stderr):
    out = []
    lines = stderr.splitlines()
    for i, l in enumerate(lines):
        if re.match(r"(ERROR|WARNING|FATAL):", l):
            out.append(l)
        elif re.match(r"(java\.lang\.\w+|blaze: not ported yet|thread '.*' .*panicked)", l):
            out.append(l)
    return out


def write_files(ws, aux, files):
    for rel, content in files.items():
        path = rel.replace("{aux}", aux)
        path = path if os.path.isabs(path) else os.path.join(ws, path)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            f.write(content.replace("{aux}", aux).replace("{ws}", ws))


def run_side(side, binary, is_bazel, name, c, label):
    base = os.path.join(HOME, ".cache/blaze/work/repo-gaps/compare", label, side, name)
    if os.path.exists(base):
        subprocess.run(["chmod", "-R", "u+w", base])
        shutil.rmtree(base)
    ws, aux = os.path.join(base, "ws"), os.path.join(base, "aux")
    os.makedirs(ws)
    os.makedirs(aux)
    write_files(ws, aux, c["files"])
    root = os.path.join(HOME, ".cache/blaze/oracle-out/repo-gaps-" + side)
    results = []
    transcript = ""
    for args in c["cmds"]:
        args = [a.replace("{aux}", aux).replace("{ws}", ws) for a in args]
        cmd = [binary, "--output_user_root=" + root, "--nohome_rc", "--nosystem_rc"]
        if is_bazel:
            cmd.append("--batch")
        cmd += [args[0], "--repository_cache=" + REPO_CACHE, "--color=no", "--curses=no"]
        cmd += args[1:]
        p = cc.run(cmd, ws, timeout=1800, mode="scope", tag="repo-gaps")
        err = norm(p.err.decode("latin-1"), ws, aux, root)
        out = norm(p.out.decode("latin-1"), ws, aux, root)
        transcript += "$ %s\n%s\n--- stdout\n%s\n[%s]\n" % (" ".join(args), err, out, p.term)
        results.append({"cmd": " ".join(args), "exit": p.rc, "termination": p.term.to_dict(),
                        "unported": cc.unported_message(err), "lines": compared(err),
                        "stdout": out})
    odir = os.path.join(HOME, ".cache/blaze/repo-gaps-compare", label, side)
    os.makedirs(odir, exist_ok=True)
    open(os.path.join(odir, name + ".stderr"), "w").write(transcript)
    json.dump(results, open(os.path.join(odir, name + ".norm.json"), "w"), indent=1)
    return results


def main(argv):
    if not argv or argv[0] in ("help", "--help", "-h"):
        print(USAGE)
        return 0
    if argv[0] == "selftest":
        return selftest()
    if argv[0] == "list":
        for n, c in CASES.items():
            print("%-22s %s" % (n, c["desc"]))
        return 0
    import argparse
    import fnmatch
    ap = argparse.ArgumentParser(usage=USAGE)
    ap.add_argument("--binary", required=True)
    ap.add_argument("--oracle", default=ORACLE)
    ap.add_argument("--case", action="append")
    ap.add_argument("--label", default="default")
    a = ap.parse_args(argv)
    names = [n for n in CASES if not a.case or any(fnmatch.fnmatch(n, g) for g in a.case)]
    if not names:
        return cc.empty_selection_error("repo-gaps/compare")
    try:
        oracle, oracle_sha = cc.require_oracle(a.oracle)
        blaze = cc.blaze_identity(a.binary)
    except cc.Refusal as e:
        return cc.refuse("repo-gaps/compare", e)
    report = cc.Report("repo-gaps/compare", blaze=blaze,
                       oracle={"path": oracle, "sha256": oracle_sha},
                       selection="label %s, %d cases%s" % (
                           a.label, len(names), " (--case %s)" % ",".join(a.case) if a.case
                           else ""), tool_files=[os.path.abspath(__file__)])
    report.print_header()
    for n in names:
        o = run_side("oracle", oracle, True, n, CASES[n], a.label)
        b = run_side("blaze", blaze["path"], False, n, CASES[n], a.label)
        if len(o) != len(b):
            report.add(n, cc.SKIPPED, "%d oracle commands, %d blaze commands" % (len(o), len(b)))
        for i, (x, y) in enumerate(zip(o, b)):
            cls, detail = judge("%s#%d" % (n, i), x, y)
            report.add("%s#%d" % (n, i), cls, detail)
            print("%-17s %-20s #%d %s/%s  %s" % (
                cls, n, i, cc.Termination.from_dict(x["termination"]),
                cc.Termination.from_dict(y["termination"]), x["cmd"][:60]))
            if cls != cc.IDENTICAL:
                for l in x["lines"]:
                    if l not in y["lines"]:
                        print("        - oracle: " + l[:300])
                for l in y["lines"]:
                    if l not in x["lines"]:
                        print("        + blaze:  " + l[:300])
    odir = os.path.join(HOME, ".cache/blaze/repo-gaps-compare", a.label)
    os.makedirs(odir, exist_ok=True)
    report.write_json(os.path.join(odir, "results.json"))
    print()
    report.print_rows()
    report.print_footer()
    return report.exit_code()


def judge(row, x, y):
    return cc.judge(cc.Termination.from_dict(x.get("termination")),
                    cc.Termination.from_dict(y.get("termination")),
                    [] if x["lines"] == y["lines"] else ["stderr lines"],
                    declared_exit=DECLARED_EXIT.get(row), blaze_unported=y.get("unported"))


def selftest():
    def run_pair(ofake, bfake, wd):
        cc.require_oracle(ofake)
        res = {}
        for side, fake in (("oracle", ofake), ("blaze", bfake)):
            p = cc.run([fake, "build"], wd, mode="scope", tag="selftest")
            err = norm(p.err.decode("latin-1"), wd, wd, wd)
            # The fakes print their difference on stdout, which this tool does not compare; put
            # it in a compared line the way an ERROR line would be.
            lines = compared(err) + ["ERROR: " + p.out.decode("latin-1").strip()]
            res[side] = {"termination": p.term.to_dict(), "unported": cc.unported_message(err),
                         "lines": lines}
        return judge("selftest", res["oracle"], res["blaze"])

    def empty_selection():
        with open(os.devnull, "w") as null:
            old = sys.stderr
            sys.stderr = null
            try:
                return main(["--binary", "/bin/true", "--case", "no-such-case"])
            finally:
                sys.stderr = old

    return cc.selftest("repo-gaps/compare", run_pair=run_pair, empty_selection=empty_selection,
                       mode="scope")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
