      "BUILD": "aar_import(name = 'x', aar = 'x.aar')\n", "x.aar": "",
      "{aux}/ra/MODULE.bazel": 'module(name = "rules_android")\n',
      "{aux}/ra/rules/BUILD": "", "{aux}/ra/rules/rules.bzl": ""},
     [["query", "--incompatible_autoload_externally=aar_import",
       "--noincompatible_disable_autoloads_in_main_repo", "//:x"]],
     "the autoloaded .bzl lacks the symbol")
case("al-native-unknown",
     {"MODULE.bazel": "", "BUILD": "load(':m.bzl', 'm')\nm()\n",
      "m.bzl": "def m():\n    native.aar_import(name = 'x')\n"},
     [["query", "//:all"]],
     "native.<removed rule> error text (default flag)")
# Item 4: --experimental_sibling_repository_layout.
case("sib-external-pkg",
     {"MODULE.bazel": "", "external/a/BUILD":
          "genrule(name = 'g', srcs = ['a.txt'], outs = ['o.txt'], cmd = 'cat $< > $@')\n",
      "external/a/a.txt": "hello\n"},
     [["build", "--experimental_sibling_repository_layout", "//external/a:g"]],
     "a main-repo package under external/ with sibling layout")
case("sib-genrule-setup",
     {"MODULE.bazel": "", "BUILD":
          "genrule(name = 'g', outs = ['o.txt'], cmd = 'echo hi > $@')\n"},
     [["build", "--experimental_sibling_repository_layout", "//:g"]],
     "genrule (needs @bazel_tools genrule-setup.sh) with sibling layout")
case("sib-external-repo",
     {"MODULE.bazel": 'local_repository = use_repo_rule('
