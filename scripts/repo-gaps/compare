      ["query", "--incompatible_autoload_externally=+sh_library", "//:x"]],
     "removed and kept rule")
case("al-missing-repo",
     {"MODULE.bazel": "", "BUILD": "aar_import(name = 'x', aar = 'x.aar')\n",
      "x.aar": ""},
     [["query", "--incompatible_autoload_externally=aar_import",
       "--noincompatible_disable_autoloads_in_main_repo", "//:x"]],
     "autoload from a repository that is not a dependency")
case("al-mock-android",
     {"MODULE.bazel": 'bazel_dep(name = "rules_android")\n'
                      'local_path_override(module_name = "rules_android", path = "{aux}/ra")\n',
      "BUILD": "aar_import(name = 'x', aar = 'x.aar')\n", "x.aar": "",
      "{aux}/ra/MODULE.bazel": 'module(name = "rules_android")\n',
      "{aux}/ra/rules/BUILD": "",
      "{aux}/ra/rules/rules.bzl": "def _impl(ctx):\n  pass\n\naar_import = rule(\n"
                                  "  implementation = _impl,\n  attrs = {\n"
                                  '    "aar": attr.label(allow_files = True),\n'
                                  '    "deps": attr.label_list(),\n  }\n)\n'},
     [["query", "--incompatible_autoload_externally=aar_import",
       "--noincompatible_disable_autoloads_in_main_repo", "//:x", "--output=build"],
      ["query", "--incompatible_autoload_externally=aar_import",
       "--noincompatible_disable_autoloads_in_main_repo", "//:x", "--output=label_kind"]],
