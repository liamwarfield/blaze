     "malformed MODULE.bazel")
case("fd-yanked",
     {"MODULE.bazel": 'bazel_dep(name = "aaa", version = "1.0")\n', "BUILD": "",
      "{aux}/registry/bazel_registry.json": "{}\n",
      "{aux}/registry/modules/aaa/metadata.json":
          '{"versions": ["1.0"], "yanked_versions": {"1.0": "dodgy"}}\n',
      "{aux}/registry/modules/aaa/1.0/MODULE.bazel": 'module(name = "aaa", version = "1.0")\n',
      "{aux}/registry/modules/aaa/1.0/source.json":
          '{"type": "local_path", "path": "{aux}/aaa"}\n',
      "{aux}/aaa/MODULE.bazel": 'module(name = "aaa", version = "1.0")\n',
      "{aux}/aaa/BUILD": ""},
     [["build", "--registry=file://{aux}/registry", "--lockfile_mode=off", "//..."]],
     "a yanked dependency (ExternalDeps.VERSION_RESOLUTION_ERROR)")
case("fd-lockfile-error",
     {"MODULE.bazel": 'bazel_dep(name = "aaa", version = "1.0")\n', "BUILD": "",
      "{aux}/registry/bazel_registry.json": "{}\n",
      "{aux}/registry/modules/aaa/metadata.json": '{"versions": ["1.0"]}\n',
      "{aux}/registry/modules/aaa/1.0/MODULE.bazel": 'module(name = "aaa", version = "1.0")\n',
      "{aux}/registry/modules/aaa/1.0/source.json":
          '{"type": "local_path", "path": "{aux}/aaa"}\n',
      "{aux}/aaa/MODULE.bazel": 'module(name = "aaa", version = "1.0")\n',
      "{aux}/aaa/BUILD": ""},
     [["build", "--registry=file://{aux}/registry", "--lockfile_mode=error", "//..."]],
     "--lockfile_mode=error without a lockfile")
# Item 3: autoloads.
case("al-bad-flag",
     {"MODULE.bazel": "", "BUILD": "py_library(name = 'py_library')\n"},
     [["query", "--incompatible_autoload_externally=py_library,-py_library", ":py_library",
       "--output=build"]],
     "duplicated symbol in --incompatible_autoload_externally")
case("al-undefined-symbol",
     {"MODULE.bazel": "", "BUILD": ""},
     [["query", "--incompatible_autoload_externally=pyzzz_library", "//..."]],
     "undefined symbol")
case("al-rdeps",
