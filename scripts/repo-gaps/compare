      "BUILD": "genrule(name = 'g', srcs = ['@r//:r.txt'], outs = ['o.txt'], "
               "cmd = 'cat $< > $@')\n",
      "{aux}/r/REPO.bazel": "", "{aux}/r/BUILD": "exports_files(['r.txt'])\n",
      "{aux}/r/r.txt": "repo file\n"},
     [["build", "--experimental_sibling_repository_layout", "//:g"]],
     "source file of an external repository with sibling layout")
# Item 5.
SPARSE_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "../../crates/blaze_repo_fetch/tests/data/sparse")
case("sparse-tar",
     {"MODULE.bazel": 'r = use_repo_rule("//:r.bzl", "r")\nr(name = "s")\n', "BUILD": "",
      "r.bzl": "def _impl(rctx):\n"
               "    out = []\n"
               "    for v in ['0.0', '0.1', '1.0']:\n"
               "        rctx.extract('%s/sparse_' + v + '.tar', output = v)\n"
               "        p = rctx.path(v + '/dir/holes.bin')\n"
               "        c = rctx.read(p) if p.exists else ''\n"
               "        out.append('%%s exists=%%s len=%%d hash=%%d' %% (v, p.exists, len(c), hash(c)))\n"
               "    fail(' | '.join(out))\n"
               "r = repository_rule(_impl)\n" % os.path.abspath(SPARSE_DIR)},
     [["build", "@s//:all"]],
     "PAX sparse tar entries (formats 0.0, 0.1, 1.0), extracted content reported by fail()")
case("nofetch",
     {"MODULE.bazel": 'http_archive = use_repo_rule('
                      '"@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")\n'
                      'http_archive(name = "z", urls = ["http://127.0.0.1:9/z.zip"])\n',
      "BUILD": "genrule(name = 'g', srcs = ['@z//:f'], outs = ['o'], cmd = 'cp $< $@')\n"},
     [["build", "--nofetch", "//:g"]],
     "--nofetch with a repository that is not fetched")


def norm(text, ws, aux, root):
    text = text.replace(ws, "<WS>").replace(aux, "<AUX>").replace(root, "<ROOT>")
    text = re.sub(r"<ROOT>/[0-9a-f]{32}", "<ROOT>/<OB>", text)
    return text


def compared(stderr):
    out = []
    lines = stderr.splitlines()
    for i, l in enumerate(lines):
        if re.match(r"(ERROR|WARNING|FATAL):", l):
            out.append(l)
        elif re.match(r"(java\.lang\.\w+|blaze: not ported yet|thread '.*' .*panicked)", l):
            out.append(l)
    return out


def write_files(ws, aux, files):
    for rel, content in files.items():
        path = rel.replace("{aux}", aux)
        path = path if os.path.isabs(path) else os.path.join(ws, path)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            f.write(content.replace("{aux}", aux).replace("{ws}", ws))


def run_side(side, binary, is_bazel, name, c, label):
    base = os.path.join(HOME, ".cache/blaze/work/repo-gaps/compare", label, side, name)
    if os.path.exists(base):
        subprocess.run(["chmod", "-R", "u+w", base])
        shutil.rmtree(base)
    ws, aux = os.path.join(base, "ws"), os.path.join(base, "aux")
    os.makedirs(ws)
    os.makedirs(aux)
    write_files(ws, aux, c["files"])
    root = os.path.join(HOME, ".cache/blaze/oracle-out/repo-gaps-" + side)
    results = []
    transcript = ""
    for args in c["cmds"]:
        args = [a.replace("{aux}", aux).replace("{ws}", ws) for a in args]
        cmd = ["systemd-run", "--user", "--scope", "--collect", "--quiet",
               "-p", "MemoryMax=12G", "-p", "MemorySwapMax=0",
               "env", "-i", "HOME=" + HOME, "PATH=/usr/bin:/bin",
               binary, "--output_user_root=" + root, "--nohome_rc", "--nosystem_rc"]
        if is_bazel:
            cmd.append("--batch")
        cmd += [args[0], "--repository_cache=" + REPO_CACHE, "--color=no", "--curses=no"]
        cmd += args[1:]
        p = subprocess.run(cmd, cwd=ws, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        err = norm(p.stderr.decode("latin-1"), ws, aux, root)
        out = norm(p.stdout.decode("latin-1"), ws, aux, root)
        transcript += "$ %s\n%s\n--- stdout\n%s\n[exit %d]\n" % (" ".join(args), err, out,
                                                                p.returncode)
        results.append({"cmd": " ".join(args), "exit": p.returncode, "lines": compared(err),
                        "stdout": out})
    odir = os.path.join(HOME, ".cache/blaze/repo-gaps-compare", label, side)
    os.makedirs(odir, exist_ok=True)
    open(os.path.join(odir, name + ".stderr"), "w").write(transcript)
    json.dump(results, open(os.path.join(odir, name + ".norm.json"), "w"), indent=1)
    return results


def main(argv):
    if not argv or argv[0] in ("help", "--help", "-h"):
        print(USAGE)
        return 0
    if argv[0] == "list":
        for n, c in CASES.items():
            print("%-22s %s" % (n, c["desc"]))
        return 0
    import argparse
    import fnmatch
    ap = argparse.ArgumentParser(usage=USAGE)
    ap.add_argument("--binary", required=True)
    ap.add_argument("--oracle", default=ORACLE)
    ap.add_argument("--case", action="append")
    ap.add_argument("--label", default="default")
    a = ap.parse_args(argv)
    names = [n for n in CASES if not a.case or any(fnmatch.fnmatch(n, g) for g in a.case)]
    allok = True
    for n in names:
        o = run_side("oracle", a.oracle, True, n, CASES[n], a.label)
        b = run_side("blaze", os.path.abspath(a.binary), False, n, CASES[n], a.label)
        for i, (x, y) in enumerate(zip(o, b)):
            same = x["exit"] == y["exit"] and x["lines"] == y["lines"]
            allok &= same
            print("%-5s %-20s #%d exit %s/%s  %s" % ("MATCH" if same else "DIFF", n, i,
                                                    x["exit"], y["exit"], x["cmd"][:60]))
            if not same:
                for l in x["lines"]:
                    if l not in y["lines"]:
                        print("        - oracle: " + l[:300])
                for l in y["lines"]:
                    if l not in x["lines"]:
                        print("        + blaze:  " + l[:300])
    return 0 if allok else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
