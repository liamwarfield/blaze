#!/usr/bin/env python3
"""Compare oracle and Blaze on the repo-gaps reproductions. See `compare help`."""

import json
import os
import re
import shutil
import subprocess
import sys

USAGE = """\
usage: scripts/repo-gaps/compare --binary <blaze> [--oracle <bazel>] [--case GLOB]... [--label NAME]
       scripts/repo-gaps/compare list
       scripts/repo-gaps/compare help

Runs each case (see `list`) with the oracle (default ~/.cache/blaze/oracle/bazel-9.3.2-linux-x86_64)
and with <binary>: each side gets a fresh copy of the case's workspace under
~/.cache/blaze/work/repo-gaps/compare/<label>/<side>/<case> and its own output user root
(~/.cache/blaze/oracle-out/repo-gaps-<side>), a clean environment (HOME, PATH=/usr/bin:/bin),
--nohome_rc --nosystem_rc, --batch on the oracle, the shared repository cache, --color=no
--curses=no, under systemd-run --user --scope -p MemoryMax=12G.

Compared per command (after replacing the workspace, output user root and output base hash with
placeholders): the exit code, and the stderr lines that start with ERROR:, WARNING: or FATAL:
plus the first line of a Java exception / Rust panic message. Output: a table; transcripts
under ~/.cache/blaze/repo-gaps-compare/<label>/<side>/<case>.{stderr,norm.json}. Exit 0 when
all compared cases match.
"""

HOME = os.environ["HOME"]
ORACLE = os.path.join(HOME, ".cache/blaze/oracle/bazel-9.3.2-linux-x86_64")
REPO_CACHE = os.path.join(HOME, ".cache/blaze/repo-cache")

# Each case: files (relative path -> content; "{ws}" is the workspace, "{aux}" a sibling dir),
# and cmds (lists of arguments; the first is the command).
CASES = {}


def case(name, files, cmds, desc):
    CASES[name] = {"files": files, "cmds": cmds, "desc": desc}


# Item 1: FailureDetail categories (ExternalDeps / ExternalRepository).
case("fd-module-not-found",
     {"MODULE.bazel": 'bazel_dep(name = "ss", version = "1.0")\n', "BUILD": "",
      "{aux}/registry/bazel_registry.json": "{}\n"},
     [["build", "--registry=file://{aux}/registry", "//..."],
      ["query", "--registry=file://{aux}/registry", "//..."]],
     "bazel_dep on a module the registry lacks (ExternalDeps.MODULE_NOT_FOUND)")
case("fd-bad-module-file",
     {"MODULE.bazel": 'module(name = "a", version = "1.0")\nbazel_dep(name = )\n', "BUILD": ""},
