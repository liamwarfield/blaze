USAGE = """\
usage: scripts/repo-gaps/compare --binary <blaze> [--oracle <bazel>] [--case GLOB]... [--label NAME]
       scripts/repo-gaps/compare list
       scripts/repo-gaps/compare selftest
       scripts/repo-gaps/compare help

Runs each case (see `list`) with the oracle (default ~/.cache/blaze/oracle/bazel-9.3.2-linux-x86_64)
and with <binary>: each side gets a fresh copy of the case's workspace under
~/.cache/blaze/work/repo-gaps/compare/<label>/<side>/<case> and its own output user root
(~/.cache/blaze/oracle-out/repo-gaps-<side>), a clean environment (HOME, PATH=/usr/bin:/bin),
--nohome_rc --nosystem_rc, --batch on the oracle, the shared repository cache, --color=no
--curses=no, under systemd-run --user --scope -p MemoryMax=12G.

Compared per command (after replacing the workspace, output user root and output base hash with
placeholders): the termination, and the stderr lines that start with ERROR:, WARNING: or FATAL:
plus the first line of a Java exception / Rust panic message. Output: a table; transcripts
under ~/.cache/blaze/repo-gaps-compare/<label>/<side>/<case>.{stderr,norm.json}, and
results.json there.

Guards (scripts/lib/compare_common.py): every command runs under a supervisor in the scope that
records how it really ended (`exit N`, `signal NAME`, `oom-kill`, `timeout` after 1800 s);
--oracle must be the pinned oracle (UPSTREAM.json); an empty selection is an error. Each command
of a case is one row (`<case>#<n>`): IDENTICAL (termination and lines equal; the oracle exited 0,
or DECLARED_EXIT names the row with that exit code), DIFFERENT, BOTH-FAILED (equal failures not
declared), NOT-PORTED, ORACLE-UNEXPECTED, SKIPPED. The output and results.json carry the
repository HEAD and dirty flag, both binaries' paths and sha256, and the denominator. Exit 0
only when at least one row was compared and every row is IDENTICAL; 1 otherwise; 2 on a usage
error or a refusal. Oracle outputs are never reused: both sides run every time.
"""

HOME = os.environ["HOME"]
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
