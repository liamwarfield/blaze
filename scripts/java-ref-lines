#!/usr/bin/env python3
"""Check and fill the line numbers of `// Java: <path>:<line> <Class.member>` markers.

Usage:
  scripts/java-ref-lines check FILE.rs...   report markers whose line does not declare the member
  scripts/java-ref-lines fix FILE.rs...     set the line of every marker to the first declaration
                                            of the member in the Java (or C++) file; a marker
                                            may be written with line 0 to be filled in
  scripts/java-ref-lines help

<path> is relative to src/main/java of the pinned Bazel source (or starts with src/ for C++).
The member is the last dotted component (`Class.method` -> `method`; a bare `Class` -> the class
declaration; `Outer.Inner` nested classes are found by `class Inner`). Standard library only.
"""

import json
import os
import re
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
with open(os.path.join(REPO, "UPSTREAM.json")) as f:
    _up = json.load(f)
SRC = os.path.expanduser(_up["pins"][_up["current"]]["source_checkout"])
MARK = re.compile(r"(//\s*Java:\s*)(\S+?):(\d+)(\s+)([\w.$<>]+)")
_cache = {}


def java_lines(rel):
    if rel not in _cache:
        cands = [os.path.join(SRC, "src/main/java", rel), os.path.join(SRC, rel)]
        for c in cands:
            if os.path.isfile(c):
                with open(c, encoding="utf-8", errors="replace") as f:
                    _cache[rel] = f.read().split("\n")
                break
        else:
            _cache[rel] = None
    return _cache[rel]


def decl_patterns(member):
    parts = member.split(".")
    name = parts[-1]
    if name == "<init>" and len(parts) >= 2:
        name = parts[-2]
        p = re.compile(r"(public|protected|private|^)\s*" + re.escape(name) + r"\s*\(")
        return [p, p]
    pats = []
    if name[:1].isupper() and not name.isupper():
        pats.append(re.compile(r"\b(class|interface|enum|record|@interface|struct)\s+" + re.escape(name) + r"\b"))
    if name.isupper() or "_" in name and name.upper() == name:
        pats.append(re.compile(r"\b" + re.escape(name) + r"\s*(=|\(|,|;|\{)"))
    # method / function declaration: a type or modifier before the name, then '('
    pats.append(re.compile(r"(^|[\s>\]*&:])" + re.escape(name) + r"\s*\("))
    pats.append(re.compile(r"\b" + re.escape(name) + r"\b"))
    return pats


def is_decl(line, member):
    s = line.strip()
    if s.startswith("//") or s.startswith("*") or s.startswith("/*"):
        return False
    for p in decl_patterns(member)[:-1]:
        if p.search(line):
            # method calls look like `foo.name(` ; skip those
            if "." + member.split(".")[-1] + "(" in line.replace(" ", ""):
                return False
            if re.search(r"\b(return|new)\s+" + re.escape(member.split(".")[-1]) + r"\b", line):
                return False
            return True
    return False


def find_line(lines, member):
    for i, line in enumerate(lines):
        if is_decl(line, member):
            return i + 1
    pat = decl_patterns(member)[-1]
    for i, line in enumerate(lines):
        if pat.search(line):
            return i + 1
    return None


def process(path, fix):
    with open(path) as f:
        text = f.read()
    bad = 0
    out = []
    for lineno, line in enumerate(text.split("\n"), 1):
        m = MARK.search(line)
        if m:
            rel, n, member = m.group(2), int(m.group(3)), m.group(5)
            lines = java_lines(rel)
            if lines is None:
                print(f"{path}:{lineno}: missing source file {rel}")
                bad += 1
            else:
                ok = 1 <= n <= len(lines) and is_decl(lines[n - 1], member)
                if not ok:
                    found = find_line(lines, member)
                    if fix and found:
                        line = line[: m.start(3)] + str(found) + line[m.end(3):]
                    else:
                        bad += 1
                        print(f"{path}:{lineno}: {rel}:{n} does not declare {member} (first match: {found})")
        out.append(line)
    if fix:
        new = "\n".join(out)
        if new != text:
            with open(path, "w") as f:
                f.write(new)
    return bad


def main(argv):
    if len(argv) < 2 or argv[1] in ("help", "--help", "-h") or argv[1] not in ("check", "fix"):
        print(__doc__)
        return 0 if len(argv) >= 2 and argv[1] in ("help", "--help", "-h") else 2
    bad = 0
    for p in argv[2:]:
        bad += process(p, argv[1] == "fix")
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
