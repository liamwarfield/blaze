 "allowed_by": {
  "build-metrics-volatile-counters": {
   "items": 2,
   "reason": "Skyframe evaluates in parallel, so how many nodes of each SkyFunction are evaluated or dirtied in one invocation varies between identical runs (re2: a few per cent). The serialized action cache size also varies by a few hundred bytes on re2 (161890 vs 161688) with identical actions and outputs. Action, artifact, target, package and per-mnemonic action counts in the same event are still compared."
  },
  "runfiles-manifest-action-key": {
   "items": 56,
   "reason": "SourceManifestAction's action key fingerprints the manifest content, which names absolute execroot paths. Every recording has its own workspace copy and output base, so the hash differs; the normalised manifest bytes (outputs surface), argv, inputs and outputs still match."
  }
 },
