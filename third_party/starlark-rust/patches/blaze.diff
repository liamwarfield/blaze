+        ("int" | "float", "x") => Some(&["string", "bool", "int", "float"]),
+        ("abs", "x") => Some(&["int", "float"]),
+        ("startswith" | "endswith", "sub") => Some(&["string", "tuple"]),
+        _ => None,
+    };
+    let names: Vec<String> = match listed {
+        Some(l) => l.iter().map(|s| (*s).to_owned()).collect(),
+        None => {
+            let text = ty.to_string();
+            let mut parts = Vec::new();
+            let mut depth = 0;
+            let mut cur = String::new();
+            for c in text.chars() {
+                match c {
+                    '[' | '(' => depth += 1,
+                    ']' | ')' => depth -= 1,
+                    _ => {}
+                }
+                if c == '|' && depth == 0 {
+                    parts.push(std::mem::take(&mut cur));
+                } else {
+                    cur.push(c);
+                }
+            }
+            parts.push(cur);
+            let mut names: Vec<String> = parts
+                .iter()
+                .map(|p| {
+                    let p = p.trim();
+                    let base = p.split('[').next().unwrap_or(p);
+                    match base {
+                        "str" => "string",
+                        "None" => "NoneType",
+                        "typing.Iterable" => "iterable",
+                        "typing.Callable" => "callable",
+                        "typing.Any" => "Object",
+                        other => other,
+                    }
+                    .to_owned()
+                })
+                .collect();
+            names.dedup();
+            if let Some(i) = names.iter().position(|n| n == "NoneType") {
+                let n = names.remove(i);
+                names.push(n);
+            }
+            names
+        }
+    };
+    let n = names.len();
+    let mut buf = String::new();
+    for (i, name) in names.iter().enumerate() {
+        if i > 0 {
+            buf.push_str(if n == 2 {
+                " or "
+            } else if i < n - 1 {
+                ", "
+            } else {
+                ", or "
+            });
+        }
+        buf.push_str(name);
+    }
