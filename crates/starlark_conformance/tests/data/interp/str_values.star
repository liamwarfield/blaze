
s = "abc"
print(s.find("", 5), s.rfind("", 5), s.index("", 5), s.rindex("", 5))
print(s.find("", 2, 1), s.rfind("", 2, 1), s.find("", -10), s.rfind("", -10, -20))
print(s.count("", 2, 1), s.count("", 5), s.count(""), s.count("", -1), s.count("", 1, None))
print(s.startswith("", 5), s.endswith("", 5), s.startswith("", 3, 1), s.endswith(("x", ""), 5))
print(s.startswith("c", 2, 1), s.endswith("b", 0, 2), s.endswith("b", 0, -1), s.startswith("a", None))
print(s.find("c", 5), s.find("b", -2), s.rfind("b", None, None), s.find("bc", 1, 2))
print(s.count("b", None, None), s.count("a", -100, 100), s.find("a", 1, 0))
print(s[None:2], s[1:None], s[None:None:None], s[None:None:-1], s[None:-1:None])
print([1, 2, 3][None:2], (1, 2, 3)[None:None:-1])
print(" a ".strip(None) + "|", " a ".lstrip(None) + "|", " a ".rstrip(None) + "|")
print("abc".replace("", "-"), "abc".replace("", "-", 2), "abc".replace("", "-", 0), "aaa".replace("a", "b", -5))
print("a\r\nb\rc\n".splitlines(), "a\r\nb\rc\n".splitlines(True), "".splitlines(), "\n".splitlines(), "\n\n".splitlines(True))
print("a,b,,c".split(",", 1), "a,b,,c".rsplit(",", 1), "a,b".split(",", maxsplit = -1), "abab".rsplit("ab"))
print("abc".partition("b"), "abc".rpartition("x"), "abc".partition("x"))
print("abc".removeprefix(""), "abc".removesuffix(""), "abc".removeprefix("abc"), "".removesuffix(""))
print(",".join({"a": 1, "b": 2}), ",".join(("x",)), ",".join([]))
print("abc".elems(), "".elems())
print(int("0x10", 0), int("0b11", 0), int("0o7", 0), int("10", 16), int("-0x10", 0), int(" 1"[1:]))
print(type(json), str(json)[:0])
print("abc".isalpha(), "".isalpha(), "x".title())
print(dir("")[:60])
print("aXbX".split("X"), "abc".split("abc"), "".split("x"), "".rsplit("x"))
print("a b".split(" ", 0), "a b".rsplit(" ", 0))
print(s[0:100], s[-100:2], s[2:1], s[::2], s[::-2], s[5:0:-1], s[-5::-1])
print("{}{}".format(1, 2), "{{}}".format(), "{0}{x}".format(1, x = 2), "{ }".format(**{" ": 3}))
