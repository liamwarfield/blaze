
print("aaaa".count("aa"), "aaaa".replace("aa", "b"), "aaa".rfind("aa"), "aaa".rindex("aa", 0, 2), "aaa".find("aa", 1))
print("a,b,c".rsplit(",", 1), "a,b,c".split(",", 0), "a,b,c".rsplit(",", -1), ",a,".split(","), "a".rsplit("a"))
print("".capitalize(), "aBC".capitalize(), "hello world".title(), "".istitle(), "".isspace(), " ".isspace(), "".isdigit(), "1".isdigit())
print(",".join(set(["a"])), "".join(("a", "b")), "-".join(["x"]))
print("x".startswith(()), "abc".endswith(("c",), 1), "abc".find("c", None, 2), "abc".endswith("bc", -2), "abc".startswith("bc", -2, None))
print("{-0}".format("a"), "{00}".format("z"), "{0}{0}".format("q"), "{a}".format(a = None), "{} {}".format(*[1, [2]]))
print("ab".splitlines(), "a\n\rb".splitlines(True), "\r".splitlines(), "x\r\n".splitlines(False))
print("abc".lstrip(""), "  ".strip(), "xyxzx".strip("x"), "\034 a\037".strip(), "a\240".strip())
print("abc".partition("bc"), "abcbc".rpartition("bc"), "abc".rpartition("a"))
print("Ab1".isalnum(), "Ab".isalpha(), "ab".islower(), "AB".isupper(), "A1".isupper(), "1".islower())
print("Hello World".istitle(), "Hello world".istitle(), "HELLO".istitle(), "A1b".istitle())
print("abc"[-1], "abc"[-3], "abc"[1:-1], "abc"[-1:-3:-1], "abc"[100:], "abc"[:-100])
print("%s|%r|%d" % ("a", "a", 3), "%%" % (), "%s" % [1])
print("abc".replace("b", ""), "abc".replace("", ""), "".replace("", "x"), "".replace("", "x", 0))
print(len("abc".elems()), "ab".elems()[1], type("ab".elems()))
print(int("-0x1F", 16), int("0X1f", 0), int("+7"), int("-0"), int("0"), int("0b1", 16), int("z", 36), int("Z", 36))
print(int("9" * 30), int("-" + "9" * 30), int("0o777", 8), int("0", 0), int("-0o7", 0))
print(repr("{a!r}".format(**{"a!r": 1})), "{-1}".format(**{}) if False else "skip")
